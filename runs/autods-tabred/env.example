# ---------------------------------------------------------------------------
# Скопировать в env.local и заполнить.  env.local НЕ коммитить.
#   cp env.example env.local && ${EDITOR:-nano} env.local
# run.sh также подхватит .env в корне репозитория, если env.local нет.
# ---------------------------------------------------------------------------

# --- СЕКРЕТ: ключ OpenAI-совместимого шлюза, через который ходит AutoDS ------
# Для gemma-4-31b-it это ключ OpenRouter (как в исходных прогонах).
AUTODS_API_KEY=

# --- шлюз и модель ---------------------------------------------------------
AUTODS_BASE_URL=https://openrouter.ai/api/v1
AUTODS_MODEL=google/gemma-4-31b-it

# Бюджет супершагов LangGraph. Длинные табличные прогоны в него упираются.
AUTODS_RECURSION_LIMIT=150

# Цены для телеметрии стоимости в трассе (USD за 1M токенов).
AUTODS_PRICE_INPUT_PER_1M=
AUTODS_PRICE_OUTPUT_PER_1M=

# ---------------------------------------------------------------------------
# ВЕТКА ЭКСПЕРИМЕНТА — вот этим переключается слой предписанного знания.
#
#   не задано  -> слой ПРИМЕНЯЕТСЯ (ветка C1).  Это поведение по умолчанию.
#   =1         -> слой не применяется (базовая ветка).
#
# Слой собирается в c1_prompt.augment() как  _LIBRARY[family] + _DISCIPLINE:
#   _LIBRARY   369-1291 символов, зависит от модальности   -> ось K-tool
#   _DISCIPLINE      3678 символов, одинаково для всех      -> ось K-disc
# Сейчас они склеены и одним флагом включаются вместе.
# ---------------------------------------------------------------------------
AUTODS_C1_DISABLED=

# ---------------------------------------------------------------------------
# Модули самой системы AutoDS. К оси предписанного знания НЕ относятся.
# В 36 прогонах статьи все три были в состоянии по умолчанию — оставить пустыми,
# иначе прогон перестанет быть сопоставимым с уже опубликованными числами.
#
#   RESEARCH_DISABLED  отдельный модуль исследования с веб-поиском
#   LIBQ_DISABLED      конвертация репозитория в индекс для поиска по коду
#                      и документации; работает плохо, лучше не трогать
#   DEBUGGER_DISABLED  цикл отладки. ВКЛЮЧЁН по умолчанию и реально срабатывал:
#                      18 вызовов в ветке C1 против 12 в базовой, в 9 прогонах
#                      из 18 против 8 из 18. Это медиатор, а не воздействие —
#                      см. раздел про механизм в статье.
# ---------------------------------------------------------------------------
RESEARCH_DISABLED=
LIBQ_DISABLED=
DEBUGGER_DISABLED=

# --- СЕКРЕТ, опционально: только для выкладки прогонов на хаб ---------------
# Альтернатива — один раз выполнить `harbor auth login`.
HARBOR_API_KEY=
