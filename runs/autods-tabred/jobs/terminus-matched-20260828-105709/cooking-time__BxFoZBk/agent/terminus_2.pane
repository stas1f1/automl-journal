[?2004hroot@83bc5e3b763a:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import lightgbm as lgb
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> def solve():
[?2004l[?2004h>     # Load data
[?2004l[?2004h>     train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h>     val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h>     test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h>     # Identify feature types
[?2004l[?2004h>     target_col = 'target'
[?2004l[?2004h>     all_cols = train.columns.tolist()
[?2004l[?2004h>     num_cols = [c for c in all_cols if c.startswith('num_')]
[?2004l[?2004h>     bin_cols = [c for c in all_cols if c.startswith('bin_')]
[?2004l[?2004h>     cat_cols = [c for c in all_cols if c.startswith('cat_')]
[?2004l[?2004h> 
[?2004l[?2004h>     X_train = train.drop(columns=[target_col])
[?2004l[?2004h>     y_train = train[target_col]
[?2004l[?2004h>     X_val = val.drop(columns=[target_col])
[?2004l[?2004h>     y_val = val[target_col]
[?2004l[?2004h>     X_test = test
[?2004l[?2004h> 
[?2004l[?2004h>     # LightGBM handles NaNs and Categorical features if specified
[?2004l[?2004h>     # Convert cat_cols to category type for LightGBM
[?2004l[?2004h>     for col in cat_cols:
[?2004l[?2004h>         X_train[col] = X_train[col].astype('category')
[?2004l[?2004h>         X_val[col] = X_val[col].astype('category')
[?2004l[?2004h>         X_test[col] = X_test[col].astype('category')
[?2004l[?2004h> 
