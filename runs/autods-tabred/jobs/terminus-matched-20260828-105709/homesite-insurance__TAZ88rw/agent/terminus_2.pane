cat << 'EOF' > solution_fast.py
import pandas as pd
import numpy as np
import lightgbm as lgb
import os

def solve():
    print('Loading data...')
    train = pd.read_csv('/app/data/train.csv')
    val = pd.read_csv('/app/data/val.csv')
    test = pd.read_csv('/app/data/test.csv')
    target_col = 'target'
    num_cols = [c for c in train.columns if c.startswith('num_')]
    bin_cols = [c for c in train.columns if c.startswith('bin_')]
    cat_cols = [c for c in train.columns if c.startswith('cat_')]
    X_train = train[num_cols + bin_cols + cat_cols].copy()
    y_train = train[target_col]
    X_val = val[num_cols + bin_cols + cat_cols].copy()
    y_val = val[target_col]
    X_test = test[num_cols + bin_cols + cat_cols].copy()
    for col in cat_cols:
        X_train[col] = X_train[col].astype('category')
        X_val[col] = X_val[col].astype('category')
        X_test[col] = X_test[col].astype('category')
    print('Training model...')
    model = lgb.LGBMClassifier(n_estimators=10, learning_rate=0.1, random_state=42, n_jobs=-1, verbosity=-1)
    model.fit(X_train, y_train, eval_set=[(X_val, y_val)], eval_metric='auc', callbacks=[lgb.early_stopping(stopping_rounds=5)])
    print('Predicting...')
    preds = model.predict_proba(X_test)[:, 1]
    out = pd.DataFrame({'target': preds})
    out.to_csv('/app/predictions.csv', index=False)
    print(f'Done. Shape: {out.shape}')

if __name__ == '__main__':
    solve()
