[322.817598, "i", "cat << 'EOF' > solution_fast.py\nimport pandas as pd\nimport numpy as np\nimport lightgbm as lgb\nimport os\n\ndef solve():\n    print('Loading data...')\n    train = pd.read_csv('/app/data/train.csv')\n    val = pd.read_csv('/app/data/val.csv')\n    test = pd.read_csv('/app/data/test.csv')\n    target_col = 'target'\n    num_cols = [c for c in train.columns if c.startswith('num_')]\n    bin_cols = [c for c in train.columns if c.startswith('bin_')]\n    cat_cols = [c for c in train.columns if c.startswith('cat_')]\n    X_train = train[num_cols + bin_cols + cat_cols].copy()\n    y_train = train[target_col]\n    X_val = val[num_cols + bin_cols + cat_cols].copy()\n    y_val = val[target_col]\n    X_test = test[num_cols + bin_cols + cat_cols].copy()\n    for col in cat_cols:\n        X_train[col] = X_train[col].astype('category')\n        X_val[col] = X_val[col].astype('category')\n        X_test[col] = X_test[col].astype('category')\n    print('Training model...')\n    model = lgb.LGBMClassifier(n_estimators=10, learning_rate=0.1, random_state=42, n_jobs=-1, verbosity=-1)\n    model.fit(X_train, y_train, eval_set=[(X_val, y_val)], eval_metric='auc', callbacks=[lgb.early_stopping(stopping_rounds=5)])\n    print('Predicting...')\n    preds = model.predict_proba(X_test)[:, 1]\n    out = pd.DataFrame({'target': preds})\n    out.to_csv('/app/predictions.csv', index=False)\n    print(f'Done. Shape: {out.shape}')\n\nif __name__ == '__main__':\n    solve()\nEOF\n"]
[322.818605, "o", "cat << 'EOF' > solution_fast.py\r\nimport pandas as pd\r\nimport numpy as np\r\nimport lightgbm as lgb\r\nimport os\r\n\r\ndef solve():\r\n    print('Loading data...')\r\n    train = pd.read_csv('/app/data/train.csv')\r\n    val = pd.read_csv('/app/data/val.csv')\r\n    test = pd.read_csv('/app/data/test.csv')\r\n    target_col = 'target'\r\n    num_cols = [c for c in train.columns if c.startswith('num_')]\r\n    bin_cols = [c for c in train.columns if c.startswith('bin_')]\r\n    cat_cols = [c for c in train.columns if c.startswith('cat_')]\r\n    X_train = train[num_cols + bin_cols + cat_cols].copy()\r\n    y_train = train[target_col]\r\n    X_val = val[num_cols + bin_cols + cat_cols].copy()\r\n    y_val = val[target_col]\r\n    X_test = test[num_cols + bin_cols + cat_cols].copy()\r\n    for col in cat_cols:\r\n        X_train[col] = X_train[col].astype('category')\r\n        X_val[col] = X_val[col].astype('category')\r\n        X_test[col] = X_test[col].astype('category')\r\n    print('Training model...')\r\n    model = lgb.LGBMClassifier(n_estimators=10, learning_rate=0.1, random_state=42, n_jobs=-1, verbosity=-1)\r\n    model.fit(X_train, y_train, eval_set=[(X_val, y_val)], eval_metric='auc', callbacks=[lgb.early_stopping(stopping_rounds=5)])\r\n    print('Predicting...')\r\n    preds = model.predict_proba(X_test)[:, 1]\r\n    out = pd.DataFrame({'target': preds})\r\n    out.to_csv('/app/predictions.csv', index=False)\r\n    print(f'Done. Shape: {out.shape}')\r\n\r\nif __name__ == '__main__':\r\n    solve()\r\nEOF\r\n"]
[322.956955, "i", "bash -c 'python3 solution_fast.py'\n"]
[322.957109, "o", "bash -c 'python3 solution_fast.py'\r\n"]
