[338.965599, "o", "X_val = val.drop(columns=['target'])\r\n\u001b[?2004l\r"]
[338.965626, "o", "\u001b[?2004h> "]
[338.965653, "o", "y_val = val['target']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.96568, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.965712, "o", "# Identify categorical features\r\n\u001b[?2004l\r"]
[338.965739, "o", "\u001b[?2004h> "]
[338.965817, "o", "cat_cols = [col for col in X_train.columns if col.startswith('cat_')]\r\n\u001b[?2004l\r\u001b[?2004h"]
[338.965844, "o", "> "]
[338.96587, "o", "for col in cat_cols:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.965929, "o", "    X_train[col] = X_train[col].astype('category')\r\n\u001b[?2004l\r"]
[338.965955, "o", "\u001b[?2004h> "]
[338.966003, "o", "    X_val[col] = X_val[col].astype('category')\r\n\u001b[?2004l\r"]
[338.966029, "o", "\u001b[?2004h> "]
[338.96607, "o", "    test[col] = test[col].astype('category')\r\n\u001b[?2004l\r"]
[338.966098, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.966159, "o", "# Train LightGBM with fewer estimators for speed\r\n\u001b[?2004l\r"]
[338.966185, "o", "\u001b[?2004h> "]
[338.966277, "o", "model = lgb.LGBMRegressor(n_estimators=200, learning_rate=0.1, random_state=42)\r\n\u001b[?2004l\r"]
[338.966309, "o", "\u001b[?2004h> model.fit(\r\n\u001b[?2004l\r"]
[338.966337, "o", "\u001b[?2004h> "]
[338.966363, "o", "    X_train, y_train,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.966409, "o", "    eval_set=[(X_val, y_val)],\r\n\u001b[?2004l\r\u001b[?2004h"]
[338.966435, "o", "> "]
[338.966461, "o", "    eval_metric='rmse',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.966525, "o", "    callbacks=[lgb.early_stopping(stopping_rounds=20)]\r\n\u001b[?2004l\r"]
[338.966551, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h"]
[338.966577, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.966608, "o", "# Predict on test set\r\n\u001b[?2004l\r"]
[338.966633, "o", "\u001b[?2004h> "]
[338.966659, "o", "preds = model.predict(test)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[338.966685, "o", "\u001b[?2004h> "]
[338.966711, "o", "# Save to predictions.csv\r\n\u001b[?2004l\r"]
[338.966737, "o", "\u001b[?2004h> "]
[338.966769, "o", "pdf = pd.DataFrame({'target': preds})\r\n\u001b[?2004l\r"]
[338.966795, "o", "\u001b[?2004h> "]
[338.966847, "o", "pdf.to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r"]
[338.966873, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.966955, "o", "print('Predictions saved to /app/predictions.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.966983, "o", "EOF\r\n\u001b[?2004l\r"]
[338.967705, "o", "\u001b[?2004hroot@e5bf4d3afe0a:/workspace# python3 solution.py &\r\n"]
[338.967721, "o", "\u001b[?2004l\r"]
[338.967804, "o", "[1] 900\r\n"]
[338.967851, "o", "\u001b[?2004hroot@e5bf4d3afe0a:/workspace# "]
[338.967885, "o", "sleep 60\r\n\u001b[?2004l\r"]
