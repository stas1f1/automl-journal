[6.185186, "o", "\u001b[?2004h"]
[6.185214, "o", "root@1eb16ed41356:/workspace# "]
[28.985234, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport lightgbm as lgb\nfrom sklearn.metrics import roc_auc_score\nimport numpy as np\n\ndef solve():\n    train = pd.read_csv('/app/data/train.csv')\n    val = pd.read_csv('/app/data/val.csv')\n    test = pd.read_csv('/app/data/test.csv')\n\n    target_col = 'target'\n    X_train = train.drop(columns=[target_col])\n    y_train = train[target_col]\n    X_val = val.drop(columns=[target_col])\n    y_val = val[target_col]\n\n    cat_features = [col for col in X_train.columns if col.startswith('cat_') or col.startswith('bin_')]\n    \n    # Convert categorical columns to category type for LightGBM\n    for col in cat_features:\n        X_train[col] = X_train[col].astype('category')\n        X_val[col] = X_val[col].astype('category')\n        test[col] = test[col].astype('category')\n\n    model = lgb.LGBMClassifier(\n        n_estimators=1000,\n        learning_rate=0.05,\n        num_leaves=31,\n        colsample_bytree=0.8,\n        subsample=0.8,\n        random_state=42,\n        n_jobs=-1\n    )\n\n    model.fit(\n        X_train, y_train,\n        eval_set=[(X_val, y_val)],\n        eval_metric='auc',\n        callbacks=[lgb.early_stopping(stopping_rounds=50)]\n    )\n\n    preds = model.predict_proba(test)[:, 1]\n    \n    output = pd.DataFrame({'target': preds})\n    output.to_csv('/app/predictions.csv', index=False)\n    print('Predictions saved to /app/predictions.csv')\n\nif __name__ == '__main__':\n    solve()\nEOF\n"]
