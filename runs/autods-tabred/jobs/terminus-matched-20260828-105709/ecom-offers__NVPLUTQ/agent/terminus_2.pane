[?2004hroot@3a43a412e65f:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import lightgbm as lgb
[?2004l[?2004h> from sklearn.metrics import roc_auc_score
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train_df = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val_df = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test_df = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Separate features and target
[?2004l[?2004h> X_train = train_df.drop(columns=['target'])
[?2004l[?2004h> y_train = train_df['target']
[?2004l[?2004h> X_val = val_df.drop(columns=['target'])
[?2004l[?2004h> y_val = val_df['target']
[?2004l[?2004h> 
[?2004l[?2004h> # Use LightGBM classifier
[?2004l[?2004h> # We use LGBMClassifier for simplicity, it handles NaNs automatically
[?2004l[?2004h> model = lgb.LGBMClassifier(
[?2004l[?2004h>     n_estimators=1000,
[?2004l[?2004h>     learning_rate=0.05,
[?2004l[?2004h>     num_leaves=31,
[?2004l[?2004h>     random_state=42,
[?2004l[?2004h>     n_jobs=-1,
[?2004l[?2004h>     importance_type='split'
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Train with early stopping using the validation set
[?2004l[?2004h> model.fit(
[?2004l[?2004h>     X_train, y_train,
[?2004l[?2004h>     eval_set=[(X_val, y_val)],
[?2004l[?2004h>     eval_metric='auc',
[?2004l[?2004h>     callbacks=[lgb.early_stopping(stopping_rounds=50)]
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Predict probabilities for the test set
[?2004l[?2004h> # predict_proba returns [prob_class_0, prob_class_1]
[?2004l[?2004h> test_probs = model.predict_proba(test_df)[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> # Save predictions to CSV
[?2004l[?2004h> pred_df = pd.DataFrame({'target': test_probs})
[?2004l[?2004h> pred_df.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> 
[?2004l[?2004h> print('Predictions saved to /app/predictions.csv')
[?2004l[?2004h> EOF
