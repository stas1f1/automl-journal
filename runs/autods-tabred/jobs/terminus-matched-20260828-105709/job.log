Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport lightgbm as lgb\nfrom sklearn.metrics import roc_auc_score\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\n# Separate features and target\nX_train = train_df.drop(columns=['target'])\ny_train = train_df['target']\nX_val = val_df.drop(columns=['target'])\ny_val = val_df['target']\n\n# Use LightGBM classifier\n# We use LGBMClassifier for simplicity, it handles NaNs automatically\nmodel = lgb.LGBMClassifier(\n    n_estimators=1000,\n    learning_rate=0.05,\n    num_leaves=31,\n    random_state=42,\n    n_jobs=-1,\n    importance_type='split'\n)\n\n# Train with early stopping using the validation set\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    eval_metric='auc',\n    callbacks=[lgb.early_stopping(stopping_rounds=50)]\n)\n\n# Predict probabilities for the test set\n# predict_proba returns [prob_class_0, prob_class_1]\ntest_probs = model.predict_proba(test_df)[:, 1]\n\n# Save predictions to CSV\npred_df = pd.DataFrame({'target': test_probs})\npred_df.to_csv('/app/predictions.csv', index=False)\n\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
