Sending keys: ['cat << \'EOF\' > solution.py\nimport pandas as pd\nimport numpy as np\nimport lightgbm as lgb\nfrom sklearn.metrics import roc_auc_score\n\n# Load data\ntrain = pd.read_csv(\'/app/data/train.csv\')\nval = pd.read_csv(\'/app/data/val.csv\')\ntest = pd.read_csv(\'/app/data/test.csv\')\n\nX_train = train.drop(columns=[\'target\'])\ny_train = train[\'target\']\nX_val = val.drop(columns=[\'target\'])\ny_val = val[\'target\']\n\n# Identify feature types\nnum_cols = [c for c in X_train.columns if c.startswith(\'num_\')]\nbin_cols = [c for c in X_train.columns if c.startswith(\'bin_\')]\ncat_cols = [c for c in X_train.columns if c.startswith(\'cat_\')]\n\n# Convert categorical columns to \'category\' dtype for LightGBM\nfor col in cat_cols:\n    X_train[col] = X_train[col].astype(\'category\')\n    X_val[col] = X_val[col].astype(\'category\')\n    test[col] = test[col].astype(\'category\')\n\n# Train LightGBM model\nmodel = lgb.LGBMClassifier(\n    n_estimators=1000,\n    learning_rate=0.05,\n    num_leaves=31,\n    colsample_bytree=0.8,\n    subsample=0.8,\n    random_state=42,\n    n_jobs=-1\n)\n\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    eval_metric=\'auc\',\n    callbacks=[lgb.early_stopping(stopping_rounds=50)]\n)\n\n# Predict probabilities for the positive class\nprobs = model.predict_proba(test)[:, 1]\n\n# Save to predictions.csv\npred_df = pd.DataFrame({\'target\': probs})\npred_df.to_csv(\'/app/predictions.csv\', index=False)\nprint("Predictions saved to /app/predictions.csv")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
