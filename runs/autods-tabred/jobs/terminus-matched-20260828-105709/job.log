Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport lightgbm as lgb\nimport numpy as np\nfrom sklearn.metrics import mean_squared_error\n\n# Load data\nprint('Loading data...')\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\n# Identify feature types\ncat_cols = [col for col in train.columns if col.startswith('cat_')]\nnum_cols = [col for col in train.columns if col.startswith('num_')]\n\n# Convert categorical columns to category type\nfor col in cat_cols:\n    train[col] = train[col].astype('category')\n    val[col] = val[col].astype('category')\n    test[col] = test[col].astype('category')\n\nX_train = train.drop(columns=['target'])\ny_train = train['target']\nX_val = val.drop(columns=['target'])\ny_val = val['target']\n\n# Build LightGBM model\nprint('Training model...')\nmodel = lgb.LGBMRegressor(\n    n_estimators=1000,\n    learning_rate=0.05,\n    num_leaves=31,\n    objective='regression',\n    metric='rmse',\n    random_state=42,\n    n_jobs=-1\n)\n\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    callbacks=[lgb.early_stopping(stopping_rounds=50)]\n)\n\n# Evaluate on validation set\npreds_val = model.predict(X_val)\nrmse = np.sqrt(mean_squared_error(y_val, preds_val))\nprint(f'Validation RMSE: {rmse}')\n\n# Predict on test set\nprint('Predicting on test set...')\npreds_test = model.predict(test)\n\n# Save predictions\noutput = pd.DataFrame({'target': preds_test})\noutput.to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
