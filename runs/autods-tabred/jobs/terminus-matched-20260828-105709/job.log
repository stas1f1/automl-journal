Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nimport lightgbm as lgb\nfrom sklearn.metrics import roc_auc_score\nimport os\n\ndef solve():\n    print('Loading data...')\n    train = pd.read_csv('/app/data/train.csv')\n    val = pd.read_csv('/app/data/val.csv')\n    test = pd.read_csv('/app/data/test.csv')\n\n    target_col = 'target'\n    num_cols = [c for c in train.columns if c.startswith('num_')]\n    bin_cols = [c for c in train.columns if c.startswith('bin_')]\n    cat_cols = [c for c in train.columns if c.startswith('cat_')]\n\n    print(f'Features: {len(num_cols)} num, {len(bin_cols)} bin, {len(cat_cols)} cat')\n\n    X_train = train[num_cols + bin_cols + cat_cols].copy()\n    y_train = train[target_col]\n    X_val = val[num_cols + bin_cols + cat_cols].copy()\n    y_val = val[target_col]\n    X_test = test[num_cols + bin_cols + cat_cols].copy()\n\n    for col in cat_cols:\n        X_train[col] = X_train[col].astype('category')\n        X_val[col] = X_val[col].astype('category')\n        X_test[col] = X_test[col].astype('category')\n\n    print('Training model...')\n    model = lgb.LGBMClassifier(\n        n_estimators=1000,\n        learning_rate=0.05,\n        num_leaves=31,\n        max_depth=-1,\n        random_state=42,\n        n_jobs=-1,\n        verbosity=-1\n    )\n\n    model.fit(\n        X_train, y_train,\n        eval_set=[(X_val, y_val)],\n        eval_metric='auc',\n        callbacks=[lgb.early_stopping(stopping_rounds=50)]\n    )\n\n    print('Predicting...')\n    preds = model.predict_proba(X_test)[:, 1]\n    \n    print('Saving predictions...')\n    out = pd.DataFrame({'target': preds})\n    out.to_csv('/app/predictions.csv', index=False)\n    print(f'Predictions saved to /app/predictions.csv. Shape: {out.shape}')\n\nif __name__ == '__main__':\n    try:\n        solve()\n    except Exception as e:\n        print(f'Error occurred: {e}')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
