Sending keys: ['cat << \'EOF\' > solve.py\nimport pandas as pd\nimport lightgbm as lgb\nimport json\nimport numpy as np\n\n# Load schema\nwith open(\'/app/data/schema.json\', \'r\') as f:\n    schema = json.load(f)\n\nfeatures = schema[\'feature_columns\']\ntarget_col = schema[\'target_column\']\n\n# Load data\ntrain = pd.read_csv(\'/app/data/train.csv\')\nval = pd.read_csv(\'/app/data/val.csv\')\ntest = pd.read_csv(\'/app/data/test.csv\')\n\n# Prepare X and y\nX_train = train[features]\ny_train = train[target_col]\nX_val = val[features]\ny_val = val[target_col]\nX_test = test[features]\n\n# LightGBM handles NaNs internally. \n# We might want to treat -9999 as NaN if it\'s a sentinel value, \n# but let\'s start with default handling first.\n\n# Model parameters\nparams = {\n    \'objective\': \'regression\',\n    \'metric\': \'rmse\',\n    \'verbosity\': -1,\n    \'boosting_type\': \'gbdt\',\n    \'random_state\': 42,\n    \'learning_rate\': 0.05,\n    \'num_leaves\': 31,\n    \'feature_fraction\': 0.8,\n    \'bagging_fraction\': 0.8,\n    \'bagging_freq\': 5,\n}\n\n# Train with early stopping\nmodel = lgb.LGBMRegressor(**params, n_estimators=1000)\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    eval_metric=\'rmse\',\n    callbacks=[lgb.early_stopping(stopping_rounds=50)]\n)\n\n# Predict\npreds = model.predict(X_test)\n\n# Save predictions\noutput = pd.DataFrame({\'target\': preds})\noutput.to_csv(\'/app/predictions.csv\', index=False)\n\nprint("Predictions saved to /app/predictions.csv")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
