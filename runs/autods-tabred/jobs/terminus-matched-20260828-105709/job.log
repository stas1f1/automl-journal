Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport lightgbm as lgb\nimport numpy as np\n\n# Load data\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nX_train = train.drop(columns=['target'])\ny_train = train['target']\nX_val = val.drop(columns=['target'])\ny_val = val['target']\n\n# Identify categorical features\ncat_cols = [col for col in X_train.columns if col.startswith('cat_')]\nfor col in cat_cols:\n    X_train[col] = X_train[col].astype('category')\n    X_val[col] = X_val[col].astype('category')\n    test[col] = test[col].astype('category')\n\n# Train LightGBM with fewer estimators for speed\nmodel = lgb.LGBMRegressor(n_estimators=200, learning_rate=0.1, random_state=42)\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    eval_metric='rmse',\n    callbacks=[lgb.early_stopping(stopping_rounds=20)]\n)\n\n# Predict on test set\npreds = model.predict(test)\n\n# Save to predictions.csv\npdf = pd.DataFrame({'target': preds})\npdf.to_csv('/app/predictions.csv', index=False)\n\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
