[20.062947, "o", "\u001b[33mWARNING: Running pip as the 'root' user can result in broken permissions and conflicting behaviour with the system package manager, possibly rendering your system unusable. It is recommended to use a virtual environment instead: https://pip.pypa.io/warnings/venv. Use the --root-user-action option if you know what you are doing and want to suppress this warning.\u001b[0m\u001b[33m"]
[20.064087, "o", "\r\n\u001b[0m"]
[20.271212, "o", "\r\n\u001b[1m[\u001b[0m\u001b[34;49mnotice\u001b[0m\u001b[1;39;49m]\u001b[0m\u001b[39;49m A new release of pip is available: \u001b[0m\u001b[31;49m25.0.1\u001b[0m\u001b[39;49m -> \u001b[0m\u001b[32;49m26.2.1\u001b[0m\r\n\u001b[1m[\u001b[0m\u001b[34;49mnotice\u001b[0m\u001b[1;39;49m]\u001b[0m\u001b[39;49m To update, run: \u001b[0m\u001b[32;49mpip install --upgrade pip\u001b[0m\r\n"]
[20.407949, "o", "\u001b[?2004hroot@a7472311038c:/workspace# "]
[24.060305, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nimport xgboost as xgb\nfrom sklearn.metrics import roc_auc_score\n\n# Load data\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\n# Separate target\ny_train = train['target']\ny_val = val['target']\n\n# Feature selection\nfeatures = [col for col in train.columns if col != 'target']\n\nX_train = train[features]\nX_val = val[features]\nX_test = test[features]\n\n# Basic preprocessing\n# Numeric features: fill nan with mean or let XGBoost handle it\n# Categorical features: simple label encoding\nfor col in features:\n    if col.startswith('cat_'):\n        X_train[col] = X_train[col].astype(str).fillna('nan').factorize()[0]\n        # Since we need the same mapping for val and test, we should use a global map\n        # but let's do a simpler approach for the baseline: combine and factorize\n\n# Correct categorical encoding across sets\nfor col in features:\n    if col.startswith('cat_'):\n        combined = pd.concat([X_train[col], X_val[col], X_test[col]]).astype(str).fillna('nan')\n        mapping = {val: i for i, val in enumerate(combined.unique())}\n        X_train[col] = X_train[col].astype(str).fillna('nan').map(mapping)\n        X_val[col] = X_val[col].astype(str).fillna('nan').map(mapping)\n        X_test[col] = X_test[col].astype(str).fillna('nan').map(mapping)\n\n# XGBoost model\nmodel = xgb.XGBClassifier(\n    n_estimators=1000,\n    learning_rate=0.05,\n    max_depth=6,\n    subsample=0.8,\n    colsample_bytree=0.8,\n    n_jobs=-1,\n    random_state=42,\n    eval_metric='auc',\n    early_stopping_rounds=50\n)\n\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    verbose=False\n)\n\n# Predict probabilities\nprobs = model.predict_proba(X_test)[:, 1]\n\n# Save predictions\npd.DataFrame({'target': probs}).to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"]
[24.062452, "o", "cat << 'EOF' > solution.py"]
[24.063116, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> import xgboost as xgb\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.metrics import roc_auc_score\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Load data\r\n\u001b[?2004l\r\u001b[?2004h> train = pd.read_csv('/app/data/train.csv')\r\n\u001b[?2004l\r\u001b[?2004h> val = pd.read_csv('/app/data/val.csv')\r\n\u001b[?2004l\r\u001b[?2004h> test = pd.read_csv('/app/data/test.csv')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Separate target\r\n\u001b[?2004l\r\u001b[?2004h> y_train = train['target']\r\n\u001b[?2004l\r\u001b[?2004h> y_val = val['target']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Feature selection\r\n\u001b[?2004l\r\u001b[?2004h> "]
