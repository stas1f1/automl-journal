[?2004hroot@a7472311038c:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import xgboost as xgb
[?2004l[?2004h> from sklearn.metrics import roc_auc_score
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Separate target
[?2004l[?2004h> y_train = train['target']
[?2004l[?2004h> y_val = val['target']
[?2004l[?2004h> 
[?2004l[?2004h> # Feature selection
[?2004l[?2004h> features = [col for col in train.columns if col != 'target']
[?2004l[?2004h> 
[?2004l[?2004h> X_train = train[features]
[?2004l[?2004h> X_val = val[features]
[?2004l[?2004h> X_test = test[features]
[?2004l[?2004h> 
[?2004l[?2004h> # Basic preprocessing
[?2004l[?2004h> # Numeric features: fill nan with mean or let XGBoost handle it
[?2004l[?2004h> # Categorical features: simple label encoding
[?2004l[?2004h> for col in features:
[?2004l[?2004h>     if col.startswith('cat_'):
[?2004l[?2004h>         X_train[col] = X_train[col].astype(str).fillna('nan').factorize()[0]
[?2004l[?2004h>         # Since we need the same mapping for val and test, we should use a global map
[?2004l[?2004h>         # but let's do a simpler approach for the baseline: combine and factorize
[?2004l[?2004h> 
[?2004l[?2004h> # Correct categorical encoding across sets
[?2004l[?2004h> for col in features:
[?2004l[?2004h>     if col.startswith('cat_'):
[?2004l[?2004h>         combined = pd.concat([X_train[col], X_val[col], X_test[col]]).astype(str).fillna('nan')
[?2004l[?2004h>         mapping = {val: i for i, val in enumerate(combined.unique())}
[?2004l[?2004h>         X_train[col] = X_train[col].astype(str).fillna('nan').map(mapping)
[?2004l[?2004h>         X_val[col] = X_val[col].astype(str).fillna('nan').map(mapping)
[?2004l[?2004h>         X_test[col] = X_test[col].astype(str).fillna('nan').map(mapping)
[?2004l[?2004h> 
[?2004l[?2004h> # XGBoost model
[?2004l[?2004h> model = xgb.XGBClassifier(
[?2004l[?2004h>     n_estimators=1000,
[?2004l[?2004h>     learning_rate=0.05,
[?2004l[?2004h>     max_depth=6,
[?2004l[?2004h>     subsample=0.8,
[?2004l[?2004h>     colsample_bytree=0.8,
[?2004l[?2004h>     n_jobs=-1,
[?2004l[?2004h>     random_state=42,
[?2004l[?2004h>     eval_metric='auc',
[?2004l[?2004h>     early_stopping_rounds=50
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> model.fit(
[?2004l[?2004h>     X_train, y_train,
[?2004l[?2004h>     eval_set=[(X_val, y_val)],
[?2004l[?2004h>     verbose=False
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Predict probabilities
[?2004l[?2004h> probs = model.predict_proba(X_test)[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> # Save predictions
[?2004l[?2004h> pd.DataFrame({'target': probs}).to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> print('Predictions saved to /app/predictions.csv')
