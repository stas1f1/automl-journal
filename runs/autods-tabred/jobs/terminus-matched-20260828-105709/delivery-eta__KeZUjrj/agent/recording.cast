[21.014649, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport lightgbm as lgb\nimport numpy as np\n\n# Load data\nprint('Loading data...')\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\ntarget_col = 'target'\n\n# Separate features and target\nX_train = train_df.drop(columns=[target_col])\ny_train = train_df[target_col]\nX_val = val_df.drop(columns=[target_col])\ny_val = val_df[target_col]\n\n# Identify categorical and binary features\n# Based on schema: num_*, bin_0, cat_0\ncat_cols = [col for col in X_train.columns if col.startswith('cat_') or col.startswith('bin_')]\n\n# For LightGBM, we can specify which columns are categorical\n# categorical_feature = cat_cols\n\n# Initialize LightGBM model\nmodel = lgb.LGBMRegressor(\n    n_estimators=1000,\n    learning_rate=0.05,\n    num_leaves=31,\n    max_depth=-1,\n    objective='regression',\n    metric='rmse',\n    random_state=42,\n    n_jobs=-1,\n    importance_type='split'\n)\n\n# Train the model\nprint('Training model...')\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    eval_metric='rmse',\n    callbacks=[lgb.early_stopping(stopping_rounds=50)]\n)\n\n# Predict on test set\nprint('Predicting on test set...')\ny_pred = model.predict(test_df)\n\n# Save predictions\npred_df = pd.DataFrame({'target': y_pred})\npred_df.to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"]
