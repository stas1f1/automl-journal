[?2004hroot@556772a6191a:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import lightgbm as lgb
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from sklearn.metrics import mean_squared_error
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Identify feature types
[?2004l[?2004h> num_features = [col for col in train.columns if col.startswith('num_')]
[?2004l[?2004h> bin_features = [col for col in train.columns if col.startswith('bin_')]
[?2004l[?2004h> cat_features = [col for col in train.columns if col.startswith('cat_')]
[?2004l[?2004h> 
[?2004l[?2004h> # Separate target
[?2004l[?2004h> X_train = train.drop(columns=['target'])
[?2004l[?2004h> y_train = train['target']
[?2004l[?2004h> X_val = val.drop(columns=['target'])
[?2004l[?2004h> y_val = val['target']
[?2004l[?2004h> 
[?2004l[?2004h> # Convert categorical columns to 'category' dtype for LightGBM
[?2004l[?2004h> for col in cat_features + bin_features:
[?2004l[?2004h>     X_train[col] = X_train[col].astype('category')
[?2004l[?2004h>     X_val[col] = X_val[col].astype('category')
[?2004l[?2004h>     test[col] = test[col].astype('category')
[?2004l[?2004h> 
[?2004l[?2004h> # Build LightGBM model
[?2004l[?2004h> model = lgb.LGBMRegressor(
[?2004l[?2004h>     n_estimators=1000,
[?2004l[?2004h>     learning_rate=0.05,
[?2004l[?2004h>     num_leaves=31,
[?2004l[?2004h>     random_state=42,
[?2004l[?2004h>     n_jobs=-1
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Train with early stopping
[?2004l[?2004h> model.fit(
[?2004l[?2004h>     X_train, y_train,
[?2004l[?2004h>     eval_set=[(X_val, y_val)],
[?2004l[?2004h>     eval_metric='rmse',
[?2004l[?2004h>     callbacks=[lgb.early_stopping(stopping_rounds=50)]
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Predict test set
[?2004l[?2004h> preds = model.predict(test)
[?2004l[?2004h> 
[?2004l[?2004h> # Save results
[?2004l[?2004h> preds_df = pd.DataFrame({'target': preds})
[?2004l[?2004h> preds_df.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> print('Predictions saved to /app/predictions.csv')
[?2004l[?2004h> EOF
