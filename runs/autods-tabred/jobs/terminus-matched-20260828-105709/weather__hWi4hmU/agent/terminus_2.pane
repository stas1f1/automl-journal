[?2004hroot@3ddc2846cb7b:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import lightgbm as lgb
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> # Load schema
[?2004l[?2004h> with open('/app/data/schema.json', 'r') as f:
[?2004l[?2004h>     schema = json.load(f)
[?2004l[?2004h> 
[?2004l[?2004h> features = schema['feature_columns']
[?2004l[?2004h> target_col = schema['target_column']
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> X_train = train[features]
[?2004l[?2004h> y_train = train[target_col]
[?2004l[?2004h> X_val = val[features]
[?2004l[?2004h> y_val = val[target_col]
[?2004l[?2004h> X_test = test[features]
[?2004l[?2004h> 
[?2004l[?2004h> # LightGBM model
[?2004l[?2004h> # Using a simple setup with reasonable defaults for a benchmark
[?2004l[?2004h> model = lgb.LGBMRegressor(
[?2004l[?2004h>     n_estimators=1000,
[?2004l[?2004h>     learning_rate=0.05,
[?2004l[?2004h>     num_leaves=31,
[?2004l[?2004h>     random_state=42,
[?2004l[?2004h>     n_jobs=-1
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Fit with early stopping
[?2004l[?2004h> model.fit(
[?2004l[?2004h>     X_train, y_train,
[?2004l[?2004h>     eval_set=[(X_val, y_val)],
[?2004l[?2004h>     eval_metric='rmse',
[?2004l[?2004h>     callbacks=[lgb.early_stopping(stopping_rounds=50)]
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Predict
[?2004l[?2004h> preds = model.predict(X_test)
[?2004l[?2004h> 
[?2004l[?2004h> # Save predictions
[?2004l[?2004h> submission = pd.DataFrame({'target': preds})
[?2004l[?2004h> submission.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> print('Predictions saved to /app/predictions.csv')
[?2004l[?2004h> EOF
