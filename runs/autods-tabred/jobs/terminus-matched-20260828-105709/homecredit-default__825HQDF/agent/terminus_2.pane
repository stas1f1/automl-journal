[?2004hroot@f51dd7ec7666:/workspace# cat <<EOF > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import lightgbm as lgb
[?2004l[?2004h> from sklearn.metrics import roc_auc_score
[?2004l[?2004h> 
[?2004l[?2004h> def solve():
[?2004l[?2004h>     train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h>     val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h>     test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h>     target_col = 'target'
[?2004l[?2004h>     X_train = train.drop(columns=[target_col])
[?2004l[?2004h>     y_train = train[target_col]
[?2004l[?2004h>     X_val = val.drop(columns=[target_col])
[?2004l[?2004h>     y_val = val[target_col]
[?2004l[?2004h> 
[?2004l[?2004h>     # Identify feature types
[?2004l[?2004h>     cat_features = [col for col in X_train.columns if col.startswith('cat_')]
[?2004l[?2004h>     
[?2004l[?2004h>     # Convert categorical to 'category' dtype for LightGBM
[?2004l[?2004h>     for col in cat_features:
[?2004l[?2004h>         X_train[col] = X_train[col].astype('category')
[?2004l[?2004h>         X_val[col] = X_val[col].astype('category')
[?2004l[?2004h>         test[col] = test[col].astype('category')
[?2004l[?2004h> 
[?2004l[?2004h>     # Train LightGBM
[?2004l[?2004h>     model = lgb.LGBMClassifier(n_estimators=1000, learning_rate=0.05, num_leaves=31, random_state=42)
[?2004l[?2004h>     model.fit(
[?2004l[?2004h>         X_train, y_train, 
[?2004l[?2004h>         eval_set=[(X_val, y_val)],
[?2004l[?2004h>         eval_metric='auc',
[?2004l[?2004h>         callbacks=[lgb.early_stopping(stopping_rounds=50)]
[?2004l[?2004h>     )
[?2004l[?2004h> 
[?2004l[?2004h>     # Predict probabilities
[?2004l[?2004h>     preds = model.predict_proba(test)[:, 1]
[?2004l[?2004h>     
[?2004l[?2004h>     # Save to csv
[?2004l[?2004h>     pd.DataFrame({'target': preds}).to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == '__main__':
[?2004l[?2004h>     solve()
