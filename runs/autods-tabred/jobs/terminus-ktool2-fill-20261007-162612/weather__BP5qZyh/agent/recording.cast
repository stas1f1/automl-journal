[210.352534, "i", "cat <<EOF > solution.py\nimport pandas as pd\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\ntrain_df = pd.read_csv('/app/data/train.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\ntask = Task('reg')\nroles = {'target': 'target'}\n# Reduce timeout to 300s for faster completion\nautoml = TabularAutoML(task=task, timeout=300)\n\nautoml.fit_predict(train_df, roles=roles)\npred = automl.predict(test_df).data.reshape(-1)\n\npred_df = pd.DataFrame(pred, columns=['target'])\npred_df.to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"]
[210.35302, "o", "cat <<EOF > solution.py\r\nimport pandas as pd\r\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\r\nfrom lightautoml.tasks import Task\r\n\r\ntrain_df = pd.read_csv('/app/data/train.csv')\r\ntest_df = pd.read_csv('/app/data/test.csv')\r\n\r\ntask = Task('reg')\r\nroles = {'target': 'target'}\r\n# Reduce timeout to 300s for faster completion\r\nautoml = TabularAutoML(task=task, timeout=300)\r\n\r\nautoml.fit_predict(train_df, roles=roles)\r\npred = automl.predict(test_df).data.reshape(-1)\r\n\r\npred_df = pd.DataFrame(pred, columns=['target'])\r\npred_df.to_csv('/app/predictions.csv', index=False)\r\n\r\nprint('MODEL_USED=', type(automl).__name__)\r\nEOF\r\n"]
