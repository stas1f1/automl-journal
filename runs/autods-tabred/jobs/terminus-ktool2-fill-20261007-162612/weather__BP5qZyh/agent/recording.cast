[8.034753, "o", "1,0,58.0999985,93.5,5.80000019,-1.35087156,1.08354247,1.73173845,37.9900551,42,5,1,0,0,7,1,1,1,23\r\n\u001b[?2004hroot@ab709bacd235:/workspace# "]
[20.150482, "i", "cat <<EOF > solution.py\nimport pandas as pd\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\n# Setup LightAutoML\ntask = Task('reg')\nroles = {'target': 'target'}\n# Setting a reasonable timeout for the task\nautoml = TabularAutoML(task=task, timeout=3600)\n\n# Fit and Predict\n# fit_predict can be used to get OOF, but for the task we need the model to predict on test_df\nautoml.fit_predict(train_df, roles=roles)\npred = automl.predict(test_df).data.reshape(-1)\n\n# Save predictions\npred_df = pd.DataFrame(pred, columns=['target'])\npred_df.to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"]
