[679.829896, "i", "cat <<EOF > solution.py\nimport pandas as pd\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\nimport numpy as np\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\n# To ensure it finishes in time and doesn't crash due to memory,\n# use a smaller subset of training data for the AutoML search\n# while still utilizing the required library.\ntrain_df_subset = train_df.sample(n=min(50000, len(train_df)), random_state=42)\n\n# Configuration\nTARGET_COLUMN = 'target'\nTIME_BUDGET_SECONDS = 300 \n\n# LightAutoML setup\ntask = Task('reg')\nroles = {'target': TARGET_COLUMN}\nautoml = TabularAutoML(task=task, timeout=TIME_BUDGET_SECONDS)\n\n# Fit\nautoml.fit_predict(train_df_subset, roles=roles)\n\n# Predict on test set\npred = automl.predict(test_df).data.reshape(-1)\n\n# Save predictions\npred_df = pd.DataFrame({'target': pred})\npred_df.to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"]
[679.830239, "o", "cat <<EOF > solution.py\r\nimport pandas as pd\r\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\r\nfrom lightautoml.tasks import Task\r\nimport numpy as np\r\n\r\n# Load data\r\ntrain_df = pd.read_csv('/app/data/train.csv')\r\ntest_df = pd.read_csv('/app/data/test.csv')\r\n\r\n# To ensure it finishes in time and doesn't crash due to memory,\r\n# use a smaller subset of training data for the AutoML search\r\n# while still utilizing the required library.\r\ntrain_df_subset = train_df.sample(n=min(50000, len(train_df)), random_state=42)\r\n\r\n# Configuration\r\nTARGET_COLUMN = 'target'\r\nTIME_BUDGET_SECONDS = 300 \r\n\r\n# LightAutoML setup\r\ntask = Task('reg')\r\nroles = {'target': TARGET_COLUMN}\r\nautoml = TabularAutoML(task=task, timeout=TIME_BUDGET_SECONDS)\r\n\r\n# Fit\r\nautoml.fit_predict(train_df_subset, roles=roles)\r\n\r\n# Predict on test set\r\npred = automl.predict(test_df).data.reshape(-1)\r\n\r\n# Save predictions\r\npred_df = pd.DataFrame({'target': pred})\r\npred_df.to_csv('/app/predictions.csv', index=False)\r\n\r\nprint('MODEL_USED=', type(automl).__name__)\r\nEOF\r\n"]
