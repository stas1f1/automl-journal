[1075.165438, "i", "cat <<EOF > solution.py\nimport pandas as pd\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\nimport numpy as np\n\ntry:\n    train_df = pd.read_csv('/app/data/train.csv').sample(n=5000, random_state=42)\n    test_df = pd.read_csv('/app/data/test.csv')\n    task = Task('reg')\n    roles = {'target': 'target'}\n    automl = TabularAutoML(task=task, timeout=60)\n    automl.fit_predict(train_df, roles=roles)\n    pred = automl.predict(test_df).data.reshape(-1)\n    pd.DataFrame({'target': pred}).to_csv('/app/predictions.csv', index=False)\n    print('MODEL_USED=', type(automl).__name__)\nexcept Exception as e:\n    print(f'ERROR: {e}')\nEOF\n"]
[1075.1659, "o", "cat <<EOF > solution.py\r\nimport pandas as pd\r\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\r\nfrom lightautoml.tasks import Task\r\nimport numpy as np\r\n\r\ntry:\r\n    train_df = pd.read_csv('/app/data/train.csv').sample(n=5000, random_state=42)\r\n    test_df = pd.read_csv('/app/data/test.csv')\r\n    task = Task('reg')\r\n    roles = {'target': 'target'}\r\n    automl = TabularAutoML(task=task, timeout=60)\r\n    automl.fit_predict(train_df, roles=roles)\r\n    pred = automl.predict(test_df).data.reshape(-1)\r\n    pd.DataFrame({'target': pred}).to_csv('/app/predictions.csv', index=False)\r\n    print('MODEL_USED=', type(automl).__name__)\r\nexcept Exception as e:\r\n    print(f'ERROR: {e}')\r\nEOF\r\n"]
