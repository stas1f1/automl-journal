[17.052926, "o", "009,-0.52209872,0.0130788367,0.677126288,1.2114023,0.513135552,0.186756164,1.62536705,1.40698147,1.53926706,1.61256278,0.0489476882,1.12464881,1.08680773,1.54147387,1.09875071,0.00376371271,1.54291904,1.5412333,1.53937745,1.5377481,0.0364372954,0.422482818,0.421111554,0.092945233,-0.858909607,-1.37811375,-0.961404383,2.7610209,3.09186888,2.19806719,-0.687781155,nan,nan,nan,nan,-0.688889325,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,nan,1,1,1.79175961\r\n"]
[17.053078, "o", "\u001b[?2004hroot@d573e4b00c61:/workspace# "]
[50.546875, "i", "cat <<EOF > solution.py\nimport pandas as pd\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\nimport numpy as np\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\n# Configuration\nTARGET_COLUMN = 'target'\nTIME_BUDGET_SECONDS = 3600 # 1 hour budget, but it may finish faster\n\n# LightAutoML setup\ntask = Task('reg')\nroles = {'target': TARGET_COLUMN}\nautoml = TabularAutoML(task=task, timeout=TIME_BUDGET_SECONDS)\n\n# Fit and predict\n# Note: fit_predict uses the training set to find the best model\nautoml.fit_predict(train_df, roles=roles)\n\n# Predict on test set\npred = automl.predict(test_df).data.reshape(-1)\n\n# Save predictions\npred_df = pd.DataFrame({'target': pred})\npred_df.to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"]
