[381.963635, "i", "cat <<EOF > solution.py\nimport pandas as pd\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\nimport numpy as np\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\n# Configuration\nTARGET_COLUMN = 'target'\n# Reduce timeout to get a result faster while still utilizing TabularAutoML\nTIME_BUDGET_SECONDS = 600 \n\n# LightAutoML setup\ntask = Task('reg')\nroles = {'target': TARGET_COLUMN}\nautoml = TabularAutoML(task=task, timeout=TIME_BUDGET_SECONDS)\n\n# Fit and predict\n# Use a smaller subset of train_df if it's still too slow, but let's try 10min first\nautoml.fit_predict(train_df, roles=roles)\n\n# Predict on test set\npred = automl.predict(test_df).data.reshape(-1)\n\n# Save predictions\npred_df = pd.DataFrame({'target': pred})\npred_df.to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"]
