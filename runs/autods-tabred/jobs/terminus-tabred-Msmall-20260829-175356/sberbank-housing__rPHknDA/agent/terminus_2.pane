[?2004hroot@a88cd2fd5058:/workspace# cat << 'EOF' > train_model.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from catboost import CatBoostRegressor
[?2004l[?2004h> from sklearn.metrics import mean_squared_error
[?2004l[?2004h> import os
[?2004l[?2004h> 
[?2004l[?2004h> def solve():
[?2004l[?2004h>     data_dir = '/app/data'
[?2004l[?2004h>     train_path = os.path.join(data_dir, 'train.csv')
[?2004l[?2004h>     val_path = os.path.join(data_dir, 'val.csv')
[?2004l[?2004h>     test_path = os.path.join(data_dir, 'test.csv')
[?2004l[?2004h> 
[?2004l[?2004h>     print('Loading data...')
[?2004l[?2004h>     train = pd.read_csv(train_path)
[?2004l[?2004h>     val = pd.read_csv(val_path)
[?2004l[?2004h>     test = pd.read_csv(test_path)
[?2004l[?2004h> 
[?2004l[?2004h>     target_col = 'target'
[?2004l[?2004h>     X_train = train.drop(columns=[target_col])
[?2004l[?2004h>     y_train = train[target_col]
[?2004l[?2004h>     X_val = val.drop(columns=[target_col])
[?2004l[?2004h>     y_val = val[target_col]
[?2004l[?2004h>     X_test = test
[?2004l[?2004h> 
[?2004l[?2004h>     # Identify feature types
[?2004l[?2004h>     num_cols = [c for c in X_train.columns if c.startswith('num_')]
[?2004l[?2004h>     cat_cols = [c for c in X_train.columns if c.startswith('cat_')]
[?2004l[?2004h>     bin_cols = [c for c in X_train.columns if c.startswith('bin_')]
[?2004l[?2004h>     
[?2004l[?2004h>     # CatBoost handles categorical columns directly if they are integer/string
[?2004l[?2004h>     # We must ensure they are treated as categorical.
[?2004l[?2004h>     # For numerical, we fill NaNs with median.
[?2004l[?2004h>     print('Preprocessing...')
[?2004l[?2004h>     for col in num_cols:
[?2004l[?2004h>         median_val = X_train[col].median()
[?2004l[?2004h>         X_train[col] = X_train[col].fillna(median_val)
[?2004l[?2004h>         X_val[col] = X_val[col].fillna(median_val)
[?2004l[?2004h>         X_test[col] = X_test[col].fillna(median_val)
[?2004l[?2004h> 
[?2004l[?2004h>     # Convert categorical/binary to string or int for CatBoost
[?2004l[?2004h>     cat_features = cat_cols + bin_cols
[?2004l[?2004h>     for col in cat_features:
[?2004l[?2004h>         X_train[col] = X_train[col].astype(str)
[?2004l[?2004h>         X_val[col] = X_val[col].astype(str)
[?2004l[?2004h>         X_test[col] = X_test[col].astype(str)
[?2004l[?2004h> 
[?2004l[?2004h>     print('Training CatBoost...')
[?2004l[?2004h>     model = CatBoostRegressor(
[?2004l[?2004h>         iterations=1000,
[?2004l[?2004h>         learning_rate=0.05,
[?2004l[?2004h>         depth=6,
[?2004l[?2004h>         loss_function='RMSE',
[?2004l[?2004h>         eval_metric='RMSE',
[?2004l[?2004h>         random_seed=42,
[?2004l[?2004h>         verbose=100
[?2004l[?2004h>     )
[?2004l[?2004h> 
[?2004l[?2004h>     model.fit(
[?2004l[?2004h>         X_train, y_train,
[?2004l[?2004h>         eval_set=(X_val, y_val),
[?2004l[?2004h>         cat_features=cat_features,
[?2004l[?2004h>         early_stopping_rounds=50
[?2004l[?2004h>     )
[?2004l[?2004h> 
[?2004l[?2004h>     val_preds = model.predict(X_val)
[?2004l[?2004h>     rmse = np.sqrt(mean_squared_error(y_val, val_preds))
[?2004l[?2004h>     print(f'Validation RMSE: {rmse}')
[?2004l[?2004h> 
[?2004l[?2004h>     print('Predicting test set...')
[?2004l[?2004h>     test_preds = model.predict(X_test)
[?2004l[?2004h>     
[?2004l[?2004h>     result = pd.DataFrame({'target': test_preds})
[?2004l[?2004h>     result.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h>     print('Predictions saved to /app/predictions.csv')
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == '__main__':
[?2004l[?2004h>     solve()
[?2004l[?2004h> EOF
