[?2004hroot@5ed89020657a:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import lightgbm as lgb
[?2004l[?2004h> from sklearn.impute import SimpleImputer
[?2004l[?2004h> import os
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train_df = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val_df = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test_df = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Preprocessing
[?2004l[?2004h> # Replace -9999 with NaN
[?2004l[?2004h> train_df.replace(-9999, np.nan, inplace=True)
[?2004l[?2004h> val_df.replace(-9999, np.nan, inplace=True)
[?2004l[?2004h> 
[?2004l[?2004h> # Separate features and target
[?2004l[?2004h> X_train = train_df.drop(columns=['target'])
[?2004l[?2004h> Y_train = train_df['target']
[?2004l[?2004h> X_val = val_df.drop(columns=['target'])
[?2004l[?2004h> Y_val = val_df['target']
[?2004l[?2004h> 
[?2004l[?2004h> # Impute missing values
[?2004l[?2004h> imputer = SimpleImputer(strategy='median')
[?2004l[?2004h> X_train_imputed = imputer.fit_transform(X_train)
[?2004l[?2004h> X_val_imputed = imputer.transform(X_val)
[?2004l[?2004h> X_test_imputed = imputer.transform(test_df)
[?2004l[?2004h> 
[?2004l[?2004h> # Convert back to DataFrame to ensure column names are preserved if needed, 
[?2004l[?2004h> # though LightGBM works fine with numpy arrays
[?2004l[?2004h> 
[?2004l[?2004h> # Train LightGBM model
[?2004l[?2004h> train_data = lgb.Dataset(X_train_imputed, label=Y_train)
[?2004l[?2004h> val_data = lgb.Dataset(X_val_imputed, label=Y_val, reference=train_data)
[?2004l[?2004h> 
[?2004l[?2004h> params = {
[?2004l[?2004h>     'objective': 'regression',
[?2004l[?2004h>     'metric': 'rmse',
[?2004l[?2004h>     'verbosity': -1,
[?2004l[?2004h>     'boosting_type': 'gbdt',
[?2004l[?2004h>     'random_state': 42,
[?2004l[?2004h>     'learning_rate': 0.05,
[?2004l[?2004h>     'num_leaves': 31,
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> print("Training model...")
[?2004l[?2004h> model = lgb.train(
[?2004l[?2004h>     params,
[?2004l[?2004h>     train_data,
[?2004l[?2004h>     valid_sets=[train_data, val_data],
[?2004l[?2004h>     valid_names=['train', 'valid'],
[?2004l[?2004h>     num_boost_round=1000,
[?2004l[?2004h>     callbacks=[
[?2004l[?2004h>         lgb.early_stopping(stopping_rounds=50),
[?2004l[?2004h>         lgb.log_evaluation(period=50)
[?2004l[?2004h>     ]
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Predict
[?2004l[?2004h> print("Predicting...")
[?2004l[?2004h> y_pred = model.predict(X_val_imputed)
[?2004l[?2004h> rmse = np.sqrt(np.mean((Y_val.values - y_pred)**2))
[?2004l[?2004h> print(f"Validation RMSE: {rmse}")
[?2004l[?2004h> 
[?2004l[?2004h> test_preds = model.predict(X_test_imputed)
[?2004l[?2004h> 
[?2004l[?2004h> # Save predictions
[?2004l[?2004h> output = pd.DataFrame({'target': test_preds})
[?2004l[?2004h> output.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> print("Predictions saved to /app/predictions.csv")
[?2004l[?2004h> EOF
