[4.799301, "o", "\r\n    \"num_84\",\r\n    \"num_85\",\r\n    \"num_86\",\r\n    \"num_87\",\r\n    \"num_88\",\r\n    \"num_89\",\r\n    \"num_90\",\r\n    \"num_91\",\r\n    \"num_92\",\r\n    \"num_93\",\r\n    \"num_94\",\r\n    \"num_95\",\r\n    \"num_96\",\r\n    \"num_97\",\r\n    \"num_98\",\r\n    \"num_99\",\r\n    \"bin_0\",\r\n    \"bin_1\",\r\n    \"bin_2\"\r\n  ],\r\n  \"feature_counts\": {\r\n    \"num\": 100,\r\n    \"bin\": 3,\r\n    \"cat\": 0\r\n  },\r\n  \"split_sizes\": {\r\n    \"train\": 340596,\r\n    \"val\": 42359,\r\n    \"test\": 40840\r\n  },\r\n  \"excluded_arrays\": [\r\n    \"x_meta.npy\"\r\n  ]\r\n}"]
