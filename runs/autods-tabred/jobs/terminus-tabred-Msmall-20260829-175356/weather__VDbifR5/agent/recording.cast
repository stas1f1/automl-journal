[122.646715, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.646776, "o", "# LightGBM handles NaNs automatically\r\n\u001b[?2004l\r"]
[122.646821, "o", "\u001b[?2004h> model = lgb.LGBMRegressor(\r\n\u001b[?2004l\r"]
[122.64687, "o", "\u001b[?2004h> "]
[122.646921, "o", "    n_estimators=1000,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.646971, "o", "    learning_rate=0.05,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.647032, "o", "    num_leaves=31,\r\n\u001b[?2004l\r\u001b[?2004h>     importance_type='split',"]
[122.647075, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     random_state=42,\r\n\u001b[?2004l\r"]
[122.647123, "o", "\u001b[?2004h>     n_jobs=-1\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.647174, "o", "> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.647223, "o", "print(\"Starting training...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.64727, "o", "> model.fit(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.647317, "o", "    X_train, y_train,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.647366, "o", "    eval_set=[(X_val, y_val)],\r\n\u001b[?2004l\r"]
[122.647414, "o", "\u001b[?2004h> "]
[122.647462, "o", "    callbacks=[lgb.early_stopping(stopping_rounds=50)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.647512, "o", ")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.64756, "o", "print(\"Generating predictions...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.647607, "o", "predictions = model.predict(X_test)\r\n\u001b[?2004l\r"]
[122.647647, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.64771, "o", "# Prepare output\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.647788, "o", "output_df = pd.DataFrame({'target': predictions})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.647839, "o", "output_df.to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r"]
[122.647894, "o", "\u001b[?2004h> "]
[122.647942, "o", "print(\"Predictions saved to /app/predictions.csv\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.647996, "o", "> EOF\r\n\u001b[?2004l\r"]
