[?2004hroot@4eb5cde51331:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import lightgbm as lgb
[?2004l[?2004h> from sklearn.preprocessing import LabelEncoder
[?2004l[?2004h> 
[?2004l[?2004h> print("Loading data...")
[?2004l[?2004h> train_df = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val_df = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test_df = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Identify categorical columns
[?2004l[?2004h> cat_cols = [col for col in train_df.columns if col.startswith('cat_')]
[?2004l[?2004h> numeric_cols = [col for col in train_df.columns if col.startswith(('num_', 'bin_'))]
[?2004l[?2004h> target_col = 'target'
[?2004l[?2004h> 
[?2004l[?2004h> # Preprocessing categorical features
[?2004l[?2004h> for col in cat_cols:
[?2004l[?2004h>     le = LabelEncoder()
[?2004l[?2004h>     # Combine to ensure consistent encoding
[?2004l[?2004h>     combined = pd.concat([train_df[col], val_df[col], test_df[col]], axis=0).astype(str)
[?2004l[?2004h>     le.fit(combined)
[?2004l[?2004h>     train_df[col] = le.transform(train_df[col].astype(str))
[?2004l[?2004h>     val_df[col] = le.transform(val_df[col].astype(str))
[?2004l[?2004h>     test_df[col] = le.transform(test_df[col].astype(str))
[?2004l[?2004h> 
[?2004l[?2004h> X_train = train_df[numeric_cols + cat_cols]
[?2004l[?2004h> y_train = train_df[target_col]
[?2004l[?2004h> X_val = val_df[numeric_cols + cat_cols]
[?2004l[?2004h> y_val = val_df[target_col]
[?2004l[?2004h> X_test = test_df[numeric_cols + cat_cols]
[?2004l[?2004h> 
[?2004l[?2004h> print("Training model...")
[?2004l[?2004h> params = {
[?2004l[?2004h>     'objective': 'regression',
[?2004l[?2004h>     'metric': 'rmse',
[?2004l[?2004h>     'verbosity': -1,
[?2004l[?2004h>     'boosting_type': 'gbdt',
[?2004l[?2004h>     'random_state': 42,
[?2004l[?2004h>     'learning_rate': 0.05,
[?2004l[?2004h>     'num_leaves': 31,
[?2004l[?2004h>     'feature_fraction': 0.8,
[?2004l[?2004h>     'bagging_fraction': 0.8,
[?2004l[?2004h>     'bagging_freq': 5,
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> dataset = lgb.Dataset(X_train, label=y_train)
[?2004l[?2004h> val_dataset = lgb.Dataset(X_val, label=y_val, reference=dataset)
[?2004l[?2004h> 
[?2004l[?2004h> model = lgb.train(
[?2004l[?2004h>     params,
[?2004l[?2004h>     dataset,
[?2004l[?2004h>     valid_sets=[dataset, val_dataset],
[?2004l[?2004h>     valid_names=['train', 'valid'],
[?2004l[?2004h>     num_boost_round=1000,
