[6.883466, "o", "\r\n    \"num_193\",\r\n    \"num_194\",\r\n    \"num_195\",\r\n    \"num_196\",\r\n    \"num_197\",\r\n    \"num_198\",\r\n"]
[6.883492, "o", "    \"num_199\",\r\n    \"num_200\",\r\n    \"num_201\",\r\n    \"num_202\",\r\n    \"num_203\",\r\n    \"num_204\",\r\n    \"num_205\",\r\n    \"num_206\",\r\n"]
