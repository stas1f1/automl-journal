 = lgb.Dataset(X_val, label=y_val, reference=train_data, categorical_feature=cat_features)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     model = lgb.train(\r\n\u001b[?2004l\r\u001b[?2004h>         params,\r\n\u001b[?2004l\r\u001b[?2004h>         train_data,\r\n\u001b[?2004l\r\u001b[?2004h>         valid_sets=[train_data, val_data],\r\n\u001b[?2004l\r\u001b[?2004h>         valid_names=['train', 'valid'],\r\n\u001b[?2004l\r\u001b[?2004h>         num_boost_round=1000,\r\n\u001b[?2004l\r\u001b[?2004h>         callbacks=[lgb.early_stopping(stopping_rounds=50)]\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     print(\"Predicting...\")\r\n\u001b[?2004l\r\u001b[?2004h>     preds = model.predict(X_test)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # Ensure finite numbers\r\n\u001b[?2004l\r\u001b[?2004h>     preds = np.nan_to_num(preds, nan=np.nanmean(y_train))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Saving predictions to {output_path}...\")\r\n\u001b[?2004l\r\u001b[?2004h>     output_df = pd.DataFrame({'target': preds})\r\n\u001b[?2004l\r\u001b[?2004h>     output_df.to_csv(output_path, index=False)\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"Done!\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == '__main__':\r\n\u001b[?2004l\r"]
