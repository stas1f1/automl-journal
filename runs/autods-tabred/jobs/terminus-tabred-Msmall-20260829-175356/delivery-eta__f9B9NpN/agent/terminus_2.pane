[?2004hroot@2c4d2b1a6f47:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import lightgbm as lgb
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> def main():
[?2004l[?2004h>     train_path = '/app/data/train.csv'
[?2004l[?2004h>     val_path = '/app/data/val.csv'
[?2004l[?2004h>     test_path = '/app/data/test.csv'
[?2004l[?2004h>     output_path = '/app/predictions.csv'
[?2004l[?2004h> 
[?2004l[?2004h>     print("Loading data...")
[?2004l[?2004h>     train = pd.read_csv(train_path)
[?2004l[?2004h>     val = pd.read_csv(val_path)
[?2004l[?2004h>     test = pd.read_csv(test_path)
[?2004l[?2004h> 
[?2004l[?2004h>     target_col = 'target'
[?2004l[?2004h>     X_train = train.drop(columns=[target_col])
[?2004l[?2004h>     y_train = train[target_col]
[?2004l[?2004h>     X_val = val.drop(columns=[target_col])
[?2004l[?2004h>     y_val = val[target_col]
[?2004l[?2004h>     X_test = test
[?2004l[?2004h> 
[?2004l[?2004h>     # Identify categorical columns
[?2004l[?2004h>     # Based on schema, cat_0 is categorical
[?2004l[?2004h>     cat_features = [col for col in X_train.columns if col.startswith('cat_')]
[?2004l[?2004h>     for col in cat_features:
[?2004l[?2004h>         X_train[col] = X_train[col].astype('category')
[?2004l[?2004h>         X_val[col] = X_val[col].astype('category')
[?2004l[?2004h>         X_test[col] = X_test[col].astype('category')
[?2004l[?2004h> 
[?2004l[?2004h>     print("Training model...")
[?2004l[?2004h>     params = {
[?2004l[?2004h>         'objective': 'regression',
[?2004l[?2004h>         'metric': 'rmse',
[?2004l[?2004h>         'verbosity': -1,
[?2004l[?2004h>         'boosting_type': 'gbdt',
[?2004l[?2004h>         'random_state': 42,
[?2004l[?2004h>         'learning_rate': 0.05,
[?2004l[?2004h>         'num_leaves': 31,
[?2004l[?2004h>         'feature_fraction': 0.8,
[?2004l[?2004h>         'bagging_fraction': 0.8,
[?2004l[?2004h>         'bagging_freq': 5,
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     train_data = lgb.Dataset(X_train, label=y_train, categorical_feature=cat_features)
[?2004l[?2004h>     val_data = lgb.Dataset(X_val, label=y_val, reference=train_data, categorical_feature=cat_features)
[?2004l[?2004h> 
[?2004l[?2004h>     model = lgb.train(
[?2004l[?2004h>         params,
[?2004l[?2004h>         train_data,
[?2004l[?2004h>         valid_sets=[train_data, val_data],
[?2004l[?2004h>         valid_names=['train', 'valid'],
[?2004l[?2004h>         num_boost_round=1000,
[?2004l[?2004h>         callbacks=[lgb.early_stopping(stopping_rounds=50)]
[?2004l[?2004h>     )
[?2004l[?2004h> 
[?2004l[?2004h>     print("Predicting...")
[?2004l[?2004h>     preds = model.predict(X_test)
[?2004l[?2004h> 
[?2004l[?2004h>     # Ensure finite numbers
[?2004l[?2004h>     preds = np.nan_to_num(preds, nan=np.nanmean(y_train))
[?2004l[?2004h> 
[?2004l[?2004h>     print(f"Saving predictions to {output_path}...")
[?2004l[?2004h>     output_df = pd.DataFrame({'target': preds})
[?2004l[?2004h>     output_df.to_csv(output_path, index=False)
[?2004l[?2004h>     print("Done!")
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == '__main__':
[?2004l[?2004h>     main()
[?2004l[?2004h> EOF
