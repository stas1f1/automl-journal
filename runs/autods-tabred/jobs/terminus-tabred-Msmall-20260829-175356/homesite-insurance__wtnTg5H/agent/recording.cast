[308.101993, "o", "cat << 'EOF' > train_and_predict.py\r\n\u001b[?2004l\r"]
[308.102025, "o", "\u001b[?2004h> "]
[308.102057, "o", "import pandas as pd\r\n\u001b[?2004l\r"]
[308.102099, "o", "\u001b[?2004h> "]
[308.102135, "o", "import lightgbm as lgb\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Load data"]
[308.102169, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
