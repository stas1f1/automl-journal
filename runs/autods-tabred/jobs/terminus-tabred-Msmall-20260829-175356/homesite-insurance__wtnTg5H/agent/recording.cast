[308.102741, "o", "\u001b[?2004h> X_test = test\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[308.10278, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[308.102812, "o", "# Preprocessing\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.102872, "o", "cat_cols = [c for c in X_train.columns if c.startswith('cat_')]\r\n\u001b[?2004l\r"]
[308.102904, "o", "\u001b[?2004h> "]
