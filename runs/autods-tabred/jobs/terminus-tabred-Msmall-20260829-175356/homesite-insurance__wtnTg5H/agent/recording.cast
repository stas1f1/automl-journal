[308.102966, "o", "> "]
[308.103019, "o", "    X_train[col] = X_train[col].astype('category')\r\n\u001b[?2004l\r"]
[308.103052, "o", "\u001b[?2004h> "]
[308.103083, "o", "    X_val[col] = X_val[col].astype('category')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.103157, "o", "    X_test[col] = X_test[col].astype('category')\r\n\u001b[?2004l\r"]
[308.103194, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.103237, "o", "# Create datasets\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.103312, "o", "dtrain = lgb.Dataset(X_train, label=y_train, categorical_feature=cat_cols)\r\n\u001b[?2004l\r"]
