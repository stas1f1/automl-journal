cat << 'EOF' > train_and_predict.py
import pandas as pd
import lightgbm as lgb

# Load data
train = pd.read_csv('/app/data/train.csv')
val = pd.read_csv('/app/data/val.csv')
test = pd.read_csv('/app/data/test.csv')

# Separate features and target
X_train = train.drop(columns=['target'])
y_train = train['target']
X_val = val.drop(columns=['target'])
y_val = val['target']
X_test = test

# Preprocessing
cat_cols = [c for c in X_train.columns if c.startswith('cat_')]
for col in cat_cols:
    X_train[col] = X_train[col].astype('category')
    X_val[col] = X_val[col].astype('category')
    X_test[col] = X_test[col].astype('category')

# Create datasets
dtrain = lgb.Dataset(X_train, label=y_train, categorical_feature=cat_cols)
dval = lgb.Dataset(X_val, label=y_val, reference=dtrain, categorical_feature=cat_cols)

# Hyperparameters
params = {
    'objective': 'binary',
    'metric': 'auc',
    'verbosity': -1,
    'random_state': 42
}

# Train with very small number of rounds to ensure completion
print("Training model...")
model = lgb.train(
    params,
    dtrain,
    valid_sets=[dval],
    num_boost_round=10
)

# Predict
print("Predicting on test set...")
y_test_pred = model.predict(X_test)

# Save predictions
output = pd.DataFrame({'target': y_test_pred})
output.to_csv('/app/predictions.csv', index=False)
print("Predictions saved to /app/predictions.csv")
