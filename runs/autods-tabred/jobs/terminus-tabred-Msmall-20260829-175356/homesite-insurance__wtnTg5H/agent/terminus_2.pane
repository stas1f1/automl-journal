[?2004hroot@4178451db925:/workspace# cat << 'EOF' > train_and_predict.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import lightgbm as lgb
[?2004l[?2004h> from sklearn.metrics import roc_auc_score
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Separate features and target
[?2004l[?2004h> X_train = train.drop(columns=['target'])
[?2004l[?2004h> y_train = train['target']
[?2004l[?2004h> X_val = val.drop(columns=['target'])
[?2004l[?2004h> y_val = val['target']
[?2004l[?2004h> X_test = test
[?2004l[?2004h> 
[?2004l[?2004h> # Preprocessing
[?2004l[?2004h> # Categorical features: convert to 'category' dtype for LightGBM
[?2004l[?2004h> cat_cols = [c for c in X_train.columns if c.startswith('cat_')]
[?2004l[?2004h> for col in cat_cols:
[?2004l[?2004h>     X_train[col] = X_train[col].astype('category')
[?2004l[?2004h>     X_val[col] = X_val[col].astype('category')
[?2004l[?2004h>     X_test[col] = X_test[col].astype('category')
[?2004l[?2004h> 
[?2004l[?2004h> # LightGBM handles NaNs automatically in numerical columns
[?2004l[?2004h> # LightGBM handles categorical columns if dtype is 'category'
[?2004l[?2004h> 
[?2004l[?2004h> # Create datasets
[?2004l[?2004h> dtrain = lgb.Dataset(X_train, label=y_train, categorical_feature=cat_cols)
[?2004l[?2004h> dval = lgb.Dataset(X_val, label=y_val, reference=dtrain, categorical_feature=cat_cols)
[?2004l[?2004h> 
[?2004l[?2004h> # Hyperparameters
[?2004l[?2004h> params = {
[?2004l[?2004h>     'objective': 'binary',
[?2004l[?2004h>     'metric': 'auc',
[?2004l[?2004h>     'verbosity': -1,
[?2004l[?2004h>     'boosting_type': 'gbdt',
[?2004l[?2004h>     'random_state': 42,
[?2004l[?2004h>     'learning_rate': 0.05,
[?2004l[?2004h>     'num_leaves': 31,
[?2004l[?2004h>     'feature_fraction': 0.8,
[?2004l[?2004h>     'bagging_fraction': 0.8,
[?2004l[?2004h>     'bagging_freq': 5,
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Train
[?2004l[?2004h> print("Training model...")
[?2004l[?2004h> model = lgb.train(
[?2004l[?2004h>     params,
[?2004l[?2004h>     dtrain,
[?2004l[?2004h>     valid_sets=[dtrain, dval],
[?2004l[?2004h>     valid_names=['train', 'valid'],
[?2004l[?2004h>     num_boost_round=1000,
[?2004l[?2004h>     callbacks=lgb.early_stopping(stopping_rounds=50)
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Validate
[?2004l[?2004h> print("Evaluating on validation set...")
[?2004l[?2004h> y_val_pred = model.predict(X_val)
[?2004l[?2004h> auc_score = roc_auc_score(y_val, y_val_pred)
[?2004l[?2004h> print(f"Validation AUC: {auc_score}")
[?2004l[?2004h> 
[?2004l[?2004h> # Predict
[?2004l[?2004h> print("Predicting on test set...")
[?2004l[?2004h> y_test_pred = model.predict(X_test)
[?2004l[?2004h> 
[?2004l[?2004h> # Save predictions
[?2004l[?2004h> output = pd.DataFrame({'target': y_test_pred})
[?2004l[?2004h> output.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> print("Predictions saved to /app/predictions.csv")
[?2004l[?2004h> EOF
[?2004l[?2004hroot@4178451db925:/workspace# python3 train_and_predict.py
