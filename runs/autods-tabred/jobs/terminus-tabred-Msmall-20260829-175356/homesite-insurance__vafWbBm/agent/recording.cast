[16.70312, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom lightgbm import LGBMClassifier\nfrom sklearn.metrics import roc_auc_score\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\n# Separate features and target\nX_train = train_df.drop(columns=['target'])\ny_train = train_df['target']\nX_val = val_df.drop(columns=['target'])\ny_val = val_df['target']\nX_test = test_df.copy()\n\n# Identify feature types\nnumeric_cols = [c for c in X_train.columns if c.startswith('num_')]\nbinary_cols = [c for c in X_train.columns if c.startswith('bin_')]\ncategorical_cols = [c for c in X_train.columns if c.startswith('cat_')]\n\n# LightGBM can handle categorical features if they are passed as 'category' type\nfor col in categorical_cols:\n    X_train[col] = X_train[col].astype('category')\n    X_val[col] = X_val[col].astype('category')\n    X_test[col] = X_test[col].astype('category')\n\n# LightGBM handles NaNs automatically for numeric columns\n\n# Initialize and train model\nmodel = LGBMClassifier(\n    n_estimators=500,\n    learning_rate=0.05,\n    num_leaves=31,\n    random_state=42,\n    importance_type='gain',\n    verbose=-1\n)\n\nprint(\"Training model...\")\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    eval_metric='auc',\n    callbacks=[]\n)\n\n# Validation\nval_probs = model.predict_proba(X_val)[:, 1]\nauc_score = roc_auc_score(y_val, val_probs)\nprint(f\"Validation ROC-AUC: {auc_score:.4f}\")\n\n# Test predictions\nprint(\"Generating test predictions...\")\ntest_probs = model.predict_proba(X_test)[:, 1]\n\n# Save results\noutput = pd.DataFrame({'target': test_probs})\noutput.to_csv('/app/predictions.csv', index=False)\nprint(\"Predictions saved to /app/predictions.csv\")\nEOF\n"]
[16.703767, "o", "cat << 'EOF' > solution.py\r\n\u001b[?2004l\r"]
