[?2004hroot@620decb57cd3:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from lightgbm import LGBMClassifier
[?2004l[?2004h> from sklearn.metrics import roc_auc_score
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train_df = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val_df = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test_df = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Separate features and target
[?2004l[?2004h> X_train = train_df.drop(columns=['target'])
[?2004l[?2004h> y_train = train_df['target']
[?2004l[?2004h> X_val = val_df.drop(columns=['target'])
[?2004l[?2004h> y_val = val_df['target']
[?2004l[?2004h> X_test = test_df.copy()
[?2004l[?2004h> 
[?2004l[?2004h> # Identify feature types
[?2004l[?2004h> numeric_cols = [c for c in X_train.columns if c.startswith('num_')]
[?2004l[?2004h> binary_cols = [c for c in X_train.columns if c.startswith('bin_')]
[?2004l[?2004h> categorical_cols = [c for c in X_train.columns if c.startswith('cat_')]
[?2004l[?2004h> 
[?2004l[?2004h> # LightGBM can handle categorical features if they are passed as 'category' type
[?2004l[?2004h> for col in categorical_cols:
[?2004l[?2004h>     X_train[col] = X_train[col].astype('category')
[?2004l[?2004h>     X_val[col] = X_val[col].astype('category')
[?2004l[?2004h>     X_test[col] = X_test[col].astype('category')
[?2004l[?2004h> 
[?2004l[?2004h> # LightGBM handles NaNs automatically for numeric columns
[?2004l[?2004h> 
[?2004l[?2004h> # Initialize and train model
[?2004l[?2004h> model = LGBMClassifier(
[?2004l[?2004h>     n_estimators=500,
[?2004l[?2004h>     learning_rate=0.05,
[?2004l[?2004h>     num_leaves=31,
[?2004l[?2004h>     random_state=42,
[?2004l[?2004h>     importance_type='gain',
[?2004l[?2004h>     verbose=-1
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> print("Training model...")
[?2004l[?2004h> model.fit(
[?2004l[?2004h>     X_train, y_train,
[?2004l[?2004h>     eval_set=[(X_val, y_val)],
[?2004l[?2004h>     eval_metric='auc',
[?2004l[?2004h>     callbacks=[]
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Validation
[?2004l[?2004h> val_probs = model.predict_proba(X_val)[:, 1]
[?2004l[?2004h> auc_score = roc_auc_score(y_val, val_probs)
[?2004l[?2004h> print(f"Validation ROC-AUC: {auc_score:.4f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Test predictions
[?2004l[?2004h> print("Generating test predictions...")
[?2004l[?2004h> test_probs = model.predict_proba(X_test)[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> # Save results
[?2004l[?2004h> output = pd.DataFrame({'target': test_probs})
[?2004l[?2004h> output.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> print("Predictions saved to /app/predictions.csv")
[?2004l[?2004h> EOF
[?2004l[?2004hroot@620decb57cd3:/workspace# python3 solution.py
