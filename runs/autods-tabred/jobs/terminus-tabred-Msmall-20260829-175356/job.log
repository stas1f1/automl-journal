Sending keys: ['cat << \'EOF\' > solution.py\nimport pandas as pd\nimport numpy as np\nimport lightgbm as lgb\nfrom sklearn.metrics import mean_squared_error\nimport os\n\ndef main():\n    print("Loading data...")\n    train_df = pd.read_csv(\'/app/data/train.csv\')\n    val_df = pd.read_csv(\'/app/data/val.csv\')\n    test_df = pd.read_csv(\'/app/data/test.csv\')\n\n    X_train = train_df.drop(columns=[\'target\'])\n    y_train = train_df[\'target\']\n    X_val = val_df.drop(columns=[\'target\'])\n    y_val = val_df[\'target\']\n    X_test = test_df\n\n    # Identify column types\n    num_cols = [c for c in X_train.columns if c.startswith(\'num_\')]\n    bin_cols = [c for c in X_train.columns if c.startswith(\'bin_\')]\n    cat_cols = [c for c in X_train.columns if c.startswith(\'cat_\')]\n\n    # Convert categorical columns to type \'category\'\n    for col in cat_cols:\n        X_train[col] = X_train[col].astype(\'category\')\n        X_val[col] = X_val[col].astype(\'category\')\n        X_test[col] = X_test[col].astype(\'category\')\n\n    # LightGBM parameters\n    params = {\n        \'objective\': \'regression\',\n        \'metric\': \'rmse\',\n        \'verbosity\': -1,\n        \'boosting_type\': \'gbdt\',\n        \'random_state\': 42,\n        \'learning_rate\': 0.05,\n        \'num_leaves\': 31,\n    }\n\n    print("Training LightGBM model...")\n    train_data = lgb.Dataset(X_train, label=y_train, categorical_feature=cat_cols)\n    val_data = lgb.Dataset(X_val, label=y_val, reference=train_data, categorical_feature=cat_cols)\n\n    model = lgb.train(\n        params,\n        train_data,\n        valid_sets=[val_data],\n        num_boost_round=1000,\n        callbacks=[lgb.early_stopping(stopping_rounds=50)]\n    )\n\n    print("Evaluating model...")\n    val_preds = model.predict(X_val)\n    rmse = np.sqrt(mean_squared_error(y_val, val_preds))\n    print(f"Validation RMSE: {rmse}")\n\n    print("Generating test predictions...")\n    test_preds = model.predict(X_test)\n\n    print("Saving predictions...")\n    output_df = pd.DataFrame({\'target\': test_preds})\n    output_df.to_csv(\'/app/predictions.csv\', index=False)\n    print("Done!")\n\nif __name__ == \'__main__\':\n    main()\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
