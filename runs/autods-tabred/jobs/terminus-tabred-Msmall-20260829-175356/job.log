Sending keys: ['cat << \'EOF\' > train_and_predict.py\nimport pandas as pd\nimport lightgbm as lgb\nimport sys\n\ntry:\n    print("Starting script...")\n    train = pd.read_csv(\'/app/data/train.csv\')\n    val = pd.read_csv(\'/app/data/val.csv\')\n    test = pd.read_csv(\'/app/data/test.csv\')\n    print("Data loaded.")\n\n    X_train = train.drop(columns=[\'target\'])\n    y_train = train[\'target\']\n    X_val = val.drop(columns=[\'target\'])\n    y_val = val[\'target\']\n    X_test = test\n\n    cat_cols = [c for c in X_train.columns if c.startswith(\'cat_\')]\n    for col in cat_cols:\n        X_train[col] = X_train[col].astype(\'category\')\n        X_val[col] = X_val[col].astype(\'category\')\n        X_test[col] = X_test[col].astype(\'category\')\n    print("Preprocessing complete.")\n\n    dtrain = lgb.Dataset(X_train, label=y_train, categorical_feature=cat_cols)\n    dval = lgb.Dataset(X_val, label=y_val, reference=dtrain, categorical_feature=cat_cols)\n\n    params = {\n        \'objective\': \'binary\',\n        \'metric\': \'auc\',\n        \'verbosity\': -1,\n        \'random_state\': 42\n    }\n\n    print("Training model (5 rounds)...")\n    model = lgb.train(params, dtrain, valid_sets=[dval], num_boost_round=5)\n    print("Training complete.")\n\n    print("Predicting...")\n    y_test_pred = model.predict(X_test)\n\n    print("Saving...")\n    pd.DataFrame({\'target\': y_test_pred}).to_csv(\'/app/predictions.csv\', index=False)\n    print("Done!")\nexcept Exception as e:\n    print(f"Error: {e}")\n    sys.exit(1)\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
