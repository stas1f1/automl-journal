[90.061893, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import mean_squared_error\nimport lightgbm as lgb\nfrom sklearn.impute import SimpleImputer\nfrom sklearn.preprocessing import LabelEncoder\nimport sys\n\ntry:\n    train = pd.read_csv('/app/data/train.csv')\n    val = pd.read_csv('/app/data/val.csv')\n    test = pd.read_csv('/app/data/test.csv')\nexcept Exception as e:\n    print(f\"Error loading data: {e}\")\n    sys.exit(1)\n\nprint(\"Data loaded successfully.\")\n\ntarget_col = 'target'\nfeatures = [c for c in train.columns if c != target_col]\n\nnum_features = [c for c in features if c.startswith('num_')]\nbin_features = [c for c in features if c.startswith('bin_')]\ncat_features = [c for c in features if c.startswith('cat_')]\n\nprint(f\"Numerical: {len(num_features)}, Binary: {len(bin_features)}, Categorical: {len(cat_features)}\")\n\n# Imputation for numerical features\nimputer = SimpleImputer(strategy='median')\ntrain[num_features] = imputer.fit_transform(train[num_features])\nval[num_features] = imputer.transform(val[num_features])\ntest[num_features] = imputer.transform(test[num_features])\n\n# Encoding for categorical features\nfor col in cat_features:\n    le = LabelEncoder()\n    combined = pd.concat([train[col], val[col], test[col]], axis=0).astype(str)\n    le.fit(combined)\n    train[col] = le.transform(train[col].astype(str))\n    val[col] = le.transform(val[col].astype(str))\n    test[col] = le.transform(test[col].astype(str))\n\n# Model training\nX_train = train[features]\n\nmodel = lgb.LGBMRegressor(n_estimators=500, learning_rate=0.05, random_state=42, n_jobs=-1)\nprint(\"Training model...\")\nmodel.fit(\n    X_train, train[target_col],\n    eval_set=[(val[features], val[target_col])],\n    eval_metric='rmse',\n    callbacks=[lgb.early_stopping(stopping_rounds=50)]\n)\n\n# Validation\npreds_val = model.predict(val[features])\nrmse = np.sqrt(mean_squared_error(val[target_col], preds_val))\nprint(f\"Validation RMSE: {rmse}\")\n\n# Final predictions\nprint(\"Generating test predictions...\")\ntest_preds = model.predict(test[features])\n\n# Output\noutput = pd.DataFrame({'target': test_preds})\noutput.to_csv('/app/predictions.csv', index=False)\nprint(\"Predictions saved to /app/predictions.csv\")\nEOF\n"]
[90.062599, "o", "cat << 'EOF' > solution.py"]
