[100.936077, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport lightgbm as lgb\nfrom sklearn.metrics import roc_auc_score\nimport numpy as np\n\n# Load data\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\n# Identify feature columns\ntarget_col = 'target'\nfeatures = [c for c in train.columns if c != target_col]\n\n# Separate X and y\nX_train = train[features].copy()\ny_train = train[target_col]\n\nX_val = val[features].copy()\ny_val = val[target_col]\n\nX_test = test[features].copy()\n\n# Identify categorical features for LightGBM\ncat_features = [c for c in features if c.startswith('cat_')]\nfor col in cat_features:\n    X_train[col] = X_train[col].astype('category')\n    X_val[col] = X_val[col].astype('category')\n    X_test[col] = X_test[col].astype('category')\n\n# LightGBM parameters\nparams = {\n    'objective': 'binary',\n    'metric': 'auc',\n    'verbosity': -1,\n    'boosting_type': 'gbdt',\n    'random_state': 42,\n    'learning_rate': 0.05,\n    'num_leaves': 31,\n    'feature_fraction': 0.8,\n    'bagging_fraction': 0.8,\n    'bagging_freq': 5,\n}\n\n# Create datasets\ndtrain = lgb.Dataset(X_train, label=y_train, categorical_feature=cat_features)\ndval = lgb.Dataset(X_val, label=y_val, reference=dtrain, categorical_feature=cat_features)\n\n# Train model - simplified to avoid callback errors\nmodel = lgb.train(\n    params,\n    dtrain,\n    valid_sets=[dtrain, dval],\n    valid_names=['train', 'valid'],\n    num_boost_round=500\n)\n\n# Validation score\nval_preds = model.predict(X_val)\nauc_score = roc_auc_score(y_val, val_preds)\nprint(f'Validation ROC-AUC: {auc_score}')\n\n# Predict on test set\ntest_preds = model.predict(X_test)\n\n# Prepare output\noutput = pd.DataFrame({'target': test_preds})\noutput.to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"]
