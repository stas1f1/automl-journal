[100.944242, "o", "\u001b[?2004h> "]
[100.944282, "o", "# Predict on test set\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.944339, "o", "test_preds = model.predict(X_test)\r\n\u001b[?2004l\r"]
