[?2004hroot@32af4b005627:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import lightgbm as lgb
[?2004l[?2004h> from sklearn.metrics import roc_auc_score
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train_df = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val_df = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test_df = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Separate features and target
[?2004l[?2004h> X_train = train_df.drop(columns=['target'])
[?2004l[?2004h> y_train = train_df['target']
[?2004l[?2004h> 
[?2004l[?2004h> X_val = val_df.drop(columns=['target'])
[?2004l[?2004h> y_val = val_df['target']
[?2004l[?2004h> 
[?2004l[?2004h> X_test = test_df
[?2004l[?2004h> 
[?2004l[?2004h> # Convert categorical columns if any (though schema says 0 cat)
[?2004l[?2004h> # LightGBM handles NaN automatically for numerical features
[?2004l[?2004h> 
[?2004l[?2004h> # Create LightGBM datasets
[?2004l[?2004h> train_data = lgb.Dataset(X_train, label=y_train)
[?2004l[?2004h> val_data = lgb.Dataset(X_val, label=y_val, reference=train_data)
[?2004l[?2004h> 
[?2004l[?2004h> # Parameters
[?2004l[?2004h> params = {
[?2004l[?2004h>     'objective': 'binary',
[?2004l[?2004h>     'metric': 'auc',
[?2004l[?2004h>     'boosting_type': 'gbdt',
[?2004l[?2004h>     'learning_rate': 0.05,
[?2004l[?2004h>     'num_leaves': 31,
[?2004l[?2004h>     'feature_fraction': 0.8,
[?2004l[?2004h>     'bagging_fraction': 0.8,
[?2004l[?2004h>     'bagging_freq': 5,
[?2004l[?2004h>     'verbose': -1,
[?2004l[?2004h>     'seed': 42
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Train model
[?2004l[?2004h> print("Training model...")
[?2004l[?2004h> model = lgb.train(
[?2004l[?2004h>     params,
[?2004l[?2004h>     train_data,
[?2004l[?2004h>     valid_sets=[train_data, val_data],
[?2004l[?2004h>     valid_names=['train', 'valid'],
[?2004l[?2004h>     num_boost_round=1000,
[?2004l[?2004h>     callbacks=[lgb.early_stopping(stopping_rounds=50)]
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Evaluation
[?2004l[?2004h> print("Evaluating...")
[?2004l[?2004h> y_pred_val = model.predict(X_val)
[?2004l[?2004h> auc_score = roc_auc_score(y_val, y_pred_val)
[?2004l[?2004h> print(f"Validation ROC-AUC: {auc_score}")
[?2004l[?2004h> 
[?2004l[?2004h> # Prediction
[?2004l[?2004h> print("Predicting on test set...")
[?2004l[?2004h> y_pred_test = model.predict(X_test)
[?2004l[?2004h> 
[?2004l[?2004h> # Save predictions
[?2004l[?2004h> output = pd.DataFrame({'target': y_pred_test})
[?2004l[?2004h> output.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> print("Predictions saved to /app/predictions.csv")
[?2004l[?2004h> EOF
