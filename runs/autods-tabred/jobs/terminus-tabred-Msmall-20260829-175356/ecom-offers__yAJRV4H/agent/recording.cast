[19.364364, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport lightgbm as lgb\nfrom sklearn.metrics import roc_auc_score\nimport numpy as np\n\ndef solve():\n    data_path = '/app/data'\n    \n    print(\"Loading data...\")\n    train = pd.read_csv(f'{data_path}/train.csv')\n    val = pd.read_csv(f'{data_path}/val.csv')\n    test = pd.read_csv(f'{data_path}/test.csv')\n\n    X_train = train.drop(columns=['target'])\n    y_train = train['target']\n    X_val = val.drop(columns=['target'])\n    y_val = val['target']\n    X_test = test\n\n    # LightGBM handles NaNs automatically, which is convenient for the 'nan' values.\n    # However, the task says 'nan' string for missing numerical values. \n    # pandas read_csv usually converts 'nan' to np.nan automatically.\n\n    print(\"Training LightGBM...\")\n    params = {\n        'objective': 'binary',\n        'metric': 'auc',\n        'verbosity': -1,\n        'boosting_type': 'gbdt',\n        'random_state': 42,\n        'learning_rate': 0.05,\n        'num_leaves': 31,\n    }\n\n    train_data = lgb.Dataset(X_train, label=y_train)\n    val_data = lgb.Dataset(X_val, label=y_val, reference=train_data)\n\n    gbm = lgb.train(\n        params,\n        train_data,\n        valid_sets=[train_data, val_data],\n        valid_names=['train', 'valid'],\n        num_boost_round=1000,\n        callbacks=[lgb.early_stopping(stopping_rounds=50)]\n    )\n\n    print(\"Evaluating...\")\n    val_preds = gbm.predict(X_val)\n    auc = roc_auc_score(y_val, val_preds)\n    print(f\"Validation ROC-AUC: {auc}\")\n\n    print(\"Predicting test set...\")\n    test_preds = gbm.predict(X_test)\n\n    print(\"Saving predictions...\")\n    output = pd.DataFrame({'target': test_preds})\n    output.to_csv('/app/predictions.csv', index=False)\n    print(\"Done! Saved to /app/predictions.csv\")\n\nif __name__ == '__main__':\n    solve()\nEOF\n"]
[19.364852, "o", "cat << 'EOF' > solution.py\r\n"]
