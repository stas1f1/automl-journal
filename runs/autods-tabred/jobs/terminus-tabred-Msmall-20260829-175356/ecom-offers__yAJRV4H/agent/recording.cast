[184.932913, "i", "cat << 'EOF' > solution_v2.py\nimport pandas as pd\nimport lightgbm as lgb\nfrom sklearn.metrics import roc_auc_score\nimport numpy as np\nimport sys\n\ndef solve():\n    try:\n        data_path = '/app/data'\n        print(\"Loading data...\")\n        train = pd.read_csv(f'{data_path}/train.csv')\n        val = pd.read_csv(f'{data_path}/val.csv')\n        test = pd.read_csv(f'{data_path}/test.csv')\n\n        X_train = train.drop(columns=['target'])\n        y_train = train['target']\n        X_val = val.drop(columns=['target'])\n        y_val = val['target']\n        X_test = test\n\n        print(f\"Train shape: {X_train.shape}\")\n\n        params = {\n            'objective': 'binary',\n            'metric': 'auc',\n            'verbosity': -1,\n            'boosting_type': 'gbdt',\n            'random_state': 42,\n            'learning_rate': 0.05,\n            'num_leaves': 31,\n        }\n\n        train_data = lgb.Dataset(X_train, label=y_train)\n        val_data = lgb.Dataset(X_val, label=y_val, reference=train_data)\n\n        gbm = lgb.train(\n            params,\n            train_data,\n            valid_sets=[train_data, val_data],\n            valid_names=['train', 'valid'],\n            num_boost_round=500,\n            callbacks=[lgb.early_stopping(stopping_rounds=20)]\n        )\n\n        print(\"Predicting...\")\n        test_preds = gbm.predict(X_test)\n\n        output = pd.DataFrame({'target': test_preds})\n        output.to_csv('/app/predictions.csv', index=False)\n        print(\"Success! File saved.\")\n    except Exception as e:\n        print(f\"ERROR: {e}\")\n        sys.exit(1)\n\nif __name__ == '__main__':\n    solve()\nEOF\n"]
[184.933174, "o", "cat << 'EOF' > solution_v2.py\r\nimport pandas as pd\r\nimport lightgbm as lgb\r\nfrom sklearn.metrics import roc_auc_score\r\nimport numpy as np\r\nimport sys\r\n\r\ndef solve():\r\n    try:\r\n        data_path = '/app/data'\r\n        print(\"Loading data...\")\r\n        train = pd.read_csv(f'{data_path}/train.csv')\r\n        val = pd.read_csv(f'{data_path}/val.csv')\r\n        test = pd.read_csv(f'{data_path}/test.csv')\r\n\r\n        X_train = train.drop(columns=['target'])\r\n        y_train = train['target']\r\n        X_val = val.drop(columns=['target'])\r\n        y_val = val['target']\r\n        X_test = test\r\n\r\n        print(f\"Train shape: {X_train.shape}\")\r\n\r\n        params = {\r\n            'objective': 'binary',\r\n            'metric': 'auc',\r\n            'verbosity': -1,\r\n            'boosting_type': 'gbdt',\r\n            'random_state': 42,\r\n            'learning_rate': 0.05,\r\n            'num_leaves': 31,\r\n        }\r\n\r\n        train_data = lgb.Dataset(X_train, label=y_train)\r\n        val_data = lgb.Dataset(X_val, label=y_val, reference=train_data)\r\n\r\n        gbm = lgb.train(\r\n            params,\r\n            train_data,\r\n            valid_sets=[train_data, val_data],\r\n            valid_names=['train', 'valid'],\r\n            num_boost_round=500,\r\n            callbacks=[lgb.early_stopping(stopping_rounds=20)]\r\n        )\r\n\r\n        print(\"Predicting...\")\r\n        test_preds = gbm.predict(X_test)\r\n\r\n        output = pd.DataFrame({'target': test_preds})\r\n        output.to_csv('/app/predictions.csv', index=False)\r\n        print(\"Success! File saved.\")\r\n    except Exception as e:\r\n        print(f\"ERROR: {e}\")\r\n        sys.exit(1)\r\n\r\nif __name__ == '__main__':\r\n    solve()\r\nEOF\r\n"]
