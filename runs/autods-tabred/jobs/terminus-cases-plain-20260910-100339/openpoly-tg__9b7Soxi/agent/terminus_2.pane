[0m[?2004hroot@0fce2c65b1ca:/workspace# cat << 'EOF' > train_and_predict.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from rdkit import Chem
[?2004l[?2004h> from rdkit.Chem import AllChem
[?2004l[?2004h> from xgboost import XGBRegressor
[?2004l[?2004h> from sklearn.model_selection import train_test_split
[?2004l[?2004h> from sklearn.metrics import r2_score, mean_absolute_error
[?2004l[?2004h> 
[?2004l[?2004h> def smiles_to_fp(smiles, radius=2, n_bits=2048):
[?2004l[?2004h>     # PSMILES use * as connection points. RDKit interprets * as dummy atoms.
[?2004l[?2004h>     mol = Chem.MolFromSmiles(smiles)
[?2004l[?2004h>     if mol is None:
[?2004l[?2004h>         return np.zeros(n_bits)
[?2004l[?2004h>     fp = AllChem.GetMorganFingerprintAsBitVect(mol, radius, nBits=n_bits)
[?2004l[?2004h>     return np.array(fp)
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train_df = pd.read_csv('train.csv')
[?2004l[?2004h> test_df = pd.read_csv('test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> print(f'Training samples: {len(train_df)}')
[?2004l[?2004h> print(f'Test samples: {len(test_df)}')
[?2004l[?2004h> 
[?2004l[?2004h> # Generate features
[?2004l[?2004h> X_train_all = np.stack(train_df['PSMILES'].apply(smiles_to_fp).values)
[?2004l[?2004h> y_train_all = train_df['Tg'].values
[?2004l[?2004h> X_test = np.stack(test_df['PSMILES'].apply(smiles_to_fp).values)
[?2004l[?2004h> 
[?2004l[?2004h> # Split for validation
[?2004l[?2004h> X_train, X_val, y_train, y_val = train_test_split(X_train_all, y_train_all, test_size=0.2, random_state=42)
[?2004l[?2004h> 
[?2004l[?2004h> # Train XGBoost
[?2004l[?2004h> model = XGBRegressor(n_estimators=500, learning_rate=0.05, max_depth=6, random_state=42, n_jobs=-1)
[?2004l[?2004h> model.fit(X_train, y_train, eval_set=[(X_val, y_val)], verbose=False)
[?2004l[?2004h> 
[?2004l[?2004h> # Evaluate
[?2004l[?2004h> val_preds = model.predict(X_val)
[?2004l[?2004h> r2 = r2_score(y_val, val_preds)
[?2004l[?2004h> mae = mean_absolute_error(y_val, val_preds)
[?2004l[?2004h> print(f'Validation R2: {r2:.4f}')
[?2004l[?2004h> print(f'Validation MAE: {mae:.4f} K')
[?2004l[?2004h> 
[?2004l[?2004h> # Final predictions on test set
[?2004l[?2004h> test_preds = model.predict(X_test)
[?2004l[?2004h> submission = pd.DataFrame({'id': test_df['id'], 'Tg': test_preds})
[?2004l[?2004h> submission.to_csv('submission.csv', index=False)
[?2004l[?2004h> print('Submission saved to submission.csv')
[?2004l[?2004h> EOF
