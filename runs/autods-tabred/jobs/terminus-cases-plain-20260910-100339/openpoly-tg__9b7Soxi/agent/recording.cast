[7.867504, "o", "\u001b[?2004hroot@0fce2c65b1ca:/workspace# "]
[45.242834, "i", "cat << 'EOF' > train_and_predict.py\nimport pandas as pd\nimport numpy as np\nfrom rdkit import Chem\nfrom rdkit.Chem import AllChem\nfrom xgboost import XGBRegressor\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import r2_score, mean_absolute_error\n\ndef smiles_to_fp(smiles, radius=2, n_bits=2048):\n    # PSMILES use * as connection points. RDKit interprets * as dummy atoms.\n    mol = Chem.MolFromSmiles(smiles)\n    if mol is None:\n        return np.zeros(n_bits)\n    fp = AllChem.GetMorganFingerprintAsBitVect(mol, radius, nBits=n_bits)\n    return np.array(fp)\n\n# Load data\ntrain_df = pd.read_csv('train.csv')\ntest_df = pd.read_csv('test.csv')\n\nprint(f'Training samples: {len(train_df)}')\nprint(f'Test samples: {len(test_df)}')\n\n# Generate features\nX_train_all = np.stack(train_df['PSMILES'].apply(smiles_to_fp).values)\ny_train_all = train_df['Tg'].values\nX_test = np.stack(test_df['PSMILES'].apply(smiles_to_fp).values)\n\n# Split for validation\nX_train, X_val, y_train, y_val = train_test_split(X_train_all, y_train_all, test_size=0.2, random_state=42)\n\n# Train XGBoost\nmodel = XGBRegressor(n_estimators=500, learning_rate=0.05, max_depth=6, random_state=42, n_jobs=-1)\nmodel.fit(X_train, y_train, eval_set=[(X_val, y_val)], verbose=False)\n\n# Evaluate\nval_preds = model.predict(X_val)\nr2 = r2_score(y_val, val_preds)\nmae = mean_absolute_error(y_val, val_preds)\nprint(f'Validation R2: {r2:.4f}')\nprint(f'Validation MAE: {mae:.4f} K')\n\n# Final predictions on test set\ntest_preds = model.predict(X_test)\nsubmission = pd.DataFrame({'id': test_df['id'], 'Tg': test_preds})\nsubmission.to_csv('submission.csv', index=False)\nprint('Submission saved to submission.csv')\nEOF\n"]
[45.244341, "o", "cat << 'EOF' > train_and_predict.py\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from rdkit import Chem\r\n\u001b[?2004l\r\u001b[?2004h> from rdkit.Chem import AllChem\r\n\u001b[?2004l\r\u001b[?2004h> from xgboost import XGBRegressor\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.model_selection import train_test_split\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.metrics import r2_score, mean_absolute_error\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def smiles_to_fp(smiles, radius=2, n_bits=2048):\r\n\u001b[?2004l\r\u001b[?2004h> "]
