[55.548835, "o", "\u001b[?2004h> "]
[55.54888, "o", "model_full.fit(X, y)\r\n\u001b[?2004l\r"]
[55.548912, "o", "\u001b[?2004h"]
[55.548939, "o", "> "]
[55.548975, "o", "test_preds = model_full.predict(X_test)"]
[55.549004, "o", "\r\n\u001b[?2004l\r"]
[55.549037, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[55.549064, "o", "\u001b[?2004h> "]
[55.549092, "o", "# Save submission"]
[55.54913, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.549227, "o", "submission = pd.DataFrame({'jobid': test_df['jobid'], 'success': test_preds})\r\n\u001b[?2004l\r"]
[55.549255, "o", "\u001b[?2004h> "]
[55.549343, "o", "submission.to_csv('submission.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
