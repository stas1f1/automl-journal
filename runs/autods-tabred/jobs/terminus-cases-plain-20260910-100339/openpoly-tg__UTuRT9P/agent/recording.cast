[32.688691, "o", "Traceback (most recent call last):\r\n  File \"/workspace/solution.py\", line 33, in <module>\r\n    model.fit(X_train, y_train, eval_set=[(X_val, y_val)], early_stopping_rounds=50, verbose=False)\r\n  File \"/usr/local/lib/python3.12/site-packages/xgboost/core.py\", line 726, in inner_f\r\n    return func(**kwargs)\r\n           ^^^^^^^^^^^^^^\r\nTypeError: XGBModel.fit() got an unexpected keyword argument 'early_stopping_rounds'\r\n"]
[32.820737, "o", "\u001b[?2004hroot@6ff240c30afb:/workspace# "]
[80.530848, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom rdkit import Chem\nfrom rdkit.Chem import AllChem\nfrom xgboost import XGBRegressor\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import r2_score, mean_absolute_error\n\ndef smiles_to_fp(smiles, radius=2, nBits=2048):\n    mol = Chem.MolFromSmiles(smiles)\n    if mol is None:\n        return np.zeros(nBits)\n    fp = AllChem.GetMorganFingerprintAsBitVect(mol, radius, nBits=nBits)\n    return np.array(fp)\n\n# Load data\ntrain_df = pd.read_csv('train.csv')\ntest_df = pd.read_csv('test.csv')\n\nprint(f\"Training samples: {len(train_df)}\")\nprint(f\"Test samples: {len(test_df)}\")\n\n# Feature extraction\nprint(\"Extracting fingerprints for training data...\")\nX_train_full = np.array([smiles_to_fp(s) for s in train_df['PSMILES']])\ny_train_full = train_df['Tg'].values\n\n# Split for validation\nX_train, X_val, y_train, y_val = train_test_split(X_train_full, y_train_full, test_size=0.2, random_state=42)\n\n# Model - Move early_stopping_rounds to the constructor\nmodel = XGBRegressor(\n    n_estimators=1000, \n    learning_rate=0.05, \n    max_depth=6, \n    random_state=42, \n    early_stopping_rounds=50\n)\nmodel.fit(X_train, y_train, eval_set=[(X_val, y_val)], verbose=False)\n\n# Evaluate\npreds_val = model.predict(X_val)\nprint(f\"Validation R2: {r2_score(y_val, preds_val):.4f}\")\nprint(f\"Validation MAE: {mean_absolute_error(y_val, preds_val):.4f}\")\n\n# Test set\nprint(\"Extracting fingerprints for test data...\")\nX_test = np.array([smiles_to_fp(s) for s in test_df['PSMILES']])\npreds_test = model.predict(X_test)\n\n# Submission\nsubmission = pd.DataFrame({'id': test_df['id'], 'Tg': preds_test})\nsubmission.to_csv('submission.csv', index=False)\nprint(\"Submission saved to submission.csv\")\nEOF\n"]
