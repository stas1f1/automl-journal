[63.940971, "o", "\u001b[?2004h> "]
[63.941038, "o", "cat_indices = [X_features.columns.get_loc(col) for col in cat_cols]\r\n\u001b[?2004l\r"]
[63.941068, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
