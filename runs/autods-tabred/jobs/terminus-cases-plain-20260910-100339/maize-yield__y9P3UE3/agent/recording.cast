[63.941219, "o", "model = HistGradientBoostingRegressor(categorical_features=cat_indices, random_state=42)\r\n\u001b[?2004l\r"]
[63.941248, "o", "\u001b[?2004h> "]
[63.941287, "o", "model.fit(X_train, y_train)\r\n\u001b[?2004l\r"]
[63.941312, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
