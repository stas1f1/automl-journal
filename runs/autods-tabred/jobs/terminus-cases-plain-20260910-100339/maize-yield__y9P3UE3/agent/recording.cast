[63.938609, "o", "\u001b[?2004h> "]
[63.938639, "o", "y = train[target_col]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.938664, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
