[63.937368, "i", "cat << 'EOF' > solve.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import r2_score, mean_squared_error\n\n# Load data\ntrain = pd.read_csv('train.csv')\ntest = pd.read_csv('test.csv')\n\ntarget_col = 'GrainYield'\nindex_col = 'Index'\n\n# Define columns to drop\n# DatePlanted and DateHarvested are strings and should be removed for this baseline\n# Index is not a feature\ndrop_cols = [index_col, 'DatePlanted', 'DateHarvested']\n\n# Separate target\ny = train[target_col]\n\n# Features\nX = train.drop(columns=[target_col])\nX_test = test.copy()\n\n# Categorical columns identification\ncat_cols = ['Pedigree', 'F', 'M', 'ExperimentCode']\n\n# Mapping categorical columns to integers\nfor col in cat_cols:\n    all_vals = pd.concat([X[col], X_test[col]]).astype(str).unique()\n    mapping = {val: i for i, val in enumerate(all_vals)}\n    X[col] = X[col].astype(str).map(mapping)\n    X_test[col] = X_test[col].astype(str).map(mapping)\n\n# Drop the specified columns from features\nX_features = X.drop(columns=drop_cols)\nX_test_features = X_test.drop(columns=drop_cols)\n\n# Split training data for validation\nX_train, X_val, y_train, y_val = train_test_split(X_features, y, test_size=0.2, random_state=42)\n\n# Identify indices of categorical features for the model\ncat_indices = [X_features.columns.get_loc(col) for col in cat_cols]\n\n# Initialize and fit model\nmodel = HistGradientBoostingRegressor(categorical_features=cat_indices, random_state=42)\nmodel.fit(X_train, y_train)\n\n# Validate\npreds_val = model.predict(X_val)\nr2 = r2_score(y_val, preds_val)\nrmse = np.sqrt(mean_squared_error(y_val, preds_val))\nprint(f\"Validation R2: {r2:.4f}\")\nprint(f\"Validation RMSE: {rmse:.4f}\")\n\n# Predict on test set\npreds_test = model.predict(X_test_features)\n\n# Create submission\nsubmission = pd.DataFrame({index_col: test[index_col], target_col: preds_test})\nsubmission.to_csv('submission.csv', index=False)\nprint(\"Submission saved to submission.csv\")\nEOF\n"]
