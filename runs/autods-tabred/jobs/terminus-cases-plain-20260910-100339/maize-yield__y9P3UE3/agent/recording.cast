[63.941415, "o", "\u001b[?2004h> "]
[63.941445, "o", "r2 = r2_score(y_val, preds_val)\r\n\u001b[?2004l\r"]
[63.941469, "o", "\u001b[?2004h> "]
[63.94152, "o", "rmse = np.sqrt(mean_squared_error(y_val, preds_val))\r\n\u001b[?2004l\r"]
[63.941545, "o", "\u001b[?2004h> "]
[63.941575, "o", "print(f\"Validation R2: {r2:.4f}\")\r\n\u001b[?2004l\r"]
[63.941599, "o", "\u001b[?2004h> "]
[63.941631, "o", "print(f\"Validation RMSE: {rmse:.4f}\")\r\n\u001b[?2004l\r"]
[63.941656, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
