[63.938881, "o", "\u001b[?2004h> "]
[63.938938, "o", "cat_cols = ['Pedigree', 'F', 'M', 'ExperimentCode']\r\n\u001b[?2004l\r"]
[63.938966, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[63.938993, "o", "> "]
[63.939029, "o", "# Mapping categorical columns to integers\r\n\u001b[?2004l\r"]
[63.939058, "o", "\u001b[?2004h> "]
[63.939085, "o", "for col in cat_cols:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.939149, "o", "    all_vals = pd.concat([X[col], X_test[col]]).astype(str).unique()\r\n\u001b[?2004l\r"]
[63.939176, "o", "\u001b[?2004h> "]
[63.939232, "o", "    mapping = {val: i for i, val in enumerate(all_vals)}"]
[63.940295, "o", "\r\n\u001b[?2004l\r"]
[63.940325, "o", "\u001b[?2004h> "]
[63.940359, "o", "    X[col] = X[col].astype(str).map(mapping)\r\n\u001b[?2004l\r"]
[63.940385, "o", "\u001b[?2004h> "]
[63.940439, "o", "    X_test[col] = X_test[col].astype(str).map(mapping)\r\n\u001b[?2004l\r"]
[63.940465, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[63.940496, "o", "\u001b[?2004h> "]
[63.940527, "o", "# Drop the specified columns from features\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.940554, "o", "> "]
[63.940583, "o", "X_features = X.drop(columns=drop_cols)\r\n\u001b[?2004l\r"]
[63.940608, "o", "\u001b[?2004h> "]
[63.940652, "o", "X_test_features = X_test.drop(columns=drop_cols)\r\n\u001b[?2004l\r"]
[63.94068, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[63.940707, "o", "\u001b[?2004h> "]
[63.940733, "o", "# Split training data for validation\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.940758, "o", "> "]
[63.940851, "o", "X_train, X_val, y_train, y_val = train_test_split(X_features, y, test_size=0.2, random_state=42)\r\n\u001b[?2004l\r"]
[63.940877, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[63.940903, "o", "\u001b[?2004h> "]
