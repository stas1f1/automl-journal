[63.938718, "o", "> "]
[63.938743, "o", "X = train.drop(columns=[target_col])\r\n"]
[63.93877, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[63.938799, "o", "X_test = test.copy()\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.938827, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
