rmse = np.sqrt(mean_squared_error(y_val, preds_val))\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Validation R2: {r2:.4f}')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Validation RMSE: {rmse:.4f}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Predict on test set\r\n\u001b[?2004l\r\u001b[?2004h> final_preds = model.predict(X_test)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Submission\r\n\u001b[?2004l\r\u001b[?2004h> submission = pd.DataFrame({\r\n\u001b[?2004l\r\u001b[?2004h>     'Index': test_df['Index'],\r\n\u001b[?2004l\r\u001b[?2004h>     'GrainYield': final_preds\r\n\u001b[?2004l\r\u001b[?2004h> })\r\n\u001b[?2004l\r\u001b[?2004h> submission.to_csv('submission.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
