[152.295311, "i", "cat << 'EOF' > solve.py\nimport pandas as pd\nimport numpy as np\nfrom rdkit import Chem\nfrom rdkit.Chem import AllChem, Descriptors\nfrom xgboost import XGBRegressor\nfrom sklearn.model_selection import KFold\nfrom sklearn.metrics import r2_score, mean_absolute_error\nfrom sklearn.preprocessing import StandardScaler\nimport warnings\nwarnings.filterwarnings('ignore')\n\ndef get_features(smiles, radius=3, n_bits=2048):\n    mol = Chem.MolFromSmiles(smiles)\n    if mol is None:\n        return np.zeros(n_bits + 200) # Placeholder for descriptors\n    \n    # Morgan Fingerprint\n    fp = AllChem.GetMorganFingerprintAsBitVect(mol, radius, nBits=n_bits)\n    fp_array = np.array(fp)\n    \n    # Basic RDKit Descriptors\n    desc_list = []\n    for name, func in Descriptors._descList:\n        try:\n            desc_list.append(func(mol))\n        except:\n            desc_list.append(np.nan)\n    \n    return np.concatenate([fp_array, np.array(desc_list)])\n\n# Load data\ntrain_df = pd.read_csv('train.csv')\ntest_df = pd.read_csv('test.csv')\n\n# Feature extraction\nX_train_full = np.array([get_features(s) for s in train_df['PSMILES']])\ny_train_full = train_df['Tg'].values\nX_test = np.array([get_features(s) for s in test_df['PSMILES']])\n\n# Handle NaNs from descriptors\nfrom sklearn.impute import SimpleImputer\nimputer = SimpleImputer(strategy='median')\nX_train_full = imputer.fit_transform(X_train_full)\nX_test = imputer.transform(X_test)\n\n# Scaling for descriptors (though XGBoost is invariant, it's good practice)\nscaler = StandardScaler()\nX_train_full = scaler.fit_transform(X_train_full)\nX_test = scaler.transform(X_test)\n\n# Use Cross-Validation to evaluate\nkfold = KFold(n_splits=5, shuffle=True, random_state=42)\nall_val_preds = np.zeros(len(y_train_full))\n\nfor train_idx, val_idx in kfold.split(X_train_full):\n    xt, xv = X_train_full[train_idx], X_train_full[val_idx]\n    yt, yv = y_train_full[train_idx], y_train_full[val_idx]\n    \n    model = XGBRegressor(\n        n_estimators=1000,\n        learning_rate=0.03,\n        max_depth=8,\n        subsample=0.8,\n "]
[152.295551, "o", "cat << 'EOF' > solve.py\r\nimport pandas as pd\r\nimport numpy as np\r\nfrom rdkit import Chem\r\nfrom rdkit.Chem import AllChem, Descriptors\r\nfrom xgboost import XGBRegressor\r\nfrom sklearn.model_selection import KFold\r\nfrom sklearn.metrics import r2_score, mean_absolute_error\r\nfrom sklearn.preprocessing import StandardScaler\r\nimport warnings\r\nwarnings.filterwarnings('ignore')\r\n\r\ndef get_features(smiles, radius=3, n_bits=2048):\r\n    mol = Chem.MolFromSmiles(smiles)\r\n    if mol is None:\r\n        return np.zeros(n_bits + 200) # Placeholder for descriptors\r\n    \r\n    # Morgan Fingerprint\r\n    fp = AllChem.GetMorganFingerprintAsBitVect(mol, radius, nBits=n_bits)\r\n    fp_array = np.array(fp)\r\n    \r\n    # Basic RDKit Descriptors\r\n    desc_list = []\r\n    for name, func in Descriptors._descList:\r\n        try:\r\n            desc_list.append(func(mol))\r\n        except:\r\n            desc_list.append(np.nan)\r\n    \r\n    return np.concatenate([fp_array, np.array(desc_list)])\r\n\r\n# Load data\r\ntrain_df = pd.read_csv('train.csv')\r\ntest_df = pd.read_csv('test.csv')\r\n\r\n# Feature extraction\r\nX_train_full = np.array([get_features(s) for s in train_df['PSMILES']])\r\ny_train_full = train_df['Tg'].values\r\nX_test = np.array([get_features(s) for s in test_df['PSMILES']])\r\n\r\n# Handle NaNs from descriptors\r\nfrom sklearn.impute import SimpleImputer\r\nimputer = SimpleImputer(strategy='median')\r\nX_train_full = imputer.fit_transform(X_train_full)\r\nX_test = imputer.transform(X_test)\r\n\r\n# Scaling for descriptors (though XGBoost is invariant, it's good practice)\r\nscaler = StandardScaler()\r\nX_train_full = scaler.fit_transform(X_train_full)\r\nX_test = scaler.transform(X_test)\r\n\r\n# Use Cross-Validation to evaluate\r\nkfold = KFold(n_splits=5, shuffle=True, random_state=42)\r\nall_val_preds = np.zeros(len(y_train_full))\r\n\r\nfor train_idx, val_idx in kfold.split(X_train_full):\r\n    xt, xv = X_train_full[train_idx], X_train_full[val_idx]\r\n    yt, yv = y_train_full[train_idx], y_train_full[val_idx]\r\n    \r\n    model = XGBRegressor(\r\n        n_estimators=1000,\r\n        learning_rate=0.03,\r\n        max_depth=8,\r\n        subsample=0.8,\r\n "]
[152.297414, "i", "       colsample_bytree=0.8,\n        random_state=42,\n        n_jobs=-1\n    )\n    model.fit(xt, yt)\n    all_val_preds[val_idx] = model.predict(xv)\n\nprint(f\"CV R2: {r2_score(y_train_full, all_val_preds):.4f}\")\nprint(f\"CV MAE: {mean_absolute_error(y_train_full, all_val_preds):.4f}\")\n\n# Train final model on all data\nfinal_model = XGBRegressor(\n    n_estimators=1000,\n    learning_rate=0.03,\n    max_depth=8,\n    subsample=0.8,\n    colsample_bytree=0.8,\n    random_state=42,\n    n_jobs=-1\n)\nfinal_model.fit(X_train_full, y_train_full)\n\n# Predict test set\npreds_test = final_model.predict(X_test)\n\n# Save submission\nsubmission = pd.DataFrame({'id': test_df['id'], 'Tg': preds_test})\nsubmission.to_csv('submission.csv', index=False)\nprint(\"Submission saved to submission.csv\")\nEOF\n"]
[152.297486, "o", "       colsample_bytree=0.8,\r\n        random_state=42,\r\n        n_jobs=-1\r\n    )\r\n    model.fit(xt, yt)\r\n    all_val_preds[val_idx] = model.predict(xv)\r\n\r\nprint(f\"CV R2: {r2_score(y_train_full, all_val_preds):.4f}\")\r\nprint(f\"CV MAE: {mean_absolute_error(y_train_full, all_val_preds):.4f}\")\r\n\r\n# Train final model on all data\r\nfinal_model = XGBRegressor(\r\n    n_estimators=1000,\r\n    learning_rate=0.03,\r\n    max_depth=8,\r\n    subsample=0.8,\r\n    colsample_bytree=0.8,\r\n    random_state=42,\r\n    n_jobs=-1\r\n)\r\nfinal_model.fit(X_train_full, y_train_full)\r\n\r\n# Predict test set\r\npreds_test = final_model.predict(X_test)\r\n\r\n# Save submission\r\nsubmission = pd.DataFrame({'id': test_df['id'], 'Tg': preds_test})\r\nsubmission.to_csv('submission.csv', index=False)\r\nprint(\"Submission saved to submission.csv\")\r\nEOF\r\n"]
