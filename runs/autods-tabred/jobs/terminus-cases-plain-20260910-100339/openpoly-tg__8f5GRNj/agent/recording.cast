[32.435592, "o", "\u001b[?2004hroot@8c1fcac81904:/workspace# "]
[38.6255, "i", "cat << 'EOF' > solve.py\nimport pandas as pd\nimport numpy as np\nfrom rdkit import Chem\nfrom rdkit.Chem import AllChem\nfrom xgboost import XGBRegressor\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import r2_score, mean_absolute_error\n\ndef smiles_to_fp(smiles, radius=2, n_bits=2048):\n    mol = Chem.MolFromSmiles(smiles)\n    if mol is None:\n        return np.zeros(n_bits)\n    fp = AllChem.GetMorganFingerprintAsBitVect(mol, radius, nBits=n_bits)\n    return np.array(fp)\n\n# Load data\ntrain_df = pd.read_csv('train.csv')\ntest_df = pd.read_csv('test.csv')\n\nprint(f\"Training set size: {len(train_df)}\")\nprint(f\"Test set size: {len(test_df)}\")\n\n# Feature extraction\nX_train_full = np.array([smiles_to_fp(s) for s in train_df['PSMILES']])\ny_train_full = train_df['Tg'].values\nX_test = np.array([smiles_to_fp(s) for s in test_df['PSMILES']])\n\n# Split for validation\nX_train, X_val, y_train, y_val = train_test_split(X_train_full, y_train_full, test_size=0.2, random_state=42)\n\n# Train XGBoost\nmodel = XGBRegressor(n_estimators=500, learning_rate=0.05, max_depth=6, random_state=42)\nmodel.fit(X_train, y_train)\n\n# Validate\npreds_val = model.predict(X_val)\nprint(f\"Validation R2: {r2_score(y_val, preds_val):.4f}\")\nprint(f\"Validation MAE: {mean_absolute_error(y_val, preds_val):.4f}\")\n\n# Re-train on full set\nmodel.fit(X_train_full, y_train_full)\n\n# Predict test set\npreds_test = model.predict(X_test)\n\n# Save submission\nsubmission = pd.DataFrame({'id': test_df['id'], 'Tg': preds_test})\nsubmission.to_csv('submission.csv', index=False)\nprint(\"Submission saved to submission.csv\")\nEOF\n"]
