[103.290535, "o", "        n_jobs=-1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.290686, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h>     model.fit(xt, yt)"]
[103.2925, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     all_val_preds[val_idx] = model.predict(xv)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"CV R2: {r2_score(y_train_full, all_val_preds):.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"CV MAE: {mean_absolute_error(y_train_full, all_val_preds):.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Train final model on all data\r\n\u001b[?2004l\r\u001b[?2004h> final_model = XGBRegressor(\r\n\u001b[?2004l\r\u001b[?2004h>     n_estimators=1000,\r\n\u001b[?2004l\r\u001b[?2004h>     learning_rate=0.03,\r\n\u001b[?2004l\r\u001b[?2004h>     max_depth=8,\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.292643, "o", ">     subsample=0.8,\r\n"]
[103.292734, "o", "\u001b[?2004l\r\u001b[?2004h>     colsample_bytree=0.8,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.29282, "o", "    random_state=42,\r\n\u001b[?2004l\r\u001b[?2004h>     n_jobs=-1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.292905, "o", ")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.292998, "o", "final_model.fit(X_train_full, y_train_full)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.293061, "o", "# Predict test set\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.293181, "o", "preds_test = final_model.predict(X_test)\r\n\u001b[?2004l\r"]
[103.293216, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Save submission\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.293243, "o", "> "]
[103.293426, "o", "submission = pd.DataFrame({'id': test_df['id'], 'Tg': preds_test})"]
[103.294124, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> submission.to_csv('submission.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Submission saved to submission.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[103.296252, "o", "\u001b[?2004hroot@8c1fcac81904:/workspace# "]
[103.464157, "i", "python3 solve.py\n"]
[103.464906, "o", "python3 solve.py\r\n\u001b[?2004l\r"]
