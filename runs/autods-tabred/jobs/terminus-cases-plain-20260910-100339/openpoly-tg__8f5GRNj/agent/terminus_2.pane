[?2004hroot@8c1fcac81904:/workspace# cat << 'EOF' > solve.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from rdkit import Chem
[?2004l[?2004h> from rdkit.Chem import AllChem
[?2004l[?2004h> from xgboost import XGBRegressor
[?2004l[?2004h> from sklearn.model_selection import KFold
[?2004l[?2004h> from sklearn.metrics import r2_score, mean_absolute_error
[?2004l[?2004h> import warnings
[?2004l[?2004h> warnings.filterwarnings('ignore')
[?2004l[?2004h> 
[?2004l[?2004h> def smiles_to_fp(smiles, radius=3, n_bits=2048):
[?2004l[?2004h>     mol = Chem.MolFromSmiles(smiles)
[?2004l[?2004h>     if mol is None:
[?2004l[?2004h>         return np.zeros(n_bits)
[?2004l[?2004h>     fp = AllChem.GetMorganFingerprintAsBitVect(mol, radius, nBits=n_bits)
[?2004l[?2004h>     return np.array(fp)
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train_df = pd.read_csv('train.csv')
[?2004l[?2004h> test_df = pd.read_csv('test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Feature extraction
[?2004l[?2004h> X_train_full = np.array([smiles_to_fp(s) for s in train_df['PSMILES']])
[?2004l[?2004h> y_train_full = train_df['Tg'].values
[?2004l[?2004h> X_test = np.array([smiles_to_fp(s) for s in test_df['PSMILES']])
[?2004l[?2004h> 
[?2004l[?2004h> # Use Cross-Validation to evaluate
[?2004l[?2004h> kfold = KFold(n_splits=5, shuffle=True, random_state=42)
[?2004l[?2004h> all_val_preds = np.zeros(len(y_train_full))
[?2004l[?2004h> 
[?2004l[?2004h> for train_idx, val_idx in kfold.split(X_train_full):
[?2004l[?2004h>     xt, xv = X_train_full[train_idx], X_train_full[val_idx]
[?2004l[?2004h>     yt, yv = y_train_full[train_idx], y_train_full[val_idx]
[?2004l[?2004h>     
[?2004l[?2004h>     model = XGBRegressor(
[?2004l[?2004h>         n_estimators=1000,
[?2004l[?2004h>         learning_rate=0.03,
[?2004l[?2004h>         max_depth=8,
[?2004l[?2004h>         subsample=0.8,
[?2004l[?2004h>         colsample_bytree=0.8,
[?2004l[?2004h>         random_state=42,
[?2004l[?2004h>         n_jobs=-1
[?2004l[?2004h>     )
[?2004l[?2004h>     model.fit(xt, yt)
[?2004l[?2004h>     all_val_preds[val_idx] = model.predict(xv)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"CV R2: {r2_score(y_train_full, all_val_preds):.4f}")
[?2004l[?2004h> print(f"CV MAE: {mean_absolute_error(y_train_full, all_val_preds):.4f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Train final model on all data
[?2004l[?2004h> final_model = XGBRegressor(
[?2004l[?2004h>     n_estimators=1000,
[?2004l[?2004h>     learning_rate=0.03,
[?2004l[?2004h>     max_depth=8,
[?2004l[?2004h>     subsample=0.8,
[?2004l[?2004h>     colsample_bytree=0.8,
[?2004l[?2004h>     random_state=42,
[?2004l[?2004h>     n_jobs=-1
[?2004l[?2004h> )
[?2004l[?2004h> final_model.fit(X_train_full, y_train_full)
[?2004l[?2004h> 
[?2004l[?2004h> # Predict test set
[?2004l[?2004h> preds_test = final_model.predict(X_test)
[?2004l[?2004h> 
[?2004l[?2004h> # Save submission
[?2004l[?2004h> submission = pd.DataFrame({'id': test_df['id'], 'Tg': preds_test})
[?2004l[?2004h> submission.to_csv('submission.csv', index=False)
[?2004l[?2004h> print("Submission saved to submission.csv")
[?2004l[?2004h> EOF
