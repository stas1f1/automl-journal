cat << 'EOF' > solve.py
import pandas as pd
import numpy as np
from rdkit import Chem
from rdkit.Chem import AllChem, Descriptors
from xgboost import XGBRegressor
from sklearn.model_selection import KFold
from sklearn.metrics import r2_score, mean_absolute_error
from sklearn.preprocessing import StandardScaler
import warnings
warnings.filterwarnings('ignore')

def get_features(smiles, radius=3, n_bits=2048):
    mol = Chem.MolFromSmiles(smiles)
    if mol is None:
        return np.zeros(n_bits + 200) # Placeholder for descriptors
    
    # Morgan Fingerprint
    fp = AllChem.GetMorganFingerprintAsBitVect(mol, radius, nBits=n_bits)
    fp_array = np.array(fp)
    
    # Basic RDKit Descriptors
    desc_list = []
    for name, func in Descriptors._descList:
        try:
            desc_list.append(func(mol))
        except:
            desc_list.append(np.nan)
    
    return np.concatenate([fp_array, np.array(desc_list)])

# Load data
train_df = pd.read_csv('train.csv')
test_df = pd.read_csv('test.csv')

# Feature extraction
X_train_full = np.array([get_features(s) for s in train_df['PSMILES']])
y_train_full = train_df['Tg'].values
X_test = np.array([get_features(s) for s in test_df['PSMILES']])

# Handle NaNs from descriptors
from sklearn.impute import SimpleImputer
imputer = SimpleImputer(strategy='median')
X_train_full = imputer.fit_transform(X_train_full)
X_test = imputer.transform(X_test)

# Scaling for descriptors (though XGBoost is invariant, it's good practice)
scaler = StandardScaler()
X_train_full = scaler.fit_transform(X_train_full)
X_test = scaler.transform(X_test)

# Use Cross-Validation to evaluate
kfold = KFold(n_splits=5, shuffle=True, random_state=42)
all_val_preds = np.zeros(len(y_train_full))

for train_idx, val_idx in kfold.split(X_train_full):
    xt, xv = X_train_full[train_idx], X_train_full[val_idx]
    yt, yv = y_train_full[train_idx], y_train_full[val_idx]
    
    model = XGBRegressor(
        n_estimators=1000,
        learning_rate=0.03,
        max_depth=8,
        subsample=0.8,
        colsample_bytree=0.8,
        random_state=42,
        n_jobs=-1
    )
    model.fit(xt, yt)
    all_val_preds[val_idx] = model.predict(xv)

print(f"CV R2: {r2_score(y_train_full, all_val_preds):.4f}")
print(f"CV MAE: {mean_absolute_error(y_train_full, all_val_preds):.4f}")

# Train final model on all data
final_model = XGBRegressor(
    n_estimators=1000,
    learning_rate=0.03,
    max_depth=8,
    subsample=0.8,
    colsample_bytree=0.8,
    random_state=42,
    n_jobs=-1
)
final_model.fit(X_train_full, y_train_full)

# Predict test set
preds_test = final_model.predict(X_test)

# Save submission
submission = pd.DataFrame({'id': test_df['id'], 'Tg': preds_test})
submission.to_csv('submission.csv', index=False)
print("Submission saved to submission.csv")
EOF
python3 solve.py
ls -l submission.csv
