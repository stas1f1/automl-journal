reds = model.predict(X_val)\nprint(f"Validation R2: {r2_score(y_val, val_preds):.4f}")\nprint(f"Validation RMSE: {np.sqrt(mean_squared_error(y_val, val_preds)):.4f}")\nr, _ = pearsonr(y_val, val_preds)\nprint(f"Validation Pearson r: {r:.4f}")\n\n# Final fit on all train data\nmodel.fit(X, y)\n\n# Predict test\npredictions = model.predict(X_test_final)\n\nsubmission = pd.DataFrame({\'Index\': test[\'Index\'], \'GrainYield\': predictions})\nsubmission.to_csv(\'submission.csv\', index=False)\nprint("Submission file created successfully.")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
