[42.020047, "o", "\u001b[?2004h> "]
[42.020188, "o", "test = pd.read_csv('/app/data/test.csv')\r\n\u001b[?2004l\r"]
[42.020241, "o", "\u001b[?2004h> "]
[42.02031, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.020441, "o", "print(f\"Train shape: {train.shape}\")\r\n\u001b[?2004l\r"]
[42.020493, "o", "\u001b[?2004h"]
[42.02055, "o", "> "]
[42.020619, "o", "print(f\"Val shape: {val.shape}\")\r\n\u001b[?2004l\r"]
[42.020681, "o", "\u001b[?2004h> "]
[42.020832, "o", "print(f\"Test shape: {test.shape}\")\r\n\u001b[?2004l\r"]
[42.020865, "o", "\u001b[?2004h> "]
[42.020886, "o", "\r\n\u001b[?2004l\r"]
[42.020907, "o", "\u001b[?2004h"]
[42.020951, "o", "> "]
[42.021107, "o", "# Separate features and target\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.021165, "o", "> "]
[42.021216, "o", "target_col = 'target'\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.021281, "o", "> "]
[42.021489, "o", "feature_cols = [c for c in train.columns if c != target_col]\r\n\u001b[?2004l\r"]
[42.021556, "o", "\u001b[?2004h> "]
[42.021608, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.021706, "o", "X_train = train[feature_cols]\r\n\u001b[?2004l\r"]
[42.021761, "o", "\u001b[?2004h"]
[42.021816, "o", "> "]
[42.021872, "o", "y_train = train[target_col]\r\n\u001b[?2004l\r"]
[42.021923, "o", "\u001b[?2004h> "]
[42.021969, "o", "X_val = val[feature_cols]\r\n\u001b[?2004l\r"]
[42.022016, "o", "\u001b[?2004h> "]
[42.022063, "o", "y_val = val[target_col]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.022133, "o", "X_test = test[feature_cols]\r\n\u001b[?2004l\r"]
[42.022184, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[42.022232, "o", "\u001b[?2004h> "]
[42.022297, "o", "print(f\"Features: {len(feature_cols)}\")\r\n\u001b[?2004l\r"]
[42.022345, "o", "\u001b[?2004h> "]
[42.022467, "o", "print(f\"Train target distribution: {y_train.value_counts().to_dict()}\")"]
[42.024772, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Identify feature types\r\n\u001b[?2004l\r\u001b[?2004h> num_cols = [c for c in feature_cols if c.startswith('num_')]\r\n\u001b[?2004l\r\u001b[?2004h> bin_cols = [c for c in feature_cols if c.startswith('bin_')]\r\n\u001b[?2004l\r\u001b[?2004h> cat_cols = [c for c in feature_cols if c.startswith('cat_')]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Numerical: {len(num_cols)}, Binary: {len(bin_cols)}, Categorical: {len(cat_cols)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Convert object columns to numeric for categorical features\r\n\u001b[?2004l\r\u001b[?2004h> for col in cat_cols:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.026774, "o", "    if X_train[col].dtype == 'object':\r\n\u001b[?2004l\r\u001b[?2004h>         # Use frequency encoding for categorical\r\n\u001b[?2004l\r\u001b[?2004h>         freq = X_train[col].value_counts(dropna=False).to_dict()\r\n\u001b[?2004l\r\u001b[?2004h>         X_train[col] = X_train[col].map(freq)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.026932, "o", "        X_val[col] = X_val[col].map(freq).fillna(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.027035, "o", "        X_test[col] = X_test[col].map(freq).fillna(0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Convert all to float\r\n\u001b[?2004l\r"]
[42.027177, "o", "\u001b[?2004h> X_train = X_train.astype(float)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.027835, "o", "X_val = X_val.astype(float)\r\n\u001b[?2004l\r\u001b[?2004h> X_test = X_test.astype(float)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Impute missing values with median\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Imputing missing values...\")\r\n\u001b[?2004l\r\u001b[?2004h> imputer = SimpleImputer(strategy='median')\r\n\u001b[?2004l\r\u001b[?2004h> X_train_imputed = imputer.fit_transform(X_train)\r\n\u001b[?2004l\r\u001b[?2004h> X_val_imputed = imputer.transform(X_val)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.02792, "o", "X_test_imputed = imputer.transform(X_test)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.028025, "o", "print(\"Training model...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.028739, "o", "# Use HistGradientBoostingClassifier which handles large data well and is fast\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.ensemble import HistGradientBoostingClassifier\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> model = HistGradientBoostingClassifier(\r\n\u001b[?2004l\r\u001b[?2004h>     max_iter=200,\r\n\u001b[?2004l\r\u001b[?2004h>     learning_rate=0.1,\r\n\u001b[?2004l\r\u001b[?2004h>     max_depth=8,\r\n\u001b[?2004l\r\u001b[?2004h>     random_state=42\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> model.fit(X_train_imputed, y_train)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.028793, "o", "# Validate\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.028838, "o", "> "]
[42.028892, "o", "print(\"Validating...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.028945, "o", "from sklearn.metrics import roc_auc_score\r\n\u001b[?2004l\r"]
[42.02899, "o", "\u001b[?2004h> "]
[42.029086, "o", "val_pred = model.predict_proba(X_val_imputed)[:, 1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.029139, "o", "> "]
[42.02919, "o", "val_auc = roc_auc_score(y_val, val_pred)\r\n\u001b[?2004l\r"]
[42.02924, "o", "\u001b[?2004h> "]
[42.029312, "o", "print(f\"Validation ROC-AUC: {val_auc:.4f}\")\r\n\u001b[?2004l\r"]
[42.029363, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[42.029423, "o", "\u001b[?2004h> # Predict on test\r\n\u001b[?2004l\r"]
[42.029471, "o", "\u001b[?2004h> "]
[42.029514, "o", "print(\"Generating predictions...\")\r\n\u001b[?2004l\r"]
[42.029566, "o", "\u001b[?2004h> "]
[42.029632, "o", "test_pred = model.predict_proba(X_test_imputed)[:, 1]\r\n\u001b[?2004l\r"]
[42.029684, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[42.0298, "o", "\u001b[?2004h> # Save predictions\r\n\u001b[?2004l\r"]
[42.030114, "o", "\u001b[?2004h> print(f\"Saving predictions to /app/predictions.csv...\")\r\n\u001b[?2004l\r\u001b[?2004h> pd.DataFrame({'target': test_pred}).to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r"]
[42.030294, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Predictions saved! Shape: {test_pred.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.030523, "o", "print(f\"Predictions stats: min={test_pred.min():.4f}, max={test_pred.max():.4f}, mean={test_pred.mean():.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Done!\")"]
[42.03079, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[42.037195, "o", "\u001b[?2004hroot@447d75a9936b:/workspace# "]
