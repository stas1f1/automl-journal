[8.296792, "o", "\u001b[?2004hroot@447d75a9936b:/workspace# "]
[42.016689, "i", "cat > train_model.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.ensemble import GradientBoostingClassifier, RandomForestClassifier\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.impute import SimpleImputer\nimport warnings\nwarnings.filterwarnings('ignore')\n\nprint(\"Loading data...\")\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nprint(f\"Train shape: {train.shape}\")\nprint(f\"Val shape: {val.shape}\")\nprint(f\"Test shape: {test.shape}\")\n\n# Separate features and target\ntarget_col = 'target'\nfeature_cols = [c for c in train.columns if c != target_col]\n\nX_train = train[feature_cols]\ny_train = train[target_col]\nX_val = val[feature_cols]\ny_val = val[target_col]\nX_test = test[feature_cols]\n\nprint(f\"Features: {len(feature_cols)}\")\nprint(f\"Train target distribution: {y_train.value_counts().to_dict()}\")\n\n# Identify feature types\nnum_cols = [c for c in feature_cols if c.startswith('num_')]\nbin_cols = [c for c in feature_cols if c.startswith('bin_')]\ncat_cols = [c for c in feature_cols if c.startswith('cat_')]\n\nprint(f\"Numerical: {len(num_cols)}, Binary: {len(bin_cols)}, Categorical: {len(cat_cols)}\")\n\n# Convert object columns to numeric for categorical features\nfor col in cat_cols:\n    if X_train[col].dtype == 'object':\n        # Use frequency encoding for categorical\n        freq = X_train[col].value_counts(dropna=False).to_dict()\n        X_train[col] = X_train[col].map(freq)\n        X_val[col] = X_val[col].map(freq).fillna(0)\n        X_test[col] = X_test[col].map(freq).fillna(0)\n\n# Convert all to float\nX_train = X_train.astype(float)\nX_val = X_val.astype(float)\nX_test = X_test.astype(float)\n\n# Impute missing values with median\nprint(\"Imputing missing values...\")\nimputer = SimpleImputer(strategy='median')\nX_train_imputed = imputer.fit_transform(X_train)\nX_val_imputed = imputer.transform(X_val)\nX_test_imputed = imputer.transform(X_test)\n\nprint(\"Training model...\")\n# Use HistGradientBoostingClassifier which handles large data well and is fast\nfrom sklearn.ensemble import HistGradientBoostingClassifier\n\nmodel = HistGradientBoostingClassifier(\n    max_iter=200,\n    learning_rate=0.1,\n    max_depth=8,\n    random_state=42\n)\n\nmodel.fit(X_train_imputed, y_train)\n\n# Validate\nprint(\"Validating...\")\nfrom sklearn.metrics import roc_auc_score\nval_pred = model.predict_proba(X_val_imputed)[:, 1]\nval_auc = roc_auc_score(y_val, val_pred)\nprint(f\"Validation ROC-AUC: {val_auc:.4f}\")\n\n# Predict on test\nprint(\"Generating predictions...\")\ntest_pred = model.predict_proba(X_test_imputed)[:, 1]\n\n# Save predictions\nprint(f\"Saving predictions to /app/predictions.csv...\")\npd.DataFrame({'target': test_pred}).to_csv('/app/predictions.csv', index=False)\n\nprint(f\"Predictions saved! Shape: {test_pred.shape}\")\nprint(f\"Predictions stats: min={test_pred.min():.4f}, max={test_pred.max():.4f}, mean={test_pred.mean():.4f}\")\nprint(\"Done!\")\nEOF\n"]
[42.017731, "o", "cat > train_model.py << 'EOF'\r\n\u001b[?2004l\rata well and is fast\r\nfrom sklearn.ensemble import HistGradientBoostingClassifier\r\n\r\nmodel = HistGradientBoostingClassifier(\r\n    max_iter=200,\r\n    learning_rate=0.1,\r\n    max_depth=8,\r\n    random_state=42\r\n)\r\n\r\nmodel.fit(X_train_imputed, y_train)\r\n\r\n# Validate\r\nprint(\"Validating...\")\r\nfrom sklearn.metrics import roc_auc_score\r\nval_pred = model.predict_proba(X_val_imputed)[:, 1]\r\nval_auc = roc_auc_score(y_val, val_pred)\r\nprint(f\"Validation ROC-AUC: {val_auc:.4f}\")\r\n\r\n# Predict on test\r\nprint(\"Generating predictions...\")\r\ntest_pred = model.predict_proba(X_test_imputed)[:, 1]\r\n\r\n# Save predictions\r\nprint(f\"Saving predictions to /app/predictions.csv...\")\r\npd.DataFrame({'target': test_pred}).to_csv('/app/predictions.csv', index=False)\r\n\r\nprint(f\"Predictions saved! Shape: {test_pred.shape}\")\r\nprint(f\"Predictions stats: min={test_pred.min():.4f}, max={test_pred.max():.4f}, mean={test_pred.mean():.4f}\")\r\nprint(\"Done!\")\r\nEOF\r\n"]
