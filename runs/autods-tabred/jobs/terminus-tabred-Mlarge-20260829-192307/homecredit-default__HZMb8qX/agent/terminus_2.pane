[?2004hroot@447d75a9936b:/workspace# cat > train_model.py << 'EOF'
[?2004lata well and is fast
from sklearn.ensemble import HistGradientBoostingClassifier

model = HistGradientBoostingClassifier(
    max_iter=200,
    learning_rate=0.1,
    max_depth=8,
    random_state=42
)

model.fit(X_train_imputed, y_train)

# Validate
print("Validating...")
from sklearn.metrics import roc_auc_score
val_pred = model.predict_proba(X_val_imputed)[:, 1]
val_auc = roc_auc_score(y_val, val_pred)
print(f"Validation ROC-AUC: {val_auc:.4f}")

# Predict on test
print("Generating predictions...")
test_pred = model.predict_proba(X_test_imputed)[:, 1]

# Save predictions
print(f"Saving predictions to /app/predictions.csv...")
pd.DataFrame({'target': test_pred}).to_csv('/app/predictions.csv', index=False)

print(f"Predictions saved! Shape: {test_pred.shape}")
print(f"Predictions stats: min={test_pred.min():.4f}, max={test_pred.max():.4f}, mean={test_pred.mean():.4f}")
print("Done!")
