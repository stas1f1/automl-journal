[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from sklearn.ensemble import GradientBoostingClassifier, RandomForestClassifier
[?2004l[?2004h> from sklearn.preprocessing import StandardScaler
[?2004l[?2004h> from sklearn.impute import SimpleImputer
[?2004l[?2004h> import warnings
[?2004l[?2004h> warnings.filterwarnings('ignore')
[?2004l[?2004h> 
[?2004l[?2004h> print("Loading data...")
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Train shape: {train.shape}")
[?2004l[?2004h> print(f"Val shape: {val.shape}")
[?2004l[?2004h> print(f"Test shape: {test.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Separate features and target
[?2004l[?2004h> target_col = 'target'
[?2004l[?2004h> feature_cols = [c for c in train.columns if c != target_col]
[?2004l[?2004h> 
[?2004l[?2004h> X_train = train[feature_cols]
[?2004l[?2004h> y_train = train[target_col]
[?2004l[?2004h> X_val = val[feature_cols]
[?2004l[?2004h> y_val = val[target_col]
[?2004l[?2004h> X_test = test[feature_cols]
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Features: {len(feature_cols)}")
[?2004l[?2004h> print(f"Train target distribution: {y_train.value_counts().to_dict()}")
[?2004l[?2004h> 
[?2004l[?2004h> # Identify feature types
[?2004l[?2004h> num_cols = [c for c in feature_cols if c.startswith('num_')]
[?2004l[?2004h> bin_cols = [c for c in feature_cols if c.startswith('bin_')]
[?2004l[?2004h> cat_cols = [c for c in feature_cols if c.startswith('cat_')]
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Numerical: {len(num_cols)}, Binary: {len(bin_cols)}, Categorical: {len(cat_cols)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Convert object columns to numeric for categorical features
[?2004l[?2004h> for col in cat_cols:
[?2004l[?2004h>     if X_train[col].dtype == 'object':
[?2004l[?2004h>         # Use frequency encoding for categorical
[?2004l[?2004h>         freq = X_train[col].value_counts(dropna=False).to_dict()
[?2004l[?2004h>         X_train[col] = X_train[col].map(freq)
[?2004l[?2004h>         X_val[col] = X_val[col].map(freq).fillna(0)
[?2004l[?2004h>         X_test[col] = X_test[col].map(freq).fillna(0)
[?2004l[?2004h> 
[?2004l[?2004h> # Convert all to float
[?2004l[?2004h> X_train = X_train.astype(float)
[?2004l[?2004h> X_val = X_val.astype(float)
[?2004l[?2004h> X_test = X_test.astype(float)
[?2004l[?2004h> 
[?2004l[?2004h> # Impute missing values with median
[?2004l[?2004h> print("Imputing missing values...")
[?2004l[?2004h> imputer = SimpleImputer(strategy='median')
[?2004l[?2004h> X_train_imputed = imputer.fit_transform(X_train)
[?2004l[?2004h> X_val_imputed = imputer.transform(X_val)
[?2004l[?2004h> X_test_imputed = imputer.transform(X_test)
[?2004l[?2004h> 
[?2004l[?2004h> print("Training model...")
[?2004l[?2004h> # Use HistGradientBoostingClassifier which handles large data well and is fast
[?2004l[?2004h> from sklearn.ensemble import HistGradientBoostingClassifier
[?2004l[?2004h> 
[?2004l[?2004h> model = HistGradientBoostingClassifier(
[?2004l[?2004h>     max_iter=200,
[?2004l[?2004h>     learning_rate=0.1,
[?2004l[?2004h>     max_depth=8,
[?2004l[?2004h>     random_state=42
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> model.fit(X_train_imputed, y_train)
[?2004l[?2004h> 
[?2004l[?2004h> # Validate
[?2004l[?2004h> print("Validating...")
[?2004l[?2004h> from sklearn.metrics import roc_auc_score
[?2004l[?2004h> val_pred = model.predict_proba(X_val_imputed)[:, 1]
[?2004l[?2004h> val_auc = roc_auc_score(y_val, val_pred)
[?2004l[?2004h> print(f"Validation ROC-AUC: {val_auc:.4f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Predict on test
[?2004l[?2004h> print("Generating predictions...")
[?2004l[?2004h> test_pred = model.predict_proba(X_test_imputed)[:, 1]
[?2004l[?2004h> 
