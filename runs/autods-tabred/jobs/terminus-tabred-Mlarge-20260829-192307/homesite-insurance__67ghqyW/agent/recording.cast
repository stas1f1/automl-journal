[28.901644, "i", "cat > /workspace/train_model.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.preprocessing import LabelEncoder\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Load data\nprint(\"Loading data...\")\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nprint(f\"Train shape: {train.shape}\")\nprint(f\"Val shape: {val.shape}\")\nprint(f\"Test shape: {test.shape}\")\n\n# Identify feature types\nnum_features = [c for c in train.columns if c.startswith('num_')]\nbin_features = [c for c in train.columns if c.startswith('bin_')]\ncat_features = [c for c in train.columns if c.startswith('cat_')]\n\nprint(f\"Numerical features: {len(num_features)}\")\nprint(f\"Binary features: {len(bin_features)}\")\nprint(f\"Categorical features: {len(cat_features)}\")\n\n# Separate target\ny_train = train['target'].values\ny_val = val['target'].values\nX_train = train.drop('target', axis=1)\nX_val = val.drop('target', axis=1)\nX_test = test.copy()\n\n# Fill missing numerical values with median\nfor col in num_features:\n    median_val = X_train[col].median()\n    if pd.isna(median_val):\n        median_val = 0\n    X_train[col] = X_train[col].fillna(median_val)\n    X_val[col] = X_val[col].fillna(median_val)\n    X_test[col] = X_test[col].fillna(median_val)\n\n# Fill missing binary features with 0\nfor col in bin_features:\n    X_train[col] = X_train[col].fillna(0)\n    X_val[col] = X_val[col].fillna(0)\n    X_test[col] = X_test[col].fillna(0)\n\n# Encode categorical features\nlabel_encoders = {}\nfor col in cat_features:\n    le = LabelEncoder()\n    # Fit on combined data to handle all categories\n    combined = pd.concat([X_train[col], X_val[col], X_test[col]], axis=0).astype(str)\n    le.fit(combined)\n    X_train[col] = le.transform(X_train[col].astype(str))\n    X_val[col] = le.transform(X_val[col].astype(str))\n    X_test[col] = le.transform(X_test[col].astype(str))\n    label_encoders[col] = le\n\n# Try using LightGBM\ntry:\n    import lightgbm as lgb\n    print(\"\\nTraining LightGBM...\")\n    \n    # Create dataset\n    train_data = lgb.Dataset(X_train, label=y_train, categorical_feature=cat_features)\n    val_data = lgb.Dataset(X_val, label=y_val, categorical_feature=cat_features, reference=train_data)\n    \n    # Parameters\n    params = {\n        'objective': 'binary',\n        'metric': 'auc',\n        'boosting_type': 'gbdt',\n        'num_leaves': 64,\n        'max_depth': 8,\n        'learning_rate': 0.1,\n        'feature_fraction': 0.8,\n        'bagging_fraction': 0.8,\n        'bagging_freq': 5,\n        'verbose': -1,\n        'seed': 42\n    }\n    \n    # Train\n    model = lgb.train(\n        params,\n        train_data,\n        num_boost_round=500,\n        valid_sets=[train_data, val_data],\n        callbacks=[\n            lgb.early_stopping(stopping_rounds=30, verbose=False),\n            lgb.log_evaluation(period=100)\n        ]\n    )\n    \n    # Validate\n    val_preds = model.predict(X_val)\n    from sklearn.metrics import roc_auc_score\n    val_auc = roc_auc_score(y_val, val_preds)\n    print(f\"\\nValidation ROC-AUC: {val_auc:.6f}\")\n    \n    # Predict on test\n    test_preds = model.predict(X_test)\n    \nexcept ImportError:\n    print(\"LightGBM not available, using XGBoost...\")\n    import xgboost as xgb\n    \n    dtrain = xgb.DMatrix(X_train, label=y_train)\n    dval = xgb.DMatrix(X_val, label=y_val)\n    dtest = xgb.DMatrix(X_test)\n    \n    params = {\n        'objective': 'binary:logistic',\n        'eval_metric': 'auc',\n        'max_depth': 8,\n        'eta': 0.1,\n        'subsample': 0.8,\n        'colsample_bytree': 0.8,\n        'seed': 42,\n        'tree_method': 'hist'\n    }\n    \n    model = xgb.train(\n        params,\n        dtrain,\n        num_boost_round=500,\n        evals=[(dtrain, 'train'), (dval, 'val')],\n        early_stopping_rounds=30,\n        verbose_eval=100\n    )\n    \n    val_preds = model.predict(dval)\n    from sklearn.metrics import roc_auc_score\n    val_auc = roc_auc_score(y_val, val_preds)\n    print(f\"\\nValidation ROC-AUC: {val_auc:.6f}\")\n    \n    test_preds = model.predict(dtest)\n\n# Save predictions\nprint(f\"\\"]
[28.90171, "i", "nSaving predictions...\")\nprint(f\"Test predictions shape: {test_preds.shape}\")\nprint(f\"Test predictions finite: {np.isfinite(test_preds).all()}\")\nprint(f\"Test predictions range: [{test_preds.min():.4f}, {test_preds.max():.4f}]\")\n\nresult = pd.DataFrame({'target': test_preds})\nresult.to_csv('/app/predictions.csv', index=False)\nprint(\"Predictions saved to /app/predictions.csv\")\nprint(f\"Output shape: {result.shape}\")\nEOF\n"]
[28.90204, "o", "cat > /workspace/train_model.py << 'EOF'"]
[28.902553, "o", "\r\n\u001b[?2004l\r"]
[28.902638, "o", "\u001b[?2004h"]
[28.902684, "o", "> "]
[28.903166, "o", "import pandas as pd\r\n\u001b[?2004l\r"]
[28.903225, "o", "\u001b[?2004h> "]
[28.903268, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[28.903491, "o", "\u001b[?2004h> "]
[28.90353, "o", "from sklearn.preprocessing import LabelEncoder\r\n\u001b[?2004l\r"]
[28.903581, "o", "\u001b[?2004h> "]
[28.903695, "o", "import warnings\r\n\u001b[?2004l\r"]
[28.903712, "o", "\u001b[?2004h"]
[28.903764, "o", "> "]
[28.903914, "o", "warnings.filterwarnings('ignore')\r\n\u001b[?2004l\r"]
[28.904, "o", "\u001b[?2004h> "]
[28.904039, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.904078, "o", "# Load data\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.904126, "o", "> "]
[28.904229, "o", "print(\"Loading data...\")\r\n\u001b[?2004l\r"]
[28.904269, "o", "\u001b[?2004h> "]
[28.904455, "o", "train = pd.read_csv('/app/data/train.csv')\r\n\u001b[?2004l\r"]
[28.904503, "o", "\u001b[?2004h> "]
[28.904835, "o", "val = pd.read_csv('/app/data/val.csv')\r\n\u001b[?2004l\rr"]
[28.904875, "o", "\u001b[?2004h> "]
[28.90498, "o", "test = pd.read_csv('/app/data/test.csv')"]
[28.90526, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Train shape: {train.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.905384, "o", "print(f\"Val shape: {val.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.905493, "o", "print(f\"Test shape: {test.shape}\")\r\n\u001b[?2004l\r"]
[28.905531, "o", "\u001b[?2004h"]
[28.90557, "o", "> \r\n\u001b[?2004l\r"]
[28.90561, "o", "\u001b[?2004h> "]
[28.905646, "o", "# Identify feature types\r\n\u001b[?2004l\r"]
[28.905685, "o", "\u001b[?2004h"]
[28.905726, "o", "> "]
[28.906282, "o", "num_features = [c for c in train.columns if c.startswith('num_')]\r\n\u001b[?2004l\r"]
[28.906373, "o", "\u001b[?2004h> bin_features = [c for c in train.columns if c.startswith('bin_')]\r\n\u001b[?2004l\r\u001b[?2004h> cat_features = [c for c in train.columns if c.startswith('cat_')]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Numerical features: {len(num_features)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.906418, "o", "print(f\"Binary features: {len(bin_features)}\")"]
[28.906456, "o", "\r\n\u001b[?2004l\r"]
[28.906472, "o", "\u001b[?2004h"]
[28.906544, "o", "> "]
[28.906617, "o", "print(f\"Categorical features: {len(cat_features)}\")\r\n\u001b[?2004l\r"]
[28.90666, "o", "\u001b[?2004h> \r\n"]
[28.9067, "o", "\u001b[?2004l\r\u001b[?2004h"]
[28.906744, "o", "> "]
[28.906785, "o", "# Separate target\r\n\u001b[?2004l\r"]
[28.906824, "o", "\u001b[?2004h> "]
[28.906879, "o", "y_train = train['target'].values\r\n\u001b[?2004l\r"]
[28.906914, "o", "\u001b[?2004h"]
[28.906952, "o", "> "]
[28.906987, "o", "y_val = val['target'].values"]
[28.907026, "o", "\r\n\u001b[?2004l\r"]
[28.907066, "o", "\u001b[?2004h> "]
[28.907139, "o", "X_train = train.drop('target', axis=1)\r\n\u001b[?2004l\r"]
[28.907156, "o", "\u001b[?2004h"]
[28.907188, "o", "> "]
[28.907268, "o", "X_val = val.drop('target', axis=1)\r\n\u001b[?2004l\r"]
[28.907301, "o", "\u001b[?2004h"]
[28.907325, "o", "> "]
[28.90736, "o", "X_test = test.copy()"]
[28.907395, "o", "\r\n\u001b[?2004l\r"]
[28.90741, "o", "\u001b[?2004h"]
[28.907443, "o", "> \r\n"]
[28.907456, "o", "\u001b[?2004l\r"]
[28.907496, "o", "\u001b[?2004h> "]
[28.907595, "o", "# Fill missing numerical values with median\r\n\u001b[?2004l\r"]
[28.907615, "o", "\u001b[?2004h"]
[28.907629, "o", "> "]
[28.90769, "o", "for col in num_features:"]
[28.907704, "o", "\r\n\u001b[?2004l\r"]
[28.907742, "o", "\u001b[?2004h> "]
[28.907839, "o", "    median_val = X_train[col].median()\r\n\u001b[?2004l\r"]
[28.907871, "o", "\u001b[?2004h"]
[28.907895, "o", "> "]
[28.907967, "o", "    if pd.isna(median_val):\r\n\u001b[?2004l\r"]
[28.907989, "o", "\u001b[?2004h> "]
[28.908053, "o", "        median_val = 0"]
[28.90807, "o", "\r\n\u001b[?2004l\r"]
[28.908105, "o", "\u001b[?2004h> "]
[28.908236, "o", "    X_train[col] = X_train[col].fillna(median_val)\r\n\u001b[?2004l\r"]
[28.908262, "o", "\u001b[?2004h> "]
[28.90835, "o", "    X_val[col] = X_val[col].fillna(median_val)"]
[28.908384, "o", "\r\n\u001b[?2004l\r"]
[28.908401, "o", "\u001b[?2004h"]
[28.908436, "o", "> "]
[28.908539, "o", "    X_test[col] = X_test[col].fillna(median_val)\r\n\u001b[?2004l\r"]
[28.908563, "o", "\u001b[?2004h"]
[28.908584, "o", "> "]
[28.908601, "o", "\r\n\u001b[?2004l\r"]
[28.908636, "o", "\u001b[?2004h"]
[28.908651, "o", "> "]
[28.908719, "o", "# Fill missing binary features with 0"]
[28.908736, "o", "\r\n"]
[28.90875, "o", "\u001b[?2004l\r"]
[28.908786, "o", "\u001b[?2004h"]
[28.908801, "o", "> "]
[28.908874, "o", "for col in bin_features:\r\n\u001b[?2004l\r"]
[28.90889, "o", "\u001b[?2004h"]
[28.908911, "o", "> "]
[28.908993, "o", "    X_train[col] = X_train[col].fillna(0)"]
[28.909011, "o", "\r\n"]
[28.909038, "o", "\u001b[?2004l\r"]
[28.909052, "o", "\u001b[?2004h"]
[28.909081, "o", "> "]
[28.909181, "o", "    X_val[col] = X_val[col].fillna(0)\r\n\u001b[?2004l\r"]
[28.909195, "o", "\u001b[?2004h"]
[28.909228, "o", "> "]
[28.910116, "o", "    X_test[col] = X_test[col].fillna(0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.910357, "o", "# Encode categorical features\r\n\u001b[?2004l\r\u001b[?2004h> label_encoders = {}\r\n\u001b[?2004l\r\u001b[?2004h> for col in cat_features:\r\n\u001b[?2004l\r\u001b[?2004h>     le = LabelEncoder()\r\n\u001b[?2004l\r\u001b[?2004h>     # Fit on combined data to handle all categories\r\n\u001b[?2004l\r\u001b[?2004h>     combined = pd.concat([X_train[col], X_val[col], X_test[col]], axis=0).astype(str)\r\n\u001b[?2004l\r\u001b[?2004h>     le.fit(combined)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.910436, "o", "    X_train[col] = le.transform(X_train[col].astype(str))\r\n\u001b[?2004l\r\u001b[?2004h>     X_val[col] = le.transform(X_val[col].astype(str))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.910477, "o", "    X_test[col] = le.transform(X_test[col].astype(str))"]
[28.910519, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.910608, "o", "    label_encoders[col] = le\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.910648, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[28.910688, "o", "> "]
[28.910771, "o", "# Try using LightGBM\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.910811, "o", "> try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.910852, "o", "    import lightgbm as lgb\r\n\u001b[?2004l\r"]
[28.910891, "o", "\u001b[?2004h> "]
[28.910952, "o", "    print(\"\\nTraining LightGBM...\")"]
[28.910988, "o", "\r\n\u001b[?2004l\r"]
[28.911029, "o", "\u001b[?2004h> "]
[28.911068, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[28.911116, "o", "> "]
[28.911287, "o", "    # Create dataset\r\n\u001b[?2004l\r"]
[28.911352, "o", "\u001b[?2004h> "]
[28.911392, "o", "    train_data = lgb.Dataset(X_train, label=y_train, categorical_feature=cat_features)\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.911434, "o", "> "]
[28.911608, "o", "    val_data = lgb.Dataset(X_val, label=y_val, categorical_feature=cat_features, reference=train_data)\r\n\u001b[?2004l\r"]
[28.911647, "o", "\u001b[?2004h"]
[28.911685, "o", "> "]
[28.911724, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[28.91177, "o", ">     # Parameters"]
[28.911811, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.911849, "o", "> "]
[28.911886, "o", "    params = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.911924, "o", "> "]
[28.911969, "o", "        'objective': 'binary',\r\n\u001b[?2004l\r"]
[28.912005, "o", "\u001b[?2004h"]
[28.912047, "o", "> "]
[28.912083, "o", "        'metric': 'auc',\r\n\u001b[?2004l\r"]
[28.912127, "o", "\u001b[?2004h> "]
[28.912196, "o", "        'boosting_type': 'gbdt',"]
[28.912234, "o", "\r\n"]
[28.912273, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[28.912335, "o", "        'num_leaves': 64,\r\n\u001b[?2004l\r"]
[28.91238, "o", "\u001b[?2004h"]
[28.912422, "o", "> "]
[28.912468, "o", "        'max_depth': 8,\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.912623, "o", "> "]
[28.912674, "o", "        'learning_rate': 0.1,\r\n\u001b[?2004l\r\u001b[?2004h>         'feature_fraction': 0.8,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.912732, "o", "        'bagging_fraction': 0.8,\r\n\u001b[?2004l\r"]
[28.912776, "o", "\u001b[?2004h> "]
[28.912835, "o", "        'bagging_freq': 5,\r\n\u001b[?2004l\r"]
[28.912873, "o", "\u001b[?2004h"]
[28.912917, "o", "> "]
[28.912956, "o", "        'verbose': -1,\r\n\u001b[?2004l\r"]
[28.912994, "o", "\u001b[?2004h> "]
[28.913029, "o", "        'seed': 42\r\n\u001b[?2004l\r"]
[28.913067, "o", "\u001b[?2004h> "]
[28.913106, "o", "    }\r\n\u001b[?2004l\r"]
[28.913198, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.913236, "o", "    # Train\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.913285, "o", "> "]
[28.913337, "o", "    model = lgb.train(\r\n\u001b[?2004l\r"]
[28.913377, "o", "\u001b[?2004h> "]
[28.913415, "o", "        params,\r\n\u001b[?2004l\r"]
[28.913453, "o", "\u001b[?2004h> "]
[28.913487, "o", "        train_data,\r\n\u001b[?2004l\r"]
[28.913508, "o", "\u001b[?2004h"]
[28.91357, "o", "> "]
[28.913937, "o", "        num_boost_round=500,"]
[28.913999, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         valid_sets=[train_data, val_data],\r\n\u001b[?2004l\r\u001b[?2004h>         callbacks=[\r\n\u001b[?2004l\r\u001b[?2004h>             lgb.early_stopping(stopping_rounds=30, verbose=False),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.914052, "o", "            lgb.log_evaluation(period=100)\r\n\u001b[?2004l\r"]
[28.914091, "o", "\u001b[?2004h> "]
[28.91415, "o", "        ]\r\n\u001b[?2004l\r"]
[28.91421, "o", "\u001b[?2004h>     )"]
[28.91425, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n"]
[28.91429, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[28.914352, "o", "    # Validate\r\n\u001b[?2004l\r"]
[28.914391, "o", "\u001b[?2004h> "]
[28.914452, "o", "    val_preds = model.predict(X_val)\r\n\u001b[?2004l\r"]
[28.914489, "o", "\u001b[?2004h"]
[28.91453, "o", "> "]
[28.914578, "o", "    from sklearn.metrics import roc_auc_score"]
[28.914623, "o", "\r\n\u001b[?2004l\r"]
[28.914662, "o", "\u001b[?2004h> "]
[28.91474, "o", "    val_auc = roc_auc_score(y_val, val_preds)\r\n\u001b[?2004l\r"]
[28.914779, "o", "\u001b[?2004h"]
[28.914817, "o", "> "]
[28.914896, "o", "    print(f\"\\nValidation ROC-AUC: {val_auc:.6f}\")\r\n\u001b[?2004l\r"]
[28.914934, "o", "\u001b[?2004h"]
[28.914972, "o", ">     \r\n"]
[28.915012, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[28.915054, "o", "    # Predict on test\r\n\u001b[?2004l\r"]
[28.915094, "o", "\u001b[?2004h"]
[28.915145, "o", "> "]
[28.915186, "o", "    test_preds = model.predict(X_test)"]
[28.915224, "o", "\r\n"]
[28.915262, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[28.915317, "o", "    \r\n\u001b[?2004l\r"]
[28.915362, "o", "\u001b[?2004h> "]
[28.915401, "o", "except ImportError:\r\n\u001b[?2004l\r"]
[28.915448, "o", "\u001b[?2004h> "]
[28.915533, "o", "    print(\"LightGBM not available, using XGBoost...\")\r\n\u001b[?2004l\r"]
[28.915571, "o", "\u001b[?2004h"]
[28.915611, "o", "> "]
[28.915648, "o", "    import xgboost as xgb\r\n\u001b[?2004l\r"]
[28.915686, "o", "\u001b[?2004h"]
[28.915726, "o", ">     \r\n\u001b[?2004l\r"]
[28.915772, "o", "\u001b[?2004h> "]
[28.915854, "o", "    dtrain = xgb.DMatrix(X_train, label=y_train)\r\n\u001b[?2004l\r"]
[28.915892, "o", "\u001b[?2004h> "]
[28.91598, "o", "    dval = xgb.DMatrix(X_val, label=y_val)\r\n\u001b[?2004l\r"]
[28.916018, "o", "\u001b[?2004h> "]
[28.916088, "o", "    dtest = xgb.DMatrix(X_test)\r\n\u001b[?2004l\r"]
[28.916138, "o", "\u001b[?2004h"]
[28.91618, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[28.916234, "o", "> "]
[28.916278, "o", "    params = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.916365, "o", "        'objective': 'binary:logistic',"]
[28.916416, "o", "\r\n\u001b[?2004l\r"]
[28.916459, "o", "\u001b[?2004h> "]
[28.916493, "o", "        'eval_metric': 'auc',\r\n\u001b[?2004l\r"]
[28.916533, "o", "\u001b[?2004h"]
[28.916581, "o", "> "]
[28.91662, "o", "        'max_depth': 8,\r\n\u001b[?2004l\r"]
[28.917192, "o", "\u001b[?2004h> "]
[28.917254, "o", "        'eta': 0.1,\r\n\u001b[?2004l\r\u001b[?2004h>         'subsample': 0.8,\r\n\u001b[?2004l\r\u001b[?2004h>         'colsample_bytree': 0.8,\r\n\u001b[?2004l\r\u001b[?2004h>         'seed': 42,\r\n\u001b[?2004l\r\u001b[?2004h>         'tree_method': 'hist'\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     model = xgb.train(\r\n\u001b[?2004l\r\u001b[?2004h>         params,\r\n\u001b[?2004l\r\u001b[?2004h>         dtrain,\r\n\u001b[?2004l\r"]
[28.917319, "o", "\u001b[?2004h> "]
[28.917365, "o", "        num_boost_round=500,"]
[28.917389, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.91741, "o", "> "]
[28.917519, "o", "        evals=[(dtrain, 'train'), (dval, 'val')],\r\n\u001b[?2004l\r"]
[28.917558, "o", "\u001b[?2004h> "]
[28.917636, "o", "        early_stopping_rounds=30,\r\n\u001b[?2004l\r"]
[28.917675, "o", "\u001b[?2004h"]
[28.917715, "o", "> "]
[28.917749, "o", "        verbose_eval=100\r\n\u001b[?2004l\r"]
[28.917786, "o", "\u001b[?2004h"]
[28.917826, "o", ">     )\r\n\u001b[?2004l\r"]
[28.917872, "o", "\u001b[?2004h>     "]
[28.917911, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.917967, "o", "    val_preds = model.predict(dval)"]
[28.918002, "o", "\r\n\u001b[?2004l\r"]
[28.918035, "o", "\u001b[?2004h> "]
[28.918134, "o", "    from sklearn.metrics import roc_auc_score\r\n\u001b[?2004l\r"]
[28.918179, "o", "\u001b[?2004h"]
[28.918218, "o", "> "]
[28.91829, "o", "    val_auc = roc_auc_score(y_val, val_preds)\r\n\u001b[?2004l\r"]
[28.918344, "o", "\u001b[?2004h"]
[28.918387, "o", "> "]
[28.918431, "o", "    print(f\"\\nValidation ROC-AUC: {val_auc:.6f}\")"]
[28.918473, "o", "\r\n"]
[28.918511, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[28.91855, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[28.918595, "o", "> "]
[28.918644, "o", "    test_preds = model.predict(dtest)\r\n\u001b[?2004l\r"]
[28.918679, "o", "\u001b[?2004h"]
