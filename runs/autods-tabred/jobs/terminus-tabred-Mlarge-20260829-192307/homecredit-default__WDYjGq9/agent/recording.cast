[165.89933, "i", "cat > train_model.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nimport lightgbm as lgb\nfrom sklearn.metrics import roc_auc_score\nimport warnings\nwarnings.filterwarnings('ignore')\n\nprint(\"Loading data...\")\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nprint(f\"Train shape: {train.shape}\")\nprint(f\"Val shape: {val.shape}\")\nprint(f\"Test shape: {test.shape}\")\n\n# Separate features and target\ny_train = train['target']\ny_val = val['target']\nX_train = train.drop('target', axis=1)\nX_val = val.drop('target', axis=1)\nX_test = test.copy()\n\nprint(\"Training LightGBM model...\")\n# Create LightGBM datasets\ntrain_data = lgb.Dataset(X_train, label=y_train)\nval_data = lgb.Dataset(X_val, label=y_val, reference=train_data)\n\n# Parameters\nparams = {\n    'objective': 'binary',\n    'metric': 'auc',\n    'boosting_type': 'gbdt',\n    'num_leaves': 31,\n    'learning_rate': 0.1,\n    'feature_fraction': 0.8,\n    'bagging_fraction': 0.8,\n    'bagging_freq': 5,\n    'verbose': -1,\n    'random_state': 42\n}\n\nmodel = lgb.train(\n    params,\n    train_data,\n    num_boost_round=200,\n    valid_sets=[val_data],\n    callbacks=[lgb.early_stopping(stopping_rounds=20, verbose=False)]\n)\n\nprint(\"Validating...\")\nval_preds = model.predict(X_val)\nval_auc = roc_auc_score(y_val, val_preds)\nprint(f\"Validation ROC-AUC: {val_auc:.4f}\")\n\nprint(\"Generating predictions...\")\ntest_preds = model.predict(X_test)\n\nprint(f\"Predictions shape: {test_preds.shape}\")\nprint(f\"Predictions finite: {np.isfinite(test_preds).all()}\")\nprint(f\"Predictions min/max: {test_preds.min():.4f} / {test_preds.max():.4f}\")\n\n# Save predictions\nresult = pd.DataFrame({'target': test_preds})\nresult.to_csv('/app/predictions.csv', index=False)\nprint(\"Saved predictions to /app/predictions.csv\")\nEOF\n"]
[165.899811, "o", "cat > train_model.py << 'EOF'\r\n\u001b[?2004l\r"]
