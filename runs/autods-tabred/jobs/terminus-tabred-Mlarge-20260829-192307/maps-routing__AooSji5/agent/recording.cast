[29.294215, "i", "cat > train_model.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.ensemble import GradientBoostingRegressor, HistGradientBoostingRegressor\nfrom sklearn.impute import SimpleImputer\nimport warnings\nwarnings.filterwarnings('ignore')\n\nprint(\"Loading data...\")\n# Load data\ndtypes = {f'num_{i}': np.float32 for i in range(986)}\ntrain_df = pd.read_csv('/app/data/train.csv', dtype=dtypes)\nval_df = pd.read_csv('/app/data/val.csv', dtype=dtypes)\ntest_df = pd.read_csv('/app/data/test.csv', dtype=dtypes)\n\nprint(f\"Train shape: {train_df.shape}\")\nprint(f\"Val shape: {val_df.shape}\")\nprint(f\"Test shape: {test_df.shape}\")\n\n# Separate features and target\nfeature_cols = [c for c in train_df.columns if c.startswith('num_')]\nX_train = train_df[feature_cols].values\ny_train = train_df['target'].values\nX_val = val_df[feature_cols].values\ny_val = val_df['target'].values\nX_test = test_df[feature_cols].values\n\nprint(f\"X_train shape: {X_train.shape}\")\nprint(f\"Missing values in train: {np.isnan(X_train).sum()}\")\n\n# Impute missing values with median\nprint(\"Imputing missing values...\")\nimputer = SimpleImputer(strategy='median')\nX_train_imputed = imputer.fit_transform(X_train)\nX_val_imputed = imputer.transform(X_val)\nX_test_imputed = imputer.transform(X_test)\n\nprint(f\"Missing values after imputation: {np.isnan(X_train_imputed).sum()}\")\n\n# Train model\nprint(\"Training model...\")\nmodel = HistGradientBoostingRegressor(\n    max_iter=200,\n    learning_rate=0.1,\n    max_depth=8,\n    random_state=42\n)\nmodel.fit(X_train_imputed, y_train)\n\n# Evaluate on validation set\nval_pred = model.predict(X_val_imputed)\nval_rmse = np.sqrt(np.mean((val_pred - y_val)**2))\nprint(f\"Validation RMSE: {val_rmse:.6f}\")\n\n# Predict on test set\nprint(\"Making predictions...\")\ntest_pred = model.predict(X_test_imputed)\n\n# Save predictions\nresult_df = pd.DataFrame({'target': test_pred})\nresult_df.to_csv('/app/predictions.csv', index=False)\nprint(f\"Saved {len(result_df)} predictions to /app/predictions.csv\")\nprint(f\"Prediction stats: min={test_pred.min():.6f}, max={tes"]
