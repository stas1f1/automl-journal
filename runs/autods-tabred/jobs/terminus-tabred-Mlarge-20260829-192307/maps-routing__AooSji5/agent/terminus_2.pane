[?2004hroot@4f6bff4a35ac:/workspace# wc -l /app/data/*.csv
[?2004l     59952 /app/data/test.csv
    160020 /app/data/train.csv
     59976 /app/data/val.csv
    279948 total
[?2004hroot@4f6bff4a35ac:/workspace# cat > train_model.py << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from sklearn.ensemble import GradientBoostingRegressor, HistGradientBoostingRegressor
[?2004l[?2004h> from sklearn.impute import SimpleImputer
[?2004l[?2004h> import warnings
[?2004l[?2004h> warnings.filterwarnings('ignore')
[?2004l[?2004h> 
[?2004l[?2004h> print("Loading data...")
[?2004l[?2004h> # Load data
[?2004l[?2004h> dtypes = {f'num_{i}': np.float32 for i in range(986)}
[?2004l[?2004h> train_df = pd.read_csv('/app/data/train.csv', dtype=dtypes)
[?2004l[?2004h> val_df = pd.read_csv('/app/data/val.csv', dtype=dtypes)
[?2004l[?2004h> test_df = pd.read_csv('/app/data/test.csv', dtype=dtypes)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Train shape: {train_df.shape}")
[?2004l[?2004h> print(f"Val shape: {val_df.shape}")
[?2004l[?2004h> print(f"Test shape: {test_df.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Separate features and target
[?2004l[?2004h> feature_cols = [c for c in train_df.columns if c.startswith('num_')]
[?2004l[?2004h> X_train = train_df[feature_cols].values
[?2004l[?2004h> y_train = train_df['target'].values
[?2004l[?2004h> X_val = val_df[feature_cols].values
[?2004l[?2004h> y_val = val_df['target'].values
[?2004l[?2004h> X_test = test_df[feature_cols].values
[?2004l[?2004h> 
[?2004l[?2004h> print(f"X_train shape: {X_train.shape}")
[?2004l[?2004h> print(f"Missing values in train: {np.isnan(X_train).sum()}")
[?2004l[?2004h> 
[?2004l[?2004h> # Impute missing values with median
[?2004l[?2004h> print("Imputing missing values...")
[?2004l[?2004h> imputer = SimpleImputer(strategy='median')
[?2004l[?2004h> X_train_imputed = imputer.fit_transform(X_train)
[?2004l[?2004h> X_val_imputed = imputer.transform(X_val)
[?2004l[?2004h> X_test_imputed = imputer.transform(X_test)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Missing values after imputation: {np.isnan(X_train_imputed).sum()}")
[?2004l[?2004h> 
[?2004l[?2004h> # Train model
[?2004l[?2004h> print("Training model...")
[?2004l[?2004h> model = HistGradientBoostingRegressor(
[?2004l[?2004h>     max_iter=200,
[?2004l[?2004h>     learning_rate=0.1,
[?2004l[?2004h>     max_depth=8,
[?2004l[?2004h>     random_state=42
[?2004l[?2004h> )
[?2004l[?2004h> model.fit(X_train_imputed, y_train)
[?2004l[?2004h> 
[?2004l[?2004h> # Evaluate on validation set
[?2004l[?2004h> val_pred = model.predict(X_val_imputed)
[?2004l[?2004h> val_rmse = np.sqrt(np.mean((val_pred - y_val)**2))
[?2004l[?2004h> print(f"Validation RMSE: {val_rmse:.6f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Predict on test set
[?2004l[?2004h> print("Making predictions...")
[?2004l[?2004h> test_pred = model.predict(X_test_imputed)
[?2004l[?2004h> 
[?2004l[?2004h> # Save predictions
[?2004l[?2004h> result_df = pd.DataFrame({'target': test_pred})
[?2004l[?2004h> result_df.to_csv('/app/predictions.csv', index=False)
