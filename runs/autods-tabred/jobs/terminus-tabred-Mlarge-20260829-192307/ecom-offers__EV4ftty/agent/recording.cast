[1217.469096, "i", "cat > train_model10.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom catboost import CatBoostClassifier\nfrom sklearn.metrics import roc_auc_score\n\nprint(\"Loading data...\")\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nX_train = train.drop('target', axis=1)\ny_train = train['target']\nX_val = val.drop('target', axis=1)\ny_val = val['target']\nX_test = test.copy()\n\nfor col in X_train.columns:\n    if X_train[col].isna().any():\n        median_val = X_train[col].median()\n        X_train[col].fillna(median_val, inplace=True)\n        X_val[col].fillna(median_val, inplace=True)\n        X_test[col].fillna(median_val, inplace=True)\n\n# Variations around best config (iter=800, depth=6, l2=5, colsample=0.8)\nparams_list = [\n    {'iterations': 800, 'learning_rate': 0.025, 'depth': 6, 'l2_leaf_reg': 5, 'random_state': 42, 'verbose': False, 'colsample_bylevel': 0.8},\n    {'iterations': 800, 'learning_rate': 0.028, 'depth': 6, 'l2_leaf_reg': 5, 'random_state': 42, 'verbose': False, 'colsample_bylevel': 0.8},\n    {'iterations': 800, 'learning_rate': 0.032, 'depth': 6, 'l2_leaf_reg': 5, 'random_state': 42, 'verbose': False, 'colsample_bylevel': 0.8},\n    {'iterations': 800, 'learning_rate': 0.035, 'depth': 6, 'l2_leaf_reg': 5, 'random_state': 42, 'verbose': False, 'colsample_bylevel': 0.8},\n    {'iterations': 800, 'learning_rate': 0.03, 'depth': 5, 'l2_leaf_reg': 5, 'random_state': 42, 'verbose': False, 'colsample_bylevel': 0.8},\n    {'iterations': 800, 'learning_rate': 0.03, 'depth': 7, 'l2_leaf_reg': 5, 'random_state': 42, 'verbose': False, 'colsample_bylevel': 0.8},\n    {'iterations': 900, 'learning_rate': 0.03, 'depth': 6, 'l2_leaf_reg': 5, 'random_state': 42, 'verbose': False, 'colsample_bylevel': 0.8},\n    {'iterations': 700, 'learning_rate': 0.03, 'depth': 6, 'l2_leaf_reg': 5, 'random_state': 42, 'verbose': False, 'colsample_bylevel': 0.8},\n    {'iterations': 800, 'learning_rate': 0.03, 'depth': 6, 'l2_leaf_reg': 5, 'random_state': 42, 'verbose':"]
