[267.164279, "i", "cat > train_model3.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom lightgbm import LGBMClassifier\nfrom xgboost import XGBClassifier\nfrom catboost import CatBoostClassifier\nfrom sklearn.metrics import roc_auc_score\n\n# Load data\nprint(\"Loading data...\")\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\n# Separate features and target\nX_train = train.drop('target', axis=1)\ny_train = train['target']\nX_val = val.drop('target', axis=1)\ny_val = val['target']\nX_test = test.copy()\n\n# Handle missing values\nfor col in X_train.columns:\n    if X_train[col].isna().any():\n        median_val = X_train[col].median()\n        X_train[col].fillna(median_val, inplace=True)\n        X_val[col].fillna(median_val, inplace=True)\n        X_test[col].fillna(median_val, inplace=True)\n\n# Train LightGBM (original config that worked better)\nprint(\"\\nTraining LightGBM...\")\nlgb = LGBMClassifier(n_estimators=500, learning_rate=0.05, max_depth=8, \n                     num_leaves=64, random_state=42, n_jobs=-1, verbose=-1)\nlgb.fit(X_train, y_train)\nlgb_pred = lgb.predict_proba(X_val)[:, 1]\nlgb_auc = roc_auc_score(y_val, lgb_pred)\nprint(f\"LightGBM ROC-AUC: {lgb_auc:.6f}\")\n\n# Train XGBoost\nprint(\"\\nTraining XGBoost...\")\nxgb = XGBClassifier(n_estimators=500, learning_rate=0.05, max_depth=8,\n                    random_state=42, n_jobs=-1, eval_metric='auc')\nxgb.fit(X_train, y_train)\nxgb_pred = xgb.predict_proba(X_val)[:, 1]\nxgb_auc = roc_auc_score(y_val, xgb_pred)\nprint(f\"XGBoost ROC-AUC: {xgb_auc:.6f}\")\n\n# Train CatBoost\nprint(\"\\nTraining CatBoost...\")\ncat = CatBoostClassifier(iterations=500, learning_rate=0.05, depth=8,\n                         random_state=42, verbose=False)\ncat.fit(X_train, y_train)\ncat_pred = cat.predict_proba(X_val)[:, 1]\ncat_auc = roc_auc_score(y_val, cat_pred)\nprint(f\"CatBoost ROC-AUC: {cat_auc:.6f}\")\n\n# Ensemble - average of best models\nprint(\"\\nCreating ensemble...\")\nval_ensemble = (lgb_pred + xgb_pred + cat_pred) / 3\nensemble_auc = roc_auc_score(y_val, val_ensemble)\nprint(f\"Ensemble ROC-AUC: {ensemble_auc:.6f}\")\n\n# Use best model for final predictions\nif lgb_auc >= xgb_auc and lgb_auc >= cat_auc and lgb_auc >= ensemble_auc:\n    print(\"Using LightGBM for final predictions\")\n    final_pred = lgb.predict_proba(X_test)[:, 1]\nelif xgb_auc >= lgb_auc and xgb_auc >= cat_auc and xgb_auc >= ensemble_auc:\n    print(\"Using XGBoost for final predictions\")\n    final_pred = xgb.predict_proba(X_test)[:, 1]\nelif cat_auc >= lgb_auc and cat_auc >= xgb_auc and cat_auc >= ensemble_auc:\n    print(\"Using CatBoost for final predictions\")\n    final_pred = cat.predict_proba(X_test)[:, 1]\nelse:\n    print(\"Using Ensemble for final predictions\")\n    final_pred = (lgb.predict_proba(X_test)[:, 1] + \n                  xgb.predict_proba(X_test)[:, 1] + \n                  cat.predict_proba(X_test)[:, 1]) / 3\n\n# Save predictions\npredictions = pd.DataFrame({'target': final_pred})\npredictions.to_csv('/app/predictions.csv', index=False)\nprint(f\"Predictions saved. All finite: {np.all(np.isfinite(final_pred))}\")\nEOF\n"]
[267.165727, "o", "cat > train_model3.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from lightgbm import LGBMClassifier\r\n\u001b[?2004l\r\u001b[?2004h> from xgboost import XGBClassifier\r\n\u001b[?2004l\r\u001b[?2004h> from catboost import CatBoostClassifier\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.metrics import roc_auc_score\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Load data\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Loading data...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
