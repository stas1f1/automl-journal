[820.608393, "i", "cat > train_model7.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom catboost import CatBoostClassifier, Pool\nfrom lightgbm import LGBMClassifier\nfrom xgboost import XGBClassifier\nfrom sklearn.metrics import roc_auc_score\nfrom sklearn.ensemble import VotingClassifier\n\nprint(\"Loading data...\")\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nX_train = train.drop('target', axis=1)\ny_train = train['target']\nX_val = val.drop('target', axis=1)\ny_val = val['target']\nX_test = test.copy()\n\nfor col in X_train.columns:\n    if X_train[col].isna().any():\n        median_val = X_train[col].median()\n        X_train[col].fillna(median_val, inplace=True)\n        X_val[col].fillna(median_val, inplace=True)\n        X_test[col].fillna(median_val, inplace=True)\n\n# Train best CatBoost\nprint(\"\\nTraining best CatBoost...\")\ncat_best = CatBoostClassifier(iterations=1500, learning_rate=0.025, depth=6, \n                               l2_leaf_reg=5, random_state=42, verbose=False)\ncat_best.fit(X_train, y_train)\ncat_pred = cat_best.predict_proba(X_val)[:, 1]\ncat_auc = roc_auc_score(y_val, cat_pred)\nprint(f\"CatBoost ROC-AUC: {cat_auc:.6f}\")\n\n# Train LightGBM with tuned params\nprint(\"\\nTraining LightGBM...\")\nlgb = LGBMClassifier(n_estimators=800, learning_rate=0.03, max_depth=6, \n                     num_leaves=64, reg_lambda=5, random_state=42, n_jobs=-1, verbose=-1)\nlgb.fit(X_train, y_train)\nlgb_pred = lgb.predict_proba(X_val)[:, 1]\nlgb_auc = roc_auc_score(y_val, lgb_pred)\nprint(f\"LightGBM ROC-AUC: {lgb_auc:.6f}\")\n\n# Train XGBoost with similar params\nprint(\"\\nTraining XGBoost...\")\nxgb = XGBClassifier(n_estimators=1000, learning_rate=0.03, max_depth=6,\n                    reg_lambda=5, random_state=42, n_jobs=-1, eval_metric='auc')\nxgb.fit(X_train, y_train)\nxgb_pred = xgb.predict_proba(X_val)[:, 1]\nxgb_auc = roc_auc_score(y_val, xgb_pred)\nprint(f\"XGBoost ROC-AUC: {xgb_auc:.6f}\")\n\n# Weighted ensemble\nval_ensemble = (cat_pred + lgb_pred + xgb_pred) / 3\nensemble_auc "]
[820.609715, "o", "cat > train_model7.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h"]
[820.609798, "i", "= roc_auc_score(y_val, val_ensemble)\nprint(f\"\\nEnsemble ROC-AUC: {ensemble_auc:.6f}\")\n\n# Use best for predictions\nbest_auc = max(cat_auc, lgb_auc, xgb_auc, ensemble_auc)\nprint(f\"\\nBest ROC-AUC: {best_auc:.6f}\")\n\nif ensemble_auc >= best_auc:\n    print(\"Using ensemble\")\n    test_pred = (cat_best.predict_proba(X_test)[:, 1] + \n                 lgb.predict_proba(X_test)[:, 1] + \n                 xgb.predict_proba(X_test)[:, 1]) / 3\nelif cat_auc >= lgb_auc and cat_auc >= xgb_auc:\n    print(\"Using CatBoost\")\n    test_pred = cat_best.predict_proba(X_test)[:, 1]\nelif lgb_auc >= cat_auc and lgb_auc >= xgb_auc:\n    print(\"Using LightGBM\")\n    test_pred = lgb.predict_proba(X_test)[:, 1]\nelse:\n    print(\"Using XGBoost\")\n    test_pred = xgb.predict_proba(X_test)[:, 1]\n\npredictions = pd.DataFrame({'target': test_pred})\npredictions.to_csv('/app/predictions.csv', index=False)\nprint(f\"Predictions saved. All finite: {np.all(np.isfinite(test_pred))}\")\nEOF\n"]
