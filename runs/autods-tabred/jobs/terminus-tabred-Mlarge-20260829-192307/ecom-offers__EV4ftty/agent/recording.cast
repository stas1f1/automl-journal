[46.264734, "i", "cat > train_model.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom lightgbm import LGBMClassifier\nfrom sklearn.metrics import roc_auc_score\n\n# Load data\nprint(\"Loading data...\")\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nprint(f\"Train shape: {train.shape}\")\nprint(f\"Val shape: {val.shape}\")\nprint(f\"Test shape: {test.shape}\")\n\n# Separate features and target\nX_train = train.drop('target', axis=1)\ny_train = train['target']\nX_val = val.drop('target', axis=1)\ny_val = val['target']\nX_test = test.copy()\n\nprint(f\"\\nTarget distribution in train: {y_train.value_counts().to_dict()}\")\nprint(f\"Target distribution in val: {y_val.value_counts().to_dict()}\")\n\n# Handle missing values - fill with median for numerical\nprint(\"\\nHandling missing values...\")\nfor col in X_train.columns:\n    if X_train[col].isna().any():\n        median_val = X_train[col].median()\n        X_train[col].fillna(median_val, inplace=True)\n        X_val[col].fillna(median_val, inplace=True)\n        X_test[col].fillna(median_val, inplace=True)\n\n# Train LightGBM model\nprint(\"\\nTraining LightGBM model...\")\nmodel = LGBMClassifier(\n    n_estimators=500,\n    learning_rate=0.05,\n    max_depth=8,\n    num_leaves=64,\n    random_state=42,\n    n_jobs=-1,\n    verbose=-1\n)\n\nmodel.fit(X_train, y_train)\n\n# Validate\nval_pred = model.predict_proba(X_val)[:, 1]\nval_auc = roc_auc_score(y_val, val_pred)\nprint(f\"\\nValidation ROC-AUC: {val_auc:.6f}\")\n\n# Generate test predictions\nprint(\"\\nGenerating test predictions...\")\ntest_pred = model.predict_proba(X_test)[:, 1]\n\n# Save predictions\npredictions = pd.DataFrame({'target': test_pred})\npredictions.to_csv('/app/predictions.csv', index=False)\nprint(f\"\\nPredictions saved to /app/predictions.csv\")\nprint(f\"Number of predictions: {len(predictions)}\")\nprint(f\"All finite: {np.all(np.isfinite(test_pred))}\")\nEOF\n"]
