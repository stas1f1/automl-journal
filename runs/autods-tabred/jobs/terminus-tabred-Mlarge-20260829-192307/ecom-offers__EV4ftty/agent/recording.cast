[558.469615, "i", "cat > train_model5.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom catboost import CatBoostClassifier\nfrom sklearn.metrics import roc_auc_score\n\n# Load data\nprint(\"Loading data...\")\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nX_train = train.drop('target', axis=1)\ny_train = train['target']\nX_val = val.drop('target', axis=1)\ny_val = val['target']\nX_test = test.copy()\n\n# Handle missing values\nfor col in X_train.columns:\n    if X_train[col].isna().any():\n        median_val = X_train[col].median()\n        X_train[col].fillna(median_val, inplace=True)\n        X_val[col].fillna(median_val, inplace=True)\n        X_test[col].fillna(median_val, inplace=True)\n\n# Fine-tune around best config (depth=6, lr=0.03, iter=800)\nparams_list = [\n    {'iterations': 800, 'learning_rate': 0.03, 'depth': 5, 'random_state': 42, 'verbose': False},\n    {'iterations': 800, 'learning_rate': 0.03, 'depth': 6, 'random_state': 42, 'verbose': False},\n    {'iterations': 800, 'learning_rate': 0.03, 'depth': 7, 'random_state': 42, 'verbose': False},\n    {'iterations': 1000, 'learning_rate': 0.025, 'depth': 6, 'random_state': 42, 'verbose': False},\n    {'iterations': 1200, 'learning_rate': 0.02, 'depth': 6, 'random_state': 42, 'verbose': False},\n    {'iterations': 800, 'learning_rate': 0.04, 'depth': 6, 'random_state': 42, 'verbose': False},\n    {'iterations': 800, 'learning_rate': 0.03, 'depth': 6, 'l2_leaf_reg': 1, 'random_state': 42, 'verbose': False},\n    {'iterations': 800, 'learning_rate': 0.03, 'depth': 6, 'l2_leaf_reg': 5, 'random_state': 42, 'verbose': False},\n    {'iterations': 800, 'learning_rate': 0.03, 'depth': 6, 'bagging_temperature': 0.5, 'random_state': 42, 'verbose': False},\n]\n\nbest_model = None\nbest_score = 0\nbest_params = None\n\nfor i, params in enumerate(params_list):\n    print(f\"\\nModel {i+1}: {params}\")\n    model = CatBoostClassifier(**params)\n    model.fit(X_train, y_train)\n    val_pred = model.predict_proba(X_val)[:, 1]\n    val_auc = roc_auc_score(y_val, val_pred)\n    print(f\"ROC-AUC: {val_auc:.6f}\")\n    if val_auc > best_score:\n        best_score = val_auc\n        best_model = model\n        best_params = params\n\nprint(f\"\\nBest ROC-AUC: {best_score:.6f}\")\nprint(f\"Best params: {best_params}\")\n\ntest_pred = best_model.predict_proba(X_test)[:, 1]\npredictions = pd.DataFrame({'target': test_pred})\npredictions.to_csv('/app/predictions.csv', index=False)\nprint(f\"Predictions saved. All finite: {np.all(np.isfinite(test_pred))}\")\nEOF\n"]
[558.47002, "o", "cat > train_model5.py << 'EOF'\r\n"]
