[1785.105465, "i", "cat > train_model14.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom catboost import CatBoostClassifier\nfrom sklearn.metrics import roc_auc_score\n\nprint(\"Loading data...\")\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nX_train = train.drop('target', axis=1)\ny_train = train['target']\nX_val = val.drop('target', axis=1)\ny_val = val['target']\nX_test = test.copy()\n\n# Handle missing values\nfor col in X_train.columns:\n    if X_train[col].isna().any():\n        median_val = X_train[col].median()\n        X_train[col].fillna(median_val, inplace=True)\n        X_val[col].fillna(median_val, inplace=True)\n        X_test[col].fillna(median_val, inplace=True)\n\n# Train best single model on train only\nprint(\"\\nTraining best model on train only...\")\nmodel_train = CatBoostClassifier(iterations=850, learning_rate=0.03, depth=6,\n                                  l2_leaf_reg=5, colsample_bylevel=0.8,\n                                  random_state=42, verbose=False)\nmodel_train.fit(X_train, y_train)\nval_pred_train = model_train.predict_proba(X_val)[:, 1]\nval_auc_train = roc_auc_score(y_val, val_pred_train)\nprint(f\"Val ROC-AUC (train only): {val_auc_train:.6f}\")\n\n# Train best model on combined train+val\nprint(\"\\nTraining best model on train+val...\")\nX_combined = pd.concat([X_train, X_val], ignore_index=True)\ny_combined = pd.concat([y_train, y_val], ignore_index=True)\nmodel_combined = CatBoostClassifier(iterations=850, learning_rate=0.03, depth=6,\n                                     l2_leaf_reg=5, colsample_bylevel=0.8,\n                                     random_state=42, verbose=False)\nmodel_combined.fit(X_combined, y_combined)\ntest_pred_combined = model_combined.predict_proba(X_test)[:, 1]\nprint(f\"Combined training complete\")\n\n# Try with more iterations for combined training\nprint(\"\\nTraining with 1000 iterations on train+val...\")\nmodel_combined2 = CatBoostClassifier(iterations=1000, learning_rate=0.03, depth=6,\n                                      l2_leaf_reg=5, colsample_bylevel=0.8,\n                                      random_state=42, verbose=False)\nmodel_combined2.fit(X_combined, y_combined)\ntest_pred_combined2 = model_combined2.predict_proba(X_test)[:, 1]\nprint(f\"Combined training complete (1000 iter)\")\n\n# Use the train-only model predictions (best validated)\ntest_pred_best = model_train.predict_proba(X_test)[:, 1]\npredictions = pd.DataFrame({'target': test_pred_best})\npredictions.to_csv('/app/predictions.csv', index=False)\nprint(f\"\\nPredictions saved from best validated model.\")\nprint(f\"Val ROC-AUC: {val_auc_train:.6f}\")\nprint(f\"All finite: {np.all(np.isfinite(test_pred_best))}\")\nEOF\n"]
