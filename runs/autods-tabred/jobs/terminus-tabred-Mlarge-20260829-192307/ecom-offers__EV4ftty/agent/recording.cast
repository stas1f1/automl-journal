[147.925253, "i", "cat > train_model2.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom lightgbm import LGBMClassifier\nfrom sklearn.metrics import roc_auc_score\nfrom sklearn.model_selection import cross_val_score\n\n# Load data\nprint(\"Loading data...\")\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\n# Separate features and target\nX_train = train.drop('target', axis=1)\ny_train = train['target']\nX_val = val.drop('target', axis=1)\ny_val = val['target']\nX_test = test.copy()\n\nprint(f\"Train shape: {X_train.shape}\")\nprint(f\"Target distribution: Class 0: {(y_train==0).sum()}, Class 1: {(y_train==1).sum()}\")\n\n# Handle missing values - fill with median\nprint(\"Handling missing values...\")\nfor col in X_train.columns:\n    if X_train[col].isna().any():\n        median_val = X_train[col].median()\n        X_train[col].fillna(median_val, inplace=True)\n        X_val[col].fillna(median_val, inplace=True)\n        X_test[col].fillna(median_val, inplace=True)\n\n# Calculate class weight for imbalance\nclass_0 = (y_train == 0).sum()\nclass_1 = (y_train == 1).sum()\nscale_pos_weight = class_0 / class_1\nprint(f\"Scale pos weight: {scale_pos_weight:.4f}\")\n\n# Try multiple models with different parameters\nparams_list = [\n    {'n_estimators': 300, 'learning_rate': 0.1, 'max_depth': 10, 'num_leaves': 128, \n     'scale_pos_weight': scale_pos_weight, 'random_state': 42, 'n_jobs': -1, 'verbose': -1},\n    {'n_estimators': 500, 'learning_rate': 0.05, 'max_depth': 12, 'num_leaves': 256, \n     'scale_pos_weight': scale_pos_weight, 'random_state': 42, 'n_jobs': -1, 'verbose': -1,\n     'feature_fraction': 0.8, 'bagging_fraction': 0.8},\n    {'n_estimators': 800, 'learning_rate': 0.03, 'max_depth': 15, 'num_leaves': 512, \n     'scale_pos_weight': scale_pos_weight, 'random_state': 42, 'n_jobs': -1, 'verbose': -1,\n     'feature_fraction': 0.7, 'bagging_fraction': 0.7, 'reg_alpha': 0.1, 'reg_lambda': 0.1},\n]\n\nbest_model = None\nbest_score = 0\nbest_params = None\n\nfor i, params in enumerate(params_list):\n    print(f\"\\nTraining model {i+1}...\")\n    model = LGBMClassifier(**params)\n    model.fit(X_train, y_train)\n    val_pred = model.predict_proba(X_val)[:, 1]\n    val_auc = roc_auc_score(y_val, val_pred)\n    print(f\"Model {i+1} ROC-AUC: {val_auc:.6f}\")\n    if val_auc > best_score:\n        best_score = val_auc\n        best_model = model\n        best_params = params\n\nprint(f\"\\nBest model ROC-AUC: {best_score:.6f}\")\n\n# Generate test predictions with best model\nprint(\"Generating test predictions...\")\ntest_pred = best_model.predict_proba(X_test)[:, 1]\n\n# Save predictions\npredictions = pd.DataFrame({'target': test_pred})\npredictions.to_csv('/app/predictions.csv', index=False)\nprint(f\"Predictions saved to /app/predictions.csv\")\nprint(f\"All finite: {np.all(np.isfinite(test_pred))}\")\nEOF\n"]
