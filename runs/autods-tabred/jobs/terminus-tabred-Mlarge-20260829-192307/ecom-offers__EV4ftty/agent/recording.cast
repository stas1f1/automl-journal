[267.168926, "o", "xgb = XGBClassifier(n_estimators=500, learning_rate=0.05, max_depth=8,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.169067, "o", "                    random_state=42, n_jobs=-1, eval_metric='auc')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.169159, "o", "xgb.fit(X_train, y_train)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.169271, "o", "xgb_pred = xgb.predict_proba(X_val)[:, 1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.169369, "o", "xgb_auc = roc_auc_score(y_val, xgb_pred)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.169455, "o", "print(f\"XGBoost ROC-AUC: {xgb_auc:.6f}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.169541, "o", "# Train CatBoost\r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.169601, "o", "print(\"\\nTraining CatBoost...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.169718, "o", "cat = CatBoostClassifier(iterations=500, learning_rate=0.05, depth=8,\r\n\u001b[?2004l\r\u001b[?2004h"]
[267.169758, "o", "> "]
[267.169858, "o", "                         random_state=42, verbose=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[267.169939, "o", "> "]
[267.170001, "o", "cat.fit(X_train, y_train)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.170076, "o", "cat_pred = cat.predict_proba(X_val)[:, 1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.170156, "o", "cat_auc = roc_auc_score(y_val, cat_pred)\r\n\u001b[?2004l\r"]
[267.17022, "o", "\u001b[?2004h> "]
[267.170265, "o", "print(f\"CatBoost ROC-AUC: {cat_auc:.6f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[267.170361, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.170434, "o", "# Ensemble - average of best models\r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.170494, "o", "print(\"\\nCreating ensemble...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.170597, "o", "val_ensemble = (lgb_pred + xgb_pred + cat_pred) / 3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.170709, "o", "ensemble_auc = roc_auc_score(y_val, val_ensemble)\r\n\u001b[?2004l\r\u001b[?2004h"]
[267.170772, "o", "> "]
[267.170849, "o", "print(f\"Ensemble ROC-AUC: {ensemble_auc:.6f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[267.170896, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.170991, "o", "# Use best model for final predictions\r\n\u001b[?2004l\r"]
[267.171057, "o", "\u001b[?2004h> "]
[267.17116, "o", "if lgb_auc >= xgb_auc and lgb_auc >= cat_auc and lgb_auc >= ensemble_auc:\r\n\u001b[?2004l\r\u001b[?2004h"]
[267.171238, "o", "> "]
[267.171301, "o", "    print(\"Using LightGBM for final predictions\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.171399, "o", "    final_pred = lgb.predict_proba(X_test)[:, 1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[267.171463, "o", "> "]
[267.171576, "o", "elif xgb_auc >= lgb_auc and xgb_auc >= cat_auc and xgb_auc >= ensemble_auc:\r\n\u001b[?2004l\r\u001b[?2004h"]
[267.17164, "o", "> "]
[267.171703, "o", "    print(\"Using XGBoost for final predictions\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.171798, "o", "    final_pred = xgb.predict_proba(X_test)[:, 1]\r\n\u001b[?2004l\r"]
[267.171852, "o", "\u001b[?2004h> "]
[267.171989, "o", "elif cat_auc >= lgb_auc and cat_auc >= xgb_auc and cat_auc >= ensemble_auc:\r\n\u001b[?2004l\r\u001b[?2004h"]
[267.172064, "o", "> "]
[267.172124, "o", "    print(\"Using CatBoost for final predictions\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.172222, "o", "    final_pred = cat.predict_proba(X_test)[:, 1]\r\n\u001b[?2004l\r"]
[267.172291, "o", "\u001b[?2004h> else:\r\n\u001b[?2004l\r"]
[267.172361, "o", "\u001b[?2004h> "]
[267.172597, "o", "    print(\"Using Ensemble for final predictions\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.172666, "o", "    final_pred = (lgb.predict_proba(X_test)[:, 1] + \r\n\u001b[?2004l\r\u001b[?2004h>                   xgb.predict_proba(X_test)[:, 1] + \r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.172758, "o", "                  cat.predict_proba(X_test)[:, 1]) / 3\r\n\u001b[?2004l\r"]
[267.172837, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.172906, "o", "# Save predictions\r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.172984, "o", "predictions = pd.DataFrame({'target': final_pred})\r\n\u001b[?2004l\r"]
[267.173058, "o", "\u001b[?2004h> "]
[267.173119, "o", "predictions.to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[267.173191, "o", "> "]
[267.173294, "o", "print(f\"Predictions saved. All finite: {np.all(np.isfinite(final_pred))}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
