[267.167849, "o", "# Train LightGBM (original config that worked better)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nTraining LightGBM...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.168012, "o", "lgb = LGBMClassifier(n_estimators=500, learning_rate=0.05, max_depth=8, \r\n\u001b[?2004l\r\u001b[?2004h> "]
