[1701.9357, "i", "cat > train_model13.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom catboost import CatBoostClassifier\nfrom sklearn.metrics import roc_auc_score\n\nprint(\"Loading data...\")\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nX_train = train.drop('target', axis=1)\ny_train = train['target']\nX_val = val.drop('target', axis=1)\ny_val = val['target']\nX_test = test.copy()\n\nfor col in X_train.columns:\n    if X_train[col].isna().any():\n        median_val = X_train[col].median()\n        X_train[col].fillna(median_val, inplace=True)\n        X_val[col].fillna(median_val, inplace=True)\n        X_test[col].fillna(median_val, inplace=True)\n\n# Best config: iter=850, lr=0.03, depth=6, l2=5, colsample=0.8\n# Train multiple models with different seeds and ensemble\nseeds = [42, 123, 456, 789, 999]\npredictions_list = []\nval_scores = []\n\nfor seed in seeds:\n    print(f\"\\nTraining model with seed {seed}...\")\n    model = CatBoostClassifier(iterations=850, learning_rate=0.03, depth=6, \n                                l2_leaf_reg=5, colsample_bylevel=0.8,\n                                random_state=seed, verbose=False)\n    model.fit(X_train, y_train)\n    val_pred = model.predict_proba(X_val)[:, 1]\n    val_auc = roc_auc_score(y_val, val_pred)\n    val_scores.append(val_auc)\n    print(f\"ROC-AUC: {val_auc:.6f}\")\n    predictions_list.append(model.predict_proba(X_test)[:, 1])\n\n# Ensemble prediction\nensemble_pred = np.mean(predictions_list, axis=0)\nprint(f\"\\nMean val ROC-AUC: {np.mean(val_scores):.6f}\")\nprint(f\"Std val ROC-AUC: {np.std(val_scores):.6f}\")\n\n# Save predictions\npredictions = pd.DataFrame({'target': ensemble_pred})\npredictions.to_csv('/app/predictions.csv', index=False)\nprint(f\"Predictions saved. All finite: {np.all(np.isfinite(ensemble_pred))}\")\nEOF\n"]
