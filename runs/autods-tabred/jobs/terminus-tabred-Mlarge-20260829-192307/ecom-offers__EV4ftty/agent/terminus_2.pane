[?2004l[?2004h> y_combined = pd.concat([y_train, y_val], ignore_index=True)
[?2004l[?2004h> model_combined = CatBoostClassifier(iterations=850, learning_rate=0.03, depth=6,
[?2004l[?2004h>                                      l2_leaf_reg=5, colsample_bylevel=0.8,
[?2004l[?2004h>                                      random_state=42, verbose=False)
[?2004l[?2004h> model_combined.fit(X_combined, y_combined)
