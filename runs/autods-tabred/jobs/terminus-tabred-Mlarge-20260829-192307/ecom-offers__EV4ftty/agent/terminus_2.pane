[?2004hroot@1fe042ee5392:/workspace# cat > train_model.py << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from lightgbm import LGBMClassifier
[?2004l[?2004h> from sklearn.metrics import roc_auc_score
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> print("Loading data...")
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Train shape: {train.shape}")
[?2004l[?2004h> print(f"Val shape: {val.shape}")
[?2004l[?2004h> print(f"Test shape: {test.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Separate features and target
[?2004l[?2004h> X_train = train.drop('target', axis=1)
[?2004l[?2004h> y_train = train['target']
[?2004l[?2004h> X_val = val.drop('target', axis=1)
[?2004l[?2004h> y_val = val['target']
[?2004l[?2004h> X_test = test.copy()
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nTarget distribution in train: {y_train.value_counts().to_dict()}")
[?2004l[?2004h> print(f"Target distribution in val: {y_val.value_counts().to_dict()}")
[?2004l[?2004h> 
[?2004l[?2004h> # Handle missing values - fill with median for numerical
[?2004l[?2004h> print("\nHandling missing values...")
[?2004l[?2004h> for col in X_train.columns:
[?2004l[?2004h>     if X_train[col].isna().any():
[?2004l[?2004h>         median_val = X_train[col].median()
[?2004l[?2004h>         X_train[col].fillna(median_val, inplace=True)
[?2004l[?2004h>         X_val[col].fillna(median_val, inplace=True)
[?2004l[?2004h>         X_test[col].fillna(median_val, inplace=True)
[?2004l[?2004h> 
[?2004l[?2004h> # Train LightGBM model
[?2004l[?2004h> print("\nTraining LightGBM model...")
[?2004l[?2004h> model = LGBMClassifier(
[?2004l[?2004h>     n_estimators=500,
[?2004l[?2004h>     learning_rate=0.05,
[?2004l[?2004h>     max_depth=8,
[?2004l[?2004h>     num_leaves=64,
[?2004l[?2004h>     random_state=42,
[?2004l[?2004h>     n_jobs=-1,
[?2004l[?2004h>     verbose=-1
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> model.fit(X_train, y_train)
[?2004l[?2004h> 
[?2004l[?2004h> # Validate
[?2004l[?2004h> val_pred = model.predict_proba(X_val)[:, 1]
[?2004l[?2004h> val_auc = roc_auc_score(y_val, val_pred)
[?2004l[?2004h> print(f"\nValidation ROC-AUC: {val_auc:.6f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Generate test predictions
[?2004l[?2004h> print("\nGenerating test predictions...")
[?2004l[?2004h> test_pred = model.predict_proba(X_test)[:, 1]
