[?2004l[?2004h> from sklearn.metrics import roc_auc_score
[?2004l[?2004h> from sklearn.ensemble import VotingClassifier
[?2004l[?2004h> 
[?2004l[?2004h> print("Loading data...")
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> X_train = train.drop('target', axis=1)
[?2004l[?2004h> y_train = train['target']
[?2004l[?2004h> X_val = val.drop('target', axis=1)
[?2004l[?2004h> y_val = val['target']
[?2004l[?2004h> X_test = test.copy()
[?2004l[?2004h> 
[?2004l[?2004h> for col in X_train.columns:
[?2004l[?2004h>     if X_train[col].isna().any():
[?2004l[?2004h>         median_val = X_train[col].median()
[?2004l[?2004h>         X_train[col].fillna(median_val, inplace=True)
[?2004l[?2004h>         X_val[col].fillna(median_val, inplace=True)
[?2004l[?2004h>         X_test[col].fillna(median_val, inplace=True)
[?2004l[?2004h> 
[?2004l[?2004h> # Train best CatBoost
[?2004l[?2004h> print("\nTraining best CatBoost...")
[?2004l[?2004h> cat_best = CatBoostClassifier(iterations=1500, learning_rate=0.025, depth=6, 
[?2004l[?2004h>                                l2_leaf_reg=5, random_state=42, verbose=False)
[?2004l[?2004h> cat_best.fit(X_train, y_train)
[?2004l[?2004h> cat_pred = cat_best.predict_proba(X_val)[:, 1]
[?2004l[?2004h> cat_auc = roc_auc_score(y_val, cat_pred)
[?2004l[?2004h> print(f"CatBoost ROC-AUC: {cat_auc:.6f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Train LightGBM with tuned params
[?2004l[?2004h> print("\nTraining LightGBM...")
[?2004l[?2004h> lgb = LGBMClassifier(n_estimators=800, learning_rate=0.03, max_depth=6, 
[?2004l[?2004h>                      num_leaves=64, reg_lambda=5, random_state=42, n_jobs=-1, verbose=-1)
[?2004l[?2004h> lgb.fit(X_train, y_train)
[?2004l[?2004h> lgb_pred = lgb.predict_proba(X_val)[:, 1]
[?2004l[?2004h> lgb_auc = roc_auc_score(y_val, lgb_pred)
[?2004l[?2004h> print(f"LightGBM ROC-AUC: {lgb_auc:.6f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Train XGBoost with similar params
[?2004l[?2004h> print("\nTraining XGBoost...")
[?2004l[?2004h> xgb = XGBClassifier(n_estimators=1000, learning_rate=0.03, max_depth=6,
[?2004l[?2004h>                     reg_lambda=5, random_state=42, n_jobs=-1, eval_metric='auc')
[?2004l[?2004h> xgb.fit(X_train, y_train)
[?2004l[?2004h> xgb_pred = xgb.predict_proba(X_val)[:, 1]
[?2004l[?2004h> xgb_auc = roc_auc_score(y_val, xgb_pred)
[?2004l[?2004h> print(f"XGBoost ROC-AUC: {xgb_auc:.6f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Weighted ensemble
[?2004l[?2004h> val_ensemble = (cat_pred + lgb_pred + xgb_pred) / 3
[?2004l[?2004h> ensemble_auc = roc_auc_score(y_val, val_ensemble)
[?2004l[?2004h> print(f"\nEnsemble ROC-AUC: {ensemble_auc:.6f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Use best for predictions
[?2004l[?2004h> best_auc = max(cat_auc, lgb_auc, xgb_auc, ensemble_auc)
[?2004l[?2004h> print(f"\nBest ROC-AUC: {best_auc:.6f}")
[?2004l[?2004h> 
[?2004l[?2004h> if ensemble_auc >= best_auc:
[?2004l[?2004h>     print("Using ensemble")
[?2004l[?2004h>     test_pred = (cat_best.predict_proba(X_test)[:, 1] + 
[?2004l[?2004h>                  lgb.predict_proba(X_test)[:, 1] + 
[?2004l[?2004h>                  xgb.predict_proba(X_test)[:, 1]) / 3
[?2004l[?2004h> elif cat_auc >= lgb_auc and cat_auc >= xgb_auc:
[?2004l[?2004h>     print("Using CatBoost")
[?2004l[?2004h>     test_pred = cat_best.predict_proba(X_test)[:, 1]
[?2004l[?2004h> elif lgb_auc >= cat_auc and lgb_auc >= xgb_auc:
[?2004l[?2004h>     print("Using LightGBM")
[?2004l[?2004h>     test_pred = lgb.predict_proba(X_test)[:, 1]
