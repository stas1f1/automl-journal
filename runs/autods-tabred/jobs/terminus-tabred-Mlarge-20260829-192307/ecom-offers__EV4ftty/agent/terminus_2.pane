[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from catboost import CatBoostClassifier
[?2004l[?2004h> from sklearn.metrics import roc_auc_score
[?2004l[?2004h> 
[?2004l[?2004h> print("Loading data...")
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> X_train = train.drop('target', axis=1)
[?2004l[?2004h> y_train = train['target']
[?2004l[?2004h> X_val = val.drop('target', axis=1)
[?2004l[?2004h> y_val = val['target']
[?2004l[?2004h> X_test = test.copy()
[?2004l[?2004h> 
[?2004l[?2004h> for col in X_train.columns:
[?2004l[?2004h>     if X_train[col].isna().any():
[?2004l[?2004h>         median_val = X_train[col].median()
[?2004l[?2004h>         X_train[col].fillna(median_val, inplace=True)
[?2004l[?2004h>         X_val[col].fillna(median_val, inplace=True)
[?2004l[?2004h>         X_test[col].fillna(median_val, inplace=True)
[?2004l[?2004h> 
[?2004l[?2004h> # Best config: iter=850, lr=0.03, depth=6, l2=5, colsample=0.8
[?2004l[?2004h> # Train multiple models with different seeds and ensemble
[?2004l[?2004h> seeds = [42, 123, 456, 789, 999]
[?2004l[?2004h> predictions_list = []
[?2004l[?2004h> val_scores = []
[?2004l[?2004h> 
[?2004l[?2004h> for seed in seeds:
[?2004l[?2004h>     print(f"\nTraining model with seed {seed}...")
[?2004l[?2004h>     model = CatBoostClassifier(iterations=850, learning_rate=0.03, depth=6, 
[?2004l[?2004h>                                 l2_leaf_reg=5, colsample_bylevel=0.8,
[?2004l[?2004h>                                 random_state=seed, verbose=False)
[?2004l[?2004h>     model.fit(X_train, y_train)
[?2004l[?2004h>     val_pred = model.predict_proba(X_val)[:, 1]
[?2004l[?2004h>     val_auc = roc_auc_score(y_val, val_pred)
[?2004l[?2004h>     val_scores.append(val_auc)
[?2004l[?2004h>     print(f"ROC-AUC: {val_auc:.6f}")
[?2004l[?2004h>     predictions_list.append(model.predict_proba(X_test)[:, 1])
[?2004l[?2004h> 
[?2004l[?2004h> # Ensemble prediction
[?2004l[?2004h> ensemble_pred = np.mean(predictions_list, axis=0)
[?2004l[?2004h> print(f"\nMean val ROC-AUC: {np.mean(val_scores):.6f}")
[?2004l[?2004h> print(f"Std val ROC-AUC: {np.std(val_scores):.6f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Save predictions
[?2004l[?2004h> predictions = pd.DataFrame({'target': ensemble_pred})
[?2004l[?2004h> predictions.to_csv('/app/predictions.csv', index=False)
