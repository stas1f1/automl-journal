[?2004l[?2004h>         median_val = X_train[col].median()
[?2004l[?2004h>         X_train[col].fillna(median_val, inplace=True)
[?2004l[?2004h>         X_val[col].fillna(median_val, inplace=True)
[?2004l[?2004h>         X_test[col].fillna(median_val, inplace=True)
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate class weight for imbalance
[?2004l[?2004h> class_0 = (y_train == 0).sum()
[?2004l[?2004h> class_1 = (y_train == 1).sum()
[?2004l[?2004h> scale_pos_weight = class_0 / class_1
[?2004l[?2004h> print(f"Scale pos weight: {scale_pos_weight:.4f}")
