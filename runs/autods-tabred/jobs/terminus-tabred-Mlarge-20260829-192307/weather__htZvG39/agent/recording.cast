[47.361222, "i", "cat > train_model.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.ensemble import GradientBoostingRegressor, HistGradientBoostingRegressor\nfrom sklearn.metrics import mean_squared_error\nimport warnings\nwarnings.filterwarnings('ignore')\n\nprint(\"Loading data...\")\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nprint(f\"Train shape: {train_df.shape}\")\nprint(f\"Val shape: {val_df.shape}\")\nprint(f\"Test shape: {test_df.shape}\")\n\n# Separate features and target\nfeature_cols = [col for col in train_df.columns if col != 'target']\n\nX_train = train_df[feature_cols]\ny_train = train_df['target']\nX_val = val_df[feature_cols]\ny_val = val_df['target']\nX_test = test_df[feature_cols]\n\nprint(f\"\\nFeatures: {len(feature_cols)}\")\nprint(f\"Missing values in train: {X_train.isna().sum().sum()}\")\nprint(f\"Missing values in val: {X_val.isna().sum().sum()}\")\nprint(f\"Missing values in test: {X_test.isna().sum().sum()}\")\n\nprint(\"\\nTraining HistGradientBoostingRegressor...\")\nmodel = HistGradientBoostingRegressor(\n    max_iter=200,\n    learning_rate=0.1,\n    max_depth=8,\n    min_samples_leaf=20,\n    random_state=42\n)\n\nmodel.fit(X_train, y_train)\n\n# Validate\nval_pred = model.predict(X_val)\nval_rmse = np.sqrt(mean_squared_error(y_val, val_pred))\nprint(f\"\\nValidation RMSE: {val_rmse:.4f}\")\n\n# Predict on test\ntest_pred = model.predict(X_test)\nprint(f\"Test predictions shape: {test_pred.shape}\")\nprint(f\"Finite predictions: {np.isfinite(test_pred).sum()}/{len(test_pred)}\")\n\n# Save predictions\nresult_df = pd.DataFrame({'target': test_pred})\nresult_df.to_csv('/app/predictions.csv', index=False)\nprint(\"\\nPredictions saved to /app/predictions.csv\")\nEOF\n"]
[47.362031, "o", "cat > train_model.py << 'EOF'\r\n\u001b[?2004l\r"]
[47.362233, "o", "\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.362401, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.362591, "o", "from sklearn.ensemble import GradientBoostingRegressor, HistGradientBoostingRegressor\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.362751, "o", "from sklearn.metrics import mean_squared_error\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.362959, "o", "import warnings\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.363117, "o", "warnings.filterwarnings('ignore')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[47.363293, "o", "> print(\"Loading data...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.363429, "o", "train_df = pd.read_csv('/app/data/train.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.363562, "o", "val_df = pd.read_csv('/app/data/val.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.363697, "o", "test_df = pd.read_csv('/app/data/test.csv')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.363859, "o", "print(f\"Train shape: {train_df.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.363986, "o", "print(f\"Val shape: {val_df.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.364172, "o", "print(f\"Test shape: {test_df.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[47.364358, "o", "> # Separate features and target\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.364502, "o", "feature_cols = [col for col in train_df.columns if col != 'target']\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.364633, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> X_train = train_df[feature_cols]"]
[47.364814, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> y_train = train_df['target']\r\n"]
[47.364952, "o", "\u001b[?2004l\r\u001b[?2004h> X_val = val_df[feature_cols]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.365086, "o", "y_val = val_df['target']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.365243, "o", "X_test = test_df[feature_cols]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.365415, "o", "print(f\"\\nFeatures: {len(feature_cols)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.365488, "o", "> "]
[47.365574, "o", "print(f\"Missing values in train: {X_train.isna().sum().sum()}\")"]
[47.365639, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.365729, "o", "print(f\"Missing values in val: {X_val.isna().sum().sum()}\")\r\n\u001b[?2004l\r"]
[47.36581, "o", "\u001b[?2004h> "]
[47.365905, "o", "print(f\"Missing values in test: {X_test.isna().sum().sum()}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.365999, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.366089, "o", "print(\"\\nTraining HistGradientBoostingRegressor...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.366176, "o", "model = HistGradientBoostingRegressor(\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.366263, "o", ">     max_iter=200,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.36633, "o", "    learning_rate=0.1,\r\n\u001b[?2004l\r\u001b[?2004h>     max_depth=8,\r\n\u001b[?2004l\r"]
[47.366404, "o", "\u001b[?2004h> "]
[47.366483, "o", "    min_samples_leaf=20,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.366569, "o", "    random_state=42\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[47.366639, "o", "\u001b[?2004h> model.fit(X_train, y_train)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[47.366732, "o", "\u001b[?2004h> # Validate\r\n\u001b[?2004l\r"]
[47.366815, "o", "\u001b[?2004h> val_pred = model.predict(X_val)\r\n\u001b[?2004l\r"]
[47.366897, "o", "\u001b[?2004h> "]
[47.366963, "o", "val_rmse = np.sqrt(mean_squared_error(y_val, val_pred))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.367025, "o", "print(f\"\\nValidation RMSE: {val_rmse:.4f}\")\r\n\u001b[?2004l\r"]
[47.367088, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[47.367179, "o", "> # Predict on test\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.367256, "o", "> test_pred = model.predict(X_test)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.36735, "o", "print(f\"Test predictions shape: {test_pred.shape}\")\r\n\u001b[?2004l\r"]
[47.367432, "o", "\u001b[?2004h> "]
[47.367524, "o", "print(f\"Finite predictions: {np.isfinite(test_pred).sum()}/{len(test_pred)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.367597, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.367675, "o", "# Save predictions\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.367753, "o", "result_df = pd.DataFrame({'target': test_pred})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.367884, "o", "result_df.to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.368046, "o", "print(\"\\nPredictions saved to /app/predictions.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[47.376305, "o", "\u001b[?2004hroot@db6bff3e5c53:/workspace# "]
[47.862308, "i", "python3 train_model.py\n"]
[47.862799, "o", "python3 train_model.py"]
