[?2004hroot@db6bff3e5c53:/workspace# cat > train_model.py << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from sklearn.ensemble import GradientBoostingRegressor, HistGradientBoostingRegressor
[?2004l[?2004h> from sklearn.metrics import mean_squared_error
[?2004l[?2004h> import warnings
[?2004l[?2004h> warnings.filterwarnings('ignore')
[?2004l[?2004h> 
[?2004l[?2004h> print("Loading data...")
[?2004l[?2004h> train_df = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val_df = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test_df = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Train shape: {train_df.shape}")
[?2004l[?2004h> print(f"Val shape: {val_df.shape}")
[?2004l[?2004h> print(f"Test shape: {test_df.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Separate features and target
[?2004l[?2004h> feature_cols = [col for col in train_df.columns if col != 'target']
[?2004l[?2004h> 
[?2004l[?2004h> X_train = train_df[feature_cols]
[?2004l[?2004h> y_train = train_df['target']
[?2004l[?2004h> X_val = val_df[feature_cols]
[?2004l[?2004h> y_val = val_df['target']
[?2004l[?2004h> X_test = test_df[feature_cols]
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nFeatures: {len(feature_cols)}")
[?2004l[?2004h> print(f"Missing values in train: {X_train.isna().sum().sum()}")
[?2004l[?2004h> print(f"Missing values in val: {X_val.isna().sum().sum()}")
[?2004l[?2004h> print(f"Missing values in test: {X_test.isna().sum().sum()}")
[?2004l[?2004h> 
[?2004l[?2004h> print("\nTraining HistGradientBoostingRegressor...")
[?2004l[?2004h> model = HistGradientBoostingRegressor(
[?2004l[?2004h>     max_iter=200,
[?2004l[?2004h>     learning_rate=0.1,
[?2004l[?2004h>     max_depth=8,
[?2004l[?2004h>     min_samples_leaf=20,
[?2004l[?2004h>     random_state=42
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> model.fit(X_train, y_train)
[?2004l[?2004h> 
[?2004l[?2004h> # Validate
[?2004l[?2004h> val_pred = model.predict(X_val)
[?2004l[?2004h> val_rmse = np.sqrt(mean_squared_error(y_val, val_pred))
[?2004l[?2004h> print(f"\nValidation RMSE: {val_rmse:.4f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Predict on test
[?2004l[?2004h> test_pred = model.predict(X_test)
[?2004l[?2004h> print(f"Test predictions shape: {test_pred.shape}")
[?2004l[?2004h> print(f"Finite predictions: {np.isfinite(test_pred).sum()}/{len(test_pred)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Save predictions
[?2004l[?2004h> result_df = pd.DataFrame({'target': test_pred})
[?2004l[?2004h> result_df.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> print("\nPredictions saved to /app/predictions.csv")
[?2004l[?2004h> EOF
[?2004l[?2004hroot@db6bff3e5c53:/workspace# python3 train_model.py
