[106.001786, "o", "\u001b[?2004hroot@181b73f230a4:/workspace# "]
[128.118486, "i", "cat > train_model.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom lightgbm import LGBMClassifier\nfrom sklearn.metrics import roc_auc_score\n\n# Load data\nprint(\"Loading data...\")\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\n# Separate features and target\nfeature_cols = [c for c in train_df.columns if c != 'target']\n\nX_train = train_df[feature_cols]\ny_train = train_df['target']\nX_val = val_df[feature_cols]\ny_val = val_df['target']\nX_test = test_df[feature_cols]\n\n# Combine train and val for final training\nX_combined = pd.concat([X_train, X_val], ignore_index=True)\ny_combined = pd.concat([y_train, y_val], ignore_index=True)\n\nprint(f\"Combined training shape: {X_combined.shape}\")\nprint(f\"Target distribution: {y_combined.value_counts().to_dict()}\")\n\n# Try different hyperparameters for better performance\nprint(\"\\nTraining improved LightGBM model...\")\nmodel = LGBMClassifier(\n    n_estimators=1000,\n    learning_rate=0.03,\n    max_depth=8,\n    num_leaves=64,\n    subsample=0.7,\n    colsample_bytree=0.7,\n    reg_alpha=0.1,\n    reg_lambda=0.1,\n    min_child_samples=20,\n    random_state=42,\n    n_jobs=-1,\n    verbose=-1\n)\n\nmodel.fit(X_combined, y_combined)\n\n# Quick validation on original val set\nval_preds = model.predict_proba(X_val)[:, 1]\nval_auc = roc_auc_score(y_val, val_preds)\nprint(f\"Validation ROC-AUC: {val_auc:.6f}\")\n\n# Generate test predictions\ntest_preds = model.predict_proba(X_test)[:, 1]\nprint(f\"Test predictions: {len(test_preds)} rows, range [{test_preds.min():.6f}, {test_preds.max():.6f}]\")\n\n# Save predictions\nresult_df = pd.DataFrame({'target': test_preds})\nresult_df.to_csv('/app/predictions.csv', index=False)\nprint(\"Predictions saved to /app/predictions.csv\")\nEOF\n"]
