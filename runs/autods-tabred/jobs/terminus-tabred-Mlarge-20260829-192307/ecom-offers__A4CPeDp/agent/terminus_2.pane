[?2004l[?2004h> # Try different hyperparameters for better performance
[?2004l[?2004h> print("\nTraining improved LightGBM model...")
[?2004l[?2004h> model = LGBMClassifier(
[?2004l[?2004h>     n_estimators=1000,
[?2004l[?2004h>     learning_rate=0.03,
[?2004l[?2004h>     max_depth=8,
[?2004l[?2004h>     num_leaves=64,
[?2004l[?2004h>     subsample=0.7,
[?2004l[?2004h>     colsample_bytree=0.7,
[?2004l[?2004h>     reg_alpha=0.1,
[?2004l[?2004h>     reg_lambda=0.1,
[?2004l[?2004h>     min_child_samples=20,
[?2004l[?2004h>     random_state=42,
[?2004l[?2004h>     n_jobs=-1,
[?2004l[?2004h>     verbose=-1
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> model.fit(X_combined, y_combined)
[?2004l[?2004h> 
[?2004l[?2004h> # Quick validation on original val set
[?2004l[?2004h> val_preds = model.predict_proba(X_val)[:, 1]
[?2004l[?2004h> val_auc = roc_auc_score(y_val, val_preds)
[?2004l[?2004h> print(f"Validation ROC-AUC: {val_auc:.6f}")
