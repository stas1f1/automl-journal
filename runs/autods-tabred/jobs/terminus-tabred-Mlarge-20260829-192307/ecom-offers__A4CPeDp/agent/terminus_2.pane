[?2004hroot@181b73f230a4:/workspace# cat > train_model.py << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from lightgbm import LGBMClassifier
[?2004l[?2004h> from sklearn.metrics import roc_auc_score
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> print("Loading data...")
[?2004l[?2004h> train_df = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val_df = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test_df = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Train shape: {train_df.shape}")
[?2004l[?2004h> print(f"Val shape: {val_df.shape}")
[?2004l[?2004h> print(f"Test shape: {test_df.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Separate features and target
[?2004l[?2004h> feature_cols = [c for c in train_df.columns if c != 'target']
[?2004l[?2004h> X_train = train_df[feature_cols]
[?2004l[?2004h> y_train = train_df['target']
[?2004l[?2004h> X_val = val_df[feature_cols]
[?2004l[?2004h> y_val = val_df['target']
[?2004l[?2004h> X_test = test_df[feature_cols]
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nTraining target distribution:")
[?2004l[?2004h> print(y_train.value_counts())
[?2004l[?2004h> print(f"\nValidation target distribution:")
[?2004l[?2004h> print(y_val.value_counts())
[?2004l[?2004h> 
[?2004l[?2004h> # Train LightGBM model
[?2004l[?2004h> print("\nTraining LightGBM model...")
[?2004l[?2004h> model = LGBMClassifier(
[?2004l[?2004h>     n_estimators=500,
[?2004l[?2004h>     learning_rate=0.05,
[?2004l[?2004h>     max_depth=-1,
[?2004l[?2004h>     num_leaves=31,
[?2004l[?2004h>     subsample=0.8,
[?2004l[?2004h>     colsample_bytree=0.8,
[?2004l[?2004h>     random_state=42,
[?2004l[?2004h>     n_jobs=-1,
[?2004l[?2004h>     verbose=-1
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> model.fit(X_train, y_train)
[?2004l[?2004h> 
[?2004l[?2004h> # Validate
[?2004l[?2004h> val_preds = model.predict_proba(X_val)[:, 1]
[?2004l[?2004h> val_auc = roc_auc_score(y_val, val_preds)
[?2004l[?2004h> print(f"\nValidation ROC-AUC: {val_auc:.6f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Generate test predictions
[?2004l[?2004h> test_preds = model.predict_proba(X_test)[:, 1]
[?2004l[?2004h> print(f"Test predictions shape: {test_preds.shape}")
[?2004l[?2004h> print(f"Test predictions range: [{test_preds.min():.6f}, {test_preds.max():.6f}]")
[?2004l[?2004h> 
[?2004l[?2004h> # Save predictions
[?2004l[?2004h> result_df = pd.DataFrame({'target': test_preds})
[?2004l[?2004h> result_df.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> print(f"\nPredictions saved to /app/predictions.csv")
[?2004l[?2004h> print(f"Output file has {len(result_df)} rows")
[?2004l[?2004h> EOF
