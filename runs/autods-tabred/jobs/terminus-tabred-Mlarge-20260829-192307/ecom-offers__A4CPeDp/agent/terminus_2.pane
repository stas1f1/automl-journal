[?2004hroot@181b73f230a4:/workspace# cat > train_model.py << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from lightgbm import LGBMClassifier
[?2004l[?2004h> from sklearn.metrics import roc_auc_score
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> print("Loading data...")
[?2004l[?2004h> train_df = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val_df = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test_df = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Separate features and target
[?2004l[?2004h> feature_cols = [c for c in train_df.columns if c != 'target']
[?2004l[?2004h> 
[?2004l[?2004h> X_train = train_df[feature_cols]
[?2004l[?2004h> y_train = train_df['target']
[?2004l[?2004h> X_val = val_df[feature_cols]
[?2004l[?2004h> y_val = val_df['target']
[?2004l[?2004h> X_test = test_df[feature_cols]
[?2004l[?2004h> 
[?2004l[?2004h> # Combine train and val for final training
[?2004l[?2004h> X_combined = pd.concat([X_train, X_val], ignore_index=True)
[?2004l[?2004h> y_combined = pd.concat([y_train, y_val], ignore_index=True)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Combined training shape: {X_combined.shape}")
[?2004l[?2004h> print(f"Target distribution: {y_combined.value_counts().to_dict()}")
