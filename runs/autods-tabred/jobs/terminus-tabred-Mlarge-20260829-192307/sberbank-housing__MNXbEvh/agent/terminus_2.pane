[?2004hroot@664bc732626f:/workspace# cat > train_model.py << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from sklearn.ensemble import GradientBoostingRegressor, RandomForestRegressor
[?2004l[?2004h> from sklearn.preprocessing import LabelEncoder
[?2004l[?2004h> from sklearn.metrics import mean_squared_error
[?2004l[?2004h> import warnings
[?2004l[?2004h> warnings.filterwarnings('ignore')
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> print("Loading data...")
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Train: {train.shape}, Val: {val.shape}, Test: {test.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Separate features and target
[?2004l[?2004h> y_train = train['target']
[?2004l[?2004h> y_val = val['target']
[?2004l[?2004h> X_train = train.drop('target', axis=1)
[?2004l[?2004h> X_val = val.drop('target', axis=1)
[?2004l[?2004h> X_test = test.copy()
[?2004l[?2004h> 
[?2004l[?2004h> # Identify feature types
[?2004l[?2004h> num_cols = [c for c in X_train.columns if c.startswith('num_')]
[?2004l[?2004h> bin_cols = [c for c in X_train.columns if c.startswith('bin_')]
[?2004l[?2004h> cat_cols = [c for c in X_train.columns if c.startswith('cat_')]
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Numerical: {len(num_cols)}, Binary: {len(bin_cols)}, Categorical: {len(cat_cols)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Fill missing numerical values with median
[?2004l[?2004h> for col in num_cols:
[?2004l[?2004h>     median_val = X_train[col].median()
[?2004l[?2004h>     if pd.isna(median_val):
[?2004l[?2004h>         median_val = 0
[?2004l[?2004h>     X_train[col] = X_train[col].fillna(median_val)
[?2004l[?2004h>     X_val[col] = X_val[col].fillna(median_val)
[?2004l[?2004h>     X_test[col] = X_test[col].fillna(median_val)
[?2004l[?2004h> 
[?2004l[?2004h> # Fill binary missing values with 0
[?2004l[?2004h> for col in bin_cols:
[?2004l[?2004h>     X_train[col] = X_train[col].fillna(0).astype(int)
[?2004l[?2004h>     X_val[col] = X_val[col].fillna(0).astype(int)
[?2004l[?2004h>     X_test[col] = X_test[col].fillna(0).astype(int)
[?2004l[?2004h> 
[?2004l[?2004h> # Encode categorical features
[?2004l[?2004h> for col in cat_cols:
[?2004l[?2004h>     le = LabelEncoder()
[?2004l[?2004h>     # Combine all data for fitting
[?2004l[?2004h>     all_vals = pd.concat([X_train[col], X_val[col], X_test[col]]).astype(str)
[?2004l[?2004h>     le.fit(all_vals)
[?2004l[?2004h>     X_train[col] = le.transform(X_train[col].astype(str))
[?2004l[?2004h>     X_val[col] = le.transform(X_val[col].astype(str))
[?2004l[?2004h>     X_test[col] = le.transform(X_test[col].astype(str))
[?2004l[?2004h> 
[?2004l[?2004h> print("Training GradientBoostingRegressor...")
[?2004l[?2004h> model = GradientBoostingRegressor(
[?2004l[?2004h>     n_estimators=200,
[?2004l[?2004h>     max_depth=6,
[?2004l[?2004h>     learning_rate=0.1,
[?2004l[?2004h>     random_state=42,
[?2004l[?2004h>     verbose=1
[?2004l[?2004h> )
[?2004l[?2004h> model.fit(X_train, y_train)
[?2004l[?2004h> 
[?2004l[?2004h> # Validate
[?2004l[?2004h> val_pred = model.predict(X_val)
[?2004l[?2004h> val_rmse = np.sqrt(mean_squared_error(y_val, val_pred))
[?2004l[?2004h> print(f"Validation RMSE: {val_rmse:.6f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Predict on test
[?2004l[?2004h> test_pred = model.predict(X_test)
[?2004l[?2004h> print(f"Test predictions: {len(test_pred)} rows")
[?2004l[?2004h> print(f"Predictions stats - min: {test_pred.min():.2f}, max: {test_pred.max():.2f}, mean: {test_pred.mean():.2f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Save predictions
[?2004l[?2004h> result = pd.DataFrame({'target': test_pred})
[?2004l[?2004h> result.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> print("Predictions saved to /app/predictions.csv")
