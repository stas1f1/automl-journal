[?2004hroot@b42498f03d68:/workspace# cat > train_model.py << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from sklearn.ensemble import GradientBoostingRegressor, HistGradientBoostingRegressor
[?2004l[?2004h> from sklearn.preprocessing import LabelEncoder
[?2004l[?2004h> import warnings
[?2004l[?2004h> warnings.filterwarnings('ignore')
[?2004l[?2004h> 
[?2004l[?2004h> print("Loading data...")
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Train shape: {train.shape}")
[?2004l[?2004h> print(f"Val shape: {val.shape}")
[?2004l[?2004h> print(f"Test shape: {test.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Identify feature types
[?2004l[?2004h> num_cols = [c for c in train.columns if c.startswith('num_')]
[?2004l[?2004h> bin_cols = [c for c in train.columns if c.startswith('bin_')]
[?2004l[?2004h> cat_cols = [c for c in train.columns if c.startswith('cat_')]
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Numerical: {len(num_cols)}, Binary: {len(bin_cols)}, Categorical: {len(cat_cols)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Combine train and val for training
[?2004l[?2004h> X_train_full = pd.concat([train, val], ignore_index=True)
[?2004l[?2004h> y_train_full = X_train_full['target'].values
[?2004l[?2004h> X_train_full = X_train_full.drop(columns=['target'])
[?2004l[?2004h> 
[?2004l[?2004h> # Prepare test data
[?2004l[?2004h> X_test = test.copy()
[?2004l[?2004h> 
[?2004l[?2004h> # Handle categorical features - label encode
[?2004l[?2004h> for col in cat_cols:
[?2004l[?2004h>     le = LabelEncoder()
[?2004l[?2004h>     # Fit on combined data
[?2004l[?2004h>     combined = pd.concat([X_train_full[col], X_test[col]], axis=0).astype(str)
[?2004l[?2004h>     le.fit(combined)
[?2004l[?2004h>     X_train_full[col] = le.transform(X_train_full[col].astype(str))
[?2004l[?2004h>     X_test[col] = le.transform(X_test[col].astype(str))
[?2004l[?2004h> 
[?2004l[?2004h> # Fill missing values with median for numerical columns
[?2004l[?2004h> for col in num_cols:
[?2004l[?2004h>     median_val = X_train_full[col].median()
[?2004l[?2004h>     if pd.isna(median_val):
[?2004l[?2004h>         median_val = 0
[?2004l[?2004h>     X_train_full[col] = X_train_full[col].fillna(median_val)
[?2004l[?2004h>     X_test[col] = X_test[col].fillna(median_val)
[?2004l[?2004h> 
[?2004l[?2004h> # Fill missing binary/categorical with 0
[?2004l[?2004h> for col in bin_cols + cat_cols:
[?2004l[?2004h>     X_train_full[col] = X_train_full[col].fillna(0)
[?2004l[?2004h>     X_test[col] = X_test[col].fillna(0)
[?2004l[?2004h> 
[?2004l[?2004h> print("Training HistGradientBoostingRegressor...")
[?2004l[?2004h> model = HistGradientBoostingRegressor(
[?2004l[?2004h>     max_iter=200,
[?2004l[?2004h>     max_depth=10,
[?2004l[?2004h>     learning_rate=0.1,
[?2004l[?2004h>     random_state=42
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> model.fit(X_train_full, y_train_full)
[?2004l[?2004h> 
[?2004l[?2004h> print("Making predictions...")
[?2004l[?2004h> predictions = model.predict(X_test)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Predictions shape: {predictions.shape}")
[?2004l[?2004h> print(f"Predictions range: {predictions.min():.4f} to {predictions.max():.4f}")
[?2004l[?2004h> print(f"Any NaN predictions: {np.isnan(predictions).any()}")
[?2004l[?2004h> print(f"Any inf predictions: {np.isinf(predictions).any()}")
[?2004l[?2004h> 
[?2004l[?2004h> # Save predictions
[?2004l[?2004h> result = pd.DataFrame({'target': predictions})
[?2004l[?2004h> result.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> 
[?2004l[?2004h> print("Saved predictions to /app/predictions.csv")
[?2004l[?2004h> print(f"Output shape: {result.shape}")
[?2004l[?2004h> EOF
