[?2004hroot@42284e58d7a7:/workspace# python3 -c "import pandas, sklearn, numpy; print('Libraries available')"
[?2004lLibraries available
[?2004hroot@42284e58d7a7:/workspace# cat > train_model.py << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from sklearn.ensemble import GradientBoostingRegressor, HistGradientBoostingRegressor
[?2004l[?2004h> from sklearn.metrics import mean_squared_error
[?2004l[?2004h> import warnings
[?2004l[?2004h> warnings.filterwarnings('ignore')
[?2004l[?2004h> 
[?2004l[?2004h> print("Loading data...")
[?2004l[?2004h> train_df = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val_df = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test_df = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Train shape: {train_df.shape}")
[?2004l[?2004h> print(f"Val shape: {val_df.shape}")
[?2004l[?2004h> print(f"Test shape: {test_df.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Get feature columns
[?2004l[?2004h> feature_cols = [c for c in train_df.columns if c != 'target']
[?2004l[?2004h> print(f"Features: {len(feature_cols)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Prepare data
[?2004l[?2004h> X_train = train_df[feature_cols].copy()
[?2004l[?2004h> y_train = train_df['target'].copy()
[?2004l[?2004h> X_val = val_df[feature_cols].copy()
[?2004l[?2004h> y_val = val_df['target'].copy()
[?2004l[?2004h> X_test = test_df[feature_cols].copy()
[?2004l[?2004h> 
[?2004l[?2004h> # Handle missing values - replace -9999 with NaN, then fill
[?2004l[?2004h> for df in [X_train, X_val, X_test]:
[?2004l[?2004h>     df.replace(-9999, np.nan, inplace=True)
[?2004l[?2004h>     # Fill NaN with median of each column (using train median for consistency)
[?2004l[?2004h> 
[?2004l[?2004h> train_median = X_train.median()
[?2004l[?2004h> X_train = X_train.fillna(train_median)
[?2004l[?2004h> X_val = X_val.fillna(train_median)
[?2004l[?2004h> X_test = X_test.fillna(train_median)
[?2004l[?2004h> 
[?2004l[?2004h> print("Training model...")
[?2004l[?2004h> model = HistGradientBoostingRegressor(
[?2004l[?2004h>     max_iter=200,
[?2004l[?2004h>     learning_rate=0.1,
[?2004l[?2004h>     max_depth=8,
[?2004l[?2004h>     random_state=42
[?2004l[?2004h> )
[?2004l[?2004h> model.fit(X_train, y_train)
[?2004l[?2004h> 
[?2004l[?2004h> print("Validating...")
[?2004l[?2004h> val_pred = model.predict(X_val)
[?2004l[?2004h> rmse = np.sqrt(mean_squared_error(y_val, val_pred))
[?2004l[?2004h> print(f"Validation RMSE: {rmse:.4f}")
[?2004l[?2004h> 
[?2004l[?2004h> print("Generating test predictions...")
[?2004l[?2004h> test_pred = model.predict(X_test)
[?2004l[?2004h> print(f"Predictions shape: {test_pred.shape}")
[?2004l[?2004h> print(f"All finite: {np.all(np.isfinite(test_pred))}")
[?2004l[?2004h> 
[?2004l[?2004h> # Save predictions
[?2004l[?2004h> result_df = pd.DataFrame({'target': test_pred})
[?2004l[?2004h> result_df.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> print("Saved to /app/predictions.csv")
[?2004l[?2004h> print(f"Output rows: {len(result_df)}")
[?2004l[?2004h> EOF
