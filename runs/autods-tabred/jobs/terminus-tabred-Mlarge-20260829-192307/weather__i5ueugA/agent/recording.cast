[27.326603, "o", "\u001b[?2004hroot@42284e58d7a7:/workspace# "]
[43.507291, "i", "cat > train_model.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.ensemble import GradientBoostingRegressor, HistGradientBoostingRegressor\nfrom sklearn.metrics import mean_squared_error\nimport warnings\nwarnings.filterwarnings('ignore')\n\nprint(\"Loading data...\")\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nprint(f\"Train shape: {train_df.shape}\")\nprint(f\"Val shape: {val_df.shape}\")\nprint(f\"Test shape: {test_df.shape}\")\n\n# Get feature columns\nfeature_cols = [c for c in train_df.columns if c != 'target']\nprint(f\"Features: {len(feature_cols)}\")\n\n# Prepare data\nX_train = train_df[feature_cols].copy()\ny_train = train_df['target'].copy()\nX_val = val_df[feature_cols].copy()\ny_val = val_df['target'].copy()\nX_test = test_df[feature_cols].copy()\n\n# Handle missing values - replace -9999 with NaN, then fill\nfor df in [X_train, X_val, X_test]:\n    df.replace(-9999, np.nan, inplace=True)\n    # Fill NaN with median of each column (using train median for consistency)\n\ntrain_median = X_train.median()\nX_train = X_train.fillna(train_median)\nX_val = X_val.fillna(train_median)\nX_test = X_test.fillna(train_median)\n\nprint(\"Training model...\")\nmodel = HistGradientBoostingRegressor(\n    max_iter=200,\n    learning_rate=0.1,\n    max_depth=8,\n    random_state=42\n)\nmodel.fit(X_train, y_train)\n\nprint(\"Validating...\")\nval_pred = model.predict(X_val)\nrmse = np.sqrt(mean_squared_error(y_val, val_pred))\nprint(f\"Validation RMSE: {rmse:.4f}\")\n\nprint(\"Generating test predictions...\")\ntest_pred = model.predict(X_test)\nprint(f\"Predictions shape: {test_pred.shape}\")\nprint(f\"All finite: {np.all(np.isfinite(test_pred))}\")\n\n# Save predictions\nresult_df = pd.DataFrame({'target': test_pred})\nresult_df.to_csv('/app/predictions.csv', index=False)\nprint(\"Saved to /app/predictions.csv\")\nprint(f\"Output rows: {len(result_df)}\")\nEOF\n"]
