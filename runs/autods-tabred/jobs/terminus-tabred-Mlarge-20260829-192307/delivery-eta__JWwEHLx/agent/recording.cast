[9.462042, "o", "\u001b[?2004hroot@e19b785098ef:/workspace# "]
[54.244478, "i", "cat > /workspace/train_model.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.ensemble import GradientBoostingRegressor, HistGradientBoostingRegressor\nfrom sklearn.preprocessing import LabelEncoder\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Load data\nprint(\"Loading data...\")\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nprint(f\"Train shape: {train.shape}\")\nprint(f\"Val shape: {val.shape}\")\nprint(f\"Test shape: {test.shape}\")\n\n# Separate features and target\nfeature_cols = [c for c in train.columns if c != 'target']\nX_train = train[feature_cols]\ny_train = train['target']\nX_val = val[feature_cols]\ny_val = val['target']\nX_test = test[feature_cols]\n\n# Encode categorical column\nprint(\"Encoding categorical features...\")\nfor col in feature_cols:\n    if col.startswith('cat_'):\n        le = LabelEncoder()\n        # Combine train and test to handle unseen categories\n        combined = pd.concat([X_train[col], X_val[col], X_test[col]], axis=0).astype(str)\n        le.fit(combined)\n        X_train[col] = le.transform(X_train[col].astype(str))\n        X_val[col] = le.transform(X_val[col].astype(str))\n        X_test[col] = le.transform(X_test[col].astype(str))\n\nprint(\"Training model...\")\n# Use HistGradientBoosting which handles NaN values natively\nmodel = HistGradientBoostingRegressor(\n    max_iter=200,\n    learning_rate=0.1,\n    max_depth=8,\n    random_state=42,\n    verbose=1\n)\nmodel.fit(X_train, y_train)\n\n# Validate\nval_pred = model.predict(X_val)\nval_rmse = np.sqrt(np.mean((val_pred - y_val)**2))\nprint(f\"Validation RMSE: {val_rmse:.4f}\")\n\n# Predict on test\nprint(\"Generating predictions...\")\ntest_pred = model.predict(X_test)\nprint(f\"Test predictions shape: {test_pred.shape}\")\nprint(f\"All finite: {np.all(np.isfinite(test_pred))}\")\n\n# Save predictions\nresult = pd.DataFrame({'target': test_pred})\nresult.to_csv('/app/predictions.csv', index=False)\nprint(\"Predictions saved to /app/predictions.csv\")\nprint(f\"Output shape: {result.shape}\")\nEOF\n"]
[54.244931, "o", "cat > /workspace/train_model.py << 'EOF'"]
