[54.248281, "o", "print(\"Encoding categorical features...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.248367, "o", "for col in feature_cols:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.248437, "o", "    if col.startswith('cat_'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.248506, "o", "        le = LabelEncoder()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.248572, "o", "        # Combine train and test to handle unseen categories\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.248642, "o", "> "]
[54.248748, "o", "        combined = pd.concat([X_train[col], X_val[col], X_test[col]], axis=0).astype(str)\r\n\u001b[?2004l\r"]
[54.24882, "o", "\u001b[?2004h> "]
[54.248895, "o", "        le.fit(combined)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.248978, "o", "        X_train[col] = le.transform(X_train[col].astype(str))"]
[54.249005, "o", "\r\n\u001b[?2004l\r"]
[54.249099, "o", "\u001b[?2004h> "]
[54.249167, "o", "        X_val[col] = le.transform(X_val[col].astype(str))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.249307, "o", "        X_test[col] = le.transform(X_test[col].astype(str))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[54.249371, "o", "\u001b[?2004h> "]
[54.249438, "o", "print(\"Training model...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.249529, "o", "# Use HistGradientBoosting which handles NaN values natively\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.24959, "o", "> "]
[54.249628, "o", "model = HistGradientBoostingRegressor(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.249715, "o", "    max_iter=200,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.249784, "o", "    learning_rate=0.1,\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.249848, "o", ">     max_depth=8,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.249928, "o", "    random_state=42,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.250016, "o", "    verbose=1\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.250083, "o", "model.fit(X_train, y_train)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.250149, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> # Validate\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.250214, "o", "> val_pred = model.predict(X_val)\r\n"]
[54.250277, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[54.250345, "o", "val_rmse = np.sqrt(np.mean((val_pred - y_val)**2))\r\n\u001b[?2004l\r"]
[54.250411, "o", "\u001b[?2004h> "]
[54.250476, "o", "print(f\"Validation RMSE: {val_rmse:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[54.250541, "o", "> # Predict on test\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.250615, "o", "print(\"Generating predictions...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.250679, "o", "test_pred = model.predict(X_test)\r\n\u001b[?2004l\r"]
[54.250716, "o", "\u001b[?2004h> "]
[54.250804, "o", "print(f\"Test predictions shape: {test_pred.shape}\")\r\n\u001b[?2004l\r"]
[54.250872, "o", "\u001b[?2004h> "]
[54.250936, "o", "print(f\"All finite: {np.all(np.isfinite(test_pred))}\")\r\n\u001b[?2004l\r"]
[54.251013, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.25108, "o", "# Save predictions\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.25114, "o", "result = pd.DataFrame({'target': test_pred})\r\n\u001b[?2004l\r"]
[54.251201, "o", "\u001b[?2004h> "]
[54.25127, "o", "result.to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.25138, "o", "print(\"Predictions saved to /app/predictions.csv\")\r\n\u001b[?2004l\r"]
[54.251449, "o", "\u001b[?2004h> "]
[54.251524, "o", "print(f\"Output shape: {result.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.252018, "o", "> EOF\r\n\u001b[?2004l\r"]
[54.256053, "o", "\u001b[?2004hroot@e19b785098ef:/workspace# "]
[54.750137, "i", "python3 /workspace/train_model.py\n"]
