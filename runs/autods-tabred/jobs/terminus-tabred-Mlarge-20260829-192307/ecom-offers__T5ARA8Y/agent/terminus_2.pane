[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from sklearn.ensemble import GradientBoostingClassifier, RandomForestClassifier
[?2004l[?2004h> from sklearn.metrics import roc_auc_score
[?2004l[?2004h> import warnings
[?2004l[?2004h> warnings.filterwarnings('ignore')
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> print("Loading data...")
[?2004l[?2004h> train_df = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val_df = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test_df = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Train shape: {train_df.shape}")
[?2004l[?2004h> print(f"Val shape: {val_df.shape}")
[?2004l[?2004h> print(f"Test shape: {test_df.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Separate features and target
[?2004l[?2004h> feature_cols = [col for col in train_df.columns if col != 'target']
[?2004l[?2004h> 
[?2004l[?2004h> X_train = train_df[feature_cols].fillna(0)
[?2004l[?2004h> y_train = train_df['target']
[?2004l[?2004h> 
[?2004l[?2004h> X_val = val_df[feature_cols].fillna(0)
[?2004l[?2004h> y_val = val_df['target']
[?2004l[?2004h> 
[?2004l[?2004h> X_test = test_df[feature_cols].fillna(0)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nTarget distribution in train:")
[?2004l[?2004h> print(y_train.value_counts())
[?2004l[?2004h> 
[?2004l[?2004h> # Train model
[?2004l[?2004h> print("\nTraining GradientBoostingClassifier...")
[?2004l[?2004h> model = GradientBoostingClassifier(
[?2004l[?2004h>     n_estimators=200,
[?2004l[?2004h>     max_depth=5,
[?2004l[?2004h>     learning_rate=0.1,
[?2004l[?2004h>     random_state=42
[?2004l[?2004h> )
[?2004l[?2004h> model.fit(X_train, y_train)
[?2004l[?2004h> 
[?2004l[?2004h> # Validate
[?2004l[?2004h> print("\nValidating...")
[?2004l[?2004h> val_preds = model.predict_proba(X_val)[:, 1]
[?2004l[?2004h> val_auc = roc_auc_score(y_val, val_preds)
[?2004l[?2004h> print(f"Validation ROC-AUC: {val_auc:.4f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Train on combined data for final model
[?2004l[?2004h> print("\nTraining final model on train+val...")
[?2004l[?2004h> X_combined = pd.concat([X_train, X_val], axis=0)
[?2004l[?2004h> y_combined = pd.concat([y_train, y_val], axis=0)
[?2004l[?2004h> 
[?2004l[?2004h> final_model = GradientBoostingClassifier(
[?2004l[?2004h>     n_estimators=200,
[?2004l[?2004h>     max_depth=5,
[?2004l[?2004h>     learning_rate=0.1,
[?2004l[?2004h>     random_state=42
[?2004l[?2004h> )
[?2004l[?2004h> final_model.fit(X_combined, y_combined)
[?2004l[?2004h> 
[?2004l[?2004h> # Predict on test
[?2004l[?2004h> print("\nGenerating test predictions...")
[?2004l[?2004h> test_preds = final_model.predict_proba(X_test)[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Test predictions shape: {test_preds.shape}")
[?2004l[?2004h> print(f"Test predictions range: [{test_preds.min():.4f}, {test_preds.max():.4f}]")
[?2004l[?2004h> print(f"All finite: {np.all(np.isfinite(test_preds))}")
[?2004l[?2004h> 
[?2004l[?2004h> # Save predictions
[?2004l[?2004h> result_df = pd.DataFrame({'target': test_preds})
[?2004l[?2004h> result_df.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> print(f"\nSaved predictions to /app/predictions.csv")
[?2004l[?2004h> print(f"Output shape: {result_df.shape}")
[?2004l[?2004h> EOF
