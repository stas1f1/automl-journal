[97.987358, "o", "\u001b[?2004h>     max_depth=5,\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.987438, "o", ">     learning_rate=0.1,\r\n\u001b[?2004l\r\u001b[?2004h>     random_state=42\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> model.fit(X_train, y_train)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[97.987518, "o", "> # Validate\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.987603, "o", "> print(\"\\nValidating...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.987701, "o", "val_preds = model.predict_proba(X_val)[:, 1]\r\n\u001b[?2004l\r"]
[97.987776, "o", "\u001b[?2004h> val_auc = roc_auc_score(y_val, val_preds)"]
[97.987844, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.987894, "o", "print(f\"Validation ROC-AUC: {val_auc:.4f}\")\r\n\u001b[?2004l\r"]
[97.987965, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.988034, "o", "# Train on combined data for final model\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.98813, "o", "> "]
[97.988184, "o", "print(\"\\nTraining final model on train+val...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.988267, "o", "X_combined = pd.concat([X_train, X_val], axis=0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.988332, "o", "> "]
[97.988402, "o", "y_combined = pd.concat([y_train, y_val], axis=0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.988483, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.988554, "o", "final_model = GradientBoostingClassifier(\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.988621, "o", ">     n_estimators=200,\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.988685, "o", "> "]
[97.988736, "o", "    max_depth=5,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.988805, "o", "    learning_rate=0.1,\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.988867, "o", ">     random_state=42\r\n\u001b[?2004l\r"]
[97.988914, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.988994, "o", "final_model.fit(X_combined, y_combined)\r\n\u001b[?2004l\r"]
[97.989068, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.989148, "o", "# Predict on test\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.989204, "o", "print(\"\\nGenerating test predictions...\")\r\n\u001b[?2004l\r"]
[97.989277, "o", "\u001b[?2004h> "]
[97.989331, "o", "test_preds = final_model.predict_proba(X_test)[:, 1]\r\n\u001b[?2004l\r"]
[97.989399, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.989469, "o", "print(f\"Test predictions shape: {test_preds.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.989541, "o", "> "]
[97.989656, "o", "print(f\"Test predictions range: [{test_preds.min():.4f}, {test_preds.max():.4f}]\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.989709, "o", "> "]
[97.989808, "o", "print(f\"All finite: {np.all(np.isfinite(test_preds))}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.989883, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> # Save predictions"]
[97.989959, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.99002, "o", "result_df = pd.DataFrame({'target': test_preds})\r\n\u001b[?2004l\r"]
[97.99009, "o", "\u001b[?2004h> "]
[97.990187, "o", "result_df.to_csv('/app/predictions.csv', index=False)"]
[97.990681, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"\\nSaved predictions to /app/predictions.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Output shape: {result_df.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
