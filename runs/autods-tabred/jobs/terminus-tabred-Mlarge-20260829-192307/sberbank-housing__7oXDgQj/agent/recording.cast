[52.128486, "o", "\u001b[?2004h> "]
[52.128557, "o", "import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.128581, "o", "> "]
[52.128666, "o", "from sklearn.ensemble import GradientBoostingRegressor, RandomForestRegressor\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.12871, "o", "> "]
[52.128754, "o", "from sklearn.preprocessing import LabelEncoder\r\n\u001b[?2004l\r"]
[52.128789, "o", "\u001b[?2004h> import warnings\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.128834, "o", "warnings.filterwarnings('ignore')\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.12887, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.128916, "o", "# Load data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.128951, "o", "print(\"Loading data...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.128997, "o", "train = pd.read_csv('/app/data/train.csv')\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.129041, "o", "> "]
[52.129078, "o", "val = pd.read_csv('/app/data/val.csv')\r\n\u001b[?2004l\r"]
[52.129117, "o", "\u001b[?2004h> "]
[52.129162, "o", "test = pd.read_csv('/app/data/test.csv')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[52.129242, "o", "\u001b[?2004h> "]
[52.129275, "o", "print(f\"Train shape: {train.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Val shape: {val.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.129313, "o", "> "]
[52.12935, "o", "print(f\"Test shape: {test.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.129394, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> # Separate target\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.129438, "o", "> "]
[52.129471, "o", "y_train = train['target'].values\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.129553, "o", "y_val = val['target'].values\r\n\u001b[?2004l\r"]
[52.129585, "o", "\u001b[?2004h> X_train = train.drop('target', axis=1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.129623, "o", "X_val = val.drop('target', axis=1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.129668, "o", "> "]
[52.129706, "o", "X_test = test.copy()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.129735, "o", "# Identify feature types\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.129815, "o", "num_cols = [c for c in X_train.columns if c.startswith('num_')]\r\n\u001b[?2004l\r"]
[52.129851, "o", "\u001b[?2004h> "]
[52.129911, "o", "bin_cols = [c for c in X_train.columns if c.startswith('bin_')]\r\n\u001b[?2004l\r"]
[52.129948, "o", "\u001b[?2004h> "]
[52.130003, "o", "cat_cols = [c for c in X_train.columns if c.startswith('cat_')]\r\n\u001b[?2004l\r"]
[52.130035, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.130158, "o", "print(f\"Numerical: {len(num_cols)}, Binary: {len(bin_cols)}, Categorical: {len(cat_cols)}\")\r\n\u001b[?2004l\r"]
[52.130231, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[52.130271, "o", "> # Fill missing numerical values with median\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.130302, "o", "for col in num_cols:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.130352, "o", "    median_val = X_train[col].median()\r\n\u001b[?2004l\r"]
[52.130407, "o", "\u001b[?2004h> "]
[52.130441, "o", "    if pd.isna(median_val):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.130474, "o", "        median_val = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.130527, "o", "    X_train[col] = X_train[col].fillna(median_val)\r\n\u001b[?2004l\r"]
[52.130565, "o", "\u001b[?2004h> "]
[52.130598, "o", "    X_val[col] = X_val[col].fillna(median_val)\r\n\u001b[?2004l\r"]
[52.130815, "o", "\u001b[?2004h> "]
[52.130863, "o", "    X_test[col] = X_test[col].fillna(median_val)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Fill binary with 0\r\n\u001b[?2004l\r\u001b[?2004h> for col in bin_cols:\r\n\u001b[?2004l\r\u001b[?2004h>     X_train[col] = X_train[col].fillna(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.130899, "o", "    X_val[col] = X_val[col].fillna(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.130949, "o", "    X_test[col] = X_test[col].fillna(0)\r\n\u001b[?2004l\r"]
[52.130991, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.131031, "o", "# Encode categorical features\r\n\u001b[?2004l\r"]
[52.131063, "o", "\u001b[?2004h> for col in cat_cols:\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.131102, "o", "> "]
[52.131133, "o", "    le = LabelEncoder()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.131182, "o", "    # Combine all data to fit encoder\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.131226, "o", "> "]
[52.131284, "o", "    all_values = pd.concat([X_train[col], X_val[col], X_test[col]]).astype(str)\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.131317, "o", "> "]
[52.131356, "o", "    le.fit(all_values)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.131449, "o", "    X_train[col] = le.transform(X_train[col].astype(str))\r\n\u001b[?2004l\r"]
[52.131468, "o", "\u001b[?2004h> "]
[52.131544, "o", "    X_val[col] = le.transform(X_val[col].astype(str))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.131676, "o", "    X_test[col] = le.transform(X_test[col].astype(str))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Training model...\")\r\n\u001b[?2004l\r"]
[52.131725, "o", "\u001b[?2004h> "]
[52.131766, "o", "# Use Gradient Boosting Regressor\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.131798, "o", "model = GradientBoostingRegressor(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.131839, "o", "    n_estimators=200,\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.131874, "o", "> "]
[52.131906, "o", "    max_depth=6,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.131944, "o", "    learning_rate=0.1,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.131984, "o", "    min_samples_split=10,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.132018, "o", "    min_samples_leaf=5,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.132054, "o", "    random_state=42,\r\n\u001b[?2004l\r"]
[52.132094, "o", "\u001b[?2004h>     verbose=1"]
[52.13213, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[52.132177, "o", "> "]
[52.132213, "o", "model.fit(X_train, y_train)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.132252, "o", "# Validate\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.132291, "o", "val_preds = model.predict(X_val)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.132346, "o", "rmse = np.sqrt(np.mean((val_preds - y_val)**2))\r\n\u001b[?2004l\r"]
[52.132393, "o", "\u001b[?2004h> "]
[52.132429, "o", "print(f\"Validation RMSE: {rmse:.6f}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[52.132469, "o", "\u001b[?2004h> "]
[52.132508, "o", "# Predict on test\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.132548, "o", "test_preds = model.predict(X_test)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.132605, "o", "print(f\"Test predictions shape: {test_preds.shape}\")\r\n\u001b[?2004l\r"]
[52.132649, "o", "\u001b[?2004h> "]
[52.132689, "o", "print(f\"All finite: {np.all(np.isfinite(test_preds))}\")\r\n\u001b[?2004l\r"]
[52.132729, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.132769, "o", "# Save predictions\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.132822, "o", "result = pd.DataFrame({'target': test_preds})\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.132858, "o", "> "]
[52.132914, "o", "result.to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.132936, "o", "> "]
[52.132989, "o", "print(\"Saved predictions to /app/predictions.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.133025, "o", "print(result.head())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.133075, "o", "EOF\r\n\u001b[?2004l\r"]
[52.255321, "o", "\u001b[?2004hroot@c7c897dfed76:/workspace# "]
