re_fraction\': 0.7, \'bagging_fraction\': 0.7, \'reg_alpha\': 0.1, \'reg_lambda\': 0.1},\n]\n\nbest_model = None\nbest_score = 0\nbest_params = None\n\nfor i, params in enumerate(params_list):\n    print(f"\\nTraining model {i+1}...")\n    model = LGBMClassifier(**params)\n    model.fit(X_train, y_train)\n    val_pred = model.predict_proba(X_val)[:, 1]\n    val_auc = roc_auc_score(y_val, val_pred)\n    print(f"Model {i+1} ROC-AUC: {val_auc:.6f}")\n    if val_auc > best_score:\n        best_score = val_auc\n        best_model = model\n        best_params = params\n\nprint(f"\\nBest model ROC-AUC: {best_score:.6f}")\n\n# Generate test predictions with best model\nprint("Generating test predictions...")\ntest_pred = best_model.predict_proba(X_test)[:, 1]\n\n# Save predictions\npredictions = pd.DataFrame({\'target\': test_pred})\npredictions.to_csv(\'/app/predictions.csv\', index=False)\nprint(f"Predictions saved to /app/predictions.csv")\nprint(f"All finite: {np.all(np.isfinite(test_pred))}")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
