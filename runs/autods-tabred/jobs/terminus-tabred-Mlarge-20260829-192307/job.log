...")\nmodel_combined2 = CatBoostClassifier(iterations=1000, learning_rate=0.03, depth=6,\n                                      l2_leaf_reg=5, colsample_bylevel=0.8,\n                                      random_state=42, verbose=False)\nmodel_combined2.fit(X_combined, y_combined)\ntest_pred_combined2 = model_combined2.predict_proba(X_test)[:, 1]\nprint(f"Combined training complete (1000 iter)")\n\n# Use the train-only model predictions (best validated)\ntest_pred_best = model_train.predict_proba(X_test)[:, 1]\npredictions = pd.DataFrame({\'target\': test_pred_best})\npredictions.to_csv(\'/app/predictions.csv\', index=False)\nprint(f"\\nPredictions saved from best validated model.")\nprint(f"Val ROC-AUC: {val_auc_train:.6f}")\nprint(f"All finite: {np.all(np.isfinite(test_pred_best))}")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
