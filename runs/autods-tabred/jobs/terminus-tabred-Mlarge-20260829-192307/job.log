pd.isna(median_val):\n        median_val = 0\n    X_train[col] = X_train[col].fillna(median_val)\n    X_val[col] = X_val[col].fillna(median_val)\n    X_test[col] = X_test[col].fillna(median_val)\n\nprint("\\nTraining HistGradientBoostingRegressor...")\nmodel = HistGradientBoostingRegressor(\n    max_iter=200,\n    learning_rate=0.1,\n    max_depth=8,\n    min_samples_leaf=20,\n    random_state=42,\n    categorical_features=[feature_cols.index(c) for c in cat_cols]\n)\n\nmodel.fit(X_train, y_train)\n\n# Validate\nval_preds = model.predict(X_val)\nrmse = np.sqrt(np.mean((val_preds - y_val) ** 2))\nprint(f"\\nValidation RMSE: {rmse:.6f}")\n\n# Predict on test\nprint("\\nMaking predictions on test set...")\ntest_preds = model.predict(X_test)\n\nprint(f"Predictions shape: {test_preds.shape}")\nprint(f"Predictions stats: min={test_preds.min():.4f}, max={test_preds.max():.4f}, mean={test_preds.mean():.4f}")\nprint(f"All finite: {np.all(np.isfinite(test_preds))}")\n\n# Save predictions\noutput_df = pd.DataFrame({\'target\': test_preds})\noutput_df.to_csv(\'/app/predictions.csv\', index=False)\nprint(f"\\nSaved {len(output_df)} predictions to /app/predictions.csv")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
