 {np.all(np.isfinite(test_preds))}")\n\n# Save predictions\nresult_df = pd.DataFrame({\'target\': test_preds})\nresult_df.to_csv(\'/app/predictions.csv\', index=False)\nprint(f"\\nSaved predictions to /app/predictions.csv")\nprint(f"Output shape: {result_df.shape}")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
