Sending keys: ['cat > train_model.py << \'EOF\'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.ensemble import GradientBoostingRegressor, RandomForestRegressor\nfrom sklearn.preprocessing import LabelEncoder\nfrom sklearn.metrics import mean_squared_error\nimport warnings\nwarnings.filterwarnings(\'ignore\')\n\n# Load data\nprint("Loading data...")\ntrain = pd.read_csv(\'/app/data/train.csv\')\nval = pd.read_csv(\'/app/data/val.csv\')\ntest = pd.read_csv(\'/app/data/test.csv\')\n\nprint(f"Train: {train.shape}, Val: {val.shape}, Test: {test.shape}")\n\n# Separate features and target\ny_train = train[\'target\']\ny_val = val[\'target\']\nX_train = train.drop(\'target\', axis=1)\nX_val = val.drop(\'target\', axis=1)\nX_test = test.copy()\n\n# Identify feature types\nnum_cols = [c for c in X_train.columns if c.startswith(\'num_\')]\nbin_cols = [c for c in X_train.columns if c.startswith(\'bin_\')]\ncat_cols = [c for c in X_train.columns if c.startswith(\'cat_\')]\n\nprint(f"Numerical: {len(num_cols)}, Binary: {len(bin_cols)}, Categorical: {len(cat_cols)}")\n\n# Fill missing numerical values with median\nfor col in num_cols:\n    median_val = X_train[col].median()\n    if pd.isna(median_val):\n        median_val = 0\n    X_train[col] = X_train[col].fillna(median_val)\n    X_val[col] = X_val[col].fillna(median_val)\n    X_test[col] = X_test[col].fillna(median_val)\n\n# Fill binary missing values with 0\nfor col in bin_cols:\n    X_train[col] = X_train[col].fillna(0).astype(int)\n    X_val[col] = X_val[col].fillna(0).astype(int)\n    X_test[col] = X_test[col].fillna(0).astype(int)\n\n# Encode categorical features\nfor col in cat_cols:\n    le = LabelEncoder()\n    # Combine all data for fitting\n    all_vals = pd.concat([X_train[col], X_val[col], X_test[col]]).astype(str)\n    le.fit(all_vals)\n    X_train[col] = le.transform(X_train[col].astype(str))\n    X_val[col] = le.transform(X_val[col].astype(str))\n    X_test[col] = le.transform(X_test[col].astype(str))\n\nprint("Training GradientBoostingRegressor...")\nmodel = GradientBoostingRegressor(\n    n_estimators=200,\n    max_depth=6,\n    learning_rate=0.1,\n    random_state=42,\n    verbose=1\n)\nmodel.fit(X_train, y_train)\n\n# Validate\nval_pred = model.predict(X_val)\nval_rmse = np.sqrt(mean_squared_error(y_val, val_pred))\nprint(f"Validation RMSE: {val_rmse:.6f}")\n\n# Predict on test\ntest_pred = model.predict(X_test)\nprint(f"Test predictions: {len(test_pred)} rows")\nprint(f"Predictions stats - min: {test_pred.min():.2f}, max: {test_pred.max():.2f}, mean: {test_pred.mean():.2f}")\n\n# Save predictions\nresult = pd.DataFrame({\'target\': test_pred})\nresult.to_csv(\'/app/predictions.csv\', index=False)\nprint("Predictions saved to /app/predictions.csv")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
