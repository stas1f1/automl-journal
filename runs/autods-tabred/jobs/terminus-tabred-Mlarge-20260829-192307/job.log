Sending keys: ['cat > train_model.py << \'EOF\'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.ensemble import GradientBoostingClassifier\nfrom sklearn.preprocessing import LabelEncoder\nimport warnings\nwarnings.filterwarnings(\'ignore\')\n\n# Load data\nprint("Loading data...")\ntrain = pd.read_csv(\'/app/data/train.csv\')\nval = pd.read_csv(\'/app/data/val.csv\')\ntest = pd.read_csv(\'/app/data/test.csv\')\n\nprint(f"Train shape: {train.shape}")\nprint(f"Val shape: {val.shape}")\nprint(f"Test shape: {test.shape}")\n\n# Identify feature types\nnum_features = [c for c in train.columns if c.startswith(\'num_\')]\nbin_features = [c for c in train.columns if c.startswith(\'bin_\')]\ncat_features = [c for c in train.columns if c.startswith(\'cat_\')]\n\nprint(f"Num features: {len(num_features)}")\nprint(f"Bin features: {len(bin_features)}")\nprint(f"Cat features: {len(cat_features)}")\n\n# Prepare features\nfeature_cols = num_features + bin_features + cat_features\n\nX_train = train[feature_cols].copy()\ny_train = train[\'target\'].values\nX_val = val[feature_cols].copy()\ny_val = val[\'target\'].values\nX_test = test[feature_cols].copy()\n\n# Handle numerical missing values with median\nfor col in num_features:\n    median_val = X_train[col].median()\n    if pd.isna(median_val):\n        median_val = 0\n    X_train[col] = X_train[col].fillna(median_val)\n    X_val[col] = X_val[col].fillna(median_val)\n    X_test[col] = X_test[col].fillna(median_val)\n\n# Handle binary missing values\nfor col in bin_features:\n    X_train[col] = X_train[col].fillna(0)\n    X_val[col] = X_val[col].fillna(0)\n    X_test[col] = X_test[col].fillna(0)\n\n# Handle categorical features with label encoding\nlabel_encoders = {}\nfor col in cat_features:\n    le = LabelEncoder()\n    # Combine train, val, test for consistent encoding\n    combined = pd.concat([X_train[col].astype(str), X_val[col].astype(str), X_test[col].astype(str)])\n    le.fit(combined)\n    X_train[col] = le.transform(X_train[col].astype(str))\n    X_val[col] = le.transform(X_val[col].astype(str))\n    X_test[col] = le.transform(X_test[col].astype(str))\n    label_encoders[col] = le\n\nprint("Training GradientBoostingClassifier...")\nmodel = GradientBoostingClassifier(\n    n_estimators=200,\n    max_depth=5,\n    learning_rate=0.1,\n    subsample=0.8,\n    random_state=42\n)\nmodel.fit(X_train, y_train)\n\n# Validate\nfrom sklearn.metrics import roc_auc_score\nval_preds = model.predict_proba(X_val)[:, 1]\nval_auc = roc_auc_score(y_val, val_preds)\nprint(f"Validation ROC-AUC: {val_auc:.4f}")\n\n# Predict on test\ntest_preds = model.predict_proba(X_test)[:, 1]\nprint(f"Test predictions shape: {test_preds.shape}")\nprint(f"Test predictions range: [{test_preds.min():.4f}, {test_preds.max():.4f}]")\n\n# Save predictions\nresult = pd.DataFrame({\'target\': test_preds})\nresult.to_csv(\'/app/predictions.csv\', index=False)\nprint("Saved predictions to /app/predictions.csv")\nprint(f"Output has {len(result)} rows")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
