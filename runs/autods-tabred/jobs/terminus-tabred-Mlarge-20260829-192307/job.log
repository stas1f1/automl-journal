Sending keys: ['cat > /workspace/train_model.py << \'EOF\'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import mean_squared_error\nimport warnings\nwarnings.filterwarnings(\'ignore\')\n\n# Load data\nprint("Loading data...")\ntrain_df = pd.read_csv(\'/app/data/train.csv\')\nval_df = pd.read_csv(\'/app/data/val.csv\')\ntest_df = pd.read_csv(\'/app/data/test.csv\')\n\nprint(f"Train shape: {train_df.shape}")\nprint(f"Val shape: {val_df.shape}")\nprint(f"Test shape: {test_df.shape}")\n\n# Separate features and target\ny_train = train_df[\'target\'].values\ny_val = val_df[\'target\'].values\n\nX_train = train_df.drop(\'target\', axis=1)\nX_val = val_df.drop(\'target\', axis=1)\nX_test = test_df.copy()\n\nprint(f"Features: {X_train.shape[1]}")\n\n# Identify feature types\nnum_features = [c for c in X_train.columns if c.startswith(\'num_\')]\nbin_features = [c for c in X_train.columns if c.startswith(\'bin_\')]\ncat_features = [c for c in X_train.columns if c.startswith(\'cat_\')]\n\nprint(f"Numerical: {len(num_features)}, Binary: {len(bin_features)}, Categorical: {len(cat_features)}")\n\n# Convert categorical to category dtype for LightGBM\nfor col in cat_features:\n    X_train[col] = X_train[col].astype(\'category\')\n    X_val[col] = X_val[col].astype(\'category\')\n    X_test[col] = X_test[col].astype(\'category\')\n\n# Train with LightGBM\nprint("Training LightGBM model...")\nimport lightgbm as lgb\n\n# Find categorical column indices\ncat_indices = [X_train.columns.get_loc(col) for col in cat_features]\n\ntrain_data = lgb.Dataset(X_train, label=y_train, categorical_feature=cat_indices)\nval_data = lgb.Dataset(X_val, label=y_val, categorical_feature=cat_indices, reference=train_data)\n\nparams = {\n    \'objective\': \'regression\',\n    \'metric\': \'rmse\',\n    \'boosting_type\': \'gbdt\',\n    \'num_leaves\': 64,\n    \'learning_rate\': 0.1,\n    \'feature_fraction\': 0.8,\n    \'bagging_fraction\': 0.8,\n    \'bagging_freq\': 1,\n    \'verbosity\': -1,\n    \'random_state\': 42\n}\n\nmodel = lgb.train(\n    params,\n    train_data,\n    num_boost_round=500,\n    valid_sets=[val_data],\n    callbacks=[\n        lgb.early_stopping(stopping_rounds=30, verbose=False),\n        lgb.log_evaluation(100)\n    ]\n)\n\n# Validate\nval_preds = model.predict(X_val)\nval_rmse = np.sqrt(mean_squared_error(y_val, val_preds))\nprint(f"Validation RMSE: {val_rmse:.6f}")\n\n# Generate test predictions\nprint("Generating test predictions...")\ntest_preds = model.predict(X_test)\n\nprint(f"Test predictions shape: {test_preds.shape}")\nprint(f"Test predictions - finite: {np.isfinite(test_preds).all()}")\nprint(f"Test predictions - min: {test_preds.min():.4f}, max: {test_preds.max():.4f}")\n\n# Save predictions\nresult_df = pd.DataFrame({\'target\': test_preds})\nresult_df.to_csv(\'/app/predictions.csv\', index=False)\nprint(f"Saved {len(result_df)} predictions to /app/predictions.csv")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
