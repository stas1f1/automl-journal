Sending keys: ['cat > train_model.py << \'EOF\'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.ensemble import GradientBoostingRegressor, HistGradientBoostingRegressor\nfrom sklearn.preprocessing import LabelEncoder\nimport warnings\nwarnings.filterwarnings(\'ignore\')\n\nprint("Loading data...")\ntrain = pd.read_csv(\'/app/data/train.csv\')\nval = pd.read_csv(\'/app/data/val.csv\')\ntest = pd.read_csv(\'/app/data/test.csv\')\n\nprint(f"Train shape: {train.shape}")\nprint(f"Val shape: {val.shape}")\nprint(f"Test shape: {test.shape}")\n\n# Identify feature types\nnum_cols = [c for c in train.columns if c.startswith(\'num_\')]\nbin_cols = [c for c in train.columns if c.startswith(\'bin_\')]\ncat_cols = [c for c in train.columns if c.startswith(\'cat_\')]\n\nprint(f"Numerical: {len(num_cols)}, Binary: {len(bin_cols)}, Categorical: {len(cat_cols)}")\n\n# Combine train and val for training\nX_train_full = pd.concat([train, val], ignore_index=True)\ny_train_full = X_train_full[\'target\'].values\nX_train_full = X_train_full.drop(columns=[\'target\'])\n\n# Prepare test data\nX_test = test.copy()\n\n# Handle categorical features - label encode\nfor col in cat_cols:\n    le = LabelEncoder()\n    # Fit on combined data\n    combined = pd.concat([X_train_full[col], X_test[col]], axis=0).astype(str)\n    le.fit(combined)\n    X_train_full[col] = le.transform(X_train_full[col].astype(str))\n    X_test[col] = le.transform(X_test[col].astype(str))\n\n# Fill missing values with median for numerical columns\nfor col in num_cols:\n    median_val = X_train_full[col].median()\n    if pd.isna(median_val):\n        median_val = 0\n    X_train_full[col] = X_train_full[col].fillna(median_val)\n    X_test[col] = X_test[col].fillna(median_val)\n\n# Fill missing binary/categorical with 0\nfor col in bin_cols + cat_cols:\n    X_train_full[col] = X_train_full[col].fillna(0)\n    X_test[col] = X_test[col].fillna(0)\n\nprint("Training HistGradientBoostingRegressor...")\nmodel = HistGradientBoostingRegressor(\n    max_iter=200,\n    max_depth=10,\n    learning_rate=0.1,\n    random_state=42\n)\n\nmodel.fit(X_train_full, y_train_full)\n\nprint("Making predictions...")\npredictions = model.predict(X_test)\n\nprint(f"Predictions shape: {predictions.shape}")\nprint(f"Predictions range: {predictions.min():.4f} to {predictions.max():.4f}")\nprint(f"Any NaN predictions: {np.isnan(predictions).any()}")\nprint(f"Any inf predictions: {np.isinf(predictions).any()}")\n\n# Save predictions\nresult = pd.DataFrame({\'target\': predictions})\nresult.to_csv(\'/app/predictions.csv\', index=False)\n\nprint("Saved predictions to /app/predictions.csv")\nprint(f"Output shape: {result.shape}")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
