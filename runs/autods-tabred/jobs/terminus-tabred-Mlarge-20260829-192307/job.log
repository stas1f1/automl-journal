oncat([X_train[col], X_val[col], X_test[col]], axis=0).fillna(\'unknown\').astype(str)\n    le.fit(all_values)\n    X_train[col] = le.transform(X_train[col].fillna(\'unknown\').astype(str))\n    X_val[col] = le.transform(X_val[col].fillna(\'unknown\').astype(str))\n    X_test[col] = le.transform(X_test[col].fillna(\'unknown\').astype(str))\n    label_encoders[col] = le\n\nprint("Data preprocessing complete.")\n\n# Try LightGBM first\ntry:\n    import lightgbm as lgb\n    print("\\nTraining LightGBM model...")\n    \n    # Create LightGBM datasets\n    train_data = lgb.Dataset(X_train, label=y_train, categorical_feature=cat_features)\n    val_data = lgb.Dataset(X_val, label=y_val, categorical_feature=cat_features, reference=train_data)\n    \n    # Parameters\n    params = {\n        \'objective\': \'regression\',\n        \'metric\': \'rmse\',\n        \'boosting_type\': \'gbdt\',\n        \'num_leaves\': 64,\n        \'max_depth\': -1,\n        \'learning_rate\': 0.1,\n        \'feature_fraction\': 0.8,\n        \'bagging_fraction\': 0.8,\n        \'bagging_freq\': 5,\n        \'verbose\': -1,\n        \'num_threads\': 4\n    }\n    \n    # Train with early stopping\n    model = lgb.train(\n        params,\n        train_data,\n        num_boost_round=2000,\n        valid_sets=[val_data],\n        callbacks=[lgb.early_stopping(stopping_rounds=50), lgb.log_evaluation(100)]\n    )\n    \n    # Predict\n    test_predictions = model.predict(X_test)\n    \n    # Validation RMSE\n    val_predictions = model.predict(X_val)\n    val_rmse = np.sqrt(np.mean((val_predictions - y_val)**2))\n    print(f"Validation RMSE: {val_rmse:.6f}")\n    \nexcept Exception as e:\n    print(f"LightGBM failed: {e}")\n    print("\\nTrying sklearn\'s GradientBoostingRegressor...")\n    \n    from sklearn.ensemble import GradientBoostingRegressor\n    from sklearn.metrics import mean_squared_error\n    \n    # Sample data for faster training if needed\n    model = GradientBoostingRegressor(\n        n_estimators=100,\n        max_depth=5,\n        learning_rate=0.1,\n        random_state=42\n    )\n    \n    model.fit(X_train, y_train)\n    \n    val_predictions = model.predict(X_val)\n    val_rmse = np.sqrt(mean_squared_error(y_val, val_predictions))\n    print(f"Validation RMSE: {val_rmse:.6f}")\n    \n    test_predictions = model.predict(X_test)\n\n# Save predictions\nprint(f"\\nPredictions stats: mean={test_predictions.mean():.4f}, std={test_predictions.std():.4f}")\nprint(f"Finite predictions: {np.isfinite(test_predictions).sum()} / {len(test_predictions)}")\n\n# Ensure all predictions are finite\ntest_predictions = np.nan_to_num(test_predictions, nan=y_train.mean())\n\n# Create output dataframe\noutput = pd.DataFrame({\'target\': test_predictions})\noutput.to_csv(\'/app/predictions.csv\', index=False)\n\nprint(f"\\nPredictions saved to /app/predictions.csv")\nprint(f"Output shape: {output.shape}")\nprint(output.head())\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
