Sending keys: ['cat > /app/train_model.py << \'EOF\'\nimport pandas as pd\nimport numpy as np\nimport lightgbm as lgb\nfrom sklearn.metrics import mean_squared_error\n\nprint("Loading data...")\ntrain_df = pd.read_csv(\'/app/data/train.csv\')\nval_df = pd.read_csv(\'/app/data/val.csv\')\ntest_df = pd.read_csv(\'/app/data/test.csv\')\n\nprint(f"Train shape: {train_df.shape}")\nprint(f"Val shape: {val_df.shape}")\nprint(f"Test shape: {test_df.shape}")\n\n# Separate features and target\nX_train = train_df.drop(\'target\', axis=1)\ny_train = train_df[\'target\']\nX_val = val_df.drop(\'target\', axis=1)\ny_val = val_df[\'target\']\nX_test = test_df\n\nprint(f"X_train shape: {X_train.shape}")\nprint(f"X_val shape: {X_val.shape}")\nprint(f"X_test shape: {X_test.shape}")\n\n# Identify categorical columns\ncat_cols = [c for c in X_train.columns if c.startswith(\'cat_\')]\nfor col in cat_cols:\n    X_train[col] = X_train[col].astype(\'category\')\n    X_val[col] = X_val[col].astype(\'category\')\n    X_test[col] = X_test[col].astype(\'category\')\n\n# Create LightGBM datasets\ntrain_data = lgb.Dataset(X_train, label=y_train, categorical_feature=cat_cols)\nval_data = lgb.Dataset(X_val, label=y_val, categorical_feature=cat_cols, reference=train_data)\n\n# Parameters\nparams = {\n    \'objective\': \'regression\',\n    \'metric\': \'rmse\',\n    \'boosting_type\': \'gbdt\',\n    \'num_leaves\': 127,\n    \'learning_rate\': 0.05,\n    \'feature_fraction\': 0.8,\n    \'bagging_fraction\': 0.8,\n    \'bagging_freq\': 5,\n    \'verbosity\': -1,\n    \'random_state\': 42\n}\n\nprint("Training model...")\nmodel = lgb.train(\n    params,\n    train_data,\n    num_boost_round=1000,\n    valid_sets=[val_data],\n    callbacks=[\n        lgb.early_stopping(stopping_rounds=50, verbose=False),\n        lgb.log_evaluation(100)\n    ]\n)\n\n# Validate\nval_pred = model.predict(X_val)\nval_rmse = np.sqrt(mean_squared_error(y_val, val_pred))\nprint(f"Validation RMSE: {val_rmse:.6f}")\n\n# Predict on test\ntest_pred = model.predict(X_test)\nprint(f"Test predictions shape: {test_pred.shape}")\nprint(f"Finite predictions: {np.isfinite(test_pred).sum()} / {len(test_pred)}")\n\n# Save predictions\nresult_df = pd.DataFrame({\'target\': test_pred})\nresult_df.to_csv(\'/app/predictions.csv\', index=False)\nprint("Predictions saved to /app/predictions.csv")\nprint(f"Output shape: {result_df.shape}")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
