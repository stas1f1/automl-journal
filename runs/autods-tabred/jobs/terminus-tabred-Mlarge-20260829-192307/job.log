Sending keys: ['cat > /app/train_model.py << \'EOF\'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.ensemble import GradientBoostingRegressor, RandomForestRegressor\nfrom sklearn.preprocessing import LabelEncoder\nimport warnings\nwarnings.filterwarnings(\'ignore\')\n\n# Load data\nprint("Loading data...")\ntrain = pd.read_csv(\'/app/data/train.csv\')\nval = pd.read_csv(\'/app/data/val.csv\')\ntest = pd.read_csv(\'/app/data/test.csv\')\n\nprint(f"Train shape: {train.shape}")\nprint(f"Val shape: {val.shape}")\nprint(f"Test shape: {test.shape}")\n\n# Separate target\ny_train = train[\'target\'].values\ny_val = val[\'target\'].values\nX_train = train.drop(\'target\', axis=1)\nX_val = val.drop(\'target\', axis=1)\nX_test = test.copy()\n\n# Identify feature types\nnum_cols = [c for c in X_train.columns if c.startswith(\'num_\')]\nbin_cols = [c for c in X_train.columns if c.startswith(\'bin_\')]\ncat_cols = [c for c in X_train.columns if c.startswith(\'cat_\')]\n\nprint(f"Numerical: {len(num_cols)}, Binary: {len(bin_cols)}, Categorical: {len(cat_cols)}")\n\n# Fill missing numerical values with median\nfor col in num_cols:\n    median_val = X_train[col].median()\n    if pd.isna(median_val):\n        median_val = 0\n    X_train[col] = X_train[col].fillna(median_val)\n    X_val[col] = X_val[col].fillna(median_val)\n    X_test[col] = X_test[col].fillna(median_val)\n\n# Fill binary with 0\nfor col in bin_cols:\n    X_train[col] = X_train[col].fillna(0)\n    X_val[col] = X_val[col].fillna(0)\n    X_test[col] = X_test[col].fillna(0)\n\n# Encode categorical features\nfor col in cat_cols:\n    le = LabelEncoder()\n    # Combine all data to fit encoder\n    all_values = pd.concat([X_train[col], X_val[col], X_test[col]]).astype(str)\n    le.fit(all_values)\n    X_train[col] = le.transform(X_train[col].astype(str))\n    X_val[col] = le.transform(X_val[col].astype(str))\n    X_test[col] = le.transform(X_test[col].astype(str))\n\nprint("Training model...")\n# Use Gradient Boosting Regressor\nmodel = GradientBoostingRegressor(\n    n_estimators=200,\n    max_depth=6,\n    learning_rate=0.1,\n    min_samples_split=10,\n    min_samples_leaf=5,\n    random_state=42,\n    verbose=1\n)\n\nmodel.fit(X_train, y_train)\n\n# Validate\nval_preds = model.predict(X_val)\nrmse = np.sqrt(np.mean((val_preds - y_val)**2))\nprint(f"Validation RMSE: {rmse:.6f}")\n\n# Predict on test\ntest_preds = model.predict(X_test)\nprint(f"Test predictions shape: {test_preds.shape}")\nprint(f"All finite: {np.all(np.isfinite(test_preds))}")\n\n# Save predictions\nresult = pd.DataFrame({\'target\': test_preds})\nresult.to_csv(\'/app/predictions.csv\', index=False)\nprint("Saved predictions to /app/predictions.csv")\nprint(result.head())\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
