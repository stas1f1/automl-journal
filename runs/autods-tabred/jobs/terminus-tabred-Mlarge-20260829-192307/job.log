Sending keys: ['cat > /workspace/train_model.py << \'EOF\'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.preprocessing import LabelEncoder\nimport warnings\nwarnings.filterwarnings(\'ignore\')\n\n# Load data\nprint("Loading data...")\ntrain = pd.read_csv(\'/app/data/train.csv\')\nval = pd.read_csv(\'/app/data/val.csv\')\ntest = pd.read_csv(\'/app/data/test.csv\')\n\nprint(f"Train shape: {train.shape}")\nprint(f"Val shape: {val.shape}")\nprint(f"Test shape: {test.shape}")\n\n# Identify feature types\nnum_features = [c for c in train.columns if c.startswith(\'num_\')]\nbin_features = [c for c in train.columns if c.startswith(\'bin_\')]\ncat_features = [c for c in train.columns if c.startswith(\'cat_\')]\n\nprint(f"Numerical features: {len(num_features)}")\nprint(f"Binary features: {len(bin_features)}")\nprint(f"Categorical features: {len(cat_features)}")\n\n# Separate target\ny_train = train[\'target\'].values\ny_val = val[\'target\'].values\nX_train = train.drop(\'target\', axis=1)\nX_val = val.drop(\'target\', axis=1)\nX_test = test.copy()\n\n# Fill missing numerical values with median\nfor col in num_features:\n    median_val = X_train[col].median()\n    if pd.isna(median_val):\n        median_val = 0\n    X_train[col] = X_train[col].fillna(median_val)\n    X_val[col] = X_val[col].fillna(median_val)\n    X_test[col] = X_test[col].fillna(median_val)\n\n# Fill missing binary features with 0\nfor col in bin_features:\n    X_train[col] = X_train[col].fillna(0)\n    X_val[col] = X_val[col].fillna(0)\n    X_test[col] = X_test[col].fillna(0)\n\n# Encode categorical features\nlabel_encoders = {}\nfor col in cat_features:\n    le = LabelEncoder()\n    # Fit on combined data to handle all categories\n    combined = pd.concat([X_train[col], X_val[col], X_test[col]], axis=0).astype(str)\n    le.fit(combined)\n    X_train[col] = le.transform(X_train[col].astype(str))\n    X_val[col] = le.transform(X_val[col].astype(str))\n    X_test[col] = le.transform(X_test[col].astype(str))\n    label_encoders[col] = le\n\n# Try using LightGBM\ntry:\n    import lightgbm as lgb\n    print("\\nTraining LightGBM...")\n    \n    # Create dataset\n    train_data = lgb.Dataset(X_train, label=y_train, categorical_feature=cat_features)\n    val_data = lgb.Dataset(X_val, label=y_val, categorical_feature=cat_features, reference=train_data)\n    \n    # Parameters\n    params = {\n        \'objective\': \'binary\',\n        \'metric\': \'auc\',\n        \'boosting_type\': \'gbdt\',\n        \'num_leaves\': 64,\n        \'max_depth\': 8,\n        \'learning_rate\': 0.1,\n        \'feature_fraction\': 0.8,\n        \'bagging_fraction\': 0.8,\n        \'bagging_freq\': 5,\n        \'verbose\': -1,\n        \'seed\': 42\n    }\n    \n    # Train\n    model = lgb.train(\n        params,\n        train_data,\n        num_boost_round=500,\n        valid_sets=[train_data, val_data],\n        callbacks=[\n            lgb.early_stopping(stopping_rounds=30, verbose=False),\n            lgb.log_evaluation(period=100)\n        ]\n    )\n    \n    # Validate\n    val_preds = model.predict(X_val)\n    from sklearn.metrics import roc_auc_score\n    val_auc = roc_auc_score(y_val, val_preds)\n    print(f"\\nValidation ROC-AUC: {val_auc:.6f}")\n    \n    # Predict on test\n    test_preds = model.predict(X_test)\n    \nexcept ImportError:\n    print("LightGBM not available, using XGBoost...")\n    import xgboost as xgb\n    \n    dtrain = xgb.DMatrix(X_train, label=y_train)\n    dval = xgb.DMatrix(X_val, label=y_val)\n    dtest = xgb.DMatrix(X_test)\n    \n    params = {\n        \'objective\': \'binary:logistic\',\n        \'eval_metric\': \'auc\',\n        \'max_depth\': 8,\n        \'eta\': 0.1,\n        \'subsample\': 0.8,\n        \'colsample_bytree\': 0.8,\n        \'seed\': 42,\n        \'tree_method\': \'hist\'\n    }\n    \n    model = xgb.train(\n        params,\n        dtrain,\n        num_boost_round=500,\n        evals=[(dtrain, \'train\'), (dval, \'val\')],\n        early_stopping_rounds=30,\n        verbose_eval=100\n    )\n    \n    val_preds = model.predict(dval)\n    from sklearn.metrics import roc_auc_score\n    val_auc = roc_auc_score(y_val, val_preds)\n    print(f"\\nValidation ROC-AUC: {val_auc:.6f}")\n    \n    test_preds = model.predict(dtest)\n\n# Save predictions\nprint(f"\\nSaving predictions...")\nprint(f"Test predictions shape: {test_preds.shape}")\nprint(f"Test predictions finite: {np.isfinite(test_preds).all()}")\nprint(f"Test predictions range: [{test_preds.min():.4f}, {test_preds.max():.4f}]")\n\nresult = pd.DataFrame({\'target\': test_preds})\nresult.to_csv(\'/app/predictions.csv\', index=False)\nprint("Predictions saved to /app/predictions.csv")\nprint(f"Output shape: {result.shape}")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
