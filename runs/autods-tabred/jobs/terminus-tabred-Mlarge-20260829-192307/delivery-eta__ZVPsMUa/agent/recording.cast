[44.517104, "o", "# Separate features and target\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.517181, "o", "> "]
[44.517251, "o", "y_train = train_df['target'].values\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.51733, "o", "y_val = val_df['target'].values\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.517398, "o", "X_train = train_df.drop('target', axis=1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.517471, "o", "X_val = val_df.drop('target', axis=1)\r\n\u001b[?2004l\r"]
[44.517543, "o", "\u001b[?2004h> "]
[44.517604, "o", "X_test = test_df.copy()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.517667, "o", "print(f\"Features: {X_train.shape[1]}\")\r\n\u001b[?2004l\r"]
[44.517723, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[44.517793, "o", "> # Identify feature types\r\n\u001b[?2004l\r"]
[44.517851, "o", "\u001b[?2004h> "]
[44.517911, "o", "num_features = [c for c in X_train.columns if c.startswith('num_')]\r\n\u001b[?2004l\r"]
[44.519041, "o", "\u001b[?2004h> "]
[44.519134, "o", "bin_features = [c for c in X_train.columns if c.startswith('bin_')]\r\n\u001b[?2004l\r\u001b[?2004h> cat_features = [c for c in X_train.columns if c.startswith('cat_')]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Numerical: {len(num_features)}, Binary: {len(bin_features)}, Categorical: {len(cat_features)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Convert categorical to category dtype for LightGBM\r\n\u001b[?2004l\r\u001b[?2004h> for col in cat_features:\r\n\u001b[?2004l\r\u001b[?2004h>     X_train[col] = X_train[col].astype('category')\r\n\u001b[?2004l\r\u001b[?2004h>     X_val[col] = X_val[col].astype('category')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.519168, "o", "    X_test[col] = X_test[col].astype('category')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.519268, "o", "# Train with LightGBM\r\n\u001b[?2004l\r"]
[44.519341, "o", "\u001b[?2004h> print(\"Training LightGBM model...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.519407, "o", "> import lightgbm as lgb\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[44.519493, "o", "\u001b[?2004h> "]
[44.519558, "o", "# Find categorical column indices\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.519623, "o", "cat_indices = [X_train.columns.get_loc(col) for col in cat_features]\r\n\u001b[?2004l\r"]
[44.519679, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[44.519748, "o", "> "]
[44.519822, "o", "train_data = lgb.Dataset(X_train, label=y_train, categorical_feature=cat_indices)\r\n\u001b[?2004l\r"]
[44.519882, "o", "\u001b[?2004h> "]
[44.520037, "o", "val_data = lgb.Dataset(X_val, label=y_val, categorical_feature=cat_indices, reference=train_data)\r\n\u001b[?2004l\r"]
[44.520108, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[44.520164, "o", "> params = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.520234, "o", "    'objective': 'regression',\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.520293, "o", ">     'metric': 'rmse',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.520351, "o", "    'boosting_type': 'gbdt',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.520413, "o", "    'num_leaves': 64,\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.520475, "o", "> "]
[44.520544, "o", "    'learning_rate': 0.1,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.520602, "o", "    'feature_fraction': 0.8,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.520659, "o", "    'bagging_fraction': 0.8,\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.52072, "o", ">     'bagging_freq': 1,\r\n\u001b[?2004l\r"]
[44.520777, "o", "\u001b[?2004h>     'verbosity': -1,\r\n"]
[44.520844, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[44.520901, "o", "    'random_state': 42\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[44.520976, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[44.521055, "o", "model = lgb.train(\r\n\u001b[?2004l\r\u001b[?2004h>     params,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.521127, "o", "    train_data,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.521185, "o", "    num_boost_round=500,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.521216, "o", "    valid_sets=[val_data],\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.521239, "o", "> "]
[44.521264, "o", "    callbacks=[\r\n\u001b[?2004l\r"]
[44.521294, "o", "\u001b[?2004h> "]
[44.521445, "o", "        lgb.early_stopping(stopping_rounds=30, verbose=False),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.521516, "o", "        lgb.log_evaluation(100)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.521577, "o", "    ]\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n"]
[44.521635, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.521704, "o", "# Validate\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.521772, "o", "val_preds = model.predict(X_val)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.521846, "o", "val_rmse = np.sqrt(mean_squared_error(y_val, val_preds))\r\n\u001b[?2004l\r"]
[44.521901, "o", "\u001b[?2004h> "]
[44.521964, "o", "print(f\"Validation RMSE: {val_rmse:.6f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.522022, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.522089, "o", "# Generate test predictions\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.522164, "o", "print(\"Generating test predictions...\")\r\n\u001b[?2004l\r"]
[44.52222, "o", "\u001b[?2004h> "]
[44.522277, "o", "test_preds = model.predict(X_test)\r\n\u001b[?2004l\r"]
[44.522345, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.522401, "o", "print(f\"Test predictions shape: {test_preds.shape}\")\r\n\u001b[?2004l\r"]
[44.522479, "o", "\u001b[?2004h> "]
[44.522553, "o", "print(f\"Test predictions - finite: {np.isfinite(test_preds).all()}\")\r\n\u001b[?2004l\r"]
[44.522612, "o", "\u001b[?2004h> "]
[44.522732, "o", "print(f\"Test predictions - min: {test_preds.min():.4f}, max: {test_preds.max():.4f}\")\r\n\u001b[?2004l\r"]
[44.522788, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[44.522845, "o", "> # Save predictions\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.522915, "o", "> "]
[44.522981, "o", "result_df = pd.DataFrame({'target': test_preds})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.523089, "o", "result_df.to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r"]
[44.523146, "o", "\u001b[?2004h> "]
[44.523241, "o", "print(f\"Saved {len(result_df)} predictions to /app/predictions.csv\")\r\n\u001b[?2004l\r"]
[44.523298, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[44.528059, "o", "\u001b[?2004hroot@853767d01834:/workspace# "]
[44.990777, "i", "python3 /workspace/train_model.py\n"]
