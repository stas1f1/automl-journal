[?2004hroot@853767d01834:/workspace# cat > /workspace/train_model.py << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from sklearn.metrics import mean_squared_error
[?2004l[?2004h> import warnings
[?2004l[?2004h> warnings.filterwarnings('ignore')
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> print("Loading data...")
[?2004l[?2004h> train_df = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val_df = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test_df = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Train shape: {train_df.shape}")
[?2004l[?2004h> print(f"Val shape: {val_df.shape}")
[?2004l[?2004h> print(f"Test shape: {test_df.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Separate features and target
[?2004l[?2004h> y_train = train_df['target'].values
[?2004l[?2004h> y_val = val_df['target'].values
[?2004l[?2004h> 
[?2004l[?2004h> X_train = train_df.drop('target', axis=1)
[?2004l[?2004h> X_val = val_df.drop('target', axis=1)
[?2004l[?2004h> X_test = test_df.copy()
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Features: {X_train.shape[1]}")
[?2004l[?2004h> 
[?2004l[?2004h> # Identify feature types
[?2004l[?2004h> num_features = [c for c in X_train.columns if c.startswith('num_')]
[?2004l[?2004h> bin_features = [c for c in X_train.columns if c.startswith('bin_')]
[?2004l[?2004h> cat_features = [c for c in X_train.columns if c.startswith('cat_')]
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Numerical: {len(num_features)}, Binary: {len(bin_features)}, Categorical: {len(cat_features)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Convert categorical to category dtype for LightGBM
[?2004l[?2004h> for col in cat_features:
[?2004l[?2004h>     X_train[col] = X_train[col].astype('category')
[?2004l[?2004h>     X_val[col] = X_val[col].astype('category')
[?2004l[?2004h>     X_test[col] = X_test[col].astype('category')
[?2004l[?2004h> 
[?2004l[?2004h> # Train with LightGBM
[?2004l[?2004h> print("Training LightGBM model...")
[?2004l[?2004h> import lightgbm as lgb
[?2004l[?2004h> 
[?2004l[?2004h> # Find categorical column indices
[?2004l[?2004h> cat_indices = [X_train.columns.get_loc(col) for col in cat_features]
[?2004l[?2004h> 
[?2004l[?2004h> train_data = lgb.Dataset(X_train, label=y_train, categorical_feature=cat_indices)
[?2004l[?2004h> val_data = lgb.Dataset(X_val, label=y_val, categorical_feature=cat_indices, reference=train_data)
[?2004l[?2004h> 
[?2004l[?2004h> params = {
[?2004l[?2004h>     'objective': 'regression',
[?2004l[?2004h>     'metric': 'rmse',
[?2004l[?2004h>     'boosting_type': 'gbdt',
[?2004l[?2004h>     'num_leaves': 64,
[?2004l[?2004h>     'learning_rate': 0.1,
[?2004l[?2004h>     'feature_fraction': 0.8,
[?2004l[?2004h>     'bagging_fraction': 0.8,
[?2004l[?2004h>     'bagging_freq': 1,
[?2004l[?2004h>     'verbosity': -1,
[?2004l[?2004h>     'random_state': 42
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> model = lgb.train(
[?2004l[?2004h>     params,
[?2004l[?2004h>     train_data,
[?2004l[?2004h>     num_boost_round=500,
[?2004l[?2004h>     valid_sets=[val_data],
[?2004l[?2004h>     callbacks=[
[?2004l[?2004h>         lgb.early_stopping(stopping_rounds=30, verbose=False),
[?2004l[?2004h>         lgb.log_evaluation(100)
[?2004l[?2004h>     ]
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Validate
[?2004l[?2004h> val_preds = model.predict(X_val)
[?2004l[?2004h> val_rmse = np.sqrt(mean_squared_error(y_val, val_preds))
[?2004l[?2004h> print(f"Validation RMSE: {val_rmse:.6f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Generate test predictions
[?2004l[?2004h> print("Generating test predictions...")
[?2004l[?2004h> test_preds = model.predict(X_test)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Test predictions shape: {test_preds.shape}")
[?2004l[?2004h> print(f"Test predictions - finite: {np.isfinite(test_preds).all()}")
[?2004l[?2004h> print(f"Test predictions - min: {test_preds.min():.4f}, max: {test_preds.max():.4f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Save predictions
[?2004l[?2004h> result_df = pd.DataFrame({'target': test_preds})
[?2004l[?2004h> result_df.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> print(f"Saved {len(result_df)} predictions to /app/predictions.csv")
[?2004l[?2004h> EOF
