[41.787938, "i", "cat > /workspace/train_model.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.preprocessing import LabelEncoder\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Load data\nprint(\"Loading data...\")\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nprint(f\"Train shape: {train.shape}\")\nprint(f\"Val shape: {val.shape}\")\nprint(f\"Test shape: {test.shape}\")\n\n# Separate target\ny_train = train['target']\ny_val = val['target']\nX_train = train.drop('target', axis=1)\nX_val = val.drop('target', axis=1)\nX_test = test.copy()\n\nprint(f\"Target stats - Train mean: {y_train.mean():.4f}, std: {y_train.std():.4f}\")\n\n# Identify feature types\nnum_features = [c for c in X_train.columns if c.startswith('num_')]\nbin_features = [c for c in X_train.columns if c.startswith('bin_')]\ncat_features = [c for c in X_train.columns if c.startswith('cat_')]\n\nprint(f\"Numerical features: {len(num_features)}\")\nprint(f\"Binary features: {len(bin_features)}\")\nprint(f\"Categorical features: {len(cat_features)}\")\n\n# Handle missing values in numerical features - fill with median\nfor col in num_features:\n    median_val = X_train[col].median()\n    if pd.isna(median_val):\n        median_val = 0\n    X_train[col] = X_train[col].fillna(median_val)\n    X_val[col] = X_val[col].fillna(median_val)\n    X_test[col] = X_test[col].fillna(median_val)\n\n# Fill binary missing values with mode (or 0)\nfor col in bin_features:\n    mode_val = X_train[col].mode()\n    if len(mode_val) > 0:\n        mode_val = mode_val[0]\n    else:\n        mode_val = 0\n    X_train[col] = X_train[col].fillna(mode_val)\n    X_val[col] = X_val[col].fillna(mode_val)\n    X_test[col] = X_test[col].fillna(mode_val)\n\n# Label encode categorical features\nlabel_encoders = {}\nfor col in cat_features:\n    le = LabelEncoder()\n    # Combine all data to fit encoder\n    all_values = pd.concat([X_train[col], X_val[col], X_test[col]], axis=0).fillna('unknown').astype(str)\n    le.fit(all_values)\n    X_train[col] = le.transform(X_train["]
[41.788895, "o", "cat > /workspace/train_model.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.788975, "o", "> import pandas as pd"]
[41.789019, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np"]
[41.789107, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.789163, "o", "> from sklearn.preprocessing import LabelEncoder"]
[41.789217, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.789303, "o", "> import warnings"]
[41.789363, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> warnings.filterwarnings('ignore')"]
[41.789423, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.789492, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> # Load data"]
[41.789536, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Loading data...\")"]
[41.78962, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.789729, "o", "> train = pd.read_csv('/app/data/train.csv')"]
[41.789752, "i", "col].fillna('unknown').astype(str))\n    X_val[col] = le.transform(X_val[col].fillna('unknown').astype(str))\n    X_test[col] = le.transform(X_test[col].fillna('unknown').astype(str))\n    label_encoders[col] = le\n\nprint(\"Data preprocessing complete.\")\n\n# Try LightGBM first\ntry:\n    import lightgbm as lgb\n    print(\"\\nTraining LightGBM model...\")\n    \n    # Create LightGBM datasets\n    train_data = lgb.Dataset(X_train, label=y_train, categorical_feature=cat_features)\n    val_data = lgb.Dataset(X_val, label=y_val, categorical_feature=cat_features, reference=train_data)\n    \n    # Parameters\n    params = {\n        'objective': 'regression',\n        'metric': 'rmse',\n        'boosting_type': 'gbdt',\n        'num_leaves': 64,\n        'max_depth': -1,\n        'learning_rate': 0.1,\n        'feature_fraction': 0.8,\n        'bagging_fraction': 0.8,\n        'bagging_freq': 5,\n        'verbose': -1,\n        'num_threads': 4\n    }\n    \n    # Train with early stopping\n    model = lgb.train(\n        params,\n        train_data,\n        num_boost_round=2000,\n        valid_sets=[val_data],\n        callbacks=[lgb.early_stopping(stopping_rounds=50), lgb.log_evaluation(100)]\n    )\n    \n    # Predict\n    test_predictions = model.predict(X_test)\n    \n    # Validation RMSE\n    val_predictions = model.predict(X_val)\n    val_rmse = np.sqrt(np.mean((val_predictions - y_val)**2))\n    print(f\"Validation RMSE: {val_rmse:.6f}\")\n    \nexcept Exception as e:\n    print(f\"LightGBM failed: {e}\")\n    print(\"\\nTrying sklearn's GradientBoostingRegressor...\")\n    \n    from sklearn.ensemble import GradientBoostingRegressor\n    from sklearn.metrics import mean_squared_error\n    \n    # Sample data for faster training if needed\n    model = GradientBoostingRegressor(\n        n_estimators=100,\n        max_depth=5,\n        learning_rate=0.1,\n        random_state=42\n    )\n    \n    model.fit(X_train, y_train)\n    \n    val_predictions = model.predict(X_val)\n    val_rmse = np.sqrt(mean_squared_error(y_val, val_predictions))\n    print(f\"Validation RMSE: {val_rmse:.6f}\")\n    \n    test_predictions = model.predict(X_test)\n\n# Save predictions\nprint(f\"\\nPredictions stats: mean={test_predictions.mean():.4f}, std={test_predictions.std():.4f}\")\nprint(f\"Finite predictions: {np.isfinite(test_predictions).sum()} / {len(test_predictions)}\")\n\n# Ensure all predictions are finite\ntest_predictions = np.nan_to_num(test_predictions, nan=y_train.mean())\n\n# Create output dataframe\noutput = pd.DataFrame({'target': test_predictions})\noutput.to_csv('/app/predictions.csv', index=False)\n\nprint(f\"\\nPredictions saved to /app/predictions.csv\")\nprint(f\"Output shape: {output.shape}\")\nprint(output.head())\nEOF\n"]
