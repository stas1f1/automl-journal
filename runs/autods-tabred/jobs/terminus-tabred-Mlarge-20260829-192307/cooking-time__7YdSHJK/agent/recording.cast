[41.801081, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.801178, "o", ">     \r\n"]
[41.801224, "o", "\u001b[?2004l\r\u001b[?2004h>     # Sample data for faster training if needed"]
[41.801304, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.801347, "o", ">     model = GradientBoostingRegressor("]
[41.801408, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.80146, "o", ">         n_estimators=100,"]
[41.801509, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.801581, "o", "        max_depth=5,"]
[41.801631, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         learning_rate=0.1,"]
[41.801694, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.801743, "o", ">         random_state=42"]
[41.801794, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     )"]
[41.801868, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[41.80191, "o", "\u001b[?2004h>     model.fit(X_train, y_train)"]
[41.801961, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.802035, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.802078, "o", "    val_predictions = model.predict(X_val)"]
[41.802196, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.802241, "o", ">     val_rmse = np.sqrt(mean_squared_error(y_val, val_predictions))"]
[41.802295, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.802362, "o", "> "]
[41.802412, "o", "    print(f\"Validation RMSE: {val_rmse:.6f}\")"]
[41.802459, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.802535, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.802577, "o", "    test_predictions = model.predict(X_test)"]
[41.802656, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.802693, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> # Save predictions"]
[41.802842, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.802885, "o", "> print(f\"\\nPredictions stats: mean={test_predictions.mean():.4f}, std={test_predictions.std():.4f}\")"]
[41.802915, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.803071, "o", "> "]
[41.803122, "o", "print(f\"Finite predictions: {np.isfinite(test_predictions).sum()} / {len(test_predictions)}\")"]
[41.803172, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[41.803223, "o", "\u001b[?2004h> "]
[41.803375, "o", "# Ensure all predictions are finite\r\n"]
[41.803415, "o", "\u001b[?2004l\r\u001b[?2004h> test_predictions = np.nan_to_num(test_predictions, nan=y_train.mean())"]
[41.803457, "o", "\r\n\u001b[?2004l\r"]
[41.803498, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[41.803553, "o", "\u001b[?2004h> "]
[41.803663, "o", "# Create output dataframe"]
[41.803708, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> output = pd.DataFrame({'target': test_predictions})"]
[41.803757, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.803827, "o", "> "]
[41.803869, "o", "output.to_csv('/app/predictions.csv', index=False)"]
[41.803976, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.804019, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"\\nPredictions saved to /app/predictions.csv\")"]
[41.804061, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.804125, "o", "> "]
[41.804203, "o", "print(f\"Output shape: {output.shape}\")"]
[41.80425, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> print(output.head())"]
[41.804473, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.804519, "o", "> EOF\r\n\u001b[?2004l\r"]
