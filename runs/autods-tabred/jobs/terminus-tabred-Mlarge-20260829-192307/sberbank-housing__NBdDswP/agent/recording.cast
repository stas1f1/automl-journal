[28.250924, "i", "cat > /workspace/train_model.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.ensemble import GradientBoostingRegressor\nfrom sklearn.impute import SimpleImputer\nfrom sklearn.preprocessing import StandardScaler\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Load data\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nprint(f\"Train shape: {train.shape}\")\nprint(f\"Val shape: {val.shape}\")\nprint(f\"Test shape: {test.shape}\")\n\n# Separate features and target\ntarget_col = 'target'\nfeature_cols = [col for col in train.columns if col != target_col]\n\nX_train = train[feature_cols]\ny_train = train[target_col]\nX_val = val[feature_cols]\ny_val = val[target_col]\nX_test = test[feature_cols]\n\nprint(f\"Features: {len(feature_cols)}\")\n\n# Impute missing values\nimputer = SimpleImputer(strategy='median')\nX_train_imputed = imputer.fit_transform(X_train)\nX_val_imputed = imputer.transform(X_val)\nX_test_imputed = imputer.transform(X_test)\n\n# Scale features\nscaler = StandardScaler()\nX_train_scaled = scaler.fit_transform(X_train_imputed)\nX_val_scaled = scaler.transform(X_val_imputed)\nX_test_scaled = scaler.transform(X_test_imputed)\n\n# Train model\nmodel = GradientBoostingRegressor(\n    n_estimators=200,\n    max_depth=5,\n    learning_rate=0.1,\n    random_state=42\n)\n\nprint(\"Training model...\")\nmodel.fit(X_train_scaled, y_train)\n\n# Validate\nval_preds = model.predict(X_val_scaled)\nrmse = np.sqrt(np.mean((val_preds - y_val) ** 2))\nprint(f\"Validation RMSE: {rmse:.4f}\")\n\n# Predict on test\ntest_preds = model.predict(X_test_scaled)\nprint(f\"Test predictions: {len(test_preds)}\")\nprint(f\"Min: {test_preds.min():.2f}, Max: {test_preds.max():.2f}\")\nprint(f\"Has NaN: {np.isnan(test_preds).any()}\")\n\n# Save predictions\nresult_df = pd.DataFrame({'target': test_preds})\nresult_df.to_csv('/app/predictions.csv', index=False)\nprint(\"Saved predictions to /app/predictions.csv\")\nEOF\n"]
[28.25178, "o", "cat > /workspace/train_model.py << 'EOF'"]
