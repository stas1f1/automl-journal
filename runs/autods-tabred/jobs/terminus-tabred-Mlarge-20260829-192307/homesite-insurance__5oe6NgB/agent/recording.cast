[337.370608, "i", "cat > train_model.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.preprocessing import LabelEncoder\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Load data\nprint(\"Loading data...\")\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nprint(f\"Train shape: {train.shape}\")\nprint(f\"Val shape: {val.shape}\")\nprint(f\"Test shape: {test.shape}\")\n\n# Identify feature types\nnum_features = [c for c in train.columns if c.startswith('num_')]\nbin_features = [c for c in train.columns if c.startswith('bin_')]\ncat_features = [c for c in train.columns if c.startswith('cat_')]\n\nprint(f\"Num features: {len(num_features)}\")\nprint(f\"Bin features: {len(bin_features)}\")\nprint(f\"Cat features: {len(cat_features)}\")\n\n# Prepare features\nfeature_cols = num_features + bin_features + cat_features\n\nX_train = train[feature_cols].copy()\ny_train = train['target'].values\nX_val = val[feature_cols].copy()\ny_val = val['target'].values\nX_test = test[feature_cols].copy()\n\n# Handle numerical missing values with median\nfor col in num_features:\n    median_val = X_train[col].median()\n    if pd.isna(median_val):\n        median_val = 0\n    X_train[col] = X_train[col].fillna(median_val)\n    X_val[col] = X_val[col].fillna(median_val)\n    X_test[col] = X_test[col].fillna(median_val)\n\n# Handle binary missing values\nfor col in bin_features:\n    X_train[col] = X_train[col].fillna(0)\n    X_val[col] = X_val[col].fillna(0)\n    X_test[col] = X_test[col].fillna(0)\n\n# Handle categorical features with label encoding\nlabel_encoders = {}\nfor col in cat_features:\n    le = LabelEncoder()\n    # Combine train, val, test for consistent encoding\n    combined = pd.concat([X_train[col].astype(str), X_val[col].astype(str), X_test[col].astype(str)])\n    le.fit(combined)\n    X_train[col] = le.transform(X_train[col].astype(str))\n    X_val[col] = le.transform(X_val[col].astype(str))\n    X_test[col] = le.transform(X_test[col].astype(str))\n    labe"]
[337.370958, "o", "cat > train_model.py << 'EOF'\r\nimport pandas as pd\r\nimport numpy as np\r\nfrom sklearn.ensemble import RandomForestClassifier\r\nfrom sklearn.preprocessing import LabelEncoder\r\nimport warnings\r\nwarnings.filterwarnings('ignore')\r\n\r\n# Load data\r\nprint(\"Loading data...\")\r\ntrain = pd.read_csv('/app/data/train.csv')\r\nval = pd.read_csv('/app/data/val.csv')\r\ntest = pd.read_csv('/app/data/test.csv')\r\n\r\nprint(f\"Train shape: {train.shape}\")\r\nprint(f\"Val shape: {val.shape}\")\r\nprint(f\"Test shape: {test.shape}\")\r\n\r\n# Identify feature types\r\nnum_features = [c for c in train.columns if c.startswith('num_')]\r\nbin_features = [c for c in train.columns if c.startswith('bin_')]\r\ncat_features = [c for c in train.columns if c.startswith('cat_')]\r\n\r\nprint(f\"Num features: {len(num_features)}\")\r\nprint(f\"Bin features: {len(bin_features)}\")\r\nprint(f\"Cat features: {len(cat_features)}\")\r\n\r\n# Prepare features\r\nfeature_cols = num_features + bin_features + cat_features\r\n\r\nX_train = train[feature_cols].copy()\r\ny_train = train['target'].values\r\nX_val = val[feature_cols].copy()\r\ny_val = val['target'].values\r\nX_test = test[feature_cols].copy()\r\n\r\n# Handle numerical missing values with median\r\nfor col in num_features:\r\n    median_val = X_train[col].median()\r\n    if pd.isna(median_val):\r\n        median_val = 0\r\n    X_train[col] = X_train[col].fillna(median_val)\r\n    X_val[col] = X_val[col].fillna(median_val)\r\n    X_test[col] = X_test[col].fillna(median_val)\r\n\r\n# Handle binary missing values\r\nfor col in bin_features:\r\n    X_train[col] = X_train[col].fillna(0)\r\n    X_val[col] = X_val[col].fillna(0)\r\n    X_test[col] = X_test[col].fillna(0)\r\n\r\n# Handle categorical features with label encoding\r\nlabel_encoders = {}\r\nfor col in cat_features:\r\n    le = LabelEncoder()\r\n    # Combine train, val, test for consistent encoding\r\n    combined = pd.concat([X_train[col].astype(str), X_val[col].astype(str), X_test[col].astype(str)])\r\n    le.fit(combined)\r\n    X_train[col] = le.transform(X_train[col].astype(str))\r\n    X_val[col] = le.transform(X_val[col].astype(str))\r\n    X_test[col] = le.transform(X_test[col].astype(str))\r\n    labe"]
[337.370999, "i", "l_encoders[col] = le\n\nprint(\"Training RandomForestClassifier...\")\nmodel = RandomForestClassifier(\n    n_estimators=100,\n    max_depth=15,\n    n_jobs=-1,\n    random_state=42,\n    verbose=1\n)\nmodel.fit(X_train, y_train)\n\n# Validate\nfrom sklearn.metrics import roc_auc_score\nval_preds = model.predict_proba(X_val)[:, 1]\nval_auc = roc_auc_score(y_val, val_preds)\nprint(f\"Validation ROC-AUC: {val_auc:.4f}\")\n\n# Predict on test\ntest_preds = model.predict_proba(X_test)[:, 1]\nprint(f\"Test predictions shape: {test_preds.shape}\")\nprint(f\"Test predictions range: [{test_preds.min():.4f}, {test_preds.max():.4f}]\")\n\n# Save predictions\nresult = pd.DataFrame({'target': test_preds})\nresult.to_csv('/app/predictions.csv', index=False)\nprint(\"Saved predictions to /app/predictions.csv\")\nprint(f\"Output has {len(result)} rows\")\nEOF\n"]
[337.371068, "o", "l_encoders[col] = le\r\n\r\nprint(\"Training RandomForestClassifier...\")\r\nmodel = RandomForestClassifier(\r\n    n_estimators=100,\r\n    max_depth=15,\r\n    n_jobs=-1,\r\n    random_state=42,\r\n    verbose=1\r\n)\r\nmodel.fit(X_train, y_train)\r\n\r\n# Validate\r\nfrom sklearn.metrics import roc_auc_score\r\nval_preds = model.predict_proba(X_val)[:, 1]\r\nval_auc = roc_auc_score(y_val, val_preds)\r\nprint(f\"Validation ROC-AUC: {val_auc:.4f}\")\r\n\r\n# Predict on test\r\ntest_preds = model.predict_proba(X_test)[:, 1]\r\nprint(f\"Test predictions shape: {test_preds.shape}\")\r\nprint(f\"Test predictions range: [{test_preds.min():.4f}, {test_preds.max():.4f}]\")\r\n\r\n# Save predictions\r\nresult = pd.DataFrame({'target': test_preds})\r\nresult.to_csv('/app/predictions.csv', index=False)\r\nprint(\"Saved predictions to /app/predictions.csv\")\r\nprint(f\"Output has {len(result)} rows\")\r\nEOF\r\n"]
