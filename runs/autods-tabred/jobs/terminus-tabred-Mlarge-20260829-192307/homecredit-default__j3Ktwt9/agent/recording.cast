[457.078696, "o", "> "]
[457.078812, "o", "result.to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r"]
[457.078852, "o", "\u001b[?2004h"]
[457.078871, "o", "> "]
[457.079032, "o", "print(f\"Saved {len(result)} predictions to /app/predictions.csv\")\r\n\u001b[?2004l\r"]
[457.07907, "o", "\u001b[?2004h> "]
