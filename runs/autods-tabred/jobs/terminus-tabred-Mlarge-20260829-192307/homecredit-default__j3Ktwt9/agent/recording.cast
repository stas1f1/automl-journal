[457.074205, "o", "\u001b[?2004l\r"]
[457.074221, "o", "\u001b[?2004h> "]
[457.074416, "o", "encoder = OrdinalEncoder(handle_unknown='use_encoded_value', unknown_value=-1)\r\n"]
[457.074463, "o", "\u001b[?2004l\r\u001b[?2004h"]
[457.074509, "o", "> "]
[457.074699, "o", "X_train[cat_cols] = encoder.fit_transform(X_train[cat_cols]).astype(np.int32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.074862, "o", "X_val[cat_cols] = encoder.transform(X_val[cat_cols]).astype(np.int32)\r\n\u001b[?2004l\r"]
[457.074904, "o", "\u001b[?2004h> "]
[457.075069, "o", "X_test[cat_cols] = encoder.transform(X_test[cat_cols]).astype(np.int32)\r\n"]
[457.075105, "o", "\u001b[?2004l\r\u001b[?2004h"]
[457.075151, "o", "> \r\n\u001b[?2004l\r"]
[457.075194, "o", "\u001b[?2004h"]
[457.075236, "o", "> "]
[457.075317, "o", "print(\"Training model...\")\r\n\u001b[?2004l\r"]
[457.075362, "o", "\u001b[?2004h"]
[457.075404, "o", "> "]
[457.075483, "o", "model = LGBMClassifier(\r\n"]
[457.075525, "o", "\u001b[?2004l\r\u001b[?2004h"]
[457.07555, "o", "> "]
[457.075643, "o", "    n_estimators=300,\r\n"]
[457.075683, "o", "\u001b[?2004l\r\u001b[?2004h"]
[457.075706, "o", "> "]
[457.075782, "o", "    learning_rate=0.05,\r\n"]
[457.075821, "o", "\u001b[?2004l\r\u001b[?2004h"]
[457.075839, "o", "> "]
[457.075904, "o", "    max_depth=-1,\r\n"]
[457.075941, "o", "\u001b[?2004l\r\u001b[?2004h"]
[457.075962, "o", "> "]
[457.076034, "o", "    num_leaves=64,\r\n"]
[457.076074, "o", "\u001b[?2004l\r\u001b[?2004h"]
[457.076092, "o", "> "]
[457.076162, "o", "    subsample=0.8,\r\n"]
[457.0762, "o", "\u001b[?2004l\r\u001b[?2004h"]
[457.076218, "o", "> "]
[457.076296, "o", "    colsample_bytree=0.8,"]
[457.076334, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[457.076359, "o", "> "]
[457.076423, "o", "    random_state=42,\r\n"]
[457.076462, "o", "\u001b[?2004l\r\u001b[?2004h"]
[457.076484, "o", "> "]
[457.076559, "o", "    n_jobs=-1,\r\n"]
[457.076605, "o", "\u001b[?2004l\r\u001b[?2004h"]
[457.076624, "o", "> "]
[457.076686, "o", "    verbose=-1\r\n"]
[457.076705, "o", "\u001b[?2004l\r\u001b[?2004h"]
[457.076772, "o", "> )\r\n\u001b[?2004l\r"]
[457.076791, "o", "\u001b[?2004h> "]
[457.076807, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[457.076827, "o", "> "]
[457.076956, "o", "model.fit(X_train, y_train)"]
[457.076998, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[457.077016, "o", "> \r\n\u001b[?2004l\r"]
[457.077036, "o", "\u001b[?2004h> "]
[457.077133, "o", "print(\"Evaluating...\")\r\n"]
[457.077172, "o", "\u001b[?2004l\r\u001b[?2004h"]
[457.07719, "o", "> "]
[457.077304, "o", "from sklearn.metrics import roc_auc_score\r\n"]
[457.077348, "o", "\u001b[?2004l\r\u001b[?2004h"]
[457.077385, "o", "> "]
[457.077513, "o", "val_preds = model.predict_proba(X_val)[:, 1]\r\n\u001b[?2004l\r"]
[457.077572, "o", "\u001b[?2004h> "]
[457.077685, "o", "val_auc = roc_auc_score(y_val, val_preds)\r\n"]
[457.077725, "o", "\u001b[?2004l\r\u001b[?2004h"]
[457.077768, "o", "> "]
[457.077871, "o", "print(f\"Validation ROC-AUC: {val_auc:.4f}\")\r\n\u001b[?2004l\r"]
[457.077909, "o", "\u001b[?2004h"]
[457.077928, "o", "> \r\n\u001b[?2004l\r"]
[457.077997, "o", "\u001b[?2004h> "]
[457.0781, "o", "print(\"Generating test predictions...\")\r\n"]
[457.078139, "o", "\u001b[?2004l\r\u001b[?2004h"]
[457.078163, "o", "> "]
[457.078284, "o", "test_preds = model.predict_proba(X_test)[:, 1]"]
[457.078332, "o", "\r\n\u001b[?2004l\r"]
[457.078371, "o", "\u001b[?2004h"]
[457.078394, "o", "> \r\n"]
[457.07845, "o", "\u001b[?2004l\r\u001b[?2004h"]
[457.078499, "o", "> "]
[457.078615, "o", "result = pd.DataFrame({'target': test_preds})\r\n"]
