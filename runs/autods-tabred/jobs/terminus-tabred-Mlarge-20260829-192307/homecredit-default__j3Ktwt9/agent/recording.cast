[457.065784, "i", "cat > /workspace/train_model.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom lightgbm import LGBMClassifier\nfrom sklearn.preprocessing import OrdinalEncoder\nimport warnings\nwarnings.filterwarnings('ignore')\n\nprint(\"Loading data...\")\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nprint(f\"Train shape: {train.shape}\")\nprint(f\"Val shape: {val.shape}\")\nprint(f\"Test shape: {test.shape}\")\n\nfeature_cols = [col for col in train.columns if col != 'target']\nnum_cols = [col for col in feature_cols if col.startswith('num_')]\nbin_cols = [col for col in feature_cols if col.startswith('bin_')]\ncat_cols = [col for col in feature_cols if col.startswith('cat_')]\n\nprint(f\"Numerical: {len(num_cols)}, Binary: {len(bin_cols)}, Categorical: {len(cat_cols)}\")\n\nX_train = train[feature_cols].copy()\ny_train = train['target'].values\nX_val = val[feature_cols].copy()\ny_val = val['target'].values\nX_test = test[feature_cols].copy()\n\n# Fill all NaN first\nprint(\"Filling missing values...\")\nfor col in num_cols:\n    median_val = X_train[col].median()\n    if pd.isna(median_val):\n        median_val = 0\n    X_train[col] = X_train[col].fillna(median_val).astype(np.float32)\n    X_val[col] = X_val[col].fillna(median_val).astype(np.float32)\n    X_test[col] = X_test[col].fillna(median_val).astype(np.float32)\n\nfor col in bin_cols:\n    X_train[col] = X_train[col].fillna(0).astype(np.float32)\n    X_val[col] = X_val[col].fillna(0).astype(np.float32)\n    X_test[col] = X_test[col].fillna(0).astype(np.float32)\n\n# Handle categorical - use OrdinalEncoder which is faster\nprint(\"Processing categorical features...\")\nX_train[cat_cols] = X_train[cat_cols].fillna('MISSING').astype(str)\nX_val[cat_cols] = X_val[cat_cols].fillna('MISSING').astype(str)\nX_test[cat_cols] = X_test[cat_cols].fillna('MISSING').astype(str)\n\nencoder = OrdinalEncoder(handle_unknown='use_encoded_value', unknown_value=-1)\nX_train[cat_cols] = encoder.fit_transform(X_train[cat_cols]).astype(np.int32)\nX_val[cat_cols] = encoder.transform(X_val[cat_cols]).astype(np.int32)\nX_test[cat_cols] = encoder.transform(X_test[cat_cols]).astype(np.int32)\n\nprint(\"Training model...\")\nmodel = LGBMClassifier(\n    n_estimators=300,\n    learning_rate=0.05,\n    max_depth=-1,\n    num_leaves=64,\n    subsample=0.8,\n    colsample_bytree=0.8,\n    random_state=42,\n    n_jobs=-1,\n    verbose=-1\n)\n\nmodel.fit(X_train, y_train)\n\nprint(\"Evaluating...\")\nfrom sklearn.metrics import roc_auc_score\nval_preds = model.predict_proba(X_val)[:, 1]\nval_auc = roc_auc_score(y_val, val_preds)\nprint(f\"Validation ROC-AUC: {val_auc:.4f}\")\n\nprint(\"Generating test predictions...\")\ntest_preds = model.predict_proba(X_test)[:, 1]\n\nresult = pd.DataFrame({'target': test_preds})\nresult.to_csv('/app/predictions.csv', index=False)\nprint(f\"Saved {len(result)} predictions to /app/predictions.csv\")\nprint(f\"Predictions stats: min={test_preds.min():.4f}, max={test_preds.max():.4f}, mean={test_preds.mean():.4f}\")\nprint(\"All predictions finite:\", np.all(np.isfinite(test_preds)))\nEOF\n"]
