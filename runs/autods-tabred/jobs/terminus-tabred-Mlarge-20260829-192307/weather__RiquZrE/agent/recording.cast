[19.416783, "o", "\u001b[?2004hroot@b2ff7085cb07:/workspace# "]
[34.978816, "i", "cat > train_model.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nimport lightgbm as lgb\nfrom sklearn.metrics import mean_squared_error\n\n# Load data\nprint(\"Loading data...\")\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nprint(f\"Train shape: {train_df.shape}\")\nprint(f\"Val shape: {val_df.shape}\")\nprint(f\"Test shape: {test_df.shape}\")\n\n# Extract feature columns from schema\nimport json\nwith open('/app/data/schema.json') as f:\n    schema = json.load(f)\nfeature_cols = schema['feature_columns']\n\n# Prepare data\nX_train = train_df[feature_cols]\ny_train = train_df['target']\nX_val = val_df[feature_cols]\ny_val = val_df['target']\nX_test = test_df[feature_cols]\n\n# Replace -9999 with NaN (special missing value marker)\nX_train = X_train.replace(-9999, np.nan)\nX_val = X_val.replace(-9999, np.nan)\nX_test = X_test.replace(-9999, np.nan)\n\nprint(f\"Features: {len(feature_cols)}\")\nprint(f\"Training samples: {len(X_train)}\")\n\n# Create LightGBM dataset\ntrain_data = lgb.Dataset(X_train, label=y_train)\nval_data = lgb.Dataset(X_val, label=y_val, reference=train_data)\n\n# Parameters\nparams = {\n    'objective': 'regression',\n    'metric': 'rmse',\n    'boosting_type': 'gbdt',\n    'num_leaves': 63,\n    'learning_rate': 0.05,\n    'feature_fraction': 0.8,\n    'bagging_fraction': 0.8,\n    'bagging_freq': 5,\n    'verbose': -1,\n    'num_threads': 4\n}\n\n# Train model\nprint(\"Training model...\")\nmodel = lgb.train(\n    params,\n    train_data,\n    num_boost_round=500,\n    valid_sets=[train_data, val_data],\n    callbacks=[\n        lgb.early_stopping(stopping_rounds=30, verbose=False),\n        lgb.log_evaluation(period=50)\n    ]\n)\n\n# Validate\nval_preds = model.predict(X_val)\nval_rmse = np.sqrt(mean_squared_error(y_val, val_preds))\nprint(f\"Validation RMSE: {val_rmse:.6f}\")\n\n# Predict on test\nprint(\"Generating test predictions...\")\ntest_preds = model.predict(X_test)\n\n# Check predictions\nprint(f\"Test predictions shape: {test_preds.shape}\")\nprint(f\"Finite values: {np.isfinite(test_preds).sum()}/{len(test_preds)}\")\nprint(f\"Prediction stats: min={test_preds.min():.4f}, max={test_preds.max():.4f}, mean={test_preds.mean():.4f}\")\n\n# Save predictions\nresult_df = pd.DataFrame({'target': test_preds})\nresult_df.to_csv('/app/predictions.csv', index=False)\nprint(\"Predictions saved to /app/predictions.csv\")\n\n# Verify output\nverify_df = pd.read_csv('/app/predictions.csv')\nprint(f\"Output file shape: {verify_df.shape}\")\nprint(f\"Output columns: {verify_df.columns.tolist()}\")\nEOF\n"]
[34.979077, "o", "cat > train_model.py << 'EOF'\r\n\u001b[?2004l\r"]
