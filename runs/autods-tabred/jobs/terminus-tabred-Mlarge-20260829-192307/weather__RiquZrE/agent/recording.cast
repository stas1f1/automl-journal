     'learning_rate': 0.05,\r\n\u001b[?2004l\r\u001b[?2004h>     'feature_fraction': 0.8,\r\n\u001b[?2004l\r\u001b[?2004h>     'bagging_fraction': 0.8,\r\n\u001b[?2004l\r"]
