[34.981912, "o", "print(\"Training model...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.981968, "o", "model = lgb.train(\r\n\u001b[?2004l\r\u001b[?2004h>     params,\r\n\u001b[?2004l\r\u001b[?2004h>     train_data,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.982024, "o", "    num_boost_round=500,\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.982072, "o", ">     valid_sets=[train_data, val_data],"]
[34.982226, "o", "\r\n\u001b[?2004l\r"]
[34.982276, "o", "\u001b[?2004h> "]
[34.98233, "o", "    callbacks=[\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.982396, "o", "        lgb.early_stopping(stopping_rounds=30, verbose=False),\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.982444, "o", "> "]
[34.982495, "o", "        lgb.log_evaluation(period=50)\r\n\u001b[?2004l\r\u001b[?2004h>     ]\r\n\u001b[?2004l\r"]
[34.982552, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[34.982592, "o", "> # Validate\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.98265, "o", "val_preds = model.predict(X_val)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.98273, "o", "val_rmse = np.sqrt(mean_squared_error(y_val, val_preds))\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.982773, "o", "> "]
[34.982802, "o", "print(f\"Validation RMSE: {val_rmse:.6f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.982832, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.982856, "o", "# Predict on test\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.982883, "o", "> "]
[34.983009, "o", "print(\"Generating test predictions...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.983038, "o", "test_preds = model.predict(X_test)\r\n\u001b[?2004l\r"]
[34.983103, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[34.983133, "o", "\u001b[?2004h> # Check predictions\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.983194, "o", "print(f\"Test predictions shape: {test_preds.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.983292, "o", "print(f\"Finite values: {np.isfinite(test_preds).sum()}/{len(test_preds)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.983336, "o", "> "]
[34.983483, "o", "print(f\"Prediction stats: min={test_preds.min():.4f}, max={test_preds.max():.4f}, mean={test_preds.mean():.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.983547, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.983593, "o", "# Save predictions\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.983639, "o", "result_df = pd.DataFrame({'target': test_preds})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.983688, "o", "result_df.to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.983732, "o", "> "]
[34.98378, "o", "print(\"Predictions saved to /app/predictions.csv\")\r\n\u001b[?2004l\r"]
[34.983823, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Verify output\r\n\u001b[?2004l\r"]
[34.983855, "o", "\u001b[?2004h> "]
[34.98391, "o", "verify_df = pd.read_csv('/app/predictions.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.983967, "o", "print(f\"Output file shape: {verify_df.shape}\")\r\n\u001b[?2004l\r"]
[34.984009, "o", "\u001b[?2004h> "]
[34.984049, "o", "print(f\"Output columns: {verify_df.columns.tolist()}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.98409, "o", "> EOF\r\n\u001b[?2004l\r"]
