[285.60823, "o", "X_train = train_df.drop('target', axis=1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[285.608298, "o", "> y_train = train_df['target']\r\n\u001b[?2004l\r\u001b[?2004h> X_val = val_df.drop('target', axis=1)\r\n\u001b[?2004l\r\u001b[?2004h> y_val = val_df['target']\r\n\u001b[?2004l\r\u001b[?2004h> X_test = test_df\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Handle categorical features - one-hot encode or label encode\r\n\u001b[?2004l\r\u001b[?2004h> cat_cols = [c for c in X_train.columns if c.startswith('cat_')]\r\n\u001b[?2004l\r\u001b[?2004h> for col in cat_cols:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.608366, "o", "    X_train[col] = X_train[col].fillna(-1).astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.608433, "o", "    X_val[col] = X_val[col].fillna(-1).astype(int)\r\n\u001b[?2004l\r"]
[285.608484, "o", "\u001b[?2004h> "]
[285.608529, "o", "    X_test[col] = X_test[col].fillna(-1).astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[285.608577, "o", "\u001b[?2004h> "]
[285.60863, "o", "print(\"Training Random Forest...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.608672, "o", "model = RandomForestRegressor(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.608724, "o", "    n_estimators=100,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.608769, "o", "    max_depth=15,\r\n\u001b[?2004l\r\u001b[?2004h>     min_samples_split=10,\r\n"]
[285.608844, "o", "\u001b[?2004l\r\u001b[?2004h>     n_jobs=-1,\r\n\u001b[?2004l\r\u001b[?2004h"]
[285.608889, "o", ">     random_state=42,\r\n\u001b[?2004l\r\u001b[?2004h>     verbose=1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.608977, "o", ")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.609018, "o", "model.fit(X_train, y_train)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Validate\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.609079, "o", "val_pred = model.predict(X_val)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.609126, "o", "val_rmse = np.sqrt(mean_squared_error(y_val, val_pred))\r\n\u001b[?2004l\r\u001b[?2004h"]
[285.609178, "o", "> "]
[285.609228, "o", "print(f\"Validation RMSE: {val_rmse:.6f}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[285.609279, "o", "> # Predict on test\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.609331, "o", "test_pred = model.predict(X_test)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.60938, "o", "print(f\"Test predictions shape: {test_pred.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[285.609429, "o", "> "]
[285.609491, "o", "print(f\"Finite predictions: {np.isfinite(test_pred).sum()} / {len(test_pred)}\")\r\n\u001b[?2004l\r"]
[285.609542, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.609596, "o", "# Save predictions\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.609794, "o", "result_df = pd.DataFrame({'target': test_pred})\r\n\u001b[?2004l\r\u001b[?2004h"]
[285.609853, "o", "> result_df.to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Predictions saved to /app/predictions.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Output shape: {result_df.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.609907, "o", "EOF\r\n\u001b[?2004l\r"]
