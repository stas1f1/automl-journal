[284.024617, "i", "cat > /app/train_model.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.ensemble import RandomForestRegressor, GradientBoostingRegressor\nfrom sklearn.linear_model import Ridge\nfrom sklearn.metrics import mean_squared_error\nfrom sklearn.impute import SimpleImputer\nfrom sklearn.preprocessing import StandardScaler\n\nprint(\"Loading data...\")\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nprint(f\"Train shape: {train_df.shape}\")\nprint(f\"Val shape: {val_df.shape}\")\nprint(f\"Test shape: {test_df.shape}\")\n\n# Separate features and target\nX_train = train_df.drop('target', axis=1)\ny_train = train_df['target']\nX_val = val_df.drop('target', axis=1)\ny_val = val_df['target']\nX_test = test_df\n\n# Handle categorical features - one-hot encode or label encode\ncat_cols = [c for c in X_train.columns if c.startswith('cat_')]\nfor col in cat_cols:\n    X_train[col] = X_train[col].fillna(-1).astype(int)\n    X_val[col] = X_val[col].fillna(-1).astype(int)\n    X_test[col] = X_test[col].fillna(-1).astype(int)\n\nprint(\"Training Random Forest...\")\nmodel = RandomForestRegressor(\n    n_estimators=100,\n    max_depth=15,\n    min_samples_split=10,\n    n_jobs=-1,\n    random_state=42,\n    verbose=1\n)\nmodel.fit(X_train, y_train)\n\n# Validate\nval_pred = model.predict(X_val)\nval_rmse = np.sqrt(mean_squared_error(y_val, val_pred))\nprint(f\"Validation RMSE: {val_rmse:.6f}\")\n\n# Predict on test\ntest_pred = model.predict(X_test)\nprint(f\"Test predictions shape: {test_pred.shape}\")\nprint(f\"Finite predictions: {np.isfinite(test_pred).sum()} / {len(test_pred)}\")\n\n# Save predictions\nresult_df = pd.DataFrame({'target': test_pred})\nresult_df.to_csv('/app/predictions.csv', index=False)\nprint(\"Predictions saved to /app/predictions.csv\")\nprint(f\"Output shape: {result_df.shape}\")\nEOF\n"]
[284.024839, "o", "cat > /app/train_model.py << 'EOF'\r\nimport pandas as pd\r\nimport numpy as np\r\nfrom sklearn.ensemble import RandomForestRegressor, GradientBoostingRegressor\r\nfrom sklearn.linear_model import Ridge\r\nfrom sklearn.metrics import mean_squared_error\r\nfrom sklearn.impute import SimpleImputer\r\nfrom sklearn.preprocessing import StandardScaler\r\n\r\nprint(\"Loading data...\")\r\ntrain_df = pd.read_csv('/app/data/train.csv')\r\nval_df = pd.read_csv('/app/data/val.csv')\r\ntest_df = pd.read_csv('/app/data/test.csv')\r\n\r\nprint(f\"Train shape: {train_df.shape}\")\r\nprint(f\"Val shape: {val_df.shape}\")\r\nprint(f\"Test shape: {test_df.shape}\")\r\n\r\n# Separate features and target\r\nX_train = train_df.drop('target', axis=1)\r\ny_train = train_df['target']\r\nX_val = val_df.drop('target', axis=1)\r\ny_val = val_df['target']\r\nX_test = test_df\r\n\r\n# Handle categorical features - one-hot encode or label encode\r\ncat_cols = [c for c in X_train.columns if c.startswith('cat_')]\r\nfor col in cat_cols:\r\n    X_train[col] = X_train[col].fillna(-1).astype(int)\r\n    X_val[col] = X_val[col].fillna(-1).astype(int)\r\n    X_test[col] = X_test[col].fillna(-1).astype(int)\r\n\r\nprint(\"Training Random Forest...\")\r\nmodel = RandomForestRegressor(\r\n    n_estimators=100,\r\n    max_depth=15,\r\n    min_samples_split=10,\r\n    n_jobs=-1,\r\n    random_state=42,\r\n    verbose=1\r\n)\r\nmodel.fit(X_train, y_train)\r\n\r\n# Validate\r\nval_pred = model.predict(X_val)\r\nval_rmse = np.sqrt(mean_squared_error(y_val, val_pred))\r\nprint(f\"Validation RMSE: {val_rmse:.6f}\")\r\n\r\n# Predict on test\r\ntest_pred = model.predict(X_test)\r\nprint(f\"Test predictions shape: {test_pred.shape}\")\r\nprint(f\"Finite predictions: {np.isfinite(test_pred).sum()} / {len(test_pred)}\")\r\n\r\n# Save predictions\r\nresult_df = pd.DataFrame({'target': test_pred})\r\nresult_df.to_csv('/app/predictions.csv', index=False)\r\nprint(\"Predictions saved to /app/predictions.csv\")\r\nprint(f\"Output shape: {result_df.shape}\")\r\nEOF\r\n"]
