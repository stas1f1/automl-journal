[7.766881, "o", "\u001b[?2004hroot@b64e7781948d:/workspace# "]
[107.446062, "i", "cat > /workspace/train_model.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom lightgbm import LGBMClassifier\nfrom sklearn.metrics import roc_auc_score\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Load data\nprint(\"Loading data...\")\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nprint(f\"Train shape: {train_df.shape}\")\nprint(f\"Val shape: {val_df.shape}\")\nprint(f\"Test shape: {test_df.shape}\")\n\n# Separate features and target\ny_train = train_df['target'].values\ny_val = val_df['target'].values\n\n# Drop target column\nX_train = train_df.drop('target', axis=1)\nX_val = val_df.drop('target', axis=1)\nX_test = test_df.copy()\n\n# Identify feature types\nnum_features = [col for col in X_train.columns if col.startswith('num_')]\nbin_features = [col for col in X_train.columns if col.startswith('bin_')]\ncat_features = [col for col in X_train.columns if col.startswith('cat_')]\n\nprint(f\"Numerical features: {len(num_features)}\")\nprint(f\"Binary features: {len(bin_features)}\")\nprint(f\"Categorical features: {len(cat_features)}\")\n\n# Convert categorical columns to category dtype\ncat_feature_indices = [i for i, col in enumerate(X_train.columns) if col in cat_features]\nfor col in cat_features:\n    X_train[col] = X_train[col].astype('category')\n    X_val[col] = X_val[col].astype('category')\n    X_test[col] = X_test[col].astype('category')\n\nprint(\"\\nTraining LightGBM model...\")\nmodel = LGBMClassifier(\n    n_estimators=1000,\n    learning_rate=0.05,\n    num_leaves=64,\n    max_depth=-1,\n    subsample=0.8,\n    colsample_bytree=0.8,\n    reg_alpha=0.1,\n    reg_lambda=0.1,\n    random_state=42,\n    n_jobs=-1,\n    verbose=-1,\n    categorical_feature=cat_feature_indices\n)\n\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    callbacks=[]  # Disable early stopping for simplicity\n)\n\n# Validation predictions\nval_preds = model.predict_proba(X_val)[:, 1]\nval_auc = roc_auc_score(y_val, val_preds)\nprint(f\"Validation ROC-AUC: {val_auc:.6f}\")\n\n# Test predictions\nprint(\"Generating test predictions...\")\ntest_preds = model.predict_proba(X_test)[:, 1]\n\n# Save predictions\noutput_df = pd.DataFrame({'target': test_preds})\noutput_df.to_csv('/app/predictions.csv', index=False)\nprint(f\"Predictions saved to /app/predictions.csv\")\nprint(f\"Output shape: {output_df.shape}\")\nprint(f\"Output stats: min={test_preds.min():.4f}, max={test_preds.max():.4f}, mean={test_preds.mean():.4f}\")\nEOF\n"]
[107.446986, "o", "cat > /workspace/train_model.py << 'EOF'\r\n\u001b[?2004l\r"]
