[107.451156, "o", "test_df = pd.read_csv('/app/data/test.csv')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[107.451222, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[107.451309, "o", "print(f\"Train shape: {train_df.shape}\")\r\n\u001b[?2004l\r"]
[107.451373, "o", "\u001b[?2004h> print(f\"Val shape: {val_df.shape}\")"]
[107.451449, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.451513, "o", "print(f\"Test shape: {test_df.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[107.451595, "o", "\u001b[?2004h> "]
[107.451673, "o", "# Separate features and target\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.451753, "o", "y_train = train_df['target'].values\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.451818, "o", "y_val = val_df['target'].values\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[107.451898, "o", "\u001b[?2004h> # Drop target column"]
[107.451968, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.452054, "o", "X_train = train_df.drop('target', axis=1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.45212, "o", "X_val = val_df.drop('target', axis=1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.452188, "o", "X_test = test_df.copy()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[107.452254, "o", "\u001b[?2004h> "]
[107.452325, "o", "# Identify feature types\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.452438, "o", "num_features = [col for col in X_train.columns if col.startswith('num_')]\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.452521, "o", "> "]
[107.452595, "o", "bin_features = [col for col in X_train.columns if col.startswith('bin_')]\r\n\u001b[?2004l\r"]
[107.452671, "o", "\u001b[?2004h> "]
[107.452764, "o", "cat_features = [col for col in X_train.columns if col.startswith('cat_')]\r\n\u001b[?2004l\r"]
[107.452835, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[107.452904, "o", "> "]
[107.452973, "o", "print(f\"Numerical features: {len(num_features)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.453034, "o", "print(f\"Binary features: {len(bin_features)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.453095, "o", "> "]
[107.453172, "o", "print(f\"Categorical features: {len(cat_features)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[107.453244, "o", "\u001b[?2004h> "]
[107.453311, "o", "# Convert categorical columns to category dtype\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.453502, "o", "cat_feature_indices = [i for i, col in enumerate(X_train.columns) if col in cat_features]\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.453562, "o", "> for col in cat_features:"]
[107.45364, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.453711, "o", "    X_train[col] = X_train[col].astype('category')\r\n\u001b[?2004l\r"]
[107.453787, "o", "\u001b[?2004h> "]
[107.453851, "o", "    X_val[col] = X_val[col].astype('category')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.453915, "o", "    X_test[col] = X_test[col].astype('category')\r\n\u001b[?2004l\r"]
[107.453974, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.454037, "o", "print(\"\\nTraining LightGBM model...\")\r\n\u001b[?2004l\r"]
[107.454102, "o", "\u001b[?2004h> "]
[107.454134, "o", "model = LGBMClassifier(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.454157, "o", "    n_estimators=1000,\r\n\u001b[?2004l\r"]
[107.454326, "o", "\u001b[?2004h> "]
[107.454407, "o", "    learning_rate=0.05,\r\n\u001b[?2004l\r\u001b[?2004h>     num_leaves=64,\r\n\u001b[?2004l\r\u001b[?2004h>     max_depth=-1,\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.454474, "o", ">     subsample=0.8,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.454548, "o", "    colsample_bytree=0.8,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.45462, "o", "    reg_alpha=0.1,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.454667, "o", "    reg_lambda=0.1,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.454689, "o", "    random_state=42,\r\n\u001b[?2004l\r"]
[107.454712, "o", "\u001b[?2004h> "]
[107.454748, "o", "    n_jobs=-1,\r\n\u001b[?2004l\r"]
[107.45489, "o", "\u001b[?2004h> "]
[107.454977, "o", "    verbose=-1,\r\n\u001b[?2004l\r\u001b[?2004h>     categorical_feature=cat_feature_indices\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n"]
[107.455052, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> model.fit(\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.455132, "o", ">     X_train, y_train,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.455194, "o", "    eval_set=[(X_val, y_val)],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.455305, "o", "    callbacks=[]  # Disable early stopping for simplicity\r\n\u001b[?2004l\r"]
[107.455364, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.45546, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> # Validation predictions\r\n"]
[107.455522, "o", "\u001b[?2004l\r\u001b[?2004h> val_preds = model.predict_proba(X_val)[:, 1]\r\n"]
[107.455583, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[107.455653, "o", "val_auc = roc_auc_score(y_val, val_preds)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.455756, "o", "print(f\"Validation ROC-AUC: {val_auc:.6f}\")\r\n\u001b[?2004l\r"]
[107.455816, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.455892, "o", "# Test predictions\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.455961, "o", "print(\"Generating test predictions...\")\r\n\u001b[?2004l\r"]
[107.456036, "o", "\u001b[?2004h> "]
[107.456097, "o", "test_preds = model.predict_proba(X_test)[:, 1]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[107.456172, "o", "> # Save predictions\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.456236, "o", "> "]
[107.456307, "o", "output_df = pd.DataFrame({'target': test_preds})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.456369, "o", "output_df.to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r"]
[107.456432, "o", "\u001b[?2004h> "]
[107.456491, "o", "print(f\"Predictions saved to /app/predictions.csv\")\r\n\u001b[?2004l\r"]
[107.456562, "o", "\u001b[?2004h> "]
[107.456642, "o", "print(f\"Output shape: {output_df.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.45683, "o", "print(f\"Output stats: min={test_preds.min():.4f}, max={test_preds.max():.4f}, mean={test_preds.mean():.4f}\")\r\n\u001b[?2004l\r"]
[107.45689, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[107.462021, "o", "\u001b[?2004hroot@b64e7781948d:/workspace# "]
[107.953001, "i", "python3 /workspace/train_model.py\n"]
[107.953474, "o", "python3 /workspace/train_model.py\r\n\u001b[?2004l\r"]
