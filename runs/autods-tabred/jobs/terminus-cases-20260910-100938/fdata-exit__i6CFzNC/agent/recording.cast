[12.789297, "i", "cat <<EOF > solve.py\nimport pandas as pd\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\n# Load data\ntrain_df = pd.read_csv('train.csv')\ntest_df = pd.read_csv('test.csv')\n\n# Initialize AutoML\nautoml = TabularAutoML(task=Task('binary'))\n\n# Fit model\n# roles specify the target and columns to drop\nautoml.fit_predict(train_df, roles={'target': 'success', 'drop': ['jobid']})\n\n# Predict on test set\nproba = automl.predict(test_df).data[:, 0]\npred = (proba >= 0.5).astype(int)\n\n# Create submission file\nsubmission = pd.DataFrame({'jobid': test_df['jobid'], 'success': pred})\nsubmission.to_csv('submission.csv', index=False)\nprint('Submission file created successfully.')\nEOF\n"]
[12.789592, "o", "cat <<EOF > solve.py\r\n\u001b[?2004l\r"]
