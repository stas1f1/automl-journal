cat <<EOF > solve_fast.py
import pandas as pd
from catboost import CatBoostRegressor

train_df = pd.read_csv('train.csv')
test_df = pd.read_csv('test.csv')

X_train = train_df.drop(columns=['GrainYield', 'Index'])
y_train = train_df['GrainYield']
X_test = test_df.drop(columns=['Index'])

# Identify categorical features
cat_features = X_train.select_dtypes(include=['object']).columns.tolist()

model = CatBoostRegressor(iterations=500, learning_rate=0.1, depth=6, verbose=0)
model.fit(X_train, y_train, cat_features=cat_features)

preds = model.predict(X_test)
submission = pd.DataFrame({'Index': test_df['Index'], 'GrainYield': preds})
submission.to_csv('submission.csv', index=False)
print('SUCCESS')
EOF
python3 solve_fast.py
ls -l submission.csv
ls -l submission.csv
head -n 5 submission.csv
