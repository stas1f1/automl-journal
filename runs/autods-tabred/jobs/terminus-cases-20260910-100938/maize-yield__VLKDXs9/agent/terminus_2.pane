cat <<EOF > solve.py
import pandas as pd
import logging
from lightautoml.automl.presets.tabular_presets import TabularAutoML
from lightautoml.tasks import Task

logging.basicConfig(level=logging.INFO, filename='solve.log', filemode='w')
logger = logging.getLogger()

try:
    logger.info('Loading data...')
    train_df = pd.read_csv('train.csv')
    test_df = pd.read_csv('test.csv')

    logger.info('Initializing TabularAutoML...')
    automl = TabularAutoML(task=Task('reg'))

    logger.info('Fitting model...')
    automl.fit_predict(train_df, roles={'target': 'GrainYield', 'drop': ['Index']})

    logger.info('Predicting on test set...')
    pred_data = automl.predict(test_df).data

    logger.info('Creating submission...')
    submission = pd.DataFrame({
        'Index': test_df['Index'],
        'GrainYield': pred_data[:, 0]
    })

    submission.to_csv('submission.csv', index=False)
    logger.info('Submission saved to submission.csv')
except Exception as e:
    logger.error(f'Error occurred: {str(e)}')
EOF
nohup python3 solve.py > /dev/null 2>&1 &
