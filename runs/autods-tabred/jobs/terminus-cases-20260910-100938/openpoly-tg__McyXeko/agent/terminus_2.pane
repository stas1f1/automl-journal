[?2004hroot@20f05396072b:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from rdkit import Chem
[?2004l[?2004h> from rdkit.Chem import AllChem
[?2004l[?2004h> from sklearn.model_selection import train_test_split
[?2004l[?2004h> from sklearn.metrics import r2_score, mean_absolute_error
[?2004l[?2004h> 
[?2004l[?2004h> try:
[?2004l[?2004h>     from lightautoml. AutoML import TabularAutoML
[?2004l[?2004h>     USE_LAM = True
[?2004l[?2004h> except ImportError:
[?2004l[?2004h>     USE_LAM = False
[?2004l[?2004h> 
[?2004l[?2004h> if not USE_LAM:
[?2004l[?2004h>     from xgboost import XGBRegressor
[?2004l[?2004h> 
[?2004l[?2004h> def fp(psmiles, n_bits=2048):
[?2004l[?2004h>     # Replace polymer connection points with Carbon
[?2004l[?2004h>     s = psmiles.replace('[*]', 'C').replace('*', 'C')
[?2004l[?2004h>     mol = Chem.MolFromSmiles(s)
[?2004l[?2004h>     if mol is None:
[?2004l[?2004h>         return np.zeros(n_bits)
[?2004l[?2004h>     bv = AllChem.GetMorganFingerprintAsBitVect(mol, 2, nBits=n_bits)
[?2004l[?2004h>     # Convert bit vector to numpy array of 0s and 1s
[?2004l[?2004h>     return np.array(bv)
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h>  train_df = pd.read_csv('train.csv')
[?2004l[?2004h>  test_df = pd.read_csv('test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Featurize
[?2004l[?2004h> print("Featurizing training data...")
[?2004l[?2004h> X_train_all = np.stack(train_df['PSMILES'].apply(fp).values)
[?2004l[?2004h> y_train_all = train_df['Tg'].values
[?2004l[?2004h> 
[?2004l[?2004h> print("Featurizing test data...")
[?2004l[?2004h> X_test = np.stack(test_df['PSMILES'].apply(fp).values)
[?2004l[?2004h> 
[?2004l[?2004h> # Validation split
[?2004l[?2004h> X_train, X_val, y_train, y_val = train_test_split(X_train_all, y_train_all, test_size=0.2, random_state=42)
[?2004l[?2004h> 
[?2004l[?2004h> if USE_LAM:
[?2004l[?2004h>     print("Using LightAutoML...")
[?2004l[?2004h>     automl = TabularAutoML()
[?2004l[?2004h>     # LightAutoML requires dataframe format
[?2004l[?2004h>     train_df_lam = pd.DataFrame(X_train)
[?2004l[?2004h>     train_df_lam['Tg'] = y_train
[?2004l[?2004h>     val_df_lam = pd.DataFrame(X_val)
[?2004l[?2004h>     val_df_lam['Tg'] = y_val
[?2004l[?2004h>     
[?2004l[?2004h>     automl.fit_train(train_df_lam, val_df_lam, target='Tg')
[?2004l[?2004h>     
[?2004l[?2004h>     test_df_lam = pd.DataFrame(X_test)
[?2004l[?2004h>     preds = automl.predict(test_df_lam)
[?2004l[?2004h> else:
[?2004l[?2004h>     print("Using XGBoost...")
[?2004l[?2004h>     model = XGBRegressor(n_estimators=1000, learning_rate=0.05, max_depth=6, random_state=42)
[?2004l[?2004h>     model.fit(X_train, y_train)
[?2004l[?2004h>     val_preds = model.predict(X_val)
[?2004l[?2004h>     preds = model.predict(X_test)
[?2004l[?2004h>     
[?2004l[?2004h>     r2 = r2_score(y_val, val_preds)
[?2004l[?2004h>     mae = mean_absolute_error(y_val, val_preds)
[?2004l[?2004h>     print(f"Validation R2: {r2:.4f}, MAE: {mae:.4f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Create submission
[?2004l[?2004h> submission = pd.DataFrame({'id': test_df['id'], 'Tg': preds})
[?2004l[?2004h> submission.to_csv('submission.csv', index=False)
[?2004l[?2004h> print("Submission saved to submission.csv")
[?2004l[?2004h> EOF
