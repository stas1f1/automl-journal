[106.295089, "o", "from sklearn.metrics import r2_score, mean_absolute_error\r\n\u001b[?2004l\r"]
[106.29511, "o", "\u001b[?2004h> \r\n"]
[106.295129, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[106.295146, "o", "try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.295217, "o", "    from lightautoml.AutoML import TabularAutoML\r\n\u001b[?2004l\r"]
[106.295239, "o", "\u001b[?2004h> "]
[106.295411, "o", "    USE_LAM = True\r\n\u001b[?2004l\r"]
[106.295433, "o", "\u001b[?2004h> except ImportError:\r\n\u001b[?2004l\r\u001b[?2004h>     USE_LAM = False\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.295464, "o", "if not USE_LAM:\r\n\u001b[?2004l\r"]
[106.295526, "o", "\u001b[?2004h> "]
[106.295545, "o", "    from xgboost import XGBRegressor\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[106.295561, "o", "> "]
[106.295617, "o", "def fp(psmiles, n_bits=2048):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.295669, "o", "    s = psmiles.replace('[*]', 'C').replace('*', 'C')\r\n\u001b[?2004l\r"]
[106.295708, "o", "\u001b[?2004h> "]
[106.295727, "o", "    mol = Chem.MolFromSmiles(s)\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.295771, "o", "> "]
[106.295806, "o", "    if mol is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.295845, "o", "        return np.zeros(n_bits)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.295904, "o", "    bv = AllChem.GetMorganFingerprintAsBitVect(mol, 2, nBits=n_bits)\r\n\u001b[?2004l\r"]
[106.295925, "o", "\u001b[?2004h> "]
[106.295945, "o", "    return np.array(bv)\r\n\u001b[?2004l\r"]
[106.295999, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[106.296038, "o", "\u001b[?2004h> # Load data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.296058, "o", "train_df = pd.read_csv('train.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.296106, "o", "test_df = pd.read_csv('test.csv')\r\n\u001b[?2004l\r"]
[106.296143, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[106.296164, "o", "> # Featurize\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.296209, "o", "print(\"Featurizing training data...\")\r\n\u001b[?2004l\r"]
[106.296227, "o", "\u001b[?2004h> "]
[106.296294, "o", "X_train_all = np.stack(train_df['PSMILES'].apply(fp).values)\r\n\u001b[?2004l\r"]
[106.29633, "o", "\u001b[?2004h> "]
[106.296369, "o", "y_train_all = train_df['Tg'].values\r\n\u001b[?2004l\r"]
[106.296408, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.29645, "o", "print(\"Featurizing test data...\")\r\n\u001b[?2004l\r"]
[106.296492, "o", "\u001b[?2004h> "]
[106.296535, "o", "X_test = np.stack(test_df['PSMILES'].apply(fp).values)\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.296573, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.296611, "o", "# Validation split\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.296697, "o", "X_train, X_val, y_train, y_val = train_test_split(X_train_all, y_train_all, test_size=0.2, random_state=42)\r\n\u001b[?2004l\r"]
[106.296735, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[106.296774, "o", "\u001b[?2004h> if USE_LAM:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.296807, "o", "    print(\"Using LightAutoML...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.296847, "o", "    automl = TabularAutoML()\r\n\u001b[?2004l\r"]
[106.296883, "o", "\u001b[?2004h> "]
[106.296919, "o", "    train_df_lam = pd.DataFrame(X_train)\r\n\u001b[?2004l\r"]
[106.296956, "o", "\u001b[?2004h> "]
[106.296993, "o", "    train_df_lam['Tg'] = y_train\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.297028, "o", "    val_df_lam = pd.DataFrame(X_val)\r\n\u001b[?2004l\r"]
[106.297066, "o", "\u001b[?2004h> "]
[106.297099, "o", "    val_df_lam['Tg'] = y_val\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.297154, "o", "    automl.fit_train(train_df_lam, val_df_lam, target='Tg')\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.297192, "o", "> "]
[106.29723, "o", "    test_df_lam = pd.DataFrame(X_test)\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.297267, "o", "> "]
[106.297299, "o", "    preds = automl.predict(test_df_lam)\r\n\u001b[?2004l\r\u001b[?2004h> else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.297341, "o", "    print(\"Using XGBoost...\")\r\n\u001b[?2004l\r"]
[106.297376, "o", "\u001b[?2004h> "]
[106.297471, "o", "    model = XGBRegressor(n_estimators=1000, learning_rate=0.05, max_depth=6, random_state=42)\r\n\u001b[?2004l\r"]
[106.297512, "o", "\u001b[?2004h> "]
[106.297549, "o", "    model.fit(X_train, y_train)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.297581, "o", "    val_preds = model.predict(X_val)\r\n\u001b[?2004l\r"]
[106.297597, "o", "\u001b[?2004h> "]
[106.297635, "o", "    preds = model.predict(X_test)\r\n\u001b[?2004l\r"]
[106.297671, "o", "\u001b[?2004h> "]
[106.297708, "o", "    r2 = r2_score(y_val, val_preds)\r\n\u001b[?2004l\r"]
[106.297753, "o", "\u001b[?2004h> "]
[106.297796, "o", "    mae = mean_absolute_error(y_val, val_preds)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.297835, "o", "    print(f\"Validation R2: {r2:.4f}, MAE: {mae:.4f}\")\r\n\u001b[?2004l\r"]
[106.297872, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[106.297909, "o", "> # Create submission\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.297926, "o", "> "]
[106.297973, "o", "submission = pd.DataFrame({'id': test_df['id'], 'Tg': preds})\r\n\u001b[?2004l\r"]
[106.29801, "o", "\u001b[?2004h> "]
[106.298044, "o", "submission.to_csv('submission.csv', index=False)\r\n\u001b[?2004l\r"]
[106.298081, "o", "\u001b[?2004h> "]
[106.298111, "o", "print(\"Submission saved to submission.csv\")\r\n\u001b[?2004l\r"]
[106.298145, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[106.299255, "o", "\u001b[?2004hroot@20f05396072b:/workspace# "]
[106.445381, "i", "python3 solution.py\n"]
[106.445514, "o", "python3 solution.py"]
