[106.294387, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom rdkit import Chem\nfrom rdkit.Chem import AllChem\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import r2_score, mean_absolute_error\n\ntry:\n    from lightautoml.AutoML import TabularAutoML\n    USE_LAM = True\nexcept ImportError:\n    USE_LAM = False\n\nif not USE_LAM:\n    from xgboost import XGBRegressor\n\ndef fp(psmiles, n_bits=2048):\n    s = psmiles.replace('[*]', 'C').replace('*', 'C')\n    mol = Chem.MolFromSmiles(s)\n    if mol is None:\n        return np.zeros(n_bits)\n    bv = AllChem.GetMorganFingerprintAsBitVect(mol, 2, nBits=n_bits)\n    return np.array(bv)\n\n# Load data\ntrain_df = pd.read_csv('train.csv')\ntest_df = pd.read_csv('test.csv')\n\n# Featurize\nprint(\"Featurizing training data...\")\nX_train_all = np.stack(train_df['PSMILES'].apply(fp).values)\ny_train_all = train_df['Tg'].values\n\nprint(\"Featurizing test data...\")\nX_test = np.stack(test_df['PSMILES'].apply(fp).values)\n\n# Validation split\nX_train, X_val, y_train, y_val = train_test_split(X_train_all, y_train_all, test_size=0.2, random_state=42)\n\nif USE_LAM:\n    print(\"Using LightAutoML...\")\n    automl = TabularAutoML()\n    train_df_lam = pd.DataFrame(X_train)\n    train_df_lam['Tg'] = y_train\n    val_df_lam = pd.DataFrame(X_val)\n    val_df_lam['Tg'] = y_val\n    automl.fit_train(train_df_lam, val_df_lam, target='Tg')\n    test_df_lam = pd.DataFrame(X_test)\n    preds = automl.predict(test_df_lam)\nelse:\n    print(\"Using XGBoost...\")\n    model = XGBRegressor(n_estimators=1000, learning_rate=0.05, max_depth=6, random_state=42)\n    model.fit(X_train, y_train)\n    val_preds = model.predict(X_val)\n    preds = model.predict(X_test)\n    r2 = r2_score(y_val, val_preds)\n    mae = mean_absolute_error(y_val, val_preds)\n    print(f\"Validation R2: {r2:.4f}, MAE: {mae:.4f}\")\n\n# Create submission\nsubmission = pd.DataFrame({'id': test_df['id'], 'Tg': preds})\nsubmission.to_csv('submission.csv', index=False)\nprint(\"Submission saved to submission.csv\")\nEOF\n"]
