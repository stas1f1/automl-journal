[10.434795, "i", "cat <<EOF > solution.py\nimport pandas as pd\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\n# Load data\ntrain_df = pd.read_csv('train.csv')\ntest_df = pd.read_csv('test.csv')\n\n# Initialize LightAutoML\nautoml = TabularAutoML(task=Task('binary'))\n\n# Fit and predict on training set for validation/internal use\n# roles define the target and columns to be excluded from features\nautoml.fit_predict(train_df, roles={'target': 'success', 'drop': ['jobid']})\n\n# Predict on test set\n# predict returns a PredictResult object; .data contains the probabilities\nproba = automl.predict(test_df).data[:, 0]\n\n# Convert probabilities to binary labels (0 or 1)\npred = (proba >= 0.5).astype(int)\n\n# Create submission dataframe\nsubmission = pd.DataFrame({\n    'jobid': test_df['jobid'],\n    'success': pred\n})\n\n# Save to csv\nsubmission.to_csv('submission.csv', index=False)\nprint('Submission file created successfully.')\nEOF\n"]
