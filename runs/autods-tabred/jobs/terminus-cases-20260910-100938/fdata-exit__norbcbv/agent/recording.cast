[80.680706, "i", "cat <<EOF > solution.py\nimport pandas as pd\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\nprint('Starting script...')\ntrain_df = pd.read_csv('train.csv')\ntest_df = pd.read_csv('test.csv')\n\n# Basic cleaning for the overflow column\ntrain_df['mszl'] = train_df['mszl'].replace(1.8446744073709552e+19, -1)\ntest_df['mszl'] = test_df['mszl'].replace(1.8446744073709552e+19, -1)\n\nautoml = TabularAutoML(task=Task('binary'))\nautoml.fit_predict(train_df, roles={'target': 'success', 'drop': ['jobid']})\n\nproba = automl.predict(test_df).data[:, 0]\npred = (proba >= 0.5).astype(int)\n\nsubmission = pd.DataFrame({'jobid': test_df['jobid'], 'success': pred})\nsubmission.to_csv('submission.csv', index=False)\nprint('SUCCESS: submission.csv created')\nEOF\n"]
[80.680973, "o", "cat <<EOF > solution.py\r\nimport pandas as pd\r\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\r\nfrom lightautoml.tasks import Task\r\n\r\nprint('Starting script...')\r\ntrain_df = pd.read_csv('train.csv')\r\ntest_df = pd.read_csv('test.csv')\r\n\r\n# Basic cleaning for the overflow column\r\ntrain_df['mszl'] = train_df['mszl'].replace(1.8446744073709552e+19, -1)\r\ntest_df['mszl'] = test_df['mszl'].replace(1.8446744073709552e+19, -1)\r\n\r\nautoml = TabularAutoML(task=Task('binary'))\r\nautoml.fit_predict(train_df, roles={'target': 'success', 'drop': ['jobid']})\r\n\r\nproba = automl.predict(test_df).data[:, 0]\r\npred = (proba >= 0.5).astype(int)\r\n\r\nsubmission = pd.DataFrame({'jobid': test_df['jobid'], 'success': pred})\r\nsubmission.to_csv('submission.csv', index=False)\r\nprint('SUCCESS: submission.csv created')\r\nEOF\r\n"]
