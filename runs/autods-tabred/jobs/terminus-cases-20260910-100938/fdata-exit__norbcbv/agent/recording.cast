[46.381787, "i", "cat <<EOF > solution.py\nimport pandas as pd\nimport numpy as np\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\n# Load data\ntrain_df = pd.read_csv('train.csv')\ntest_df = pd.read_csv('test.csv')\n\n# Handle the extreme values in mszl (likely sentinels/max uint64)\n# We can cap it or treat it as a categorical/constant if most are the same\nMAX_VAL = 1.8446744073709552e+19\ntrain_df.loc[train_df['mszl'] >= MAX_VAL, 'mszl'] = -1\ntest_df.loc[test_df['mszl'] >= MAX_VAL, 'mszl'] = -1\n\n# Initialize LightAutoML\nautoml = TabularAutoML(task=Task('binary'))\n\n# Fit\nautoml.fit_predict(train_df, roles={'target': 'success', 'drop': ['jobid']})\n\n# Predict\nproba = automl.predict(test_df).data[:, 0]\npred = (proba >= 0.5).astype(int)\n\n# Submission\nsubmission = pd.DataFrame({\n    'jobid': test_df['jobid'],\n    'success': pred\n})\nsubmission.to_csv('submission.csv', index=False)\nprint('SUCCESS: submission.csv created')\nEOF\n"]
[46.381963, "o", "cat <<EOF > solution.py\r\nimport pandas as pd\r\nimport numpy as np\r\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\r\nfrom lightautoml.tasks import Task\r\n\r\n# Load data\r\ntrain_df = pd.read_csv('train.csv')\r\ntest_df = pd.read_csv('test.csv')\r\n\r\n# Handle the extreme values in mszl (likely sentinels/max uint64)\r\n# We can cap it or treat it as a categorical/constant if most are the same\r\nMAX_VAL = 1.8446744073709552e+19\r\ntrain_df.loc[train_df['mszl'] >= MAX_VAL, 'mszl'] = -1\r\ntest_df.loc[test_df['mszl'] >= MAX_VAL, 'mszl'] = -1\r\n\r\n# Initialize LightAutoML\r\nautoml = TabularAutoML(task=Task('binary'))\r\n\r\n# Fit\r\nautoml.fit_predict(train_df, roles={'target': 'success', 'drop': ['jobid']})\r\n\r\n# Predict\r\nproba = automl.predict(test_df).data[:, 0]\r\npred = (proba >= 0.5).astype(int)\r\n\r\n# Submission\r\nsubmission = pd.DataFrame({\r\n    'jobid': test_df['jobid'],\r\n    'success': pred\r\n})\r\nsubmission.to_csv('submission.csv', index=False)\r\nprint('SUCCESS: submission.csv created')\r\nEOF\r\n"]
