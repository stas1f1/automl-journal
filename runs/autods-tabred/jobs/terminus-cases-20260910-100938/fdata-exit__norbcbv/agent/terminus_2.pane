cat <<EOF > solution.py
import pandas as pd
import numpy as np
from lightautoml.automl.presets.tabular_presets import TabularAutoML
from lightautoml.tasks import Task

# Load data
train_df = pd.read_csv('train.csv')
test_df = pd.read_csv('test.csv')

# Handle the extreme values in mszl (likely sentinels/max uint64)
# We can cap it or treat it as a categorical/constant if most are the same
MAX_VAL = 1.8446744073709552e+19
train_df.loc[train_df['mszl'] >= MAX_VAL, 'mszl'] = -1
test_df.loc[test_df['mszl'] >= MAX_VAL, 'mszl'] = -1

# Initialize LightAutoML
automl = TabularAutoML(task=Task('binary'))

# Fit
automl.fit_predict(train_df, roles={'target': 'success', 'drop': ['jobid']})

# Predict
proba = automl.predict(test_df).data[:, 0]
pred = (proba >= 0.5).astype(int)

# Submission
submission = pd.DataFrame({
    'jobid': test_df['jobid'],
    'success': pred
})
submission.to_csv('submission.csv', index=False)
print('SUCCESS: submission.csv created')
EOF
python3 solution.py
ls -l submission.csv
