[?2004hroot@a43723bcd63d:/workspace# cat <<EOF > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from lightautoml.automl.presets.tabular_presets import TabularAutoML
[?2004l[?2004h> from lightautoml.tasks import Task
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train_df = pd.read_csv('train.csv')
[?2004l[?2004h> test_df = pd.read_csv('test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Initialize LightAutoML
[?2004l[?2004h> automl = TabularAutoML(task=Task('binary'))
[?2004l[?2004h> 
[?2004l[?2004h> # Fit model
[?2004l[?2004h> # roles{"target": "success", "drop": ["jobid"]}
[?2004l[?2004h> automl.fit_predict(train_df, roles={"target": "success", "drop": ["jobid"]})
[?2004l[?2004h> 
[?2004l[?2004h> # Predict on test set
[?2004l[?2004h> proba = automl.predict(test_df).data[:, 0]
[?2004l[?2004h> pred = (proba >= 0.5).astype(int)
[?2004l[?2004h> 
[?2004l[?2004h> # Prepare submission
[?2004l[?2004h> submission = pd.DataFrame({
[?2004l[?2004h>     'jobid': test_df['jobid'],
[?2004l[?2004h>     'success': pred
[?2004l[?2004h> })
[?2004l[?2004h> submission.to_csv('submission.csv', index=False)
[?2004l[?2004h> print('Submission saved to submission.csv')
