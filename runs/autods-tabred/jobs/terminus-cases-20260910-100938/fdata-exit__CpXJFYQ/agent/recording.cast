[24.394538, "i", "cat <<EOF > solution.py\nimport pandas as pd\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\n# Load data\ntrain_df = pd.read_csv('train.csv')\ntest_df = pd.read_csv('test.csv')\n\n# Initialize LightAutoML\nautoml = TabularAutoML(task=Task('binary'))\n\n# Fit model\n# roles{\"target\": \"success\", \"drop\": [\"jobid\"]}\nautoml.fit_predict(train_df, roles={\"target\": \"success\", \"drop\": [\"jobid\"]})\n\n# Predict on test set\nproba = automl.predict(test_df).data[:, 0]\npred = (proba >= 0.5).astype(int)\n\n# Prepare submission\nsubmission = pd.DataFrame({\n    'jobid': test_df['jobid'],\n    'success': pred\n})\nsubmission.to_csv('submission.csv', index=False)\nprint('Submission saved to submission.csv')\nEOF\n"]
[24.394807, "o", "cat <<EOF > solution.py"]
