[?2004hroot@f4a7510bd796:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from lightautoml.automl.presets.tabular_presets import TabularAutoML
[?2004l[?2004h> from lightautoml.tasks import Task
[?2004l[?2004h> 
[?2004l[?2004h> def main():
[?2004l[?2004h>     # Load data
[?2004l[?2004h>     train_df = pd.read_csv('train.csv')
[?2004l[?2004h>     test_df = pd.read_csv('test.csv')
[?2004l[?2004h>     
[?2004l[?2004h>     # Initialize TabularAutoML for regression
[?2004l[?2004h>     automl = TabularAutoML(task=Task('reg'))
[?2004l[?2004h>     
[?2004l[?2004h>     # Fit model
[?2004l[?2004h>     # LightAutoML handles categorical features and mixed types automatically
[?2004l[?2004h>     # We drop 'Index' as it is just a unique identifier
[?2004l[?2004h>     automl.fit_predict(train_df, roles={'target': 'GrainYield', 'drop': ['Index']})
[?2004l[?2004h>     
[?2004l[?2004h>     # Predict on test set
[?2004l[?2004h>     predictions = automl.predict(test_df).data[:, 0]
[?2004l[?2004h>     
[?2004l[?2004h>     # Create submission dataframe
[?2004l[?2004h>     submission = pd.DataFrame({
[?2004l[?2004h>         'Index': test_df['Index'],
[?2004l[?2004h>         'GrainYield': predictions
[?2004l[?2004h>     })
[?2004l[?2004h>     
[?2004l[?2004h>     # Save to submission.csv
[?2004l[?2004h>     submission.to_csv('submission.csv', index=False)
[?2004l[?2004h>     print('Submission file saved successfully.')
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == '__main__':
[?2004l[?2004h>     main()
[?2004l[?2004h> EOF
