[8.09916, "o", "Index,Pedigree,F,M,ExperimentCode,Year,DatePlanted,DateHarvested,DaysToPollen,DaysToSilk,Height,EarHeight,StandCount,RootLodging,StalkLodging,GrainYield\r\n4,2369/LH123HT,2369,LH123HT,GAH1,2019,3/28/2019,8/15/2019,61.0,63.0,225.0,110.0,71.0,0.0,7.0,151.1659824\r\n5,2369/LH123HT,2369,LH123HT,GAH1,2019,3/28/2019,8/14/2019,63.0,65.0,200.0,100.0,66.0,0.0,0.0,67.77009673\r\n6,2369/LH123HT,2369,LH123HT,GAH2,2019,4/12/2019,9/5/2019,60.0,61.0,234.0,115.0,62.0,,,215.2872913\r\n8,2369/LH123HT,2369,LH123HT,GAH2,2019,4/12/2019,9/5/2019,65.0,65.0,241.0,119.0,65.0,,1.0,205.5182341\r\n\u001b[?2004hroot@f4a7510bd796:/workspace# "]
[8.229914, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\ndef main():\n    # Load data\n    train_df = pd.read_csv('train.csv')\n    test_df = pd.read_csv('test.csv')\n    \n    # Initialize TabularAutoML for regression\n    automl = TabularAutoML(task=Task('reg'))\n    \n    # Fit model\n    # LightAutoML handles categorical features and mixed types automatically\n    # We drop 'Index' as it is just a unique identifier\n    automl.fit_predict(train_df, roles={'target': 'GrainYield', 'drop': ['Index']})\n    \n    # Predict on test set\n    predictions = automl.predict(test_df).data[:, 0]\n    \n    # Create submission dataframe\n    submission = pd.DataFrame({\n        'Index': test_df['Index'],\n        'GrainYield': predictions\n    })\n    \n    # Save to submission.csv\n    submission.to_csv('submission.csv', index=False)\n    print('Submission file saved successfully.')\n\nif __name__ == '__main__':\n    main()\nEOF\n"]
