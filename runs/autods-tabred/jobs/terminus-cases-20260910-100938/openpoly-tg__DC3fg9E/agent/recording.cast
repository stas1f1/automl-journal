[15.340448, "o", "head -n 5 test.csv\r\n\u001b[?2004l\r"]
[15.341771, "o", "id,PSMILES"]
[15.341898, "o", "\r\n207,*CC(*)(C)C(=O)OCCCC\r\n212,*CC(*)(C)C(=O)OCCCCCCCCCCCCCCCCCC\r\n295,*CC(*)c1ccc(C(C)(C)C)cc1\r\n404,*OCC(C)(COC(*)=O)C(=O)NCC(C)O\r\n"]
[15.34209, "o", "\u001b[?2004hroot@60ed830c1be5:/workspace# "]
[26.620404, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom rdkit import Chem\nfrom rdkit.Chem import AllChem\nfrom xgboost import XGBRegressor\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import r2_score, mean_absolute_error\n\ndef fp(psmiles, n_bits=2048):\n    # Standardize the replacement of connection markers\n    s = psmiles.replace('[*]', 'C').replace('*', 'C')\n    mol = Chem.MolFromSmiles(s)\n    if mol is None:\n        return np.zeros(n_bits)\n    bv = AllChem.GetMorganFingerprintAsBitVect(mol, 2, nBits=n_bits)\n    # Convert BitVect to a numpy array of 0s and 1s\n    return np.array([int(bit) for bit in bv.ToBitString()])\n\n# Load data\ntrain_df = pd.read_csv('train.csv')\ntest_df = pd.read_csv('test.csv')\n\n# Featurization\nprint(\"Featurizing training data...\")\nX_train = np.stack(train_df['PSMILES'].apply(fp).values)\ny_train = train_df['Tg'].values\n\nprint(\"Featurizing test data...\")\nX_test = np.stack(test_df['PSMILES'].apply(fp).values)\n\n# Split for validation\nXs, Xv, ys, yv = train_test_split(X_train, y_train, test_size=0.2, random_state=42)\n\n# Train XGBoost\nmodel = XGBRegressor(n_estimators=1000, learning_rate=0.05, max_depth=6, random_state=42)\nmodel.fit(Xs, ys)\n\n# Validation\npreds_v = model.predict(Xv)\nr2 = r2_score(yv, preds_v)\nmae = mean_absolute_error(yv, preds_v)\nprint(f\"Validation R2: {r2:.4f}, MAE: {mae:.4f}\")\n\n# Final fit on all training data and predict test set\nmodel.fit(X_train, y_train)\npreds_test = model.predict(X_test)\n\n# Submission\nsubmission = pd.DataFrame({'id': test_df['id'], 'Tg': preds_test})\nsubmission.to_csv('submission.csv', index=False)\nprint(\"Submission saved to submission.csv\")\nEOF\n"]
