eds)\n    mae = mean_absolute_error(y_val, val_preds)\n    print(f"Validation R2: {r2:.4f}, MAE: {mae:.4f}")\n\n# Create submission\nsubmission = pd.DataFrame({\'id\': test_df[\'id\'], \'Tg\': preds})\nsubmission.to_csv(\'submission.csv\', index=False)\nprint("Submission saved to submission.csv")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
