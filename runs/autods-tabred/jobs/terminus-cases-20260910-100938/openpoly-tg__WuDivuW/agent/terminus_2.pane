ps aux | grep solution.py
ls -l /workspace/submission.csv
pkill -f solution.py
cat << 'EOF' > solution.py
import pandas as pd
import numpy as np
from rdkit import Chem
from rdkit.Chem import AllChem
from xgboost import XGBRegressor
from sklearn.model_selection import train_test_split
from sklearn.metrics import r2_score, mean_absolute_error

def fp(psmiles, n_bits=2048):
    s = psmiles.replace('[*]', 'C').replace('*', 'C')
    mol = Chem.MolFromSmiles(s)
    if mol is None:
        return np.zeros(n_bits)
    bv = AllChem.GetMorganFingerprintAsBitVect(mol, 2, nBits=n_bits)
    return np.array(bv)

# Load data
train_df = pd.read_csv('train.csv')
test_df = pd.read_csv('test.csv')

print("Featurizing training data...")
X_train_full = np.stack(train_df['PSMILES'].apply(fp).values)
y_train_full = train_df['Tg'].values

# Split for validation
X_train, X_val, y_train, y_val = train_test_split(X_train_full, y_train_full, test_size=0.2, random_state=42)

print("Training XGBoost model...")
model = XGBRegressor(
    n_estimators=100, 
    learning_rate=0.1, 
    max_depth=6, 
    random_state=42, 
    early_stopping_rounds=10
)
model.fit(X_train, y_train, eval_set=[(X_val, y_val)], verbose=False)

# Evaluate
preds_val = model.predict(X_val)
r2 = r2_score(y_val, preds_val)
mae = mean_absolute_error(y_val, preds_val)
print(f"Validation R2: {r2:.4f}, MAE: {mae:.4f}")

print("Featurizing test data...")
X_test = np.stack(test_df['PSMILES'].apply(fp).values)

print("Predicting on test set...")
preds_test = model.predict(X_test)

submission = pd.DataFrame({'id': test_df['id'], 'Tg': preds_test})
submission.to_csv('submission.csv', index=False)
print("Submission saved to submission.csv")
EOF
python3 solution.py
ls -l /workspace/submission.csv
ls -l /workspace/submission.csv
head -n 10 /workspace/submission.csv
pkill -9 python
nohup python3 solution.py > output.log 2>&1 &
sleep 10
