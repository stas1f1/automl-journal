[?2004hroot@143a541edbe0:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from rdkit import Chem
[?2004l[?2004h> from rdkit.Chem import AllChem
[?2004l[?2004h> from xgboost import XGBRegressor
[?2004l[?2004h> from sklearn.model_selection import train_test_split
[?2004l[?2004h> from sklearn.metrics import r2_score, mean_absolute_error
[?2004l[?2004h> 
[?2004l[?2004h> def fp(psmiles, n_bits=2048):
[?2004l[?2004h>     # As per instructions: replace [*] and * with C
[?2004l[?2004h>     s = psmiles.replace('[*]', 'C').replace('*', 'C')
[?2004l[?2004h>     mol = Chem.MolFromSmiles(s)
[?2004l[?2004h>     if mol is None:
[?2004l[?2004h>         return np.zeros(n_bits)
[?2004l[?2004h>     bv = AllChem.GetMorganFingerprintAsBitVect(mol, 2, nBits=n_bits)
[?2004l[?2004h>     # Convert BitVect to numpy array
[?2004l[?2004h>     return np.array(list(bv))
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train_df = pd.read_csv('train.csv')
[?2004l[?2004h> test_df = pd.read_csv('test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> print("Featurizing training data...")
[?2004l[?2004h> X_train_full = np.stack(train_df['PSMILES'].apply(fp).values)
[?2004l[?2004h> y_train_full = train_df['Tg'].values
[?2004l[?2004h> 
[?2004l[?2004h> # Split for validation
[?2004l[?2004h> X_train, X_val, y_train, y_val = train_test_split(X_train_full, y_train_full, test_size=0.2, random_state=42)
[?2004l[?2004h> 
[?2004l[?2004h> print("Training XGBoost model...")
[?2004l[?2004h> # LightAutoML is pre-installed but XGBoost is a strong, controllable baseline
[?2004l[?2004h> model = XGBRegressor(n_estimators=1000, learning_rate=0.05, max_depth=6, random_state=42)
[?2004l[?2004h> model.fit(X_train, y_train, eval_set=[(X_val, y_val)], early_stopping_rounds=50, verbose=False)
[?2004l[?2004h> 
[?2004l[?2004h> # Evaluate
[?2004l[?2004h> preds_val = model.predict(X_val)
[?2004l[?2004h> r2 = r2_score(y_val, preds_val)
[?2004l[?2004h> mae = mean_absolute_error(y_val, preds_val)
[?2004l[?2004h> print(f"Validation R2: {r2:.4f}, MAE: {mae:.4f}")
[?2004l[?2004h> 
[?2004l[?2004h> print("Featurizing test data...")
[?2004l[?2004h> X_test = np.stack(test_df['PSMILES'].apply(fp).values)
[?2004l[?2004h> 
[?2004l[?2004h> print("Predicting on test set...")
[?2004l[?2004h> preds_test = model.predict(X_test)
[?2004l[?2004h> 
[?2004l[?2004h> submission = pd.DataFrame({'id': test_df['id'], 'Tg': preds_test})
[?2004l[?2004h> submission.to_csv('submission.csv', index=False)
[?2004l[?2004h> print("Submission saved to submission.csv")
[?2004l[?2004h> EOF
[?2004lpython3 solution.py
[?2004hroot@143a541edbe0:/workspace# python3 solution.py
[?2004lFeaturizing training data...
