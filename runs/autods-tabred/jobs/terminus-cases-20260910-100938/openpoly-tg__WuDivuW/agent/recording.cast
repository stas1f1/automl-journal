[45.453324, "o", "Training XGBoost model...\r\nTraceback (most recent call last):\r\n  File \"/workspace/solution.py\", line 33, in <module>\r\n    model.fit(X_train, y_train, eval_set=[(X_val, y_val)], early_stopping_rounds=50, verbose=False)\r\n  File \"/usr/local/lib/python3.12/site-packages/xgboost/core.py\", line 726, in inner_f\r\n"]
