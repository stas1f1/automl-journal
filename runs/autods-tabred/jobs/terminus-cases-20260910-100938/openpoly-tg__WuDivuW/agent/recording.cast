[42.208574, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom rdkit import Chem\nfrom rdkit.Chem import AllChem\nfrom xgboost import XGBRegressor\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import r2_score, mean_absolute_error\n\ndef fp(psmiles, n_bits=2048):\n    # As per instructions: replace [*] and * with C\n    s = psmiles.replace('[*]', 'C').replace('*', 'C')\n    mol = Chem.MolFromSmiles(s)\n    if mol is None:\n        return np.zeros(n_bits)\n    bv = AllChem.GetMorganFingerprintAsBitVect(mol, 2, nBits=n_bits)\n    # Convert BitVect to numpy array\n    return np.array(list(bv))\n\n# Load data\ntrain_df = pd.read_csv('train.csv')\ntest_df = pd.read_csv('test.csv')\n\nprint(\"Featurizing training data...\")\nX_train_full = np.stack(train_df['PSMILES'].apply(fp).values)\ny_train_full = train_df['Tg'].values\n\n# Split for validation\nX_train, X_val, y_train, y_val = train_test_split(X_train_full, y_train_full, test_size=0.2, random_state=42)\n\nprint(\"Training XGBoost model...\")\n# LightAutoML is pre-installed but XGBoost is a strong, controllable baseline\nmodel = XGBRegressor(n_estimators=1000, learning_rate=0.05, max_depth=6, random_state=42)\nmodel.fit(X_train, y_train, eval_set=[(X_val, y_val)], early_stopping_rounds=50, verbose=False)\n\n# Evaluate\npreds_val = model.predict(X_val)\nr2 = r2_score(y_val, preds_val)\nmae = mean_absolute_error(y_val, preds_val)\nprint(f\"Validation R2: {r2:.4f}, MAE: {mae:.4f}\")\n\nprint(\"Featurizing test data...\")\nX_test = np.stack(test_df['PSMILES'].apply(fp).values)\n\nprint(\"Predicting on test set...\")\npreds_test = model.predict(X_test)\n\nsubmission = pd.DataFrame({'id': test_df['id'], 'Tg': preds_test})\nsubmission.to_csv('submission.csv', index=False)\nprint(\"Submission saved to submission.csv\")\nEOF\n"]
[42.208882, "o", "cat << 'EOF' > solution.py"]
