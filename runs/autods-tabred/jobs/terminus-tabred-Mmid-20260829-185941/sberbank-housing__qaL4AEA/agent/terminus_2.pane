[?2004hroot@94de41bfcdae:/workspace# cat <<EOF > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from catboost import CatBoostRegressor
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> X_train = train.drop('target', axis=1)
[?2004l[?2004h> y_train = train['target']
[?2004l[?2004h> 
[?2004l[?2004h> X_val = val.drop('target', axis=1)
[?2004l[?2004h> y_val = val['target']
[?2004l[?2004h> 
[?2004l[?2004h> # Identify feature types
[?2004l[?2004h> cat_features = [col for col in X_train.columns if col.startswith('cat_') or col.startswith('bin_')]
[?2004l[?2004h> 
[?2004l[?2004h> # Fill missing values for numerical features (though CatBoost handles NaNs)
[?2004l[?2004h> # For simplicity, we let CatBoost handle the NaNs
[?2004l[?2004h> 
[?2004l[?2004h> model = CatBoostRegressor(
[?2004l[?2004h>     iterations=1000,
[?2004l[?2004h>     learning_rate=0.05,
[?2004l[?2004h>     depth=6,
[?2004l[?2004h>     eval_metric='RMSE',
[?2004l[?2004h>     random_seed=42,
[?2004l[?2004h>     verbose=100
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> model.fit(
[?2004l[?2004h>     X_train, y_train, 
[?2004l[?2004h>     eval_set=(X_val, y_val), 
[?2004l[?2004h>     cat_features=cat_features, 
[?2004l[?2004h>     early_stopping_rounds=50
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Predict
[?2004l[?2004h> preds = model.predict(test)
[?2004l[?2004h> 
[?2004l[?2004h> # Save predictions
[?2004l[?2004h> output = pd.DataFrame({'target': preds})
[?2004l[?2004h> output.to_csv('/app/predictions.csv', index=False)
