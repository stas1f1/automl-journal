Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport xgboost as xgb\nfrom sklearn.metrics import roc_auc_score\nimport numpy as np\n\n# Load data\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\n# Identify feature types\nnum_cols = [c for c in train.columns if c.startswith('num_')]\nbin_cols = [c for c in train.columns if c.startswith('bin_')]\ncat_cols = [c for c in train.columns if c.startswith('cat_')]\n\nX_train = train.drop(columns=['target'])\ny_train = train['target']\nX_val = val.drop(columns=['target'])\ny_val = val['target']\n\n# Basic preprocessing: Fill numeric NaNs with median, cat NaNs with a constant\nfor col in num_cols:\n    X_train[col] = X_train[col].fillna(X_train[col].median())\n    X_val[col] = X_val[col].fillna(X_train[col].median())\n    test[col] = test[col].fillna(X_train[col].median())\n\nfor col in cat_cols:\n    X_train[col] = X_train[col].fillna(-1)\n    X_val[col] = X_val[col].fillna(-1)\n    test[col] = test[col].fillna(-1)\n\n# Convert categories to numeric if they aren't already\nfor col in cat_cols:\n    X_train[col] = X_train[col].astype('category').cat.codes\n    X_val[col] = X_val[col].astype('category').cat.codes\n    test[col] = test[col].astype('category').cat.codes\n\n# Train XGBoost\nmodel = xgb.XGBClassifier(n_estimators=500, learning_rate=0.05, max_depth=6, random_state=42, tree_method='hist', device='cuda' if xgb.BSTR_VERSION else 'cpu')\nmodel.fit(X_train, y_train, eval_set=[(X_val, y_val)], early_stopping_rounds=50, verbose=False)\n\n# Predict\npreds = model.predict_proba(test)[:, 1]\n\n# Save predictions\npreds_df = pd.DataFrame({'target': preds})\npreds_df.to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
