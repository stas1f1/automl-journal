Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport xgboost as xgb\nfrom sklearn.metrics import roc_auc_score\nimport numpy as np\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nX_train = train_df.drop(columns=['target'])\ny_train = train_df['target']\nX_val = val_df.drop(columns=['target'])\ny_val = val_df['target']\nX_test = test_df\n\n# XGBoost can handle NaNs internally, but we ensure the data type is correct\n# No categorical encoding needed as schema says cat: 0\n\n# Model parameters\nmodel = xgb.XGBClassifier(\n    n_estimators=1000,\n    learning_rate=0.05,\n    max_depth=6,\n    subsample=0.8,\n    colsample_bytree=0.8,\n    n_jobs=-1,\n    random_state=42,\n    eval_metric='auc',\n    early_stopping_rounds=50\n)\n\n# Train with early stopping\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    verbose=100\n)\n\n# Validate\nval_preds = model.predict_proba(X_val)[:, 1]\nauc_score = roc_auc_score(y_val, val_preds)\nprint(f'Validation ROC-AUC: {auc_score}')\n\n# Predict test set\ntest_preds = model.predict_proba(X_test)[:, 1]\npredictions_df = pd.DataFrame({'target': test_preds})\npredictions_df.to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
