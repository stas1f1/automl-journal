Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport xgboost as xgb\nfrom sklearn.preprocessing import LabelEncoder\nimport numpy as np\n\n# Load data\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\n# Identify feature types\nnum_cols = [col for col in train.columns if col.startswith('num_')]\nbin_cols = [col for col in train.columns if col.startswith('bin_')]\ncat_cols = [col for col in train.columns if col.startswith('cat_')]\n\ntarget_col = 'target'\n\n# Preprocess categorical features\nle = LabelEncoder()\nfor col in cat_cols:\n    # Combine train, val, and test to ensure consistent encoding\n    full_data = pd.concat([train[col], val[col], test[col]])\n    full_data = full_data.astype(str).fillna('nan')\n    le.fit(full_data)\n    train[col] = le.transform(train[col].astype(str).fillna('nan'))\n    val[col] = le.transform(val[col].astype(str).fillna('nan'))\n    test[col] = le.transform(test[col].astype(str).fillna('nan'))\n\nX_train = train.drop(columns=[target_col])\ny_train = train[target_col]\nX_val = val.drop(columns=[target_col])\ny_val = val[target_col]\n\n# Train XGBoost\nmodel = xgb.XGBRegressor(n_estimators=1000, learning_rate=0.05, max_depth=6, random_state=42, n_jobs=-1)\nmodel.fit(X_train, y_train, eval_set=[(X_val, y_val)], early_stopping_rounds=50, verbose=False)\n\n# Predict\npreds = model.predict(test)\n\n# Save predictions\npred_df = pd.DataFrame({'target': preds})\npred_df.to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
