Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport lightgbm as lgb\nimport numpy as np\n\n# Load data\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\ntarget_col = 'target'\n\n# Separate features and target\nX_train = train.drop(columns=[target_col])\ny_train = train[target_col]\nX_val = val.drop(columns=[target_col])\ny_val = val[target_col]\n\n# Identify feature types\nnum_cols = [c for c in X_train.columns if c.startswith('num_')]\nbin_cols = [c for c in X_train.columns if c.startswith('bin_')]\ncat_cols = [c for c in X_train.columns if c.startswith('cat_')]\n\n# Simple preprocessing\n# For LightGBM, we can handle NaNs and categorical features if we specify them\n# For simplicity, we'll treat categorical columns as categories\nfor col in cat_cols:\n    X_train[col] = X_train[col].astype('category')\n    X_val[col] = X_val[col].astype('category')\n    test[col] = test[col].astype('category')\n\n# Model training\nmodel = lgb.LGBMClassifier(n_estimators=1000, learning_rate=0.05, random_state=42, verbose=-1)\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    eval_metric='auc',\n    callbacks=[lgb.early_stopping(stopping_rounds=50)]\n)\n\n# Predictions\npreds = model.predict_proba(test)[:, 1]\npreds_df = pd.DataFrame({'target': preds})\npreds_df.to_csv('/app/predictions.csv', index=False)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
