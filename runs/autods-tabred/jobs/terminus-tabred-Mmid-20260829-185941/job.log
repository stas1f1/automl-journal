Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport lightgbm as lgb\nfrom sklearn.metrics import mean_squared_error\nimport numpy as np\n\n# Load data\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\n# Identify feature types\nnum_cols = [c for c in train.columns if c.startswith('num_')]\nbin_cols = [c for c in train.columns if c.startswith('bin_')]\ncat_cols = [c for c in train.columns if c.startswith('cat_')]\n\n# Target\ny_train = train['target']\ny_val = val['target']\n\n# Features\nX_train = train.drop(columns=['target'])\nX_val = val.drop(columns=['target'])\n\n# Simple preprocessing: fill numerical NaNs with median\nfor col in num_cols:\n    median_val = X_train[col].median()\n    X_train[col] = X_train[col].fillna(median_val)\n    X_val[col] = X_val[col].fillna(median_val)\n    test[col] = test[col].fillna(median_val)\n\n# Convert categorical columns to category type for LightGBM\nfor col in cat_cols:\n    X_train[col] = X_train[col].astype('category')\n    X_val[col] = X_val[col].astype('category')\n    test[col] = test[col].astype('category')\n\n# Train LightGBM\nmodel = lgb.LGBMRegressor(n_estimators=1000, learning_rate=0.05, random_state=42)\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    eval_metric='rmse',\n    callbacks=[lgb.early_stopping(stopping_rounds=50)]\n)\n\n# Predict\npreds = model.predict(test)\n\n# Write predictions\nsubmission = pd.DataFrame({'target': preds})\nsubmission.to_csv('/app/predictions.csv', index=False)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
