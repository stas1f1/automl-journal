[33.096647, "o", "\u001b[?2004hroot@1893e0b29eb8:/workspace# "]
[57.68895, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport xgboost as xgb\nimport numpy as np\n\n# Load data\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\n# Identify feature types\nnum_cols = [c for c in train.columns if c.startswith('num_')]\ncat_cols = [c for c in train.columns if c.startswith('cat_')]\nbin_cols = [c for c in train.columns if c.startswith('bin_')]\n\nX_train = train.drop(columns=['target'])\ny_train = train['target']\nX_val = val.drop(columns=['target'])\ny_val = val['target']\n\n# Handle numerical NaNs\nfor col in num_cols:\n    median = X_train[col].median()\n    X_train[col] = X_train[col].fillna(median)\n    X_val[col] = X_val[col].fillna(median)\n    test[col] = test[col].fillna(median)\n\n# Handle categorical features\n# To ensure consistency, we map categories based on train\nfor col in cat_cols:\n    # Fill NaNs first\n    X_train[col] = X_train[col].fillna(-1)\n    X_val[col] = X_val[col].fillna(-1)\n    test[col] = test[col].fillna(-1)\n    \n    # Create mapping\n    unique_cats = X_train[col].unique()\n    mapping = {cat: i for i, cat in enumerate(unique_cats)}\n    \n    X_train[col] = X_train[col].map(mapping).fillna(len(unique_cats)).astype(int)\n    X_val[col] = X_val[col].map(mapping).fillna(len(unique_cats)).astype(int)\n    test[col] = test[col].map(mapping).fillna(len(unique_cats)).astype(int)\n\n# Train XGBoost\n# We use tree_method='hist' for speed\nmodel = xgb.XGBClassifier(\n    n_estimators=1000,\n    learning_rate=0.05,\n    max_depth=6,\n    random_state=42,\n    tree_method='hist',\n    device='cpu'\n)\n\n# Fit with early stopping\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    early_stopping_rounds=50,\n    verbose=False\n)\n\n# Predict\npreds = model.predict_proba(test)[:, 1]\n\n# Save predictions\npreds_df = pd.DataFrame({'target': preds})\npreds_df.to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"]
