[65.652067, "o", "Traceback (most recent call last):\r\n  File \"/workspace/solution.py\", line 55, in <module>\r\n    model.fit(\r\n  File \"/usr/local/lib/python3.12/site-packages/xgboost/core.py\", line 726, in inner_f\r\n"]
