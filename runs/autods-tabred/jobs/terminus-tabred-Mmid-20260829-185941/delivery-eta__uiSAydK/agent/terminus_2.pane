[?2004hroot@bbe9b8189b0e:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import xgboost as xgb
[?2004l[?2004h> from sklearn.preprocessing import LabelEncoder
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Identify feature types
[?2004l[?2004h> num_cols = [col for col in train.columns if col.startswith('num_')]
[?2004l[?2004h> bin_cols = [col for col in train.columns if col.startswith('bin_')]
[?2004l[?2004h> cat_cols = [col for col in train.columns if col.startswith('cat_')]
[?2004l[?2004h> 
[?2004l[?2004h> target_col = 'target'
[?2004l[?2004h> 
[?2004l[?2004h> # Preprocess categorical features
[?2004l[?2004h> le = LabelEncoder()
[?2004l[?2004h> for col in cat_cols:
[?2004l[?2004h>     # Combine train, val, and test to ensure consistent encoding
[?2004l[?2004h>     full_data = pd.concat([train[col], val[col], test[col]])
[?2004l[?2004h>     full_data = full_data.astype(str).fillna('nan')
[?2004l[?2004h>     le.fit(full_data)
[?2004l[?2004h>     train[col] = le.transform(train[col].astype(str).fillna('nan'))
[?2004l[?2004h>     val[col] = le.transform(val[col].astype(str).fillna('nan'))
[?2004l[?2004h>     test[col] = le.transform(test[col].astype(str).fillna('nan'))
[?2004l[?2004h> 
[?2004l[?2004h> X_train = train.drop(columns=[target_col])
[?2004l[?2004h> y_train = train[target_col]
[?2004l[?2004h> X_val = val.drop(columns=[target_col])
[?2004l[?2004h> y_val = val[target_col]
[?2004l[?2004h> 
[?2004l[?2004h> # Train XGBoost
[?2004l[?2004h> model = xgb.XGBRegressor(n_estimators=1000, learning_rate=0.05, max_depth=6, random_state=42, n_jobs=-1)
[?2004l[?2004h> model.fit(X_train, y_train, eval_set=[(X_val, y_val)], early_stopping_rounds=50, verbose=False)
