[9.86517, "o", "{\r\n  \"dataset\": \"weather\",\r\n  \"source_split\": \"default\",\r\n  \"task_type\": \"regression\",\r\n  \"score\": \"rmse\",\r\n  \"target_column\": \"target\",\r\n  \"feature_columns\": [\r\n    \"num_0\",\r\n    \"num_1\",\r\n    \"num_2\",\r\n    \"num_3\",\r\n    \"num_4\",\r\n    \"num_5\","]
