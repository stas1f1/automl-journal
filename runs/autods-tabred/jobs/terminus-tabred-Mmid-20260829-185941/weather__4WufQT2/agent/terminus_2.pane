[?2004hroot@dcee614a5382:/workspace# cat << 'EOF' > model_train.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import lightgbm as lgb
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from sklearn.metrics import mean_squared_error
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> print('Loading data...')
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Split features and target
[?2004l[?2004h> X_train = train.drop(columns=['target'])
[?2004l[?2004h> y_train = train['target']
[?2004l[?2004h> X_val = val.drop(columns=['target'])
[?2004l[?2004h> y_val = val['target']
[?2004l[?2004h> X_test = test
[?2004l[?2004h> 
[?2004l[?2004h> # Train LightGBM
[?2004l[?2004h> print('Training model...')
[?2004l[?2004h> model = lgb.LGBMRegressor(n_estimators=1000, learning_rate=0.05, num_leaves=31, random_state=42)
[?2004l[?2004h> model.fit(
[?2004l[?2004h>     X_train, y_train, 
[?2004l[?2004h>     eval_set=[(X_val, y_val)],
[?2004l[?2004h>     eval_metric='rmse',
[?2004l[?2004h>     callbacks=[lgb.early_stopping(stopping_rounds=50)]
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Evaluate
[?2004l[?2004h> preds_val = model.predict(X_val)
[?2004l[?2004h> rmse = np.sqrt(mean_squared_error(y_val, preds_val))
[?2004l[?2004h> print(f'Validation RMSE: {rmse}')
[?2004l[?2004h> 
[?2004l[?2004h> # Predict and save
[?2004l[?2004h> print('Predicting on test set...')
[?2004l[?2004h> preds_test = model.predict(X_test)
[?2004l[?2004h> preds_df = pd.DataFrame({'target': preds_test})
[?2004l[?2004h> preds_df.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> print('Predictions saved to /app/predictions.csv')
[?2004l[?2004h> EOF
