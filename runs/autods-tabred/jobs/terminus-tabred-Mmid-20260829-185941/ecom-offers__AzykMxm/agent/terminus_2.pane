[?2004hroot@5028fe57657a:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import xgboost as xgb
[?2004l[?2004h> from sklearn.metrics import roc_auc_score
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train_df = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val_df = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test_df = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> X_train = train_df.drop(columns=['target'])
[?2004l[?2004h> y_train = train_df['target']
[?2004l[?2004h> X_val = val_df.drop(columns=['target'])
[?2004l[?2004h> y_val = val_df['target']
[?2004l[?2004h> X_test = test_df
[?2004l[?2004h> 
[?2004l[?2004h> # XGBoost can handle NaNs internally, but we ensure the data type is correct
[?2004l[?2004h> # No categorical encoding needed as schema says cat: 0
[?2004l[?2004h> 
[?2004l[?2004h> # Model parameters
[?2004l[?2004h> model = xgb.XGBClassifier(
[?2004l[?2004h>     n_estimators=1000,
[?2004l[?2004h>     learning_rate=0.05,
[?2004l[?2004h>     max_depth=6,
[?2004l[?2004h>     subsample=0.8,
[?2004l[?2004h>     colsample_bytree=0.8,
[?2004l[?2004h>     n_jobs=-1,
[?2004l[?2004h>     random_state=42,
[?2004l[?2004h>     eval_metric='auc',
[?2004l[?2004h>     early_stopping_rounds=50
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Train with early stopping
[?2004l[?2004h> model.fit(
[?2004l[?2004h>     X_train, y_train,
[?2004l[?2004h>     eval_set=[(X_val, y_val)],
[?2004l[?2004h>     verbose=100
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Validate
[?2004l[?2004h> val_preds = model.predict_proba(X_val)[:, 1]
[?2004l[?2004h> auc_score = roc_auc_score(y_val, val_preds)
[?2004l[?2004h> print(f'Validation ROC-AUC: {auc_score}')
[?2004l[?2004h> 
[?2004l[?2004h> # Predict test set
[?2004l[?2004h> test_preds = model.predict_proba(X_test)[:, 1]
[?2004l[?2004h> predictions_df = pd.DataFrame({'target': test_preds})
[?2004l[?2004h> predictions_df.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> print('Predictions saved to /app/predictions.csv')
[?2004l[?2004h> EOF
