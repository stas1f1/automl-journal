[?2004hroot@8b8a6183a98a:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import lightgbm as lgb
[?2004l[?2004h> from sklearn.metrics import roc_auc_score
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> def solve():
[?2004l[?2004h>     train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h>     val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h>     test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h>     
[?2004l[?2004h>     target_col = 'target'
[?2004l[?2004h>     
[?2004l[?2004h>     # Identify column types
[?2004l[?2004h>     cols = train.columns.tolist()
[?2004l[?2004h>     num_cols = [c for c in cols if c.startswith('num_')]
[?2004l[?2004h>     bin_cols = [c for c in cols if c.startswith('bin_')]
[?2004l[?2004h>     cat_cols = [c for c in cols if c.startswith('cat_')]
[?2004l[?2004h>     
[?2004l[?2004h>     # Prepare training data
[?2004l[?2004h>     X_train = train.drop(columns=[target_col])
[?2004l[?2004h>     y_train = train[target_col]
[?2004l[?2004h>     
[?2004l[?2004h>     X_val = val.drop(columns=[target_col])
[?2004l[?2004h>     y_val = val[target_col]
[?2004l[?2004h>     
[?2004l[?2004h>     X_test = test
[?2004l[?2004h>     
[?2004l[?2004h>     # Convert categorical columns to category type for LightGBM
[?2004l[?2004h>     for col in cat_cols:
[?2004l[?2004h>         X_train[col] = X_train[col].astype('category')
[?2004l[?2004h>         X_val[col] = X_val[col].astype('category')
[?2004l[?2004h>         X_test[col] = X_test[col].astype('category')
[?2004l[?2004h> 
[?2004l[?2004h>     # LightGBM model
[?2004l[?2004h>     model = lgb.LGBMClassifier(
[?2004l[?2004h>         n_estimators=1000,
[?2004l[?2004h>         learning_rate=0.05,
[?2004l[?2004h>         num_leaves=31,
[?2004l[?2004h>         colsample_bytree=0.8,
[?2004l[?2004h>         subsample=0.8,
[?2004l[?2004h>         random_state=42,
[?2004l[?2004h>         n_jobs=-1
[?2004l[?2004h>     )
[?2004l[?2004h>     
[?2004l[?2004h>     model.fit(
[?2004l[?2004h>         X_train, y_train,
[?2004l[?2004h>         eval_set=[(X_val, y_val)],
[?2004l[?2004h>         eval_metric='auc',
[?2004l[?2004h>         callbacks=[lgb.early_stopping(stopping_rounds=50)]
[?2004l[?2004h>     )
[?2004l[?2004h>     
[?2004l[?2004h>     # Predictions
[?2004l[?2004h>     probs = model.predict_proba(X_test)[:, 1]
[?2004l[?2004h>     
[?2004l[?2004h>     predictions = pd.DataFrame({'target': probs})
[?2004l[?2004h>     predictions.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == '__main__':
[?2004l[?2004h>     solve()
[?2004l[?2004h> EOF
