[?2004hroot@3caf891f9843:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import lightgbm as lgb
[?2004l[?2004h> from sklearn.metrics import mean_squared_error
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train_df = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val_df = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test_df = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> target_col = 'target'
[?2004l[?2004h> 
[?2004l[?2004h> X_train = train_df.drop(columns=[target_col])
[?2004l[?2004h> y_train = train_df[target_col]
[?2004l[?2004h> 
[?2004l[?2004h> X_val = val_df.drop(columns=[target_col])
[?2004l[?2004h> y_val = val_df[target_col]
[?2004l[?2004h> 
[?2004l[?2004h> X_test = test_df
[?2004l[?2004h> 
[?2004l[?2004h> # Identify categorical features
[?2004l[?2004h> cat_cols = [col for col in X_train.columns if col.startswith('cat_')]
[?2004l[?2004h> for col in cat_cols:
[?2004l[?2004h>     X_train[col] = X_train[col].astype('category')
[?2004l[?2004h>     X_val[col] = X_val[col].astype('category')
[?2004l[?2004h>     X_test[col] = X_test[col].astype('category')
[?2004l[?2004h> 
[?2004l[?2004h> # LightGBM Model
[?2004l[?2004h> model = lgb.LGBMRegressor(
[?2004l[?2004h>     n_estimators=1000,
[?2004l[?2004h>     learning_rate=0.05,
[?2004l[?2004h>     num_leaves=31,
[?2004l[?2004h>     max_depth=-1,
[?2004l[?2004h>     n_jobs=-1,
[?2004l[?2004h>     random_state=42,
[?2004l[?2004h>     importance_type='split'
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Train model with early stopping
[?2004l[?2004h> model.fit(
[?2004l[?2004h>     X_train, y_train,
[?2004l[?2004h>     eval_set=[(X_val, y_val)],
[?2004l[?2004h>     eval_metric='rmse',
[?2004l[?2004h>     callbacks=[lgb.early_stopping(stopping_rounds=50)]
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Predict
[?2004l[?2004h> preds = model.predict(X_test)
[?2004l[?2004h> 
[?2004l[?2004h> # Save predictions
[?2004l[?2004h> submission = pd.DataFrame({'target': preds})
[?2004l[?2004h> submission.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> print('Predictions saved to /app/predictions.csv')
[?2004l[?2004h> EOF
