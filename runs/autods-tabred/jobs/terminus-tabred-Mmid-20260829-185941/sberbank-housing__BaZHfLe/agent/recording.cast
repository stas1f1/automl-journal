[38.234243, "o", "\u001b[?2004h> "]
[38.234293, "o", "    learning_rate=0.05,\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.23434, "o", "> "]
[38.234386, "o", "    num_leaves=31,"]
[38.234432, "o", "\r\n"]
[38.23448, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[38.234526, "o", "    max_depth=-1,\r\n\u001b[?2004l\r\u001b[?2004h> "]
