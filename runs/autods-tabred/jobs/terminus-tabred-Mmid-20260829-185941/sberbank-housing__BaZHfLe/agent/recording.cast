[38.235239, "o", "\u001b[?2004l\r"]
[38.235286, "o", "\u001b[?2004h> "]
[38.235331, "o", "model.fit(\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.235378, "o", "> "]
