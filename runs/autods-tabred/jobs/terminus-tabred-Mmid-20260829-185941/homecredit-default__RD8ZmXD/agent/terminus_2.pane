[?2004hroot@b4b899bc7fea:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import lightgbm as lgb
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> target_col = 'target'
[?2004l[?2004h> 
[?2004l[?2004h> # Separate features and target
[?2004l[?2004h> X_train = train.drop(columns=[target_col])
[?2004l[?2004h> y_train = train[target_col]
[?2004l[?2004h> X_val = val.drop(columns=[target_col])
[?2004l[?2004h> y_val = val[target_col]
[?2004l[?2004h> 
[?2004l[?2004h> # Identify feature types
[?2004l[?2004h> num_cols = [c for c in X_train.columns if c.startswith('num_')]
[?2004l[?2004h> bin_cols = [c for c in X_train.columns if c.startswith('bin_')]
[?2004l[?2004h> cat_cols = [c for c in X_train.columns if c.startswith('cat_')]
[?2004l[?2004h> 
[?2004l[?2004h> # Simple preprocessing
[?2004l[?2004h> # For LightGBM, we can handle NaNs and categorical features if we specify them
[?2004l[?2004h> # For simplicity, we'll treat categorical columns as categories
[?2004l[?2004h> for col in cat_cols:
[?2004l[?2004h>     X_train[col] = X_train[col].astype('category')
[?2004l[?2004h>     X_val[col] = X_val[col].astype('category')
[?2004l[?2004h>     test[col] = test[col].astype('category')
[?2004l[?2004h> 
[?2004l[?2004h> # Model training
[?2004l[?2004h> model = lgb.LGBMClassifier(n_estimators=1000, learning_rate=0.05, random_state=42, verbose=-1)
[?2004l[?2004h> model.fit(
[?2004l[?2004h>     X_train, y_train,
[?2004l[?2004h>     eval_set=[(X_val, y_val)],
[?2004l[?2004h>     eval_metric='auc',
[?2004l[?2004h>     callbacks=[lgb.early_stopping(stopping_rounds=50)]
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Predictions
[?2004l[?2004h> preds = model.predict_proba(test)[:, 1]
[?2004l[?2004h> preds_df = pd.DataFrame({'target': preds})
[?2004l[?2004h> preds_df.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> EOF
