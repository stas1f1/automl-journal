[?2004hroot@1be4ef291a8e:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import lightgbm as lgb
[?2004l[?2004h> from sklearn.metrics import mean_squared_error
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Identify feature types
[?2004l[?2004h> num_cols = [c for c in train.columns if c.startswith('num_')]
[?2004l[?2004h> bin_cols = [c for c in train.columns if c.startswith('bin_')]
[?2004l[?2004h> cat_cols = [c for c in train.columns if c.startswith('cat_')]
[?2004l[?2004h> 
[?2004l[?2004h> # Target
[?2004l[?2004h> y_train = train['target']
[?2004l[?2004h> y_val = val['target']
[?2004l[?2004h> 
[?2004l[?2004h> # Features
[?2004l[?2004h> X_train = train.drop(columns=['target'])
[?2004l[?2004h> X_val = val.drop(columns=['target'])
[?2004l[?2004h> 
[?2004l[?2004h> # Simple preprocessing: fill numerical NaNs with median
[?2004l[?2004h> for col in num_cols:
[?2004l[?2004h>     median_val = X_train[col].median()
[?2004l[?2004h>     X_train[col] = X_train[col].fillna(median_val)
[?2004l[?2004h>     X_val[col] = X_val[col].fillna(median_val)
[?2004l[?2004h>     test[col] = test[col].fillna(median_val)
[?2004l[?2004h> 
[?2004l[?2004h> # Convert categorical columns to category type for LightGBM
[?2004l[?2004h> for col in cat_cols:
[?2004l[?2004h>     X_train[col] = X_train[col].astype('category')
[?2004l[?2004h>     X_val[col] = X_val[col].astype('category')
[?2004l[?2004h>     test[col] = test[col].astype('category')
[?2004l[?2004h> 
[?2004l[?2004h> # Train LightGBM
[?2004l[?2004h> model = lgb.LGBMRegressor(n_estimators=1000, learning_rate=0.05, random_state=42)
[?2004l[?2004h> model.fit(
[?2004l[?2004h>     X_train, y_train,
[?2004l[?2004h>     eval_set=[(X_val, y_val)],
[?2004l[?2004h>     eval_metric='rmse',
[?2004l[?2004h>     callbacks=[lgb.early_stopping(stopping_rounds=50)]
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Predict
[?2004l[?2004h> preds = model.predict(test)
[?2004l[?2004h> 
[?2004l[?2004h> # Write predictions
[?2004l[?2004h> submission = pd.DataFrame({'target': preds})
[?2004l[?2004h> submission.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> EOF
