[?2004hroot@6d262b0c2d37:/workspace# cat <<EOF > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from lightgbm import LGBMRegressor
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> X_train = train.drop(columns=['target'])
[?2004l[?2004h> y_train = train['target']
[?2004l[?2004h> X_val = val.drop(columns=['target'])
[?2004l[?2004h> y_val = val['target']
[?2004l[?2004h> 
[?2004l[?2004h> # Identify feature types
[?2004l[?2004h> num_cols = [c for c in X_train.columns if c.startswith('num_')]
[?2004l[?2004h> cat_cols = [c for c in X_train.columns if c.startswith('cat_')]
[?2004l[?2004h> bin_cols = [c for c in X_train.columns if c.startswith('bin_')]
[?2004l[?2004h> 
[?2004l[?2004h> # Simple preprocessing: Fill NaNs for numerical, convert categorical to codes
[?2004l[?2004h> for col in num_cols:
[?2004l[?2004h>     X_train[col] = X_train[col].fillna(X_train[col].median())
[?2004l[?2004h>     X_val[col] = X_val[col].fillna(X_train[col].median())
[?2004l[?2004h>     test[col] = test[col].fillna(X_train[col].median())
[?2004l[?2004h> 
[?2004l[?2004h> for col in cat_cols:
[?2004l[?2004h>     X_train[col] = X_train[col].astype('category')
[?2004l[?2004h>     X_val[col] = X_val[col].astype('category')
[?2004l[?2004h>     test[col] = test[col].astype('category')
[?2004l[?2004h> 
[?2004l[?2004h> # Train model
[?2004l[?2004h> model = LGBMRegressor(n_estimators=1000, learning_rate=0.05, random_state=42)
[?2004l[?2004h> model.fit(X_train, y_train, eval_set=[(X_val, y_val)], eval_metric='rmse', callbacks=[])
[?2004l[?2004h> 
[?2004l[?2004h> # Predict
[?2004l[?2004h> preds = model.predict(test)
[?2004l[?2004h> preds_df = pd.DataFrame({'target': preds})
[?2004l[?2004h> preds_df.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> EOF
