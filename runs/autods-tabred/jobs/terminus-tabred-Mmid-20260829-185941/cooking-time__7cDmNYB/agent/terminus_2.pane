[?2004hroot@091b4f51f880:/workspace# cat <<EOF > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from xgboost import XGBRegressor
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Separate target
[?2004l[?2004h> y_train = train['target']
[?2004l[?2004h> y_val = val['target']
[?2004l[?2004h> 
[?2004l[?2004h> # Remove target from features
[?2004l[?2004h> X_train = train.drop(columns=['target'])
[?2004l[?2004h> X_val = val.drop(columns=['target'])
[?2004l[?2004h> 
[?2004l[?2004h> # Basic preprocessing: fill numerical NaNs with median
[?2004l[?2004h> # Since features are prefixed, we can easily identify them
[?2004l[?2004h> num_cols = [col for col in X_train.columns if col.startswith('num_')]
[?2004l[?2004h> cat_cols = [col for col in X_train.columns if col.startswith('cat_') or col.startswith('bin_')]
[?2004l[?2004h> 
[?2004l[?2004h> for col in num_cols:
[?2004l[?2004h>     median = X_train[col].median()
[?2004l[?2004h>     X_train[col] = X_train[col].fillna(median)
[?2004l[?2004h>     X_val[col] = X_val[col].fillna(median)
[?2004l[?2004h>     test[col] = test[col].fillna(median)
[?2004l[?2004h> 
[?2004l[?2004h> # For categorical/binary, treat them as categories or fill NaNs
[?2004l[?2004h> for col in cat_cols:
[?2004l[?2004h>     X_train[col] = X_train[col].fillna(-1)
[?2004l[?2004h>     X_val[col] = X_val[col].fillna(-1)
[?2004l[?2004h>     test[col] = test[col].fillna(-1)
[?2004l[?2004h> 
[?2004l[?2004h> # Initialize and train XGBoost
[?2004l[?2004h> model = XGBRegressor(n_estimators=100, learning_rate=0.1, max_depth=6, random_state=42)
[?2004l[?2004h> model.fit(X_train, y_train, eval_set=[(X_val, y_val)], verbose=False)
[?2004l[?2004h> 
[?2004l[?2004h> # Predict
[?2004l[?2004h> preds = model.predict(test)
[?2004l[?2004h> 
[?2004l[?2004h> # Save to CSV
[?2004l[?2004h> submission = pd.DataFrame({'target': preds})
[?2004l[?2004h> submission.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> EOF
