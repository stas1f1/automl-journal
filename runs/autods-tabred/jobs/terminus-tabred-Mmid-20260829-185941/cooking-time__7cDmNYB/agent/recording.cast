[21.152281, "o", "root@091b4f51f880:/workspace# "]
[30.476977, "i", "cat <<EOF > solution.py\nimport pandas as pd\nimport numpy as np\nfrom xgboost import XGBRegressor\n\n# Load data\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\n# Separate target\ny_train = train['target']\ny_val = val['target']\n\n# Remove target from features\nX_train = train.drop(columns=['target'])\nX_val = val.drop(columns=['target'])\n\n# Basic preprocessing: fill numerical NaNs with median\n# Since features are prefixed, we can easily identify them\nnum_cols = [col for col in X_train.columns if col.startswith('num_')]\ncat_cols = [col for col in X_train.columns if col.startswith('cat_') or col.startswith('bin_')]\n\nfor col in num_cols:\n    median = X_train[col].median()\n    X_train[col] = X_train[col].fillna(median)\n    X_val[col] = X_val[col].fillna(median)\n    test[col] = test[col].fillna(median)\n\n# For categorical/binary, treat them as categories or fill NaNs\nfor col in cat_cols:\n    X_train[col] = X_train[col].fillna(-1)\n    X_val[col] = X_val[col].fillna(-1)\n    test[col] = test[col].fillna(-1)\n\n# Initialize and train XGBoost\nmodel = XGBRegressor(n_estimators=100, learning_rate=0.1, max_depth=6, random_state=42)\nmodel.fit(X_train, y_train, eval_set=[(X_val, y_val)], verbose=False)\n\n# Predict\npreds = model.predict(test)\n\n# Save to CSV\nsubmission = pd.DataFrame({'target': preds})\nsubmission.to_csv('/app/predictions.csv', index=False)\nEOF\n"]
[30.477348, "o", "cat <<EOF > solution.py\r\n"]
