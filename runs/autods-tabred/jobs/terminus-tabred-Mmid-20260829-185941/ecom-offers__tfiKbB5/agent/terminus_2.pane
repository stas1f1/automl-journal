[?2004hroot@d98535a5c5fa:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import xgboost as xgb
[?2004l[?2004h> from sklearn.metrics import roc_auc_score
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Separate features and target
[?2004l[?2004h> X_train = train.drop(columns=['target'])
[?2004l[?2004h> y_train = train['target']
[?2004l[?2004h> X_val = val.drop(columns=['target'])
[?2004l[?2004h> y_val = val['target']
[?2004l[?2004h> 
[?2004l[?2004h> # Identify feature types
[?2004l[?2004h> all_cols = X_train.columns
[?2004l[?2004h> num_cols = [c for c in all_cols if c.startswith('num_')]
[?2004l[?2004h> bin_cols = [c for c in all_cols if c.startswith('bin_')]
[?2004l[?2004h> cat_cols = [c for c in all_cols if c.startswith('cat_')]
[?2004l[?2004h> 
[?2004l[?2004h> # Simple Label Encoding for categorical features if they exist
[?2004l[?2004h> for col in cat_cols:
[?2004l[?2004h>     X_train[col] = X_train[col].astype(str).fillna('nan').astype('category').cat.codes
[?2004l[?2004h>     X_val[col] = X_val[col].astype(str).fillna('nan').astype('category').cat.codes
[?2004l[?2004h>     test[col] = test[col].astype(str).fillna('nan').astype('category').cat.codes
[?2004l[?2004h> 
[?2004l[?2004h> # Train XGBoost
[?2004l[?2004h> model = xgb.XGBClassifier(
[?2004l[?2004h>     n_estimators=1000,
[?2004l[?2004h>     max_depth=6,
[?2004l[?2004h>     learning_rate=0.05,
[?2004l[?2004h>     subsample=0.8,
[?2004l[?2004h>     colsample_bytree=0.8,
[?2004l[?2004h>     n_jobs=-1,
[?2004l[?2004h>     random_state=42,
[?2004l[?2004h>     eval_metric='auc',
[?2004l[?2004h>     early_stopping_rounds=50
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> model.fit(
[?2004l[?2004h>     X_train, y_train,
[?2004l[?2004h>     eval_set=[(X_val, y_val)],
[?2004l[?2004h>     verbose=False
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Validate
[?2004l[?2004h> val_probs = model.predict_proba(X_val)[:, 1]
[?2004l[?2004h> auc = roc_auc_score(y_val, val_probs)
[?2004l[?2004h> print(f'Validation ROC-AUC: {auc}')
[?2004l[?2004h> 
[?2004l[?2004h> # Predict
[?2004l[?2004h> test_probs = model.predict_proba(test)[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> # Save predictions
[?2004l[?2004h> pred_df = pd.DataFrame({'target': test_probs})
[?2004l[?2004h> pred_df.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> EOF
