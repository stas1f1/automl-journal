[?2004hroot@e4b9b982cc1a:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import lightgbm as lgb
[?2004l[?2004h> from sklearn.metrics import roc_auc_score
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Identify feature types
[?2004l[?2004h> numeric_cols = [col for col in train.columns if col.startswith('num_')]
[?2004l[?2004h> binary_cols = [col for col in train.columns if col.startswith('bin_')]
[?2004l[?2004h> categorical_cols = [col for col in train.columns if col.startswith('cat_')]
[?2004l[?2004h> 
[?2004l[?2004h> # Prepare target
[?2004l[?2004h> y_train = train['target']
[?2004l[?2004h> y_val = val['target']
[?2004l[?2004h> X_train = train.drop(columns=['target'])
[?2004l[?2004h> X_val = val.drop(columns=['target'])
[?2004l[?2004h> 
[?2004l[?2004h> # LightGBM handles NaNs and categorical features if specified
[?2004l[?2004h> # We specify which columns are categorical
[?2004l[?2004h> cat_features = categorical_cols
[?2004l[?2004h> 
[?2004l[?2004h> # Convert categorical columns to 'category' dtype for LightGBM
[?2004l[?2004h> for col in cat_features:
[?2004l[?2004h>     X_train[col] = X_train[col].astype('category')
[?2004l[?2004h>     X_val[col] = X_val[col].astype('category')
[?2004l[?2004h>     test[col] = test[col].astype('category')
[?2004l[?2004h> 
[?2004l[?2004h> # Train model
[?2004l[?2004h> model = lgb.LGBMClassifier(
[?2004l[?2004h>     n_estimators=1000,
[?2004l[?2004h>     learning_rate=0.05,
[?2004l[?2004h>     num_leaves=31,
[?2004l[?2004h>     objective='binary',
[?2004l[?2004h>     metric='auc',
[?2004l[?2004h>     random_state=42,
[?2004l[?2004h>     n_jobs=-1
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> model.fit(
[?2004l[?2004h>     X_train, y_train,
[?2004l[?2004h>     eval_set=[(X_val, y_val)],
[?2004l[?2004h>     eval_metric='auc',
[?2004l[?2004h>     callbacks=[lgb.early_stopping(stopping_rounds=50)]
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Predict probabilities
[?2004l[?2004h> probs = model.predict_proba(test)[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> # Save predictions
[?2004l[?2004h> pred_df = pd.DataFrame({'target': probs})
[?2004l[?2004h> pred_df.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> print('Predictions saved to /app/predictions.csv')
[?2004l[?2004h> EOF
